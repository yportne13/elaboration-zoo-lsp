// ladder_medium.typort
// Scale ladder for L09: a 94-unit proof/literal registry (same skeleton at
// every size; only the registry block grows). Shape: Nat literals + GADT
// equality proofs + one length-indexed Vec snapshot + a Nat total.
// Decl target: ~200 (actual: 201).

enum Nat {
    zero
    succ(x: Nat)
}

enum Eq[A](x: A, y: A) {
    refl[a: A] -> Eq[A] a a
}

enum Vec[A](len: Nat) {
    nil -> Vec[A] zero
    cons[n: Nat](x: A, xs: Vec[A] n) -> Vec[A] (succ n)
}

def one: Nat = succ zero

def two: Nat = succ one

def vtwo: Vec[Nat] two = cons one (cons two nil)

def nat_add_lit(x: Nat, y: Nat): Nat =
    match x {
        case zero => y
        case succ(n) => succ (nat_add_lit n y)
    }
def lit0: Nat = zero
def proof0: Eq[Nat] lit0 lit0 = refl
