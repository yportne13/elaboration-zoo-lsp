// 规模阶梯（L11 宏代码生成）：声明级宏 svc 每个调用生成一个业务函数，
// 函数体经表达式级宏 addtwo 展开；链式引用形成 service pipeline。
enum Nat {
    zero
    succ(x: Nat)
}

def add(x: Nat, y: Nat): Nat =
    match x {
        case zero => y
        case succ(n) => succ (add n y)
    }

macro_rules addtwo {
    ($x: raw) => { succ (succ $x) }
}

macro_rules svc {
    ($name: ident $prev: raw) => {
        def $name : Nat = addtwo $prev
    }
}

def stage_base : Nat = zero
svc stage_000 stage_base
