enum Nat {
    zero
    succ(x: Nat)
}

enum Bool {
    true
    false
}

trait Show {
    def show: String
}

impl Show for Bool {
    def show: String = "bool"
}

impl Show for Nat {
    def show: String = "nat"
}

def render[T][s: Show[T]](x: T): String = s.show x

println (render true)

println (render zero)
