
def outParam[A](a: A): A = a

enum Bool {
    true
    false
}

trait Less {
    def <(that: Bool): Bool
}

impl Less for Bool {
    def <(that: Bool): Bool =
        match this {
            case true =>
                match that {
                    case true => false
                    case false => false
                }
            case false =>
                match that {
                    case true => true
                    case false => false
                }
        }
}

println (true.< false)
