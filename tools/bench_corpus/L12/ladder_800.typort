// 规模阶梯（L12 实例解析）：每个 def 都触发一次 Show[T] 实例求解，
// 具体实例在 Bool / Nat 之间交替，形成实例解析密集的调用序列。
def outParam[A](a: A): A = a

enum Nat {
    zero
    succ(x: Nat)
}

enum Bool {
    true
    false
}

trait Show {
    def show: String
}

impl Show for Bool {
    def show: String =
        match this {
            case true => "true"
            case false => "false"
        }
}

impl Show for Nat {
    def show: String =
        match this {
            case zero => "0"
            case succ(n) => "n"
        }
}

def one = succ zero

def two = succ one

def three = succ two

def render[T][s: Show[T]](x: T): String = s.show x
def r_000 : String = render true
