// 规模阶梯（L12 实例解析）：每个 def 都触发一次 Show[T] 实例求解，
// 具体实例在 Bool / Nat 之间交替，形成实例解析密集的调用序列。
def outParam[A](a: A): A = a

enum Nat {
    zero
    succ(x: Nat)
}

enum Bool {
    true
    false
}

trait Show {
    def show: String
}

impl Show for Bool {
    def show: String =
        match this {
            case true => "true"
            case false => "false"
        }
}

impl Show for Nat {
    def show: String =
        match this {
            case zero => "0"
            case succ(n) => "n"
        }
}

def one = succ zero

def two = succ one

def three = succ two

def render[T][s: Show[T]](x: T): String = s.show x
def r_000 : String = render true
def r_001 : String = render false
def r_002 : String = render zero
def r_003 : String = render one
def r_004 : String = render two
def r_005 : String = render three
def r_006 : String = render true
def r_007 : String = render false
def r_008 : String = render zero
def r_009 : String = render one
def r_010 : String = render two
def r_011 : String = render three
def r_012 : String = render true
def r_013 : String = render false
def r_014 : String = render zero
def r_015 : String = render one
def r_016 : String = render two
def r_017 : String = render three
def r_018 : String = render true
def r_019 : String = render false
def r_020 : String = render zero
def r_021 : String = render one
def r_022 : String = render two
def r_023 : String = render three
def r_024 : String = render true
def r_025 : String = render false
def r_026 : String = render zero
def r_027 : String = render one
def r_028 : String = render two
def r_029 : String = render three
def r_030 : String = render true
def r_031 : String = render false
def r_032 : String = render zero
def r_033 : String = render one
def r_034 : String = render two
def r_035 : String = render three
def r_036 : String = render true
def r_037 : String = render false
def r_038 : String = render zero
def r_039 : String = render one
def r_040 : String = render two
def r_041 : String = render three

println r_000

