// ladder_medium.typort
// Scale ladder for L10: a 93-unit tag-instance registry (same skeleton at
// every size; only the registry block grows). Shape: Tag trait + dictionary
// default renderer + one Tag instance per generated register struct.
// Decl target: ~200 (actual: 202).

def outParam[A](a: A): A = a

enum Nat {
    zero
    succ(x: Nat)
}

def one: Nat = succ zero

def two: Nat = succ one

def three: Nat = succ two

def four: Nat = succ three

def nat_add(x: Nat, y: Nat): Nat =
    match x {
        case zero => y
        case succ(n) => succ (nat_add n y)
    }

trait Tag {
    def tag: String
}

impl Tag for Nat {
    def tag: String = "nat"
}

def default_render[T][t: Tag[T]](x: T): String =
    string_concat "render(" (string_concat (t.tag x) ")")

struct Reg0 {
    width: Nat
}

impl Tag for Reg0 {
    def tag: String = "reg0"
}

