    width: Nat
}

impl Tag for Reg17 {
    def tag: String = "reg17"
}

def sample_first = new Reg0(one)

def sample_last = new Reg17(four)

def last_nat: Nat = nat_add two two

println (default_render sample_first)
println (default_render sample_last)
println last_nat
