// ladder_small.typort
// Scale ladder for L10: a 18-unit tag-instance registry (same skeleton at
// every size; only the registry block grows). Shape: Tag trait + dictionary
// default renderer + one Tag instance per generated register struct.
// Decl target: ~50 (actual: 52).

def outParam[A](a: A): A = a

enum Nat {
    zero
    succ(x: Nat)
}

def one: Nat = succ zero

def two: Nat = succ one

def three: Nat = succ two

def four: Nat = succ three

def nat_add(x: Nat, y: Nat): Nat =
    match x {
        case zero => y
        case succ(n) => succ (nat_add n y)
    }

trait Tag {
    def tag: String
}

impl Tag for Nat {
    def tag: String = "nat"
}

def default_render[T][t: Tag[T]](x: T): String =
    string_concat "render(" (string_concat (t.tag x) ")")

struct Reg0 {
    width: Nat
}

impl Tag for Reg0 {
    def tag: String = "reg0"
}

struct Reg1 {
    width: Nat
}

impl Tag for Reg1 {
    def tag: String = "reg1"
}

struct Reg2 {
    width: Nat
}

impl Tag for Reg2 {
    def tag: String = "reg2"
}

struct Reg3 {
    width: Nat
}

impl Tag for Reg3 {
    def tag: String = "reg3"
}

