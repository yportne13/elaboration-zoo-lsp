enum Nat {
    zero
    succ(x: Nat)
}

enum List[A] {
    nil
    cons(head: A, tail: List[A])
}

def lennat(xs: List[Nat]): Nat =
    match xs {
        case nil => zero
        case cons(x, rest) => succ (lennat rest)
    }

def add(x: Nat, y: Nat) =
    match x {
        case zero => y
        case succ(n) => succ (add n y)
    }

println (add (lennat (cons zero (cons zero nil))) (succ zero))
