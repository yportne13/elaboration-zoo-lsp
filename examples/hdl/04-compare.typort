// ============================================================
// HDL Example 04: 比较运算 (Comparison)
//
//   <  <=  >  >=    大小比较，两侧位宽必须一致
//   ===  =/=         相等/不等
//   结果恒为 Bool
//   Nat 字面量可直接参与比较
// ============================================================

module compareUInt {
    input a = UInt[8]
    input b = UInt[8]
    output lt = Bool
    output le = Bool
    output gt = Bool
    output ge = Bool
    output eq = Bool
    output ne = Bool
    lt := a < b
    le := a <= b
    gt := a > b
    ge := a >= b
    eq := a === b
    ne := a =/= b
}
println("=== 04a: compareUInt (UInt 比较) ===")
println(moduleTreeVL(compareUInt.create.tree))

module compareNat {
    input a = UInt[8]
    output eq42 = Bool
    output lt100 = Bool
    output ne0 = Bool
    eq42 := a === 42
    lt100 := a < 100
    ne0 := a =/= 0
}
println("=== 04b: compareNat (与 Nat 字面量比较) ===")
println(moduleTreeVL(compareNat.create.tree))

module compareSInt {
    input a = SInt[8]
    input b = SInt[8]
    output lt = Bool
    output eq = Bool
    lt := a < b
    eq := a === b
}
println("=== 04c: compareSInt (SInt 比较) ===")
println(moduleTreeVL(compareSInt.create.tree))
