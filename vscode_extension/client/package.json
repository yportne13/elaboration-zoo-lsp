{
	"name": "client",
	"description": "The TyportHDL language client",
	"author": "TyportHDL contributors",
	"license": "MIT",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/yportne13/elaboration-zoo-lsp"
	},
	"publisher": "TyportHDL",
	"categories": [],
	"keywords": [
		"LSP",
		"Language Server",
		"dependent types",
		"HDL",
		"Verilog"
	],
	"activationEvents": [
    	"onLanguage:typort"
  	],
	"engines": {
		"vscode": "^1.89.0"
	},
	"main": "./dist/desktop/extension",
	"browser": "./dist/web/extension",
	"contributes": {
		"languages": [
			{
				"id": "typort",
				"aliases": [
					"typort",
					"typort"
				],
				"extensions": [
					".typort"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "typort",
				"scopeName": "source.typort",
				"path": "./syntaxes/typort.tmLanguage.json"
			}
		]
	},
	"dependencies": {
		"@vscode/wasm-wasi": "^1.0.2",
		"@vscode/wasm-wasi-lsp": "0.1.0-pre.9"
	},
	"devDependencies": {
		"@types/node": "^18.14.6",
		"@types/vscode": "1.89.0"
	},
	"scripts": {
		"compile": "tsc -b && node ./bin/esbuild",
		"watch": "tsc -b -w",
		"lint": "eslint ./src --ext .ts,.tsx",
		"esbuild": "node ./bin/esbuild"
	}
}