//! HDL self-check graph analyses (phases 2-4): combinational loops,
//! latch/coverage, bit-range overlaps, CDC.
// ============================================================
// HDL Self-Check Graph: phases 2-4 (design:
// docs/hdl-selfcheck-phase234-design.md)
// ============================================================
// ENTRY INVERSION: the module/blackbox macros' create-side `_res` hook now
// calls checkModuleTreeAll (this file) instead of hdl-check.typort's
// checkModuleTree. A typort def elaborates in file order and cannot call
// later-loaded defs, while the graph analyses build ON the phase-1 rules
// (runChecks), so the entry must live here — the design's §2.2 "入口反转".
//
// Division of labor (design §2.1/§3.4):
//   - typort (this file): everything Expr-shape sensitive — the DriveSrc
//     statement scan, condition-leaf extraction, bit-range extraction,
//     cross-layer summary edges, domain propagation, synchronizer chain
//     recognition. (A per-module cache was designed here but cancelled —
//     see docs/hdl-selfcheck-phase234-design.md §11.4: the mutable global
//     behaves differently across class-check rounds, so analysis runs every
//     round instead of being cache-gated.)
//   - Rust builtin check_comb_cycles (cxt.rs): Tarjan SCC + mutual-exclusion
//     exemption + cycle-path reconstruction over the edge list (index arrays
//     and deep recursion must not run in typort — DFS depth = |V| would
//     stack on top of the measured 502-752-deep force recursion).
//
// ENGINE DISCIPLINE (docs/l13-struct-decl-dependent-field-divergence.md,
// violations = divergence / lvl2ix drain panic):
//   - `match` only on plain parameters of small defs; NEVER on a
//     get_global/get_global_default result (or its inline field projection)
//     as scrutinee. Global reads are bound to a typed let and their fields
//     are passed as plain arguments (the fsmCtxModuleReset shape).
//   - Every mutable-global SEED is a def whose body binds an annotated
//     `let empty: List[...] = lnil` first — a polymorphic lnil in the seed
//     poisons the drain.
//   - Reads of design globals use get_global_default (pure, no map write —
//     safe under declaration-time check evaluation).
//   - These defs are only reachable from checkModuleTreeAll, i.e. from the
//     macros' `_res` line in user files (never from prelude load, never
//     from generic/impl contexts).
//   - No Nat is forced: widths/indexes are read via nat_is_ground +
//     nat_to_dec (stuck renders "0") and nat_sub-based comparisons on
//     ground values only; value-sensitive rules are gated by the HDL004
//     ground round gate (§4.6).

// ---------- condition leaves (design §3.3) ----------
// A leaf is (neg, key): the condition atom `key`, negated iff `neg`.
// Encoding of `key` (string channel to check_comb_cycles prepends "!" for
// neg leaves):
//   - Bool/comparison atom        -> exprKey(atom)
//   - sel == literal v (ground)   -> "eq:" + exprKey(sel) + ":" + v
//     (the NEGATED form !(sel == v) gets the SAME key, neg — this is what
//     makes `when c {} otherwise {}` and switch arms mutually exclusive
//     under the T2/contradiction rules)
//   - non-ground literal operand  -> "b:==(" + exprKey(l) + "," + exprKey(r) + ")"
//     (exprKey-consistent, conservative: never matches anything)

/// One literal of a branch condition, stored as `(neg, key)`: `key` is the exprKey of the atom (or the `eq:` / `b:==` encoding) and `neg` says whether that atom appears negated.
/// Keys are compared polarity-BLIND (`keyInLeaves`, `leafResidue`), so `x` and `!x` share one `key` and differ only in `neg`.
struct NegLeaf {
    neg: Boolean
    key: String
}

/// Builds the one-element leaf list `[(neg, key)]` - the base case every leaf walker (`leavesOfN`, `eqLeavesOf`) bottoms out in.
def singleLeaf(neg: Boolean, key: String): List[NegLeaf] =
    lcons (NegLeaf.mk(neg, key)) lnil

/// Tail-recursive reversal of a leaf list; callers pass the typed seed `nlEmpty` (never bare `lnil`) so the mutable-global drain sees a monomorphic list.
def nlReverse(l: List[NegLeaf], acc: List[NegLeaf]): List[NegLeaf] = match l {
    case lnil => acc
    case lcons(h, t) => nlReverse(t, lcons h acc)
}

/// Concatenation `a ++ b` of leaf lists; used to merge an accumulated enable with a mux branch's condition leaves and with the other side of a cross edge.
def nlAppend(a: List[NegLeaf], b: List[NegLeaf]): List[NegLeaf] = match a {
    case lnil => b
    case lcons(h, t) => lcons h (nlAppend(t, b))
}

/// Concatenation of two `List[String]`; `combReach` uses it to merge the flood frontier with the visited set.
def strAppend(a: List[String], b: List[String]): List[String] = match a {
    case lnil => b
    case lcons(h, t) => lcons h (strAppend(t, b))
}

/// Reverses a `List[String]`; `cdcEdgeVerdict` uses it to turn `chainWalk`'s prepend order `[Rk..R0]` back into source order before pairing stages.
def strReverse(l: List[String], acc: List[String]): List[String] = match l {
    case lnil => acc
    case lcons(h, t) => strReverse(t, lcons h acc)
}

/// Reverses a `List[List[NegLeaf]]`; `t2Scan`/`t3Scan` use it to put the already-scanned prefix back in front of the remaining condition sets.
def nllReverse(l: List[List[NegLeaf]], acc: List[List[NegLeaf]]): List[List[NegLeaf]] = match l {
    case lnil => acc
    case lcons(h, t) => nllReverse(t, lcons h acc)
}

/// Concatenation of a `List[List[NegLeaf]]`; joins the seen prefix with the not-yet-seen suffix in the T2/T3 coverage scans.
def nllAppend(a: List[List[NegLeaf]], b: List[List[NegLeaf]]): List[List[NegLeaf]] = match a {
    case lnil => b
    case lcons(h, t) => lcons h (nllAppend(t, b))
}

/// Leaf encoding of an equality `l == r` under polarity `neg`. With a GROUND literal `r` the key is `eq:<exprKey(l)>:<dec v>` and BOTH polarities get the same key - that is what makes `when c {} otherwise {}` and switch arms mutually exclusive.
/// Any non-ground operand falls back to the conservative `b:==(<l>,<r>)` key, which can never match another atom.
def eqLeavesOf(l: Expr, r: Expr, neg: Boolean): List[NegLeaf] = match r {
    case literal(v) => match nat_is_ground(v) {
        case true => singleLeaf(neg, "eq:" + exprKey(l) + ":" + nat_to_dec(v))
        case false => singleLeaf(neg, "b:==(" + exprKey(l) + "," + exprKey(r) + ")")
    }
    case _ => singleLeaf(neg, "b:==(" + exprKey(l) + "," + exprKey(r) + ")")
}

/// Condition leaves under a polarity flag. typort defs elaborate in file
/// order, so the (mutually recursive) positive/negative walkers are ONE def:
///   - `&&` distributes only in positive polarity (`!(a && b)` stays ONE
///     atomic negated leaf — negation does not distribute over conjunction);
///   - `!` flips the polarity (`!!x == x`);
///   - an equality keeps the eq-encoding with the current polarity, which is
///     what makes `when c {} otherwise {}` and switch arms mutually exclusive
///     under the T2/contradiction rules.
def leavesOfN(e: Expr, neg: Boolean): List[NegLeaf] = match e {
    case binary(l, op, r) => match str_eq(op, "&&") {
        case true => match neg {
            case true => singleLeaf(true, exprKey(e))
            case false => nlAppend(leavesOfN(l, false), leavesOfN(r, false))
        }
        case false => match str_eq(op, "==") {
            case true => eqLeavesOf(l, r, neg)
            case false => singleLeaf(neg, exprKey(e))
        }
    }
    case unary(op, x) => match str_eq(op, "!") {
        case true => leavesOfN(x, chkBnot(neg))
        case false => singleLeaf(neg, exprKey(e))
    }
    case _ => singleLeaf(neg, exprKey(e))
}

/// Positive-polarity entry point: the leaves that must ALL hold for `e` (`&&` distributes; a negation stays one atomic negative leaf).
def leavesOf(e: Expr): List[NegLeaf] = leavesOfN(e, false)

/// Negative-polarity entry point for `!e`; the `mux` false branch is scanned with these leaves appended.
def negLeavesOf(x: Expr): List[NegLeaf] = leavesOfN(x, true)

/// The ";"-joined string form of a leaf list (channel to check_comb_cycles;
/// the builtin re-derives the negation from the leading "!").
def leafStr(l: NegLeaf): String = match l.neg {
    case true => "!" + l.key
    case false => l.key
}

// REPLAY-POLLUTION (M2 watchdog finding): the class-field replays re-record
// when-wrapped statements with WhenStack-residue conditions (a stale level
// ANDs into the fresh one: a bare flag becomes flag AND flag, its negation
// becomes NOT-flag AND flag). Round 1 of a module's check is always clean;
// later rounds carry these duplicated leaves. CORRECTNESS OWNERSHIP (review
// 2026-09-27): the residue is neutralized at the SOURCE by nlDedup below —
// scanStmtEx canonicalizes every enable through it before any DriveSrc
// exists, so no stored drive ever carries a repeated leaf key. Together with
// dedupDrives (target,rhsKey) first-copy-wins and the CheckIssues line-level
// dedup at the drain, nlDedup is what actually carries the leaf rules'
// (HDL032/033/034/035) correctness across replay rounds.
/// Polarity-blind key membership; the primitive behind both `leafResidue` and the `nlDedup` canonicalization.
def keyInLeaves(k: String, ls: List[NegLeaf]): Boolean = match ls {
    case lnil => false
    case lcons(h, t) => match str_eq(k, h.key) {
        case true => true
        case false => keyInLeaves(k, t)
    }
}

/// Same leaf KEY twice (any polarity combination) would be WhenStack residue:
/// `en && en` as well as `!en && en`. REDUNDANT INSURANCE, not a live defense
/// (review 2026-09-27): enables are nlDedup-ed BEFORE any DriveSrc is stored,
/// so this predicate is constant-false on every drive it is consulted about.
/// Kept as a cheap tripwire in the leaf-sensitive rules in case a future
/// call site forgets the nlDedup canonicalization.
def leafResidue(ls: List[NegLeaf]): Boolean = match ls {
    case lnil => false
    case lcons(h, t) => match keyInLeaves(h.key, t) {
        case true => true
        case false => leafResidue(t)
    }
}

// Canonical enable: drop leaves whose KEY already appeared (keep the first
// polarity). WhenStack residue across class-field evaluations re-records a
// when-level's condition twice (`en && en`, `!en && en`) - key-dedup
// restores the intended condition. Generated conditions (switch/elsewhen
// chains) never repeat a leaf key, so this is a no-op on clean trees.
/// Typed empty `List[NegLeaf]` seed (the annotated `let` keeps the drain monomorphic): the initial accumulator of `nlDedup` and the terminator of its reversal.
def nlEmpty: List[NegLeaf] =
    let e: List[NegLeaf] = lnil;
    e

/// Canonicalizes an enable by KEY: keeps the first leaf of each key (the first polarity wins) and drops later duplicates.
/// This is what neutralizes WhenStack residue (`en && en`, `!en && en`) before any `DriveSrc` exists; the accumulator is prepend-ordered, so the result is reversed on the way out.
def nlDedup(ls: List[NegLeaf], acc: List[NegLeaf]): List[NegLeaf] = match ls {
    case lnil => nlReverse(acc, nlEmpty)
    case lcons(h, t) => match keyInLeaves(h.key, acc) {
        case true => nlDedup(t, acc)
        case false => nlDedup(t, lcons h acc)
    }
}

/// Renders a leaf list as one `;`-joined string, prefixing `!` for negated leaves - the channel to the Rust `check_comb_cycles` builtin.
/// `acc` seeds the accumulator, so starting from an empty string avoids a leading separator.
def joinLeaves(ls: List[NegLeaf], acc: String): String = match ls {
    case lnil => acc
    case lcons(h, t) => match str_eq(acc, "") {
        case true => joinLeaves(t, leafStr(h))
        case false => joinLeaves(t, acc + ";" + leafStr(h))
    }
}

/// Structured equality atoms of a condition: `sel == v` with GROUND v.
/// typort-side mutual exclusion over switch arms needs the value
/// STRUCTURALLY (nat_sub on ground values); the string channel keeps its
/// own parse in the builtin.
struct EqTerm {
    sel: String
    v: Nat
}

/// Appends the structured atom `(exprKey(l), v)` when `r` is a GROUND literal, otherwise returns `acc` untouched.
/// It is the structural twin of the `eq:` string key, kept so typort can compare selector values with `nat_sub` instead of parsing strings.
def eqTermOf(l: Expr, r: Expr, acc: List[EqTerm]): List[EqTerm] = match r {
    case literal(v) => match nat_is_ground(v) {
        case true => lcons (EqTerm.mk(exprKey(l), v)) acc
        case false => acc
    }
    case _ => acc
}

/// Collects the ground equality atoms of a condition: only `&&` is traversed, so a `sel == v` under `||` or `!` contributes nothing, and non-equality leaves contribute nothing.
/// Atoms accumulate in reverse traversal order.
def eqLeavesOfTerms(e: Expr, acc: List[EqTerm]): List[EqTerm] = match e {
    case binary(l, op, r) => match str_eq(op, "&&") {
        case true => eqLeavesOfTerms(r, eqLeavesOfTerms(l, acc))
        case false => match str_eq(op, "==") {
            case true => eqTermOf(l, r, acc)
            case false => acc
        }
    }
    case _ => acc
}

/// Typed empty `List[EqTerm]` seed (annotated `let` for the monomorphic drain); resets the atom accumulator for each mux condition.
def eqsFresh: List[EqTerm] =
    let e: List[EqTerm] = lnil;
    e

/// Concatenation of two `List[EqTerm]`; the `when` handler uses it to carry the enclosing atoms onto the nested enable.
def eqAppend(a: List[EqTerm], b: List[EqTerm]): List[EqTerm] = match a {
    case lnil => b
    case lcons(h, t) => lcons h (eqAppend(t, b))
}

// ---------- phase 3: LHS bit ranges (design §4.4) ----------
// LHS bit-range of one drive. Bare create* LHS drives the whole signal
// (rFull); bitsel/partsel with ground literal indexes carry their static
// range (normalized hi >= lo); any dynamic index is rUnknown (excluded from
// overlap detection AND from rangeSafe suppression — keeps phase-1
// behavior; the ground round gate also skips HDL033 in Phase-A rounds).
/// LHS bit-range of one drive, normalized to `hi >= lo`: `rFull` for a bare `create*` target, `rPart(hi, lo)` for a bitsel/partsel with ground literal indexes, `rUnknown` for any dynamic index.
/// Only `rPart` takes part in overlap detection and in `rangeSafe` suppression, so dynamic indexes keep the phase-1 behaviour.
enum DrvRange {
    rFull
    rPart(hi: Nat, lo: Nat)
    rUnknown
}

/// `Some(v)` iff `e` is a literal whose Nat is ground; the gate that keeps every width/index comparison off stuck Nats.
def litNat(e: Expr): Option[Nat] = match e {
    case literal(v) => match nat_is_ground(v) {
        case true => Some(v)
        case false => None
    }
    case _ => None
}

/// Classifies a drive LHS: a `bitsel` with a ground index gives `rPart(v, v)`; a `partsel` with BOTH bounds ground gives `rPart` normalized through `maxNat`/`minNat`; either bound dynamic gives `rUnknown`.
/// Everything else - including a `bitsel` with a dynamic index - is `rFull`, i.e. the whole signal is driven.
def lhsRange(e: Expr): DrvRange = match e {
    case bitsel(_, i) => match litNat(i) {
        case Some(v) => rPart(v, v)
        case None => rUnknown
    }
    case partsel(_, hi, lo) => match litNat(hi) {
        case Some(hv) => match litNat(lo) {
            case Some(lv) => rPart(maxNat(hv, lv), minNat(hv, lv))
            case None => rUnknown
        }
        case None => rUnknown
    }
    case _ => rFull
}

/// a <= b on ground Nats (nat_sub saturates: a-b == 0 iff a <= b).
def chkNatLe(a: Nat, b: Nat): Boolean = match nat_sub(a, b) {
    case zero => true
    case succ(_) => false
}

/// Interval intersection of two `rPart` ranges (`lo1 <= hi2 && lo2 <= hi1`); FALSE whenever either side is `rFull`/`rUnknown`, so HDL033 never fires on those.
def rangesOverlap(r1: DrvRange, r2: DrvRange): Boolean = match r1 {
    case rPart(hi1, lo1) => match r2 {
        case rPart(hi2, lo2) => chkBand(chkNatLe(lo1, hi2), chkNatLe(lo2, hi1))
        case _ => false
    }
    case _ => false
}

/// True only for two `rPart` ranges that do not intersect; a `rFull`/`rUnknown` operand is NOT disjoint, so `restSafeVs` then demands condition exclusivity instead.
def rangesDisjoint(r1: DrvRange, r2: DrvRange): Boolean = match r1 {
    case rPart(hi1, lo1) => match r2 {
        case rPart(hi2, lo2) => chkBor(chkBnot(chkNatLe(lo2, hi1)), chkBnot(chkNatLe(lo1, hi2)))
        case _ => false
    }
    case _ => false
}

/// True when `r1`'s high bit is at or above `r2`'s (`hi2 <= hi1`), and vacuously true for non-`rPart` operands; `pairsVsRest` uses it to print the HDL033 pair hi-descending.
def rangeOrder(r1: DrvRange, r2: DrvRange): Boolean = match r1 {
    case rPart(hi1, _) => match r2 {
        case rPart(hi2, _) => chkNatLe(hi2, hi1)
        case _ => true
    }
    case _ => true
}

/// Renders an `rPart` range as `[hi:lo]`; `rFull` and `rUnknown` both render `[?]`.
def rangeStr(r: DrvRange): String = match r {
    case rPart(hi, lo) => "[" + nat_to_dec(hi) + ":" + nat_to_dec(lo) + "]"
    case _ => "[?]"
}

// ---------- drive facts (design §3.1) ----------
// One driving statement's graph-side facts. srcs = RHS reads with the
// condition leaves they flow under (statement enable ++ mux branch
// refinement); the leaf lists are ALREADY the accumulated result.

/// One RHS read of a driving statement: the read's `src` name plus the condition leaves/atoms it flows under (the statement enable already refined by the enclosing mux branches).
struct CondSrc {
    src: String
    leaves: List[NegLeaf]
    eqs: List[EqTerm]
}

/// One driving statement's complete graph fact set: `target`, `clocked`/`cd`, the accumulated `enable`/`eqs` and their `enableKey`, the RHS `rhsKey`, the LHS `rng`, and the reads (`srcs`) that produced it.
struct DriveSrc {
    target: String
    clocked: Boolean
    cd: Option[ClockDomain]
    enable: List[NegLeaf]
    eqs: List[EqTerm]
    enableKey: String
    rhsKey: String
    rng: DrvRange
    srcs: List[CondSrc]
}

/// Reverses the `DriveSrc` accumulator back into statement order; `checkModuleAll` calls it before `dedupDrives` so the OLDEST copy of a statement wins.
def drvReverse(l: List[DriveSrc], acc: List[DriveSrc]): List[DriveSrc] = match l {
    case lnil => acc
    case lcons(h, t) => drvReverse(t, lcons h acc)
}

/// A hierarchical connection with its statement enable ("u.port := p" /
/// "q := u.op"); sig = the parent-side signal ("" when not a bare signal).
struct ConnEx {
    inst: String
    port: String
    sig: String
    isLhs: Boolean
    leaves: List[NegLeaf]
}

/// Reverses the `ConnEx` accumulator into statement order during `checkModuleAll`'s normalization.
def connReverse(l: List[ConnEx], acc: List[ConnEx]): List[ConnEx] = match l {
    case lnil => acc
    case lcons(h, t) => connReverse(t, lcons h acc)
}

/// A declaration with the width/cd the phase-1 SigDecl drops.
struct GDecl {
    name: String
    kind: SigKind
    width: Option[Nat]
    cd: Option[ClockDomain]
    key: String
}

/// Reverses the `GDecl` accumulator into creation order - `dropShadowedWires` depends on wire-before-port ordering.
def gdeclReverse(l: List[GDecl], acc: List[GDecl]): List[GDecl] = match l {
    case lnil => acc
    case lcons(h, t) => gdeclReverse(t, lcons h acc)
}

/// Statement-level enable context threaded through the scan.
struct EnableCtx {
    leaves: List[NegLeaf]
    eqs: List[EqTerm]
    key: String
}

/// The empty enable context (no leaves, no atoms, empty key) that `scanAllEx` gives every top-level statement.
def enableCtxEmpty: EnableCtx =
    let l: List[NegLeaf] = lnil;
    let q: List[EqTerm] = lnil;
    EnableCtx.mk(l, q, "")

/// The scan accumulator: `drives`/`conns`/`insts`/`decls` (all prepend-ordered, reversed later), the `seen` statement-key list, the concatenated `key`, and `pending` - the RHS reads of the statement being scanned, which become the next `DriveSrc.srcs`.
struct GraphAcc {
    drives: List[DriveSrc]
    conns: List[ConnEx]
    insts: List[InstInfo]
    decls: List[GDecl]
    seen: List[String]
    key: String
    pending: List[CondSrc]
}

/// All-empty `GraphAcc` seed, with one annotated `let` per list type (the monomorphic-drain rule); starts the per-module scan.
def graphAccFresh: GraphAcc =
    let eD: List[DriveSrc] = lnil;
    let eC: List[ConnEx] = lnil;
    let eI: List[InstInfo] = lnil;
    let eG: List[GDecl] = lnil;
    let eS: List[String] = lnil;
    let eP: List[CondSrc] = lnil;
    GraphAcc.mk(eD, eC, eI, eG, eS, "", eP)

/// Prepends a `DriveSrc` to the accumulator (reverse statement order, undone by `drvReverse`).
def accAddDrive(acc: GraphAcc, d: DriveSrc): GraphAcc =
    GraphAcc.mk(lcons d acc.drives, acc.conns, acc.insts, acc.decls, acc.seen, acc.key, acc.pending)

// Drive-level dedup by (target, rhsKey), FIRST occurrence in STATEMENT
// order wins. The class-field replays append the same source statements
// again with WhenStack-residue-polluted enable conditions (engine fact: the
// WhenStack is only reset per create, not per check-evaluation round), and
// the def Vec is prepend-ordered, so the raw drive list carries both the
// clean copy and residue copies of one statement. The RHS exprKey is
// residue-free; running the dedup AFTER the statement-order reversal makes
// the first (oldest = cleanest) copy win and the leaf-sensitive rules
// (HDL032/034/035) never see residue. Same accepted blind spot as
// phase-1's exprKey dedup: two distinct statements with identical
// target+RHS count as one driver.
/// Typed empty `List[ConnEx]` seed, used as the `connReverse` terminator in `checkModuleAll`.
def connEmpty: List[ConnEx] =
    let e: List[ConnEx] = lnil;
    e

/// Typed empty `List[InstInfo]` seed, used as the `instReverse` terminator.
def instEmpty: List[InstInfo] =
    let e: List[InstInfo] = lnil;
    e

/// Typed empty `List[GDecl]` seed, used as the `gdeclReverse` terminator.
def gdeclEmpty: List[GDecl] =
    let e: List[GDecl] = lnil;
    e

/// Typed empty `List[List[NegLeaf]]` seed; the accumulator terminator of `nllReverse` inside the T2/T3 scans.
def nllEmpty: List[List[NegLeaf]] =
    let e: List[List[NegLeaf]] = lnil;
    e

/// Typed empty `List[String]` seed: `dedupDrives`'s seen list, the `done` list of `rangeSafeOf`/`ruleRangeOverlap`, and T3's key-multiset accumulators.
def strListEmpty: List[String] =
    let e: List[String] = lnil;
    e

/// Typed empty `List[DriveSrc]` seed; the `drvReverse` terminator in both `dedupDrives` and `checkModuleAll`.
def drvListEmpty: List[DriveSrc] =
    let e: List[DriveSrc] = lnil;
    e

/// The dedup worker: walking the statement-ordered drive list, keeps the FIRST drive per `target|rhsKey` and drops every later copy (the WhenStack-residue copies).
/// `acc` is prepend-ordered and reversed with `drvListEmpty` on exit, so the surviving order is statement order.
def chkDriveDupSeen(ds: List[DriveSrc], seen: List[String], acc: List[DriveSrc]): List[DriveSrc] = match ds {
    case lnil => drvReverse(acc, drvListEmpty)
    case lcons(d, t) =>
        let k = d.target + "|" + d.rhsKey;
        match chkStrIn(k, seen) {
            case true => chkDriveDupSeen(t, seen, acc)
            case false => chkDriveDupSeen(t, lcons k seen, lcons d acc)
        }
}

/// Entry point for the `(target, rhsKey)` first-copy-wins dedup; it must run AFTER the drives are back in statement order.
def dedupDrives(ds: List[DriveSrc]): List[DriveSrc] =
    chkDriveDupSeen(ds, strListEmpty, drvListEmpty)

/// Prepends a `ConnEx` to the accumulator.
def accAddConn(acc: GraphAcc, c: ConnEx): GraphAcc =
    GraphAcc.mk(acc.drives, lcons c acc.conns, acc.insts, acc.decls, acc.seen, acc.key, acc.pending)

/// Prepends an `InstInfo` (reversed later by `instReverse`).
def accAddInst(acc: GraphAcc, i: InstInfo): GraphAcc =
    GraphAcc.mk(acc.drives, acc.conns, lcons i acc.insts, acc.decls, acc.seen, acc.key, acc.pending)

/// Reverses the `InstInfo` accumulator into statement order.
def instReverse(l: List[InstInfo], acc: List[InstInfo]): List[InstInfo] = match l {
    case lnil => acc
    case lcons(h, t) => instReverse(t, lcons h acc)
}

/// Prepends a `GDecl` (reversed later by `gdeclReverse`).
def accAddDecl(acc: GraphAcc, d: GDecl): GraphAcc =
    GraphAcc.mk(acc.drives, acc.conns, acc.insts, lcons d acc.decls, acc.seen, acc.key, acc.pending)

/// Drops `pending` once a `DriveSrc` has consumed this statement's RHS reads.
def accClearPending(acc: GraphAcc): GraphAcc =
    let eP: List[CondSrc] = lnil;
    GraphAcc.mk(acc.drives, acc.conns, acc.insts, acc.decls, acc.seen, acc.key, eP)

/// Records one RHS read (name plus the current leaves/atoms) to be attached to the `DriveSrc` built at the end of the statement.
def accAddPending(acc: GraphAcc, s: CondSrc): GraphAcc =
    GraphAcc.mk(acc.drives, acc.conns, acc.insts, acc.decls, acc.seen, acc.key, lcons s acc.pending)

// ---------- leaf-level predicates (typort side; the builtin keeps its own
// string-form copy for the edge channel) ----------

/// True iff the two leaves share a key with OPPOSITE polarity - `x` against `!x`. Equal polarity is never contradictory, so `x && x` is not dead.
def leafPairContradicts(a: NegLeaf, b: NegLeaf): Boolean = match a.neg {
    case true => match b.neg {
        case true => false
        case false => str_eq(a.key, b.key)
    }
    case false => match b.neg {
        case true => str_eq(a.key, b.key)
        case false => false
    }
}

/// True iff `l` has an opposite-polarity partner anywhere in `ls` (both argument orders of `leafPairContradicts` are tried).
def leafInContradicts(l: NegLeaf, ls: List[NegLeaf]): Boolean = match ls {
    case lnil => false
    case lcons(h, t) => match chkBor(leafPairContradicts(l, h), leafPairContradicts(h, l)) {
        case true => true
        case false => leafInContradicts(l, t)
    }
}

/// True iff some leaf of `l1` contradicts some leaf of `l2`.
def leavesContradict(l1: List[NegLeaf], l2: List[NegLeaf]): Boolean = match l1 {
    case lnil => false
    case lcons(h, t) => match leafInContradicts(h, l2) {
        case true => true
        case false => leavesContradict(t, l2)
    }
}

/// Ground-Nat inequality built from the saturating `nat_sub` in both directions (`a - b == 0` iff `a <= b`); never call it on a stuck Nat.
def natNeq(a: Nat, b: Nat): Boolean = match nat_sub(a, b) {
    case zero => match nat_sub(b, a) {
        case zero => false
        case succ(_) => true
    }
    case succ(_) => true
}

/// True iff `ts` holds an atom over the SAME selector with a DIFFERENT ground value - the `sel == v1` / `sel == v2` exclusivity test.
def eqTermInContradicts(t: EqTerm, ts: List[EqTerm]): Boolean = match ts {
    case lnil => false
    case lcons(h, t2) => match str_eq(t.sel, h.sel) {
        case true => match natNeq(t.v, h.v) {
            case true => true
            case false => eqTermInContradicts(t, t2)
        }
        case false => eqTermInContradicts(t, t2)
    }
}

/// True iff two atom lists disagree on the value of some selector they share.
def eqListsContradict(l1: List[EqTerm], l2: List[EqTerm]): Boolean = match l1 {
    case lnil => false
    case lcons(h, t) => match eqTermInContradicts(h, l2) {
        case true => true
        case false => eqListsContradict(t, l2)
    }
}

/// Full condition mutual exclusion (§3.3): `c` vs `!c` leaf pairs, or
/// `sel == v1` vs `sel == v2` over the same selector with ground v1 != v2.
def condsContradict(ls1: List[NegLeaf], eqs1: List[EqTerm], ls2: List[NegLeaf], eqs2: List[EqTerm]): Boolean =
    chkBor(leavesContradict(ls1, ls2), eqListsContradict(eqs1, eqs2))

// ---------- declaration extraction ----------

/// Builds a `GDecl`; `key` is `exprKey` of the whole `create*` node (not the name), which is exactly what `xorKeyOf` compares against an RHS `b:^(...)` key.
def gdecl(n: String, k: SigKind, w: Option[Nat], cd: Option[ClockDomain], e: Expr): GDecl =
    GDecl.mk(n, k, w, cd, exprKey(e))

/// Recognizes the ~30 `create*` / `createMem` declaration shapes and maps each to `(name, SigKind, Option[width], Option[cd])`; a `createMem` width is the CELL width and mems carry no cd. Returns `None` for anything that is not a declaration.
def gDeclOf(e: Expr): Option[GDecl] = match e {
    case create(n) => Some(gdecl(n, kWire, None, None, e))
    case createWidth(n, w) => Some(gdecl(n, kWire, Some(w), None, e))
    case createSIntWidth(n, w) => Some(gdecl(n, kWire, Some(w), None, e))
    case createIn(n) => Some(gdecl(n, kIn, None, None, e))
    case createInWidth(n, w) => Some(gdecl(n, kIn, Some(w), None, e))
    case createSIntInWidth(n, w) => Some(gdecl(n, kIn, Some(w), None, e))
    case createOut(n) => Some(gdecl(n, kOut, None, None, e))
    case createOutWidth(n, w) => Some(gdecl(n, kOut, Some(w), None, e))
    case createSIntOutWidth(n, w) => Some(gdecl(n, kOut, Some(w), None, e))
    case createInOut(n) => Some(gdecl(n, kInOut, None, None, e))
    case createInOutWidth(n, w) => Some(gdecl(n, kInOut, Some(w), None, e))
    case createSIntInOutWidth(n, w) => Some(gdecl(n, kInOut, Some(w), None, e))
    case createReg(n) => Some(gdecl(n, kReg, None, None, e))
    case createRegWidth(n, w) => Some(gdecl(n, kReg, Some(w), None, e))
    case createRegWidthInit(n, w, _) => Some(gdecl(n, kReg, Some(w), None, e))
    case createRegWidthCd(n, w, cd) => Some(gdecl(n, kReg, Some(w), Some(cd), e))
    case createRegWidthInitCd(n, w, _, cd) => Some(gdecl(n, kReg, Some(w), Some(cd), e))
    case createSIntRegWidth(n, w) => Some(gdecl(n, kReg, Some(w), None, e))
    case createSIntRegWidthInit(n, w, _) => Some(gdecl(n, kReg, Some(w), None, e))
    case createSIntRegWidthCd(n, w, cd) => Some(gdecl(n, kReg, Some(w), Some(cd), e))
    case createSIntRegWidthInitCd(n, w, _, cd) => Some(gdecl(n, kReg, Some(w), Some(cd), e))
    case createOutReg(n) => Some(gdecl(n, kOutReg, None, None, e))
    case createOutRegWidth(n, w) => Some(gdecl(n, kOutReg, Some(w), None, e))
    case createOutRegWidthInit(n, w, _) => Some(gdecl(n, kOutReg, Some(w), None, e))
    case createSIntOutRegWidth(n, w) => Some(gdecl(n, kOutReg, Some(w), None, e))
    case createSIntOutRegWidthInit(n, w, _) => Some(gdecl(n, kOutReg, Some(w), None, e))
    case createMem(n, _, w) => Some(gdecl(n, kMem, Some(w), None, e))
    case _ => None
}

/// Projects `GDecl` back down to the phase-1 `SigDecl` shape (name + kind only, width and cd dropped) for `registerPortTable` after `dropShadowedWires`.
def sigDeclsOf(ds: List[GDecl]): List[SigDecl] = match ds {
    case lnil => lnil
    case lcons(d, t) => lcons (SigDecl.mk(d.name, d.kind)) (sigDeclsOf(t))
}

/// Names of the declarations of one `SigKind`, in list order; `buildCombSummary` uses it for the module's input and output port lists.
def gdeclNamesOfKind(ds: List[GDecl], k: SigKind): List[String] = match ds {
    case lnil => lnil
    case lcons(d, t) => match kindEq(d.kind, k) {
        case true => lcons (d.name) (gdeclNamesOfKind(t, k))
        case false => gdeclNamesOfKind(t, k)
    }
}

// ---------- statement scan (design §3.1) ----------
// Mirrors phase-1 scanStmt semantics plus: the full statement enable
// (leaves + eq terms + exprKey), per-RHS-read condition refinement through
// mux branches, per-drive enableKey/rhsKey, and declaration widths/cds.
// The exprKey top-level dedup collapses the ~3x field-evaluation replays
// exactly like phase-1 scanAll.

/// Expression walker of the graph scan: recurses through indexes (`bitsel`/`partsel`/`memRead`) and the defensive statement shapes.
/// For `mux(c, tv, fv)` it scans `c`, then `tv` with `leavesOf(c)` and the cond's ground atoms appended, then `fv` with `negLeavesOf(c)` appended - the atom list is deliberately NOT extended for the false branch. Every other named sub-expression becomes a `pending` `CondSrc` read.
def scanExprEx(e: Expr, leaves: List[NegLeaf], eqs: List[EqTerm], acc: GraphAcc): GraphAcc = match e {
    case subSignal(_, _) => acc
    case literal(_) => acc
    case sizedLiteral(_, _) => acc
    case nop => acc
    case bbMarkerExpr(_, _) => acc
    case instance(_, _) => acc
    case instanceWithPorts(_, _, _) => acc
    case unary(_, x) => scanExprEx(x, leaves, eqs, acc)
    case binary(l, _, r) =>
        let a1 = scanExprEx(l, leaves, eqs, acc);
        scanExprEx(r, leaves, eqs, a1)
    case mux(c, tv, fv) =>
        let lc = leavesOf(c);
        let qc = eqLeavesOfTerms(c, eqsFresh);
        let a1 = scanExprEx(c, leaves, eqs, acc);
        let a2 = scanExprEx(tv, nlAppend(leaves, lc), eqAppend(eqs, qc), a1);
        let lcf = negLeavesOf(c);
        scanExprEx(fv, nlAppend(leaves, lcf), eqs, a2)
    case bitsel(b, i) =>
        let a1 = scanExprEx(b, leaves, eqs, acc);
        scanExprEx(i, leaves, eqs, a1)
    case partsel(b, hi, lo) =>
        let a1 = scanExprEx(b, leaves, eqs, acc);
        let a2 = scanExprEx(hi, leaves, eqs, a1);
        scanExprEx(lo, leaves, eqs, a2)
    case memRead(m, a) =>
        let a1 = scanExprEx(m, leaves, eqs, acc);
        scanExprEx(a, leaves, eqs, a1)
    // defensive arms (same shapes phase-1 scanExpr covers; generated trees
    // keep these out of expression position)
    case when(c, b, eb) =>
        let a1 = scanExprEx(c, leaves, eqs, acc);
        let a2 = scanExprEx(b, leaves, eqs, a1);
        match eb {
            case None => a2
            case Some(eb2) => scanExprEx(eb2, leaves, eqs, a2)
        }
    case assign(l, r) =>
        let a1 = scanExprEx(l, leaves, eqs, acc);
        scanExprEx(r, leaves, eqs, a1)
    case regAssign(l, r) =>
        let a1 = scanExprEx(l, leaves, eqs, acc);
        scanExprEx(r, leaves, eqs, a1)
    case regAssignCd(l, r, _) =>
        let a1 = scanExprEx(l, leaves, eqs, acc);
        scanExprEx(r, leaves, eqs, a1)
    case block(h, t) =>
        let a1 = scanExprEx(h, leaves, eqs, acc);
        scanExprEx(t, leaves, eqs, a1)
    case _ =>
        let nm = exprName(e);
        match str_eq(nm, "") {
            case true => acc
            case false => accAddPending(acc, CondSrc.mk(nm, leaves, eqs))
        }
}

/// Scans an LHS index expression for reads, skipping ground literals - a constant index reads nothing.
def lhsIdxInto(i: Expr, leaves: List[NegLeaf], eqs: List[EqTerm], acc: GraphAcc): GraphAcc = match i {
    case literal(_) => acc
    case sizedLiteral(_, _) => acc
    case _ => scanExprEx(i, leaves, eqs, acc)
}

/// LHS dynamic-index reads: `t[i] := x` reads i (the base is the drive
/// target, not a read) — same discipline as phase-1 scanLhsIdx, but the
/// reads become comb edges i -> t.
def lhsIdxReads(e: Expr, leaves: List[NegLeaf], eqs: List[EqTerm], acc: GraphAcc): GraphAcc = match e {
    case bitsel(b, i) =>
        let a1 = lhsIdxReads(b, leaves, eqs, acc);
        lhsIdxInto(i, leaves, eqs, a1)
    case partsel(b, hi, lo) =>
        let a1 = lhsIdxReads(b, leaves, eqs, acc);
        let a2 = lhsIdxInto(hi, leaves, eqs, a1);
        lhsIdxInto(lo, leaves, eqs, a2)
    case _ => acc
}

/// Handles one assignment: a `subSignal` LHS becomes a LHS `ConnEx`, otherwise the LHS indexes are scanned for reads; then the RHS is scanned, collecting `pending` reads, and a `subSignal` RHS becomes a RHS `ConnEx`.
/// If the LHS has a name root, one `DriveSrc` is stored with this statement's pending reads as its `srcs` and the pending list is cleared; without a root the reads are simply dropped.
def stmtAssign(lhs: Expr, rhs: Expr, clocked: Boolean, cd: Option[ClockDomain], ectx: EnableCtx, acc: GraphAcc): GraphAcc =
    let a0 = match lhs {
        case subSignal(inm, pnm) => accAddConn(acc, ConnEx.mk(inm, pnm, exprName(rhs), true, ectx.leaves))
        case _ => lhsIdxReads(lhs, ectx.leaves, ectx.eqs, acc)
    };
    let a1 = scanExprEx(rhs, ectx.leaves, ectx.eqs, a0);
    let root = lhsRoot(lhs);
    match str_eq(root, "") {
        case true => accClearPending(a1)
        case false =>
            let a1b = match rhs {
                case subSignal(inm, pnm) => accAddConn(a1, ConnEx.mk(inm, pnm, root, false, ectx.leaves))
                case _ => a1
            };
            let drv = DriveSrc.mk(root, clocked, cd, ectx.leaves, ectx.eqs, ectx.key, exprKey(rhs), lhsRange(lhs), a1b.pending);
            accClearPending(accAddDrive(a1b, drv))
    }

/// Statement dispatcher. `assign`/`regAssign`/`regAssignCd` go through `stmtAssign` with the right `clocked`/`cd`; `instance` and `instanceWithPorts` record `InstInfo` with the raw flag; `memWrite`/`assert*`/`bbMarkerExpr` only contribute reads or nothing.
/// `when` extends the `EnableCtx` by key-deduping `leaves ++ leavesOf(cond)` and appending the cond's ground atoms. hdl-core already folds the whole elsewhen/otherwise negation into that cond, so the body and the `elseBody` field are scanned with the SAME context; `block` walks sequentially, and anything else is first tried as a declaration.
def scanStmtEx(e: Expr, ectx: EnableCtx, acc: GraphAcc): GraphAcc = match e {
    case assign(lhs, rhs) => stmtAssign(lhs, rhs, false, None, ectx, acc)
    case regAssign(lhs, rhs) => stmtAssign(lhs, rhs, true, None, ectx, acc)
    case regAssignCd(lhs, rhs, cd) => stmtAssign(lhs, rhs, true, Some(cd), ectx, acc)
    case when(cond, body, elseBody) =>
        let e2 = EnableCtx.mk(
            nlDedup(nlAppend(ectx.leaves, leavesOf(cond)), nlEmpty),
            // eqLeavesOfTerms ALREADY conses onto its accumulator, so passing
            // eqsFresh here (as the mux arm does) yields exactly
            // ectx.eqs ++ atoms(cond). The previous `eqLeavesOfTerms(cond,
            // ectx.eqs)` seed, wrapped in `eqAppend(ectx.eqs, ...)`, duplicated
            // ectx.eqs at every nesting level; all consumers (condsContradict,
            // eqSelContradicted, selInEqs) are existential, so the atom set and
            // ruleDeadCond's first-contradiction answer are unchanged.
            eqAppend(ectx.eqs, eqLeavesOfTerms(cond, eqsFresh)),
            match str_eq(ectx.key, "") {
                case true => exprKey(cond)
                case false => ectx.key + "+" + exprKey(cond)
            });
        let a1 = scanStmtEx(body, e2, acc);
        match elseBody {
            case None => a1
            case Some(eb) => scanStmtEx(eb, e2, a1)
        }
    case block(h, t) =>
        let a1 = scanStmtEx(h, ectx, acc);
        scanStmtEx(t, ectx, a1)
    case instance(inm, mnm) => accAddInst(acc, InstInfo.mk(inm, mnm, false))
    case instanceWithPorts(inm, mnm, _) => accAddInst(acc, InstInfo.mk(inm, mnm, true))
    case memWrite(mem, addr, data, en) =>
        let a1 = scanExprEx(mem, ectx.leaves, ectx.eqs, acc);
        let a2 = scanExprEx(addr, ectx.leaves, ectx.eqs, a1);
        let a3 = scanExprEx(data, ectx.leaves, ectx.eqs, a2);
        scanExprEx(en, ectx.leaves, ectx.eqs, a3)
    case assertExpr(c, _, _) => scanExprEx(c, ectx.leaves, ectx.eqs, acc)
    case assertExprCd(c, _, _, _) => scanExprEx(c, ectx.leaves, ectx.eqs, acc)
    case bbMarkerExpr(_, _) => acc
    case _ =>
        let d = gDeclOf(e);
        match d {
            case Some(gd) => accAddDecl(acc, gd)
            case None => scanExprEx(e, ectx.leaves, ectx.eqs, acc)
        }
}

/// Walks the module's statement `Vec`: a statement whose exprKey was already seen is NOT re-scanned (the ~3x class-field replay collapse), but EVERY key is still recorded into `seen` and appended to `key`.
/// So `seenLen(acc.seen)` counts statements, not unique keys - the invariant that makes `checkModuleAll`'s `dupFree` gate constant-true.
def scanAllEx[ne: Nat](es: Vec[Expr] ne, acc: GraphAcc): GraphAcc = match es {
    case nil => acc
    case cons(h, t) =>
        let k = exprKey(h);
        let dup = chkStrIn(k, acc.seen);
        // seen records EVERY statement key, duplicates included (the `dup`
        // flag only skips re-SCANNING, never the seen registration) — so
        // seenLen(acc.seen) counts statements, not unique keys. This is the
        // invariant that makes the dupFree gate in checkModuleAll
        // constant-true; replay correctness lives in nlDedup + dedupDrives.
        let accK = GraphAcc.mk(acc.drives, acc.conns, acc.insts, acc.decls, lcons k acc.seen, acc.key + k + ";", acc.pending);
        let acc2 = match dup {
            case true => accK
            case false => scanStmtEx(h, enableCtxEmpty, accK)
        };
        scanAllEx(t, acc2)
}

// ---------- combinational edges (design §3.2) ----------

/// A combinational edge for the Rust cycle detector: `dst` is driven from `src`, `cross` names the instance when the edge came from a child passthrough (empty for internal edges), and `leaves` are the conditions under which the edge is live.
struct CombEdge {
    dst: String
    src: String
    cross: String
    leaves: List[NegLeaf]
}

/// Concatenation of two `List[CombEdge]`; `checkModuleAll` merges the internal and cross edge lists with it before the cycle call.
def ceAppend(a: List[CombEdge], b: List[CombEdge]): List[CombEdge] = match a {
    case lnil => b
    case lcons(h, t) => lcons h (ceAppend(t, b))
}

/// Typed empty `List[CombEdge]` seed.
def combEdgesFresh: List[CombEdge] =
    let e: List[CombEdge] = lnil;
    e

/// Turns one drive's `srcs` into `dst <- src` edges carrying that read's leaves; `cross` stays empty, so these are internal edges.
def driveEdges(d: DriveSrc, srcs: List[CondSrc], acc: List[CombEdge]): List[CombEdge] = match srcs {
    case lnil => acc
    case lcons(s, t) => driveEdges(d, t, lcons (CombEdge.mk(d.target, s.src, "", s.leaves)) acc)
}

/// All internal edges: exactly the NON-clocked drives, since a clocked drive is a register boundary and not combinational logic.
def edgesOfDrives(drives: List[DriveSrc], acc: List[CombEdge]): List[CombEdge] = match drives {
    case lnil => acc
    case lcons(d, t) =>
        let acc2 = match d.clocked {
            case true => acc
            case false => driveEdges(d, d.srcs, acc)
        };
        edgesOfDrives(t, acc2)
}

/// Serializes edges one per line as `dst|src|cross|leaves` - the string channel to `check_comb_cycles`; `acc` seeds the accumulator, so an empty seed yields no leading newline.
def joinEdges(es: List[CombEdge], acc: String): String = match es {
    case lnil => acc
    case lcons(h, t) =>
        let line = h.dst + "|" + h.src + "|" + h.cross + "|" + joinLeaves(h.leaves, "");
        match str_eq(acc, "") {
            case true => joinEdges(t, line)
            case false => joinEdges(t, acc + "\n" + line)
        }
}

// ---------- cross-layer passthrough edges (design §3.5) ----------

/// One input-to-output passthrough of a module: `from` an input port, `to` an output port.
struct CombPath {
    from: String
    to: String
}

/// One module's passthrough table, keyed by the module name.
struct CombSumEntry {
    mdl: String
    paths: List[CombPath]
}

/// Wrapper struct for the `ModuleCombSummary` mutable global (a global's name must equal its type name), so child summaries persist across `checkModuleAll` calls.
struct ModuleCombSummary {
    entries: List[CombSumEntry]
}

/// Empty `ModuleCombSummary` seed for `change_mutable_default` / `get_global_default`.
def combSumFresh: ModuleCombSummary =
    let e: List[CombSumEntry] = lnil;
    ModuleCombSummary.mk(e)

/// Removes every entry for `mdl` - the drop half of the `combSumAdd` upsert.
def combSumDrop(es: List[CombSumEntry], mdl: String): List[CombSumEntry] = match es {
    case lnil => lnil
    case lcons(e, t) => match str_eq(e.mdl, mdl) {
        case true => combSumDrop(t, mdl)
        case false => lcons e (combSumDrop(t, mdl))
    }
}

/// Upsert: drops any existing entry for the same module name and prepends the new one, so a module's summary never goes stale.
def combSumAdd(tbl: ModuleCombSummary, e: CombSumEntry): ModuleCombSummary =
    ModuleCombSummary.mk(lcons e (combSumDrop(tbl.entries, e.mdl)))

/// Looks up a module's passthrough entry; `None` when the module has not been summarized (yet).
def combSumFind(es: List[CombSumEntry], mdl: String): Option[CombSumEntry] = match es {
    case lnil => None
    case lcons(e, t) => match str_eq(e.mdl, mdl) {
        case true => Some(e)
        case false => combSumFind(t, mdl)
    }
}

/// Exact `(from, to)` membership in a passthrough table.
def combPathIn(ps: List[CombPath], from: String, to: String): Boolean = match ps {
    case lnil => false
    case lcons(p, t) => match chkBand(str_eq(p.from, from), str_eq(p.to, to)) {
        case true => true
        case false => combPathIn(t, from, to)
    }
}

// ---- reachability: from each input port, flood the comb edge set; every
// reached kOut output records one passthrough path (kOutReg cuts — it is a
// register output). Runs on internal + cross edges, so child passthroughs
// compose transitively.

/// Successors of `from` in the edge set (edges whose `src` is `from`), skipping destinations already in `visited`.
def combNexts(edges: List[CombEdge], from: String, visited: List[String]): List[String] = match edges {
    case lnil => lnil
    case lcons(e, t) => match str_eq(e.src, from) {
        case true => match chkStrIn(e.dst, visited) {
            case true => combNexts(t, from, visited)
            case false => lcons (e.dst) (combNexts(t, from, visited))
        }
        case false => combNexts(t, from, visited)
    }
}

/// Flood fill from `frontier` over the edge set, returning the accumulated `visited` set; it is called with the seed as both frontier and visited, so the source is never reported as reached through itself.
def combReach(edges: List[CombEdge], frontier: List[String], visited: List[String]): List[String] = match frontier {
    case lnil => visited
    case lcons(h, t) =>
        let nexts = combNexts(edges, h, visited);
        combReach(edges, strAppend(t, nexts), strAppend(visited, nexts))
}

/// Records `from -> o` for every output `o` of `outs` that the flood reached.
def outsToPaths(outs: List[String], from: String, reached: List[String], acc: List[CombPath]): List[CombPath] = match outs {
    case lnil => acc
    case lcons(o, t) => match chkStrIn(o, reached) {
        case true => outsToPaths(t, from, reached, lcons (CombPath.mk(from, o)) acc)
        case false => outsToPaths(t, from, reached, acc)
    }
}

/// Runs the flood once per input port and collects all input-to-output passthroughs of the module.
def sumPaths(ins: List[String], outs: List[String], edges: List[CombEdge], acc: List[CombPath]): List[CombPath] = match ins {
    case lnil => acc
    case lcons(i, t) =>
        let seed: List[String] = lcons i lnil;
        let reached = combReach(edges, seed, seed);
        sumPaths(t, outs, edges, outsToPaths(outs, i, reached, acc))
}

/// Builds a module's passthrough table from its `kIn`/`kOut` declarations and the edge set (internal + cross, so child passthroughs compose transitively).
def buildCombSummary(mname: String, decls: List[GDecl], edges: List[CombEdge]): CombSumEntry =
    let ins = gdeclNamesOfKind(decls, kIn);
    let outs = gdeclNamesOfKind(decls, kOut);
    let p: List[CombPath] = lnil;
    CombSumEntry.mk(mname, sumPaths(ins, outs, edges, p))

/// Upserts the entry into the `ModuleCombSummary` global; called once per named module after the cycle check.
def registerCombSummary(e: CombSumEntry): Unit =
    let _ = change_mutable_default("ModuleCombSummary", x => combSumAdd(x, e), combSumFresh);
    unit

// ---- parent-side wiring: for u.ip := p with q := u.op on the same
// instance, a child passthrough ip -> op yields the cross edge p -> q.

/// Parent-side wiring: for a LHS connection `u.port_l := p` and a RHS connection `q := u.port_r` on the SAME instance with non-empty parent signals, a child passthrough `port_l -> port_r` yields the cross edge `dst = q, src = p`, tagged with the instance and the concatenated leaves.
/// Returns `None` for any missing piece: wrong LHS/RHS roles, different instances, empty signal names, unknown module, or no such passthrough path.
def pairEdge(c1: ConnEx, c2: ConnEx, insts: List[InstInfo], entries: List[CombSumEntry]): Option[CombEdge] =
    let base = chkBand(c1.isLhs, chkBnot(c2.isLhs));
    match base {
        case false => None
        case true =>
            let sameInst = str_eq(c1.inst, c2.inst);
            let sigsOk = chkBand(chkBnot(str_eq(c1.sig, "")), chkBnot(str_eq(c2.sig, "")));
            match chkBand(sameInst, sigsOk) {
                case false => None
                case true =>
                    match instModule(insts, c1.inst) {
                        case None => None
                        case Some(m) =>
                            match combSumFind(entries, m) {
                                case None => None
                                case Some(entry) => match combPathIn(entry.paths, c1.port, c2.port) {
                                    case false => None
                                    case true => Some(CombEdge.mk(c2.sig, c1.sig, c1.inst, nlAppend(c1.leaves, c2.leaves)))
                                }
                            }
                    }
            }
    }

/// Inner loop of the cross-edge build: pairs one LHS connection against every connection.
def crossEdgesRhs(c1: ConnEx, conns: List[ConnEx], insts: List[InstInfo], entries: List[CombSumEntry], acc: List[CombEdge]): List[CombEdge] = match conns {
    case lnil => acc
    case lcons(c2, t) =>
        let acc2 = match pairEdge(c1, c2, insts, entries) {
            case None => acc
            case Some(e) => lcons e acc
        };
        crossEdgesRhs(c1, t, insts, entries, acc2)
}

/// Outer loop of the cross-edge build: O(n^2) pairing over all connections of the module.
def crossEdges(c1s: List[ConnEx], conns: List[ConnEx], insts: List[InstInfo], entries: List[CombSumEntry], acc: List[CombEdge]): List[CombEdge] = match c1s {
    case lnil => acc
    case lcons(c1, t1) =>
        let acc2 = crossEdgesRhs(c1, conns, insts, entries, acc);
        crossEdges(t1, conns, insts, entries, acc2)
}

// ---------- phase 3 rules: HDL033 / rangeSafe / HDL032 / HDL034 / HDL035 ----

/// One root's comb drives with their ranges/conditions.
struct RootDrv {
    rng: DrvRange
    leaves: List[NegLeaf]
    eqs: List[EqTerm]
}

/// Collects the `RootDrv` facts of one target: only NON-clocked drives on `root` whose enable has no repeated key (`leafResidue` false) - the residue-free precondition of HDL032/033.
def rootDrvsOf(drives: List[DriveSrc], root: String, acc: List[RootDrv]): List[RootDrv] = match drives {
    case lnil => acc
    case lcons(d, t) =>
        let acc2 = match chkBand(chkBnot(d.clocked), chkBand(str_eq(d.target, root), chkBnot(leafResidue(d.enable)))) {
            case true => lcons (RootDrv.mk(d.rng, d.enable, d.eqs)) acc
            case false => acc
        };
        rootDrvsOf(t, root, acc2)
}

/// Typed empty `List[RootDrv]` seed.
def rootDrvEmpty: List[RootDrv] =
    let e: List[RootDrv] = lnil;
    e

/// True iff `d1` is safe against every one of `rest`: the ranges are provably disjoint OR the conditions are mutually exclusive.
/// `rangesDisjoint` is false for `rFull`/`rUnknown`, so those ranges must be condition-exclusive to count as safe.
def restSafeVs(d1: RootDrv, rest: List[RootDrv]): Boolean = match rest {
    case lnil => true
    case lcons(d2, t) =>
        chkBand(chkBor(rangesDisjoint(d1.rng, d2.rng), condsContradict(d1.leaves, d1.eqs, d2.leaves, d2.eqs)), restSafeVs(d1, t))
}

/// rangeSafe (design §4.4): roots whose comb drives are ALL partial static
/// ranges with every pair either disjoint or condition-exclusive. Handed to
/// runChecks; ruleDrivers skips HDL010/011 for these roots (a bit-sliced bus
/// is legally driven from several statements).
def rootRangeSafe(ds: List[RootDrv]): Boolean = match ds {
    case lnil => true
    case lcons(d, t) => match d.rng {
        case rPart(_, _) => chkBand(rootRangeSafe(t), restSafeVs(d, t))
        case _ => false
    }
}

/// Collects each distinct non-clocked target whose whole drive set is `rootRangeSafe`; `done` keeps one answer per target.
def rangeSafeScan(drives: List[DriveSrc], done: List[String], acc: List[String]): List[String] = match drives {
    case lnil => acc
    case lcons(d, t) =>
        let acc2 = match chkBand(chkBnot(d.clocked), chkBnot(chkStrIn(d.target, done))) {
            case true =>
                match rootRangeSafe(rootDrvsOf(drives, d.target, rootDrvEmpty)) {
                    case true => lcons d.target acc
                    case false => acc
                }
            case false => acc
        };
        rangeSafeScan(t, lcons d.target done, acc2)
}

/// The rangeSafe target list handed to phase-1 `runChecks`, which skips HDL010/011 for those roots (a bit-sliced bus may legally be driven from several statements).
def rangeSafeOf(drives: List[DriveSrc]): List[String] =
    rangeSafeScan(drives, strListEmpty, strListEmpty)

/// Reports HDL033 for every later drive whose static range INTERSECTS `d1`'s while the conditions are not mutually exclusive; the two ranges are printed hi-descending (`rangeOrder`) to match the design's expected message.
def pairsVsRest(mname: String, root: String, d1: RootDrv, rest: List[RootDrv]): Unit = match rest {
    case lnil => unit
    case lcons(d2, t) =>
        let hit = chkBand(rangesOverlap(d1.rng, d2.rng), chkBnot(condsContradict(d1.leaves, d1.eqs, d2.leaves, d2.eqs)));
        let _ = match hit {
            case true => match rangeOrder(d1.rng, d2.rng) {
                case true =>
                    let _ = chkReport("HDL033", mname, root, "overlapping bit ranges " + rangeStr(d1.rng) + " and " + rangeStr(d2.rng) + " on multiple drivers");
                    unit
                case false =>
                    let _ = chkReport("HDL033", mname, root, "overlapping bit ranges " + rangeStr(d2.rng) + " and " + rangeStr(d1.rng) + " on multiple drivers");
                    unit
            }
            case false => unit
        };
        pairsVsRest(mname, root, d1, t)
}

/// Applies `pairsVsRest` to every unordered pair of one target's drive set.
def pairsOverlap(mname: String, root: String, ds: List[RootDrv]): Unit = match ds {
    case lnil => unit
    case lcons(d1, t) =>
        let _ = pairsVsRest(mname, root, d1, t);
        pairsOverlap(mname, root, t)
}

/// HDL033: two comb drives on one root whose static ranges intersect while
/// their conditions are not mutually exclusive. Pair order in the message is
/// canonicalized hi-descending (matches the design's §9.3 expectation).
def rangeRootScan(drives: List[DriveSrc], done: List[String], mname: String): Unit = match drives {
    case lnil => unit
    case lcons(d, t) =>
        let _ = match chkBand(chkBnot(d.clocked), chkBnot(chkStrIn(d.target, done))) {
            case true =>
                let ds = rootDrvsOf(drives, d.target, rootDrvEmpty);
                pairsOverlap(mname, d.target, ds)
            case false => unit
        };
        rangeRootScan(t, lcons d.target done, mname)
}

/// HDL033 entry point: one `rangeRootScan` pass with an empty `done` list.
def ruleRangeOverlap(mname: String, drives: List[DriveSrc]): Unit =
    rangeRootScan(drives, strListEmpty, mname)

// ---------- HDL032: inferred latch (design §4.2/§4.3) ----------

/// T2: complementary condition pair — every leaf of one set has its
/// negation in the other and vice versa (covers when/otherwise two-branch).
def leafListNegIn(as: List[NegLeaf], bs: List[NegLeaf]): Boolean = match as {
    case lnil => true
    case lcons(h, t) => chkBand(leafInContradicts(h, bs), leafListNegIn(t, bs))
}

/// True iff `a` and `b` are mutual polarity flips: every leaf of `a` has an opposite-polarity partner in `b` and vice versa. Two empty sets count as complements (both directions hold vacuously).
def isComplement(a: List[NegLeaf], b: List[NegLeaf]): Boolean =
    chkBand(leafListNegIn(a, b), leafListNegIn(b, a))

/// True iff some set in `others` is a complement of `c`.
def anyComplement(c: List[NegLeaf], others: List[List[NegLeaf]]): Boolean = match others {
    case lnil => false
    case lcons(h, t) => match isComplement(c, h) {
        case true => true
        case false => anyComplement(c, t)
    }
}

/// T2 detector: walks the condition sets and returns true as soon as one set has a complement among all the OTHERS (`prefRev` holds those already passed, `rest` those still to come).
def t2Scan(prefRev: List[List[NegLeaf]], cur: List[List[NegLeaf]]): Boolean = match cur {
    case lnil => false
    case lcons(c, rest) =>
        match anyComplement(c, nllAppend(nllReverse(prefRev, nllEmpty), rest)) {
            case true => true
            case false => t2Scan(lcons c prefRev, rest)
        }
}

// T3: some condition set is all-negated and its negated atoms equal the
// multiset of all positive atoms of the other sets (covers switch+default
// and when, elsewhen chains and otherwise).
/// True iff EVERY leaf of the condition set is negated; the empty set is vacuously all-negated. It is T3's precondition, not the T3 test itself.
def allNegForm(ls: List[NegLeaf]): Boolean = match ls {
    case lnil => true
    case lcons(h, t) => match h.neg {
        case true => allNegForm(t)
        case false => false
    }
}

/// Keys of the negated leaves only (positive leaves are skipped).
def negKeys(ls: List[NegLeaf], acc: List[String]): List[String] = match ls {
    case lnil => acc
    case lcons(h, t) => match h.neg {
        case true => negKeys(t, lcons h.key acc)
        case false => negKeys(t, acc)
    }
}

/// Keys of the positive leaves only (negated leaves are skipped).
def posKeys(ls: List[NegLeaf], acc: List[String]): List[String] = match ls {
    case lnil => acc
    case lcons(h, t) => match h.neg {
        case true => posKeys(t, acc)
        case false => posKeys(t, lcons h.key acc)
    }
}

/// Concatenation of `posKeys` over all given sets - a MULTISET, so repeated keys are kept and counted.
def posKeysOfAll(ls: List[List[NegLeaf]], acc: List[String]): List[String] = match ls {
    case lnil => acc
    case lcons(h, t) => posKeysOfAll(t, posKeys(h, acc))
}

/// Removes the FIRST occurrence of `x` and returns the rest; `None` when `x` is absent. Multiset remove-one.
def strMsetRemove(x: String, ls: List[String]): Option[List[String]] = match ls {
    case lnil => None
    case lcons(h, t) => match str_eq(h, x) {
        case true => Some(t)
        case false => match strMsetRemove(x, t) {
            case None => None
            case Some(r) => Some(lcons h r)
        }
    }
}

/// Multiset equality: each element of `a` consumes one occurrence in `b`, so `[x, x]` is not equal to `[x]`.
def strMsetEq(a: List[String], b: List[String]): Boolean = match a {
    case lnil => match b {
        case lnil => true
        case _ => false
    }
    case lcons(h, t) => match strMsetRemove(h, b) {
        case None => false
        case Some(b2) => strMsetEq(t, b2)
    }
}

/// T3: `c` is all-negated and its negated-key multiset equals the multiset of positive keys across all OTHER sets - the switch-with-default / when-elsewhen-otherwise coverage shape.
def t3Check(c: List[NegLeaf], others: List[List[NegLeaf]]): Boolean =
    chkBand(allNegForm(c), strMsetEq(negKeys(c, strListEmpty), posKeysOfAll(others, strListEmpty)))

/// T3 detector over all condition sets; the `prefRev` accumulator is reversed back so the others list is the complete set minus `c`.
def t3Scan(prefRev: List[List[NegLeaf]], cur: List[List[NegLeaf]]): Boolean = match cur {
    case lnil => false
    case lcons(c, rest) =>
        match t3Check(c, nllAppend(nllReverse(prefRev, nllEmpty), rest)) {
            case true => true
            case false => t3Scan(lcons c prefRev, rest)
        }
}

/// Typed empty `List[List[NegLeaf]]` seed used as the enable-set accumulator in `ruleLatch` and as the empty argument of `coveredBy`.
def strEnableListEmpty: List[List[NegLeaf]] =
    let e: List[List[NegLeaf]] = lnil;
    e

/// True iff the enable sets cover all cases by either rule: T2 (a complementary pair) or T3 (an exhaustive all-negated set).
def coveredBy(ls: List[List[NegLeaf]]): Boolean =
    chkBor(t2Scan(strEnableListEmpty, ls), t3Scan(strEnableListEmpty, ls))

/// Recognizes the semantically unconditional `when(literal(1))` wrapper: exactly ONE leaf, positive, whose key equals the key freshly computed from `leavesOf(literal(1))` (never hard-codes a literal key, so an exprKey change follows automatically).
/// Needed because hdl-fsm wraps an FSM's default first assignment in `when(1)`; without it every FSM `stateNext` would be misreported as a latch by HDL032.
def enableAlwaysTrue(en: List[NegLeaf]): Boolean = match en {
    // 恰一个正极性叶子、key 等于 literal(1) 的叶子——fsmNew 的 default
    // 首赋值被 when(literal(1)) 包裹（hdl-fsm.typort 对 HDL011 D5 的
    // 兜底），DriveSrc.enable 即此形状。语义上恒真使能就是无条件驱动：
    // hasUncondComb 不认账的话，每个 FSM 模块的 stateNext 都被 HDL032
    // 误报 latch（2026-09-29 评审 P2-5；与 docs/hdl-stream-fsm-design.md
    // §7.3 when(1) 兜底的承诺对齐）。
    // key 从 leavesOf(literal(1)) 现算（exprKey 改动自动跟随，不硬编码
    // "l:1"）。注意：这里是**内联**调用而非独立 def——新增 prelude def
    // 会触发 twin 引擎 def-replay 的 spine 索引越界
    // （twin_engine_tests 全例崩溃，spine.rs len=1499 idx=65964，
    // 2026-09-29 实测），单独 helper def 的形状暂不可用。
    case lcons(h, lnil) => match leavesOf(literal(1)) {
        case lcons(th, _) => chkBand(chkBnot(h.neg), str_eq(h.key, th.key))
        case _ => false
    }
    case _ => false
}

/// True iff `name` has a non-clocked drive whose enable is empty or recognized as `enableAlwaysTrue` - the no-latch-risk side of HDL032.
/// False when `name` has no non-clocked drive at all, so a never-driven wire is not HDL032's business.
def hasUncondComb(drives: List[DriveSrc], name: String): Boolean = match drives {
    case lnil => false
    case lcons(d, t) => match chkBand(chkBnot(d.clocked), str_eq(d.target, name)) {
        case true => match d.enable {
            case lnil => true
            case _ => match enableAlwaysTrue(d.enable) {
                case true => true
                case false => hasUncondComb(t, name)
            }
        }
        case false => hasUncondComb(t, name)
    }
}

/// Collects the non-empty enables of `name`'s non-clocked, residue-free drives; drives with an empty enable are covered by `hasUncondComb` instead.
def condEnablesOf(drives: List[DriveSrc], name: String, acc: List[List[NegLeaf]]): List[List[NegLeaf]] = match drives {
    case lnil => acc
    case lcons(d, t) =>
        let acc2 = match chkBand(chkBnot(d.clocked), chkBand(str_eq(d.target, name), chkBnot(leafResidue(d.enable)))) {
            case true => match d.enable {
                case lnil => acc
                case _ => lcons d.enable acc
            }
            case false => acc
        };
        condEnablesOf(t, name, acc2)
}

/// True iff at least one conditional enable was collected.
def condEnablesNonEmpty(ls: List[List[NegLeaf]]): Boolean = match ls {
    case lnil => false
    case lcons(_, _) => true
}

/// HDL032 for `wire`/`out` declarations: with at least one conditional driver and NO unconditional one, the enable sets must be covered (T2/T3); otherwise some case is uncovered and an inferred latch is reported.
def ruleLatch(mname: String, decls: List[GDecl], drives: List[DriveSrc]): Unit = match decls {
    case lnil => unit
    case lcons(d, t) =>
        let isWireOrOut = chkBor(kindEq(d.kind, kWire), kindEq(d.kind, kOut));
        let _ = match isWireOrOut {
            case true =>
                let enables = condEnablesOf(drives, d.name, strEnableListEmpty);
                let uncond = hasUncondComb(drives, d.name);
                let _ = match chkBand(condEnablesNonEmpty(enables), chkBnot(uncond)) {
                    case true => match coveredBy(enables) {
                        case true => unit
                        case false =>
                            let _ = chkReport("HDL032", mname, d.name, "inferred latch: conditional drivers do not cover all cases (no unconditional default)");
                            unit
                    }
                    case false => unit
                };
                unit
            case false => unit
        };
        ruleLatch(mname, t, drives)
}

// ---------- HDL034: always-false (dead) driver condition ----------
// Scope (docs/hdl-selfcheck-phase234-design.md §11.5, review 2026-09-27): only
// the eq-term form is reported — one drive whose own condition constrains the
// same selector to two different ground values, e.g.
// `when (sel == 0) && (sel == 1)`. The bare-signal form `when c && !c` is
// deliberately NOT reported: at leaf level it is structurally identical to the
// cross-branch WhenStack residue (`!en && en`) produced by the replay rounds,
// so reporting it would false-positive on every latchOk/loopExempt-style
// module. The extra guard in ruleDeadCond skips even the eq form when the
// contradicting selector also appears in another drive's condition (switch-arm
// residue rather than a user-written dead condition). Name/leaf-level: safe in
// every round.

/// Returns the first selector that has two atoms with different ground values inside `eqs` - a condition like `sel == 0 && sel == 1`.
def eqSelContradicted(eqs: List[EqTerm], rest: List[EqTerm]): Option[String] = match eqs {
    case lnil => None
    case lcons(h, t) => match eqTermInContradicts(h, rest) {
        case true => Some(h.sel)
        case false => eqSelContradicted(t, rest)
    }
}

/// Selector membership; the atom's value is ignored.
def selInEqs(sel: String, eqs: List[EqTerm]): Boolean = match eqs {
    case lnil => false
    case lcons(h, t) => match str_eq(sel, h.sel) {
        case true => true
        case false => selInEqs(sel, t)
    }
}

/// True iff some OTHER drive (different `rhsKey`, i.e. a different statement) mentions `sel` in its atoms; used to tell a user-written dead condition from cross-branch WhenStack residue.
def selInOtherDrives(drives: List[DriveSrc], sel: String, myKey: String): Boolean = match drives {
    case lnil => false
    case lcons(d, t) => match str_eq(d.rhsKey, myKey) {
        case true => selInOtherDrives(t, sel, myKey)
        case false => match selInEqs(sel, d.eqs) {
            case true => true
            case false => selInOtherDrives(t, sel, myKey)
        }
    }
}

/// HDL034, eq-term form only: a drive whose own condition pins the same selector to two different ground values can never fire. The bare `when c && !c` form is deliberately NOT reported, because at leaf level it is indistinguishable from cross-branch WhenStack residue (`!en && en`).
/// Also skipped when the enable shows leaf residue, and when the contradicting selector also appears in another drive's condition (switch-arm residue rather than a user-written dead condition).
def ruleDeadCond(mname: String, drives: List[DriveSrc]): Unit = match drives {
    case lnil => unit
    case lcons(d, t) =>
        // eq-term self-contradiction (sel == v1 && sel == v2), guarded: when
        // the contradicting selector ALSO appears in another drive's
        // condition, the pair is cross-branch WhenStack residue (switch
        // arms), not a user-written dead condition - skip it.
        let dead = match leafResidue(d.enable) {
            case true => false
            case false => match eqSelContradicted(d.eqs, d.eqs) {
                case None => false
                case Some(sel) => chkBnot(selInOtherDrives(drives, sel, d.rhsKey))
            }
        };
        let _ = match dead {
            case true =>
                let _ = chkReport("HDL034", mname, d.target, "driver condition is always false");
                unit
            case false => unit
        };
        ruleDeadCond(mname, t)
}

// ---------- HDL035: same-condition driver shadowed by a later one ----------
// Source-order (always-block last-wins) semantics: an earlier conditional
// driver with a byte-identical enable key is dead. Documented false
// positive: deliberate last-wins restatement of the same guard.

/// True iff a drive LATER in statement order has the same target and a byte-identical `enableKey` - under always-block last-wins semantics the earlier one is dead.
def shadowedByLater(rest: List[DriveSrc], target: String, key: String): Boolean = match rest {
    case lnil => false
    case lcons(d, t) => match chkBand(str_eq(d.target, target), str_eq(d.enableKey, key)) {
        case true => true
        case false => shadowedByLater(t, target, key)
    }
}

/// HDL035: reports the earlier of two same-target drives with identical enable keys. Drives with residue or an empty `enableKey` are excluded.
def ruleShadow(mname: String, drives: List[DriveSrc]): Unit = match drives {
    case lnil => unit
    case lcons(d, t) =>
        let _ = match chkBand(chkBnot(leafResidue(d.enable)), chkBand(chkBnot(str_eq(d.enableKey, "")), shadowedByLater(t, d.target, d.enableKey))) {
            case true =>
                let _ = chkReport("HDL035", mname, d.target, "conditional driver shadowed by a later driver with the same condition");
                unit
            case false => unit
        };
        ruleShadow(mname, t)
}

// ---------- phase 4: CDC — domain propagation & synchronizer chains ----
// Anchors (design §5.1): regAssignCd drive cd > *Cd decl variant cd > module
// default cd (regs only). Domain-neutral: input/inout ports, mems, literals,
// memRead, output ports (propagated). Comb signals start unknown (empty
// list) and inherit from their drivers; a clocked target is ALWAYS anchored.
// Pure typort fixpoint, <= V rounds x O(E), chkCdEq only compares
// clock/reset names (perf red line).

/// One signal's propagated clock-domain set; it is a list rather than a set because `chkCdInList` dedups on insert.
struct DomEntry {
    name: String
    doms: List[ClockDomain]
}

/// Typed empty `List[DomEntry]` seed for the domain fixpoint.
def domListEmpty: List[DomEntry] =
    let e: List[DomEntry] = lnil;
    e

/// Looks up a signal's domain set; `None` means the signal is not in the table at all.
def domEntryOf(es: List[DomEntry], name: String): Option[List[ClockDomain]] = match es {
    case lnil => None
    case lcons(e, t) => match str_eq(e.name, name) {
        case true => Some(e.doms)
        case false => domEntryOf(t, name)
    }
}

/// Union one domain into an entry (append-only, dedup via chkCdInList).
def domUnionOne(es: List[DomEntry], name: String, cd: ClockDomain): List[DomEntry] = match es {
    case lnil =>
        let ds: List[ClockDomain] = lcons cd lnil;
        lcons (DomEntry.mk(name, ds)) lnil
    case lcons(e, t) => match str_eq(e.name, name) {
        case true => match chkCdInList(cd, e.doms) {
            case true => lcons e t
            case false => lcons (DomEntry.mk(name, lcons cd e.doms)) t
        }
        case false => lcons e (domUnionOne(t, name, cd))
    }
}

/// Unions a whole domain list into one signal's entry, one domain at a time (each insert deduped by `chkCdInList`).
def domUnionAll(es: List[DomEntry], name: String, doms: List[ClockDomain]): List[DomEntry] = match doms {
    case lnil => es
    case lcons(cd, t) => domUnionAll(domUnionOne(es, name, cd), name, t)
}

/// Declared `SigKind` of a name; `None` when nothing is declared under it.
def gdeclKindOf(ds: List[GDecl], name: String): Option[SigKind] = match ds {
    case lnil => None
    case lcons(d, t) => match str_eq(d.name, name) {
        case true => Some(d.kind)
        case false => gdeclKindOf(t, name)
    }
}

/// Declared width of a name; `None` when the declaration carries no width or no declaration exists.
def gdeclWidthOf(ds: List[GDecl], name: String): Option[Nat] = match ds {
    case lnil => None
    case lcons(d, t) => match str_eq(d.name, name) {
        case true => d.width
        case false => gdeclWidthOf(t, name)
    }
}

/// The declaration's stored `exprKey` of its `create*` node (empty string when undeclared); `xorKeyOf` composes these into the XOR RHS key.
def gdeclKeyOf(ds: List[GDecl], name: String): String = match ds {
    case lnil => ""
    case lcons(d, t) => match str_eq(d.name, name) {
        case true => d.key
        case false => gdeclKeyOf(t, name)
    }
}

/// `kReg` or `kOutReg` - the kinds that make a signal a register for CDC and domain-anchor purposes.
def isRegKind(k: SigKind): Boolean =
    chkBor(kindEq(k, kReg), kindEq(k, kOutReg))

// ---------- HDL041: constant bit-select/part-select index out of range ----------
// A bitsel/partsel carrying GROUND literal index(es) on a signal whose
// declared width is a ground Nat must satisfy idx < width (BOTH ends of a
// part range). Verilog reads/writes x outside the declared range - silent
// wrong hardware (review 2026-09-29 P2-7: `a8.slice[9, 7]` emitted `a[9:7]`).
// The walk covers LHS selects (drive targets) and RHS selects (reads) alike
// by recursing through every statement/expression shape. Mems are excluded:
// createMem's GDecl width is the CELL width, not the address space, so mem
// indexes (memRead/memWrite addresses) are not comparable to it.
//
// SHAPE NOTE: the checks are decomposed into one-match-per-def tails on
// purpose - a `let _ = match {...}; <more>` chain nested 5 match-levels deep
// trips the parser's brace tracking ("expected `}`" xN, spans off; the same
// shape recovers in user files but poisons the next prelude decls).

/// Mem/unknown-width bases yield None; only ground widths of non-mem signals
/// pass through.
def oobWidthOf(ds: List[GDecl], nm: String): Option[Nat] = match gdeclKindOf(ds, nm) {
    case None => None
    case Some(k) => match kindEq(k, kMem) {
        case true => None
        case false => match gdeclWidthOf(ds, nm) {
            case None => None
            case Some(w) => match nat_is_ground(w) {
                case true => Some(w)
                case false => None
            }
        }
    }
}

/// HDL041 unless `idx + 1 <= w` (`succ` on ground Nats); otherwise the constant index reads or writes x outside the declared width.
def oobIdxBad(mname: String, nm: String, idx: Nat, w: Nat): Unit = match chkNatLe(succ(idx), w) {
    case true => unit
    case false => chkReport("HDL041", mname, nm, "constant bit index " + nat_to_dec(idx) + " out of declared width " + nat_to_dec(w) + " - Verilog reads/writes x")
}

/// HDL041 when either end of `[hi:lo]` fails `succ(end) <= w` - BOTH bounds of a part-select are checked.
def oobRangeBad(mname: String, nm: String, hi: Nat, lo: Nat, w: Nat): Unit =
    let badHi = chkBnot(chkNatLe(succ(hi), w));
    let badLo = chkBnot(chkNatLe(succ(lo), w));
    match chkBor(badHi, badLo) {
        case true => chkReport("HDL041", mname, nm, "constant bit range [" + nat_to_dec(hi) + ":" + nat_to_dec(lo) + "] out of declared width " + nat_to_dec(w) + " - Verilog reads/writes x")
        case false => unit
    }

/// Guards the index check: only a NAMED base with a known ground width and a GROUND literal index is compared, so dynamic indexes and mems are skipped.
def oobCheckIdx(mname: String, decls: List[GDecl], b: Expr, i: Expr): Unit =
    let nm = exprName(b);
    match str_eq(nm, "") {
        case true => unit
        case false => match litNat(i) {
            case None => unit
            case Some(idx) => match oobWidthOf(decls, nm) {
                case None => unit
                case Some(w) => oobIdxBad(mname, nm, idx, w)
            }
        }
    }

/// Same guard for part-selects: both bounds must be ground literals before the width comparison happens.
def oobCheckRange(mname: String, decls: List[GDecl], b: Expr, hiE: Expr, loE: Expr): Unit =
    let nm = exprName(b);
    match str_eq(nm, "") {
        case true => unit
        case false => match litNat(hiE) {
            case None => unit
            case Some(hv) => match litNat(loE) {
                case None => unit
                case Some(lv) => match oobWidthOf(decls, nm) {
                    case None => unit
                    case Some(w) => oobRangeBad(mname, nm, hv, lv, w)
                }
            }
        }
    }

/// Structural walker over statements AND sub-expressions (same shape coverage
/// as scanStmtEx/scanExprEx; create and createMem nodes are declarations without
/// selects and need no recursion).
def oobScanExpr(mname: String, decls: List[GDecl], e: Expr): Unit = match e {
    case subSignal(_, _) => unit
    case literal(_) => unit
    case sizedLiteral(_, _) => unit
    case nop => unit
    case bbMarkerExpr(_, _) => unit
    case instance(_, _) => unit
    case instanceWithPorts(_, _, _) => unit
    case unary(_, x) => oobScanExpr(mname, decls, x)
    case binary(l, _, r) =>
        let _ = oobScanExpr(mname, decls, l);
        oobScanExpr(mname, decls, r)
    case mux(c, tv, fv) =>
        let _ = oobScanExpr(mname, decls, c);
        let _ = oobScanExpr(mname, decls, tv);
        oobScanExpr(mname, decls, fv)
    case bitsel(b, i) =>
        let _ = oobCheckIdx(mname, decls, b, i);
        let _ = oobScanExpr(mname, decls, b);
        oobScanExpr(mname, decls, i)
    case partsel(b, hiE, loE) =>
        let _ = oobCheckRange(mname, decls, b, hiE, loE);
        let _ = oobScanExpr(mname, decls, b);
        let _ = oobScanExpr(mname, decls, hiE);
        oobScanExpr(mname, decls, loE)
    case memRead(m, a) =>
        let _ = oobScanExpr(mname, decls, m);
        oobScanExpr(mname, decls, a)
    case when(c, b2, eb) =>
        let _ = oobScanExpr(mname, decls, c);
        let _ = oobScanExpr(mname, decls, b2);
        match eb {
            case None => unit
            case Some(eb2) => oobScanExpr(mname, decls, eb2)
        }
    case assign(l, r) =>
        let _ = oobScanExpr(mname, decls, l);
        oobScanExpr(mname, decls, r)
    case regAssign(l, r) =>
        let _ = oobScanExpr(mname, decls, l);
        oobScanExpr(mname, decls, r)
    case regAssignCd(l, r, _) =>
        let _ = oobScanExpr(mname, decls, l);
        oobScanExpr(mname, decls, r)
    case block(h, t) =>
        let _ = oobScanExpr(mname, decls, h);
        oobScanExpr(mname, decls, t)
    case switch(v, cs) =>
        let _ = oobScanExpr(mname, decls, v);
        oobScanExpr(mname, decls, cs)
    case memWrite(mem, addr, data, en) =>
        let _ = oobScanExpr(mname, decls, mem);
        let _ = oobScanExpr(mname, decls, addr);
        let _ = oobScanExpr(mname, decls, data);
        oobScanExpr(mname, decls, en)
    case assertExpr(c, _, _) => oobScanExpr(mname, decls, c)
    case assertExprCd(c, _, _, _) => oobScanExpr(mname, decls, c)
    case _ => unit
}

/// Runs the HDL041 walk over every statement of the module.
def oobScanAll[ne: Nat](es: Vec[Expr] ne, mname: String, decls: List[GDecl]): Unit = match es {
    case nil => unit
    case cons(h, t) =>
        let _ = oobScanExpr(mname, decls, h);
        oobScanAll(t, mname, decls)
}


/// Anchors from declarations. A decl carrying an explicit cd anchors there;
/// a register WITHOUT one is pre-anchored to the module default (mdcd) right
/// here — the lazy resolveCd fallback (decl cd > mdcd) would land on the same
/// answer, so seeding early simply hands the propagation fixpoint a complete
/// starting table. Comb decls stay unanchored (propagation fills them).
def domInitEntries(decls: List[GDecl], drives: List[DriveSrc], mdcd: ClockDomain, acc: List[DomEntry]): List[DomEntry] = match decls {
    case lnil => acc
    case lcons(d, t) =>
        let acc1 = match d.cd {
            case Some(cd) => domUnionOne(acc, d.name, cd)
            case None => match isRegKind(d.kind) {
                case true => domUnionOne(acc, d.name, mdcd)
                case false => acc
            }
        };
        domInitEntries(t, drives, mdcd, acc1)
}

// One Gauss-Seidel propagation round over comb drives.
/// Propagates the domains of ONE comb drive: for each of its reads whose entry holds a non-empty domain set, that set is unioned into the drive's target. Reads with an empty or absent entry contribute nothing.
def domRoundSrcs(entries: List[DomEntry], d: DriveSrc, srcs: List[CondSrc]): List[DomEntry] = match srcs {
    case lnil => entries
    case lcons(s, t) =>
        let entries1 = match domEntryOf(entries, s.src) {
            case None => entries
            case Some(doms) => match doms {
                case lnil => entries
                case _ => domUnionAll(entries, d.target, doms)
            }
        };
        domRoundSrcs(entries1, d, t)
}

/// One full sweep over the drive list, applying `domRoundSrcs` to each comb drive in list order; clocked drives are boundaries and are skipped.
/// It is Gauss-Seidel rather than Jacobi: a later drive in the same round already sees an earlier drive's update.
def domRound(entries: List[DomEntry], drives: List[DriveSrc]): List[DomEntry] = match drives {
    case lnil => entries
    case lcons(d, t) =>
        let entries1 = match d.clocked {
            case true => domRound(entries, t)
            case false =>
                let entries2 = domRoundSrcs(entries, d, d.srcs);
                domRound(entries2, t)
        };
        entries1
}

/// Number of domains in one entry.
def domCountOf(ds: List[ClockDomain], acc: Nat): Nat = match ds {
    case lnil => acc
    case lcons(_, t) => domCountOf(t, succ(acc))
}

// Fixpoint: iterate until the domain sets stop growing (budget = rounds).
/// Total number of domain memberships in the table - the monotone growth metric of the fixpoint (not a count of entries).
def domsTotal(es: List[DomEntry], acc: Nat): Nat = match es {
    case lnil => acc
    case lcons(e, t) => domsTotal(t, nat_add(domCountOf(e.doms, 0), acc))
}

/// Fixpoint loop: run a round, stop as soon as the membership total stops growing, or when the budget runs out. Termination is by budget; the growth test only lets it stop earlier.
def domFix(entries: List[DomEntry], drives: List[DriveSrc], budget: Nat): List[DomEntry] = match budget {
    case zero => entries
    case succ(m) =>
        let entries2 = domRound(entries, drives);
        match chkNatLe(domsTotal(entries2, 0), domsTotal(entries, 0)) {
            case true => entries2
            case false => domFix(entries2, drives, m)
        }
}

/// Fixpoint round budget: one comb drive per round (+1 slack) — every target
/// is reached after at most V passes.
def driveRoundBudget(drives: List[DriveSrc], acc: Nat): Nat = match drives {
    case lnil => succ(acc)
    case lcons(d, t) => match d.clocked {
        case true => driveRoundBudget(t, acc)
        case false => driveRoundBudget(t, succ(acc))
    }
}

/// Clock name list rendering for HDL036 ("clkA/clkB").
def domNamesJoin(ds: List[ClockDomain], acc: String): String = match ds {
    case lnil => acc
    case lcons(cd, t) => match str_eq(acc, "") {
        case true => domNamesJoin(t, cd.clockName)
        case false => domNamesJoin(t, acc + "/" + cd.clockName)
    }
}

/// HDL036: a combinational signal (wire/out decl, not a register) whose
/// propagated domain set holds two or more domains.
def ruleDomMix(mname: String, decls: List[GDecl], entries: List[DomEntry]): Unit = match decls {
    case lnil => unit
    case lcons(d, t) =>
        let isCombDecl = chkBor(kindEq(d.kind, kWire), kindEq(d.kind, kOut));
        let _ = match isCombDecl {
            case true =>
                match domEntryOf(entries, d.name) {
                    case None => unit
                    case Some(doms) => match doms {
                        case lnil => unit
                        case lcons(_, lnil) => unit
                        case _ =>
                            let _ = chkReport("HDL036", mname, d.name, "combinational signal mixes domains " + domNamesJoin(doms, ""));
                            unit
                    }
                }
            case false => unit
        };
        ruleDomMix(mname, t, entries)
}

// ---------- synchronizer chain recognition (design §5.3) ----------

/// One clock-domain crossing: the source signal and its domain, the clocked target and its domain, and whether the source is registered. Edges exist only for sources with exactly one known domain that differs from the target's.
struct CdcEdge {
    src: String
    dst: String
    srcDom: ClockDomain
    dstDom: ClockDomain
    srcReg: Boolean
}

/// Typed empty `List[CdcEdge]` seed for the edge collection.
def cdcListEmpty: List[CdcEdge] =
    let e: List[CdcEdge] = lnil;
    e

// Resolved clock domain of a clocked drive target: explicit drive cd >
// decl variant cd > module default.
/// The declaration's OWN explicit clock domain (from the `*Cd` create variants); `None` when the name is undeclared or carries no cd - the middle priority of `resolveCd`.
def gdeclCdOf(ds: List[GDecl], name: String): Option[ClockDomain] = match ds {
    case lnil => None
    case lcons(d, t) => match str_eq(d.name, name) {
        case true => d.cd
        case false => gdeclCdOf(t, name)
    }
}

/// Domain resolution priority for a clocked target: the drive's explicit `cd`, else the declaration's cd, else the module default.
def resolveCd(name: String, dcd: Option[ClockDomain], decls: List[GDecl], mdcd: ClockDomain): ClockDomain = match dcd {
    case Some(cd) => cd
    case None => match gdeclCdOf(decls, name) {
        case Some(cd) => cd
        case None => mdcd
    }
}

/// True iff any of a drive's reads names `name`.
def srcHasOf(srcs: List[CondSrc], name: String): Boolean = match srcs {
    case lnil => false
    case lcons(s, t) => match str_eq(s.src, name) {
        case true => true
        case false => srcHasOf(t, name)
    }
}

/// True iff this drive reads `name`; a thin wrapper over `srcHasOf`.
def driveSrcHas(d: DriveSrc, name: String): Boolean = srcHasOf(d.srcs, name)

/// True iff some clocked drive targets `name`.
def hasClockedDrive(drives: List[DriveSrc], name: String): Boolean = match drives {
    case lnil => false
    case lcons(d, t) => match chkBand(d.clocked, str_eq(d.target, name)) {
        case true => true
        case false => hasClockedDrive(t, name)
    }
}

/// Classify a CDC source: "registered" or "combinational".
def srcIsRegistered(drives: List[DriveSrc], decls: List[GDecl], name: String): Boolean =
    chkBor(hasClockedDrive(drives, name), match gdeclKindOf(decls, name) {
        case None => false
        case Some(k) => isRegKind(k)
    })

/// CDC edges: a clocked drive sampling a single-known-domain signal of a
/// DIFFERENT domain. Sources with unknown/multi domains are skipped (the
/// multi case is HDL036's business; mems/ports are domain-neutral).
def cdcEdgesSrcs(drives: List[DriveSrc], d: DriveSrc, srcs: List[CondSrc], dstCd: ClockDomain, decls: List[GDecl], entries: List[DomEntry], mdcd: ClockDomain, acc: List[CdcEdge]): List[CdcEdge] = match srcs {
    case lnil => acc
    case lcons(s, t) =>
        let acc1 = match domEntryOf(entries, s.src) {
            case None => acc
            case Some(doms) => match doms {
                case lcons(sd, lnil) => match chkCdEq(sd, dstCd) {
                    case true => acc
                    case false =>
                        let reg = srcIsRegistered(drives, decls, s.src);
                        cdcEdgesSrcs(drives, d, t, dstCd, decls, entries, mdcd, lcons (CdcEdge.mk(s.src, d.target, sd, dstCd, reg)) acc)
                }
                case _ => acc
            }
        };
        acc1
}

// ---------- HDL037/038/039: chain walk + reports ----------

// The unique clocked-uncond single-reader successor of r in the clock-driven
// graph, if one exists and is a registered same-domain stage.
// Returns Some(next) when ALL chain-extension qualifications hold.
/// Collects the CDC edges of the whole module: for each CLOCKED drive it resolves the target's domain (`resolveCd`) and asks `cdcEdgesSrcs` for that drive's crossings; comb drives produce no edges.
def cdcEdgesOf(drives: List[DriveSrc], decls: List[GDecl], entries: List[DomEntry], mdcd: ClockDomain, acc: List[CdcEdge]): List[CdcEdge] = match drives {
    case lnil => acc
    case lcons(d, t) =>
        let acc1 = match d.clocked {
            case true =>
                let dstCd = resolveCd(d.target, d.cd, decls, mdcd);
                cdcEdgesSrcs(drives, d, d.srcs, dstCd, decls, entries, mdcd, acc)
            case false => acc
        };
        cdcEdgesOf(t, decls, entries, mdcd, acc1)
}

/// Targets of the clocked drives that read `r` AND are unconditional (empty `enableKey`, which means no enclosing `when` guard at all) and residue-free.
def clockedReaderTargets(drives: List[DriveSrc], r: String, acc: List[String]): List[String] = match drives {
    case lnil => acc
    case lcons(d, t) =>
        let acc1 = match chkBand(d.clocked, chkBand(chkBnot(leafResidue(d.enable)), str_eq(d.enableKey, ""))) {
            case true => match driveSrcHas(d, r) {
                case true => lcons d.target acc
                case false => acc
            }
            case false => acc
        };
        clockedReaderTargets(t, r, acc1)
}

/// Typed empty `List[String]` seed used by the chain walks and the chain-head lists.
def cdcStrEmpty: List[String] =
    let e: List[String] = lnil;
    e

/// r has exactly one clocked drive and it is unconditional (design §5.3
/// qualification: uncondClk == 1, condClk == 0). Flat matches only.
def uncondClockedCount(drives: List[DriveSrc], name: String, acc: Nat): Nat = match drives {
    case lnil => acc
    case lcons(d, t) => match chkBand(d.clocked, str_eq(d.target, name)) {
        case true => match d.enable {
            case lnil => uncondClockedCount(t, name, succ(acc))
            case _ => uncondClockedCount(t, name, acc)
        }
        case false => uncondClockedCount(t, name, acc)
    }
}

/// The complement counter: clocked drives of `name` whose enable is non-empty.
def condClockedCount(drives: List[DriveSrc], name: String, acc: Nat): Nat = match drives {
    case lnil => acc
    case lcons(d, t) => match chkBand(d.clocked, str_eq(d.target, name)) {
        case true => match d.enable {
            case lnil => condClockedCount(t, name, acc)
            case _ => condClockedCount(t, name, succ(acc))
        }
        case false => condClockedCount(t, name, acc)
    }
}

/// Peano equality with 1 (no Nat is forced); `singleUncondClockedDrive` and `headQualified` use it to demand exactly one unconditional clocked drive and exactly one source.
def countIsOne(n: Nat): Boolean = match n {
    case zero => false
    case succ(m) => match m {
        case zero => true
        case _ => false
    }
}

/// The design 5.3 head qualification: exactly ONE unconditional clocked drive AND zero conditional clocked drives for `name`.
def singleUncondClockedDrive(drives: List[DriveSrc], name: String): Boolean =
    match countIsOne(uncondClockedCount(drives, name, 0)) {
        case true => match condClockedCount(drives, name, 0) {
            case zero => true
            case _ => false
        }
        case false => false
    }

// ---------- HDL037/038/039 report pass ----------

/// The explicit regAssignCd anchor of the unique unconditional clocked drive
/// that reads r and targets x (None when that drive carries no explicit cd).
/// Lets the chain walk resolve the next stage's domain with the SAME priority
/// as the chain head (drive cd > decl cd > module default) instead of
/// ignoring the drive-side anchor.
def readerDriveCd(drives: List[DriveSrc], x: String, r: String): Option[ClockDomain] = match drives {
    case lnil => None
    case lcons(d, t) =>
        match chkBand(d.clocked, chkBand(str_eq(d.target, x), driveSrcHas(d, r))) {
            case true => match d.enable {
                case lnil => d.cd
                case _ => readerDriveCd(t, x, r)
            }
            case false => readerDriveCd(t, x, r)
        }
}

// XOR edge-detect exemption (design §5.3): a comb reader of Ri whose RHS is
// exactly binary(Ri, "^", R(i+1)) — the pulseCCByToggle/toggle-sync form.
// The reference exprKeys are the DECL nodes (references are the same create*
// nodes the decls carry).
/// Chain extension test for `r` in domain `D`: `r` must have exactly ONE clocked unconditional reader `x` (and `x != r`), `x` must itself be single-uncond-clocked and registered, and `x`'s resolved domain - with the reader drive's own cd taking priority - must equal `D`. Anything else returns `None` and ends the chain.
/// The XOR edge-detect exemption is NOT applied here; that lives in `midStageScan`.
def chainNextOf(drives: List[DriveSrc], decls: List[GDecl], mdcd: ClockDomain, r: String, D: ClockDomain): Option[String] =
    match clockedReaderTargets(drives, r, cdcStrEmpty) {
        case lcons(x, lnil) =>
            match str_eq(x, r) {
                case true => None
                case false =>
                    match singleUncondClockedDrive(drives, x) {
                        case false => None
                        case true =>
                            let regd = match gdeclKindOf(decls, x) {
                                case None => hasClockedDrive(drives, x)
                                case Some(k) => isRegKind(k)
                            };
                            match regd {
                                case false => None
                                case true => match chkCdEq(resolveCd(x, readerDriveCd(drives, x, r), decls, mdcd), D) {
                                    case true => Some(x)
                                    case false => None
                                }
                            }
                    }
            }
        case _ => None
    }

/// exprKey rendering of binary(a, "^", b) over the decl keys. XOR is
/// symmetric; the MATCHER below accepts both operand orders (typort has no
/// lexicographic string compare to normalize the pair itself), so
/// `sync1 ^ sync2` and `sync2 ^ sync1` are the same exempt edge-detect form.
def xorKeyOf(a: String, b: String, decls: List[GDecl]): String =
    "b:^(" + gdeclKeyOf(decls, a) + "," + gdeclKeyOf(decls, b) + ")"

// All targets that read r (any drive kind).
/// Every drive target that reads `r`, regardless of clocked or conditional status - the unrestricted twin of `clockedReaderTargets`.
/// Currently DEAD CODE: the only references in the tree are this definition and its own recursion, so nothing calls it.
def allReaderTargets(drives: List[DriveSrc], r: String, acc: List[String]): List[String] = match drives {
    case lnil => acc
    case lcons(d, t) =>
        let acc1 = match driveSrcHas(d, r) {
            case true => lcons d.target acc
            case false => acc
        };
        allReaderTargets(t, r, acc1)
}

// str in list (local, List[String]).
/// Local linear membership test over `List[String]`; `cdcEdgeVerdict`/`cdcVerdicts` use it to skip already-identified chain heads (the file's other membership tests use the `chkStrIn` builtin instead).
def cdcStrIn(s: String, ls: List[String]): Boolean = match ls {
    case lnil => false
    case lcons(h, t) => match str_eq(h, s) {
        case true => true
        case false => cdcStrIn(s, t)
    }
}

/// Mid-stage HDL039: every reader of Ri (i < k) must be R(i+1) or an
/// XOR-with-next reader (either operand order — XOR is symmetric).
def midStageScan(drives: List[DriveSrc], mname: String, decls: List[GDecl], ri: String, rnext: String): Unit = match drives {
    case lnil => unit
    case lcons(d, t) =>
        let _ = match driveSrcHas(d, ri) {
            case true => match str_eq(d.target, rnext) {
                case true => unit
                case false => match chkBor(str_eq(d.rhsKey, xorKeyOf(ri, rnext, decls)), str_eq(d.rhsKey, xorKeyOf(rnext, ri, decls))) {
                    case true => unit
                    case false =>
                        let _ = chkReport("HDL039", mname, ri, "synchronizer mid-stage read: consumer bypasses the chain head");
                        unit
                }
            }
            case false => unit
        };
        midStageScan(t, mname, decls, ri, rnext)
}

// Chain walk from R0: collect [R0, R1, ...] while the next stage is a
// registered, single-uncond-clocked, same-domain unique reader. Depth cap 8.
/// Thin entry point for one chain pair: reports HDL039 for every drive that reads `ri` but is neither `rnext` nor an XOR of `ri` with `rnext`. The body is a single `midStageScan` call.
def ruleMidStage(mname: String, drives: List[DriveSrc], decls: List[GDecl], ri: String, rnext: String): Unit =
    midStageScan(drives, mname, decls, ri, rnext)

/// Extends the chain from `cur` in domain `D`: repeatedly takes `chainNextOf`, stopping on `None`, on a stage already in `acc` (cycle guard), or when `depth` reaches zero (the caller passes 8).
/// Stages are CONSED onto `acc`, so the raw result is reverse order - `cdcEdgeVerdict` reverses it back.
def chainWalk(drives: List[DriveSrc], decls: List[GDecl], mdcd: ClockDomain, cur: String, D: ClockDomain, depth: Nat, acc: List[String]): List[String] = match depth {
    case zero => acc
    case succ(m) =>
        match chainNextOf(drives, decls, mdcd, cur, D) {
            case None => acc
            case Some(next) => match cdcStrIn(next, acc) {
                case true => acc
                case false => chainWalk(drives, decls, mdcd, next, D, m, lcons next acc)
            }
        }
}

/// R0 head qualification part 2: its single drive reads exactly ONE source.
def srcCountOf(srcs: List[CondSrc], acc: Nat): Nat = match srcs {
    case lnil => acc
    case lcons(_, t) => srcCountOf(t, succ(acc))
}

/// Source count of `name`'s unconditional clocked drive; 0 when there is no such drive (conditional clocked drives are not counted).
def headDriveSrcCount(drives: List[DriveSrc], name: String): Nat = match drives {
    case lnil => 0
    case lcons(d, t) => match chkBand(d.clocked, str_eq(d.target, name)) {
        case true => match d.enable {
            case lnil => srcCountOf(d.srcs, 0)
            case _ => headDriveSrcCount(t, name)
        }
        case false => headDriveSrcCount(t, name)
    }
}

/// Full chain-head qualification: a single uncond clocked drive AND that drive reads exactly one source.
def headQualified(drives: List[DriveSrc], name: String): Boolean =
    chkBand(singleUncondClockedDrive(drives, name), countIsOne(headDriveSrcCount(drives, name)))

/// `n >= 2`, i.e. the identified chain has at least two stages. Byte-identical to `natGtOne`; the two names only document the different call sites (chain stage count vs signal width).
def chainLen(n: Nat): Boolean = match n {
    case zero => false
    case succ(m) => match m {
        case zero => false
        case _ => true
    }
}

/// `n > 1` in Peano form (no Nat is forced); used on a GROUND width to decide whether an HDL038 crossing is multi-bit.
def natGtOne(n: Nat): Boolean = match n {
    case zero => false
    case succ(m) => match m {
        case zero => false
        case _ => true
    }
}

/// Length of the identified chain; its result is what `chainLen` classifies.
def chainCount(ls: List[String], acc: Nat): Nat = match ls {
    case lnil => acc
    case lcons(_, t) => chainCount(t, succ(acc))
}

/// Consecutive-pair walk over the identified chain for HDL039.
def midPairs(mname: String, drives: List[DriveSrc], decls: List[GDecl], chain: List[String]): Unit = match chain {
    case lnil => unit
    case lcons(a, t) =>
        let _ = match t {
            case lcons(b, _) => ruleMidStage(mname, drives, decls, a, b)
            case _ => unit
        };
        midPairs(mname, drives, decls, t)
}

// One CDC edge's verdicts. heads = already-identified chain heads (dedup).
// Returns the updated heads list.
//
// NOTE (task-3 audit): the design sketch (§5.3) reads as "the walk only
// starts when the edge target qualifies as a chain head (single uncond
// clocked drive, single src)". The code's skip test is
// `chkBand(cdcStrIn(e.dst, heads), headQualified(drives, e.dst))` — an AND of
// "already recorded as a head" and "still qualifies" — so a target that does
// NOT qualify but is also not yet recorded is walked anyway. Whether that is
// intended (the unqualified target simply gets no HDL038/HDL039 verdicts) or
// is a gap in head qualification needs a design decision; the comment
// documents the code as written.
/// Processes one CDC edge. The skip test is `chkBand(cdcStrIn(e.dst, heads), headQualified(drives, e.dst))`, so the walk is skipped only when the target is ALREADY a recorded head AND still qualifies - an unqualified, not-yet-recorded target is walked too.
/// On the walk path it starts the chain at the edge target in the edge's source domain, reverses `chainWalk`'s prepend order into source order, and when the chain has at least 2 stages it emits HDL038 for a ground multi-bit target, runs the HDL039 mid-stage pairs, and records the target as a head. Returns the (possibly extended) head list.
def cdcEdgeVerdict(mname: String, drives: List[DriveSrc], decls: List[GDecl], mdcd: ClockDomain, ground: Boolean, e: CdcEdge, heads: List[String]): List[String] =
    match chkBand(cdcStrIn(e.dst, heads), headQualified(drives, e.dst)) {
        case true => heads
        case false =>
            let seed: List[String] = lcons e.dst cdcStrEmpty;
            // chainWalk conses each stage onto the front, so the raw result
            // is [Rk ... R1, R0]; reverse to source order before pairing.
            let chain = strReverse(chainWalk(drives, decls, mdcd, e.dst, e.dstDom, 8, seed), cdcStrEmpty);
            let n = chainCount(chain, 0);
            match chainLen(n) {
                case true =>
                    // Identified 2FF synchronizer: this edge's crossing is
                    // exempt from HDL037. Width check -> HDL038; mid-stage
                    // readers -> HDL039.
                    let _ = match ground {
                        case true =>
                            match gdeclWidthOf(decls, e.dst) {
                                case None => unit
                                case Some(w) => match nat_is_ground(w) {
                                    case true => match natGtOne(w) {
                                        case true =>
                                            let _ = chkReport("HDL038", mname, e.dst, "multi-bit (" + nat_to_dec(w) + ") signal crossed to " + e.dstDom.clockName + " through a 2-FF synchronizer — Gray coding required");
                                            unit
                                        case false => unit
                                    }
                                    case false => unit
                                }
                            }
                        case false => unit
                    };
                    let _ = midPairs(mname, drives, decls, chain);
                    lcons e.dst heads
                case false => heads
            }
    }

/// HDL037 for an edge whose target is not an identified chain head.
def reportHdl037(mname: String, e: CdcEdge, qualified: Boolean): Unit =
    let kind = match e.srcReg {
        case true => "registered"
        case false => "combinational"
    };
    let suffix = match qualified {
        case true => " (chain length 1)"
        case false => ""
    };
    let _ = chkReport("HDL037", mname, e.dst, "register '" + e.dst + "' (" + e.dstDom.clockName + ") samples " + kind + " '" + e.src + "' (" + e.srcDom.clockName + ") without a synchronizer chain" + suffix);
    unit

// Full CDC pass: HDL036 + HDL037/038/039.
/// Walks the CDC edge list in order: each edge gets `cdcEdgeVerdict` (which may claim its target as a chain head), and an edge whose target is still not a head gets the HDL037 report. Heads accumulate across the whole list, so one chain is only reported once.
def cdcVerdicts(mname: String, drives: List[DriveSrc], decls: List[GDecl], mdcd: ClockDomain, ground: Boolean, edges: List[CdcEdge], heads: List[String]): Unit = match edges {
    case lnil => unit
    case lcons(e, t) =>
        let heads2 = cdcEdgeVerdict(mname, drives, decls, mdcd, ground, e, heads);
        let _ = match cdcStrIn(e.dst, heads2) {
            case true => unit
            case false =>
                let _ = reportHdl037(mname, e, headQualified(drives, e.dst));
                unit
        };
        cdcVerdicts(mname, drives, decls, mdcd, ground, t, heads2)
}
/// Full CDC pass: build the edge list with `cdcEdgesOf`, then run the verdicts. `ground` gates only HDL038, the width-sensitive part.
def ruleCdc(mname: String, decls: List[GDecl], drives: List[DriveSrc], entries: List[DomEntry], mdcd: ClockDomain, ground: Boolean): Unit =
    let edges = cdcEdgesOf(drives, decls, entries, mdcd, cdcListEmpty);
    let _ = cdcVerdicts(mname, drives, decls, mdcd, ground, edges, cdcStrEmpty);
    unit

// ---------- entry (design §2.1) ----------




// ---------- HDL042: same-name second module registration (P3-10) ----------
// ModuleRegistry dedups by NAME, first def wins (hdl-core). Two
// parameterizations of one parametric module (myAdder[8] / myAdder[16])
// collide: designVL emits ONE def and every later instance silently connects
// to the wrong port widths. This rule makes the collision visible.
//
// WHY A SEPARATE "ModuleSigs" TABLE (probe-verified): the registry's stored
// def is unusable as a comparison baseline - the class-field replay rounds
// re-wrap statements with WhenStack residue (doubled declarations), and the
// FIRST-registered def of a width-parametric module is the Phase-A round
// whose widths are stuck at check time (designVL can FORCE them later, the
// check must not - the phase234 red line). So the rule keeps its own
// name -> (clock domain, ground PORT keys) record: the FIRST ground
// round of a name records; later ground rounds whose key set (order- and
// duplicate-insensitive) or clock domain differs warn. Replays of one
// parameterization always match and stay silent; reports collapse at the
// CheckIssues line-level dedup. See isPortKind for why the keys are ports
// (internal declarations are round-unstable).

/// One port's HDL042 signature: the port name plus its ground width.
struct DeclKey {
    name: String
    width: Nat
}

/// Typed empty `List[DeclKey]` seed for the HDL042 signature.
def declKeysEmpty: List[DeclKey] =
    let e: List[DeclKey] = lnil;
    e

/// HDL042 keys are PORT declarations only. The reported failure mode is an
/// instance connecting to the wrong port widths (designVL emits one def per
/// name), and ports are the one part of the declaration set that is stable
/// across the checker's repeated rounds - the ground gate below already
/// guarantees a round only reaches the rule when its widths are ground, and the
/// runtime round's port widths are always ground (see the HDL004 note in
/// hdl-check.typort). INTERNAL declarations are not stable: a for-loop body's
/// `let x` materializes as `x` in one round and as x_0..x_n in another (the same
/// residue that makes the leaf rules re-run every round), and their widths can
/// be ground in one round and stuck in the next. Counting them made a module
/// that was never re-parameterized look like a second registration with a
/// different signature (review-1 F1: a port-less for-loop module warned HDL042
/// twice on the twin engine while the reference engine stayed silent).
def isPortKind(k: SigKind): Boolean = match k {
    case kIn => true
    case kOut => true
    case kInOut => true
    case kOutReg => true
    case _ => false
}

/// Extracts this round's HDL042 signature from the module's statements: PORT declarations only (`isPortKind`) whose width is GROUND - internal declarations are excluded because their names and widths are round-unstable.
/// Keys are accumulated in reverse order; `keysEqual` is order- and duplicate-insensitive.
def declKeysOf[ne: Nat](es: Vec[Expr] ne, acc: List[DeclKey]): List[DeclKey] = match es {
    case nil => acc
    case cons(h, t) =>
        match gDeclOf(h) {
            case None => declKeysOf(t, acc)
            case Some(gd) => match isPortKind(gd.kind) {
                case false => declKeysOf(t, acc)
                case true => match gd.width {
                    case None => declKeysOf(t, acc)
                    case Some(w) => match nat_is_ground(w) {
                        case true => declKeysOf(t, lcons (DeclKey.mk(gd.name, w)) acc)
                        case false => declKeysOf(t, acc)
                    }
                }
            }
        }
}

/// same name AND same width (natNeq on ground widths only)
def keysContain(keys: List[DeclKey], nm: String, w: Nat): Boolean = match keys {
    case lnil => false
    case lcons(k, t) =>
        match str_eq(k.name, nm) {
            case true => match natNeq(k.width, w) {
                case true => keysContain(t, nm, w)
                case false => true
            }
            case false => keysContain(t, nm, w)
        }
}

/// True iff every key of `keys` appears in `against` with the same width; `against` may hold EXTRA keys.
def allKeysMatch(keys: List[DeclKey], against: List[DeclKey]): Boolean = match keys {
    case lnil => true
    case lcons(k, t) =>
        match keysContain(against, k.name, k.width) {
            case true => allKeysMatch(t, against)
            case false => false
        }
}

/// Mutual containment of two signatures - order- and duplicate-insensitive equality.
def keysEqual(a: List[DeclKey], b: List[DeclKey]): Boolean =
    chkBand(allKeysMatch(a, b), allKeysMatch(b, a))

/// The HDL042 record of one module name: its clock domain plus the ground port signature recorded in the first ground round.
struct ModuleSigRec {
    name: String
    cd: ClockDomain
    keys: List[DeclKey]
}

/// Mutable-global names must equal their type name (ModuleRegistry et al.):
/// the wrapper struct carries the record list under the global "ModuleSigs".
struct ModuleSigs {
    recs: List[ModuleSigRec]
}

/// Empty `ModuleSigs` seed; the global must be a struct whose type name equals the global name.
def moduleSigsFresh: ModuleSigs =
    let r: List[ModuleSigRec] = lnil;
    ModuleSigs.mk(r)

/// Looks up a module's HDL042 record.
def sigRecFind(recs: List[ModuleSigRec], name: String): Option[ModuleSigRec] = match recs {
    case lnil => None
    case lcons(r, t) => match str_eq(r.name, name) {
        case true => Some(r)
        case false => sigRecFind(t, name)
    }
}

/// Removes every record for the name - the drop half of the upsert.
def sigRecDrop(recs: List[ModuleSigRec], name: String): List[ModuleSigRec] = match recs {
    case lnil => recs
    case lcons(r, t) => match str_eq(r.name, name) {
        case true => sigRecDrop(t, name)
        case false => lcons r (sigRecDrop(t, name))
    }
}

/// Upsert: prepends the new record after dropping any older record for the same module name.
def sigRecUpsert(recs: List[ModuleSigRec], rec: ModuleSigRec): List[ModuleSigRec] =
    lcons rec (sigRecDrop(recs, rec.name))

/// HDL042: on the first ground round of a module name it records `(clock domain, ground port keys)`; on any later ground round whose signature differs in port keys (order-insensitive) or clock domain it reports the collision, because `ModuleRegistry` dedups by name and the first def wins. Identical re-registrations stay silent.
def ruleRegistryCollision[ne: Nat](mname: String, cd: ClockDomain, es: Vec[Expr] ne): Unit =
    let fresh = declKeysOf(es, declKeysEmpty);
    let sigs: ModuleSigs = get_global_default("ModuleSigs", moduleSigsFresh);
    match sigRecFind(sigs.recs, mname) {
        case None =>
            let _ = change_mutable_default("ModuleSigs", x => ModuleSigs.mk(sigRecUpsert(x.recs, ModuleSigRec.mk(mname, cd, fresh))), moduleSigsFresh);
            unit
        case Some(prev) =>
            match chkBand(keysEqual(fresh, prev.keys), chkCdEq(cd, prev.cd)) {
                case true => unit
                case false => chkReport("HDL042", mname, mname, "second registration under the same module name with a different declaration signature (port widths / clock domain) is ignored (first def wins, designVL emits one def per name) - declare the second parameterization as its own module")
            }
    }

/// Number of statements in the module's statement `Vec`.
def cntVec[ne: Nat](es: Vec[Expr] ne, acc: Nat): Nat = match es {
    case nil => acc
    case cons(_, t) => cntVec(t, succ(acc))
}

/// Number of statement keys `scanAllEx` recorded - EVERY statement, duplicates included.
def seenLen(ls: List[String], acc: Nat): Nat = match ls {
    case lnil => acc
    case lcons(_, t) => seenLen(t, succ(acc))
}

/// Ground-Nat equality written as `a <= b && b <= a`; `checkModuleAll` uses it for the `dupFree` gate.
def bothWaysLe(a: Nat, b: Nat): Boolean =
    chkBand(chkNatLe(a, b), chkNatLe(b, a))

/// The whole per-module pipeline: scan -> reverse into source order -> dedup drives -> register the port table -> ground gate -> `rangeSafe` -> phase-1 `runChecks` -> HDL042 (ground rounds only) -> internal + cross edges -> Rust `check_comb_cycles` -> register the comb summary -> domain fixpoint -> HDL036 + CDC -> HDL033 (ground + dupFree) -> HDL032/034/035 and HDL041.
/// `dupFree` is in fact constant-true (`scanAllEx` records every key), so the leaf-sensitive rules do run every round; their replay correctness comes from `nlDedup` + `dedupDrives` + the drain's line dedup.
def checkModuleAll(md: ModuleDef): Unit =
    let acc0 = scanAllEx(md.expr, graphAccFresh);
    // prepend-order -> statement order (later statements were prepended).
    // Edge/driver ORDER is observable: the cycle report names the FIRST
    // statement's signal as the ring head, and HDL035's shadowing is
    // source-order sensitive. dropShadowedWires also expects creation order
    // (wire first, port later). Phase-1's runChecks keeps its own scan.
    let acc = GraphAcc.mk(dedupDrives(drvReverse(acc0.drives, drvListEmpty)), connReverse(acc0.conns, connEmpty), instReverse(acc0.insts, instEmpty), gdeclReverse(acc0.decls, gdeclEmpty), acc0.seen, acc0.key, acc0.pending);
    let _ = registerPortTable(md.name, dropShadowedWires(sigDeclsOf(acc.decls)));
    // Phase-3 value gate (design §4.6): a round with zero ground widths is
    // the Phase-A throwaway tree - value-sensitive rules (HDL033/038) skip
    // it. Pure scan, no globals: safe in every round.
    let wscan = widthScanAll(md.expr, WidthScan.mk(0, lnil));
    let ground = match wscan.groundCount {
        case zero => false
        case succ(_) => true
    };
    let rangeSafe = rangeSafeOf(acc.drives);
    let _ = runChecks(md, rangeSafe);
    // HDL042: this round's own registration happens AFTER checkModuleAll
    // returns (checkModuleTreeAll), so the registry here holds exactly the
    // PREVIOUS rounds/modules - a name collision seen now is real. Ground
    // gate keeps the Phase-A throwaway rounds out of the comparison.
    let _ = match ground {
        case true => ruleRegistryCollision(md.name, md.cd, md.expr)
        case false => unit
    };
    let named = chkBnot(str_eq(md.name, ""));
    // Comb cycles + cross-layer passthrough summary: name-level and
    // residue-immune -> run EVERY round (the create round's drive graph and
    // cross edges are the complete ones; earlier rounds degrade silently
    // and identical lines collapse at the drain).
    let internal = edgesOfDrives(acc.drives, combEdgesFresh);
    let _ = change_mutable_default("ModuleCombSummary", x => x, ModuleCombSummary.mk(lnil));
    let summary: ModuleCombSummary = get_global("ModuleCombSummary");
    let cross = crossEdges(acc.conns, acc.conns, acc.insts, summary.entries, combEdgesFresh);
    let all = ceAppend(internal, cross);
    let _ = check_comb_cycles(md.name, joinEdges(all, ""));
    let _ = match named {
        case true => registerCombSummary(buildCombSummary(md.name, acc.decls, all))
        case false => unit
    };
    // Phase 4: CDC - domain fixpoint, then HDL036/037/038/039. Needs GROUND
    // ClockDomain values (only the create round carries them): earlier
    // rounds hold neutral cd values, the edges never form, and the pass
    // degrades to a no-op.
    let entries0 = domInitEntries(acc.decls, acc.drives, md.cd, domListEmpty);
    let entries = domFix(entries0, acc.drives, driveRoundBudget(acc.drives, 0));
    let _ = ruleDomMix(md.name, acc.decls, entries);
    let _ = ruleCdc(md.name, acc.decls, acc.drives, entries, md.cd, ground);
    // Leaf-sensitive rules (HDL032/033/034/035) round gate. REDUNDANT
    // INSURANCE, not a live defense (review 2026-09-27): scanAllEx records
    // EVERY statement key into `seen` unconditionally (dups included), so
    // seenLen(acc.seen) == cntVec(md.expr) always and `dupFree` is
    // constant-true — the leaf rules in fact run in every round. What
    // actually carries their correctness across the WhenStack-residue replay
    // rounds (structurally identical to genuinely dead user conditions) is:
    // nlDedup (enable canonicalization at scanStmtEx) + dedupDrives
    // ((target,rhsKey) first-copy-wins, keeping the clean round-1 copy) +
    // the CheckIssues line-level dedup at the drain. Comb-cycle/CDC rules
    // above are name/domain-level and residue-immune for the same reason.
    let dupFree = bothWaysLe(cntVec(md.expr, 0), seenLen(acc.seen, 0));
    let _ = match chkBand(ground, dupFree) {
        case true => ruleRangeOverlap(md.name, acc.drives)
        case false => unit
    };
    let _ = match dupFree {
        case true =>
            let _ = ruleLatch(md.name, acc.decls, acc.drives);
            let _ = ruleDeadCond(md.name, acc.drives);
            let _ = ruleShadow(md.name, acc.drives);
            let _ = oobScanAll(md.expr, md.name, acc.decls);
            unit
        case false => unit
    };
    unit

/// The macros' `_res` entry point (the design's entry inversion): takes the tree's head module def, runs the full analysis only when its name is non-empty, then re-registers the tree and returns it UNCHANGED - the checks report through `chkReport` instead of rewriting the tree.
def checkModuleTreeAll(t: ModuleTree): ModuleTree =
    let md = headModuleDef(t.data);
    let skip = str_eq(md.name, "");
    let _ = match skip {
        case true => unit
        case false => checkModuleAll(md)
    };
    let _ = registerModuleTree(t);
    t
