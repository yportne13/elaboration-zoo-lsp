//! Miscellaneous HDL I/O helpers (inout, tri-state).
// ============================================================
//  HDL io / math / logic / fsm —— SpinalHDL lib/io、lib/math、
//  lib/logic、lib/fsm 复刻（Wave 5）
// ============================================================

// ============================================================
//  io/TriState —— 三态（read/write/writeEnable）
// ============================================================

/// Bidirectional (tri-state) buffer bundle, one `writeEnable` for the whole
/// word: `read` is the value sampled from the pad, `write` is the value to
/// drive, and `writeEnable` high means the bundle drives `write` onto the pad
/// while low leaves the pad floating for an external driver (the Verilog side
/// is an `inout` port; this struct only groups the three signals).
struct TriStateBits[w: Nat] {
    read: Bits[w]
    write: Bits[w]
    writeEnable: Bool
}

/// Master view of `TriStateBits[w]`: the master drives `write` and
/// `writeEnable` (outputs) and samples `read` (input).
def triStateAsMasterBits[bn: BindingName][w: Nat](t: TriStateBits[w]): TriStateBits[w] =
    TriStateBits.mk(in_b(t.read), out_b(t.write), out_bool(t.writeEnable))

/// Slave view of `TriStateBits[w]`: direction flip of
/// `triStateAsMasterBits` — samples `write`/`writeEnable`, drives `read`.
def triStateAsSlaveBits[bn: BindingName][w: Nat](t: TriStateBits[w]): TriStateBits[w] =
    TriStateBits.mk(out_b(t.read), in_b(t.write), in_bool(t.writeEnable))

/// Per-bit tri-state array: each of the `w` lanes has its own
/// `writeEnable` bit, so a subset of the bus can float while the rest is
/// driven. `read`/`write`/`writeEnable` are all `w` bits wide.
struct TriStateArray[w: Nat] {
    read: Bits[w]
    write: Bits[w]
    writeEnable: Bits[w]
}

/// Master view of `TriStateArray[w]`: drives `write`/`writeEnable` bit-wise,
/// samples `read`.
def triStateArrayAsMaster[bn: BindingName][w: Nat](t: TriStateArray[w]): TriStateArray[w] =
    TriStateArray.mk(in_b(t.read), out_b(t.write), out_b(t.writeEnable))

/// Slave view of `TriStateArray[w]`: direction flip of
/// `triStateArrayAsMaster`.
def triStateArrayAsSlave[bn: BindingName][w: Nat](t: TriStateArray[w]): TriStateArray[w] =
    TriStateArray.mk(out_b(t.read), in_b(t.write), in_b(t.writeEnable))

/// Open-drain line with a read-back: `write` is the value the module pulls
/// down (drain), `read` is the pad level. There is deliberately no
/// `writeEnable` — an open-drain pad is either driven low or released, which
/// the surrounding `inout` port modelling decides.
struct ReadableOpenDrain {
    read: Bool
    write: Bool
}

/// Master view of `ReadableOpenDrain`: samples `read`, drives `write`.
def rodAsMaster[bn: BindingName](t: ReadableOpenDrain): ReadableOpenDrain =
    ReadableOpenDrain.mk(in_bool(t.read), out_bool(t.write))

/// Slave view of `ReadableOpenDrain`: direction flip of `rodAsMaster` —
/// drives `read`, samples `write`.
def rodAsSlave[bn: BindingName](t: ReadableOpenDrain): ReadableOpenDrain =
    ReadableOpenDrain.mk(out_bool(t.read), in_bool(t.write))

// ============================================================
//  io/Gpio —— 简单 GPIO（输入采样 + 输出驱动 + 中断挂起）
// ============================================================

/// GPIO bundle: the physical pad group plus the internal registers the core
/// logic uses. `pin_read` is the sampled pad input, `pin_write` /
/// `pin_writeEnable` drive the pad, `input` receives the registered sample,
/// `output` / `outputEnable` are the caller's output registers the core reads,
/// and `interrupts` receives the pending-interrupt bits. Only `pin_read`,
/// `output` and `outputEnable` are inputs to `gpioCtrl`; everything else is
/// driven by it.
struct GpioIO[w: Nat] {
    pin_read: Bits[w]
    pin_write: Bits[w]
    pin_writeEnable: Bits[w]
    input: Bits[w]          // 采样后的输入（寄存器）
    output: Bits[w]         // 输出寄存器
    outputEnable: Bits[w]   // 输出使能寄存器
    interrupts: Bits[w]     // 中断挂起
}

/// GPIO core logic, one bit per pin. Per clock: (1) `pin_read` is sampled into
/// an internal register (`<bn>_input`, init 0) which drives `io.input` — so
/// `io.input` lags the pad by one cycle, matching the field's "sampled input"
/// contract; (2) `io.pin_write := io.output` and
/// `io.pin_writeEnable := io.outputEnable` pass the caller's registers to the
/// pad (the pad itself floats when the enable is low); (3) `interrupts` is a
/// **sticky pending** register (`<bn>_pend`) set on a rising edge of
/// `pin_read` (edge against the previous sample) and cleared per-bit by
/// `clearInterrupt`, so a pulse shorter than the sampling period is still
/// captured. Note the first cycle after reset already counts as a rising edge
/// if `pin_read` is high then. `clearInterrupt` has precedence over the set.
def gpioCtrl[bn: BindingName][w: Nat](io: GpioIO[w], clearInterrupt: Bits[w]): Unit =
    // 采样寄存器：每个时钟沿把 pad 采进 input
    let sampled = newBitsRegInitNatNamed(bn.name + "_input", w, 0);
    let _ = createSignalExpr("", regAssign(sampled.zz_expr, io.pin_read.zz_expr));
    let _ = io.input := sampled;
    // 输出使能时驱动引脚写，否则高阻（inout 语义由上层决定）
    let _ = io.pin_write := io.output;
    let _ = io.pin_writeEnable := io.outputEnable;
    // 中断挂起：上升沿（pin_read 高、上一拍采样低）置位；clearInterrupt 清零
    let pend = newBitsRegInitNatNamed(bn.name + "_pend", w, 0);
    let rise = binary(io.pin_read.zz_expr, "&", unary("~", sampled.zz_expr));
    let _ = createSignalExpr("", regAssign(pend.zz_expr,
        binary(binary(pend.zz_expr, "|", rise), "&", unary("~", clearInterrupt.zz_expr))));
    let _ = io.interrupts := pend;
    unit

// ============================================================
//  math/Bcd —— BCD 编码（4-bit digit 向量）
//  BCD 加法：和 > 9 时 +6 修正
// ============================================================

/// Result of a single-digit BCD addition: `sum` is the corrected low BCD digit
/// (4 bits) and `carry` is the decimal carry out (1 when the raw digit sum
/// exceeded 9). Both are combinationally derived by `bcdAddDigit`.
struct BcdAddResult {
    sum: UInt[4]
    carry: Bool
}

/// One-digit BCD adder: computes `a + b + carryIn` in 5 bits (`a +^ b` keeps
/// the carry-out bit), adds the `+6` correction when the sum is greater than
/// 9, and reports `carry = (sum > 9)`. `sum` is the corrected digit (the
/// Verilog assignment truncates the 5-bit corrected value to the low nibble,
/// which is exactly `raw - 10` for the >9 cases); `carry` must be fed into the
/// next digit's `carryIn`. Matches the `vBcdAdd` reference in
/// tools/spinalhdl-verify/verify.py (all 512 input combinations).
def bcdAddDigit(a: UInt[4], b: UInt[4], carryIn: Bool): BcdAddResult =
    let s = a +^ b;
    let sWithCarry = UInt.mk[5](None, binary(s.zz_expr, "+", Expr.mux(carryIn.zz_expr, literal(1), literal(0))));
    // 和 > 9 或进位 → +6 修正
    let over9 = binary(sWithCarry.zz_expr, ">", literal(9));
    let corrected = UInt.mk[5](None, binary(sWithCarry.zz_expr, "+", Expr.mux(over9, literal(6), literal(0))));
    BcdAddResult.mk(UInt.mk(None, corrected.zz_expr), Bool.mk(None, over9))

/// A `d`-digit BCD value: `d` four-bit digits packed into one `Bits[d * 4]`
/// vector, digit 0 in the low nibble (the layout `bcdAddDigit` cascades over).
/// Pure value — it emits no hardware; `bcdIsZero` and `bcdAddDigit` do the
/// checking/arithmetic.
struct Bcd[d: Nat] {
    digits: Bits[d * 4]
}

/// All-zero test on the whole packed digit vector (`digits == 0`), i.e. every
/// BCD digit is zero. Works for any digit count without unpacking.
def bcdIsZero[d: Nat](b: Bcd[d]): Bool =
    Bool.mk(None, binary(b.digits.zz_expr, "==", literal(0)))

/// **Stub — not a multi-digit adder**: returns `a` unchanged, ignoring `b`.
/// Only the single-digit `bcdAddDigit` (above) is a working BCD adder; a
/// generic `d`-digit ripple cannot be written here because a helper whose
/// result width grows with the digit index (`Bits[i * 4]`) needs reducible
/// type-level arithmetic on a rigid `Nat` parameter, which the elaborator does
/// not support (docs/spinalhdl-lib-replication.md §3 known limitation 5).
/// Callers needing multi-digit BCD addition must cascade `bcdAddDigit` per
/// digit themselves and propagate `carry`.
def bcdAdd[d: Nat](a: Bcd[d], b: Bcd[d]): Bcd[d] = a

// ============================================================
//  math/Divider —— 恢复除法（UnsignedDivider 简化版）
//  状态机：cmd.valid → 计算 → rsp.valid
// ============================================================

/// Divider command port: `valid` starts an operation when the core is idle,
/// `numerator`/`denominator` carry the operands. `ready` is part of the
/// interface for symmetry with SpinalHDL's `Flow`-style handshake but the
/// core never drives it — the actual command-accept signal is
/// `DividerFSM.cmdReady` (== `!busy`), so a caller must read `cmdReady`
/// instead of `cmd.ready`.
struct DividerCmd[w: Nat] {
    valid: Bool
    numerator: UInt[w]
    denominator: UInt[w]
    ready: Bool
}

/// Divider response port: `valid` pulses for one cycle when
/// `quotient`/`remainder` are final; both values stay stable during that
/// cycle and the core ignores new commands while `valid` is not asserted.
struct DividerRsp[w: Nat] {
    valid: Bool
    quotient: UInt[w]
    remainder: UInt[w]
}

/// Combinational status outputs of `dividerCore`: `busy` (operation running),
/// `cmdReady` (`!busy`, accept a new `cmd.valid` next cycle), `rspValid`
/// (one-cycle response strobe) plus the quotient/remainder of the last
/// completed operation.
struct DividerFSM[w: Nat] {
    busy: Bool
    cmdReady: Bool
    rspValid: Bool
    quotient: UInt[w]
    remainder: UInt[w]
}

/// Serial restoring divider, one quotient bit per clock: on
/// `cmd.valid && !busy` it loads `rem = {1'b0, numerator}` and clears the
/// quotient; each busy cycle shifts `rem` left, subtracts the (zero-extended)
/// denominator when `rem >= {1'b0, denominator}` and shifts a 1 into the
/// quotient's LSB; after exactly `w` steps (`cnt == w - 1`) `busy` drops and
/// `rsp.valid` pulses for that cycle. **No divide-by-zero handling**: with
/// `denominator == 0` the comparison is always true and the result is
/// meaningless. `w` must be the operand width; the step counter is
/// `maxNat(1, log2Up(w + 1))` bits wide, the remainder register `w + 1`.
def dividerCore[bn: BindingName][w: Nat](cmd: DividerCmd[w], rsp: DividerRsp[w]): DividerFSM[w] =
    // 计数器
    let cnt = newUIntRegInitNatNamed(bn.name + "_cnt", maxNat(1, log2Up(w + 1)), 0);
    let busy = newBoolRegInitNatNamed(bn.name + "_busy", 0);
    let rem = newUIntRegInitNatNamed(bn.name + "_rem", w + 1, 0);
    let quo = newUIntRegInitNatNamed(bn.name + "_quo", w, 0);
    // 启动：cmd.valid && !busy → 装载
    let _ = whenBegin(binary(cmd.valid.zz_expr, "&&", unary("!", busy.zz_expr)));
    let _ = createSignalExpr("", regAssign(busy.zz_expr, literal(1)));
    let _ = createSignalExpr("", regAssign(cnt.zz_expr, literal(0)));
    let _ = createSignalExpr("", regAssign(rem.zz_expr, binary(literal(0), "##", cmd.numerator.zz_expr)));
    let _ = createSignalExpr("", regAssign(quo.zz_expr, literal(0)));
    let _ = whenEnd(unit);
    // 恢复除法步进：rem = rem << 1；if rem >= den: rem -= den; quo.lsb = 1
    let shifted = binary(rem.zz_expr, "<<", literal(1));
    let denExt = binary(literal(0), "##", cmd.denominator.zz_expr);
    let ge = binary(shifted, ">=", denExt);
    let newRem = Expr.mux(ge, binary(shifted, "-", denExt), shifted);
    let newQuo = binary(binary(quo.zz_expr, "<<", literal(1)), "|", Expr.mux(ge, literal(1), literal(0)));
    let _ = whenBegin(busy.zz_expr);
    let _ = createSignalExpr("", regAssign(rem.zz_expr, newRem));
    let _ = createSignalExpr("", regAssign(quo.zz_expr, newQuo));
    let _ = createSignalExpr("", regAssign(cnt.zz_expr, binary(cnt.zz_expr, "+", literal(1))));
    let _ = whenEnd(unit);
    // 完成：cnt == w-1 → 输出
    let done = binary(cnt.zz_expr, "==", literal(pred w));
    let _ = whenBegin(binary(busy.zz_expr, "&&", done));
    let _ = createSignalExpr("", regAssign(busy.zz_expr, literal(0)));
    let _ = whenEnd(unit);
    let _ = rsp.valid := Bool.mk(None, binary(busy.zz_expr, "&&", done));
    let _ = rsp.quotient := UInt.mk(None, quo.zz_expr);
    let _ = rsp.remainder := UInt.mk(None, partsel(rem.zz_expr, literal(pred w), literal(0)));
    DividerFSM.mk(busy,
        Bool.mk(None, unary("!", busy.zz_expr)),
        Bool.mk(None, binary(busy.zz_expr, "&&", done)),
        UInt.mk(None, quo.zz_expr), UInt.mk(None, partsel(rem.zz_expr, literal(pred w), literal(0))))

// ============================================================
//  logic/Decoder —— onehot 解码（DecodingSpec 简化版）
//  输入 onehot 位串，输出对应索引（无效输入 → 0）
// ============================================================

/// One-hot to index decoder: the returned index has width
/// `maxNat(1, log2Up width)` and is computed as the bitwise OR of the indices
/// of all set input lines. Its result is therefore only an "index" for a legal
/// one-hot (or all-zero → 0) input; a multi-hot input yields the OR of the set
/// positions rather than 0, so normalize with `ohLegal` / `ohFirst` (hdl-utils)
/// first if the input can be multi-hot. Thin alias of `ohToUInt`.
def decoderOhToUInt[width: Nat](oh: Bits[width]): UInt[maxNat(1, log2Up width)] =
    ohToUInt(oh)

/// Priority-select decode: returns the value bound to the **lowest** set line
/// of `oh` (first hit wins, `priorityMux` semantics), or `dflt` when no line is
/// set. `values` must be exactly `w` entries and `vw` is their value width.
def decoderValueUInt[w: Nat, vw: Nat](oh: Bits[w], values: Vec[UInt[vw]] w, dflt: UInt[vw]): UInt[vw] =
    priorityMux(oh, values, dflt).into

// ============================================================
//  logic/Masked —— 掩码模式（纯值 + 硬件比较）
//  Masked(value, care)：与硬件值的掩码相等比较
// ============================================================

/// Elaboration-time mask pattern: `value` holds the expected pattern and
/// `care` the bits that matter (1 = compare this bit). Both are plain `Nat`s,
/// so a `Masked` value is used as a constant in hardware comparisons
/// (`maskedEq`) and as a pure predicate (`maskedCovers`).
struct Masked {
    value: Nat
    care: Nat
}

/// Hardware masked equality: emits `(hard & care) == value`. Note the
/// right-hand side is the **raw** `m.value` — it is *not* re-masked with
/// `care` — so callers must guarantee that `value` has no bits outside `care`
/// (the `Masked.mk(2, 6)` pattern in the verification corpus satisfies this:
/// 2 & 6 == 2). With stray bits set the comparison can never be true.
def maskedEq[width: Nat](hard: Bits[width], m: Masked): Bool =
    Bool.mk(None, binary(binary(hard.zz_expr, "&", literal(m.care)), "==", literal(m.value)))

/// Pure (elaboration-time) coverage predicate: with saturating `nat_sub` it is
/// `m.value <= x.value` — it compares only the two `value` fields and ignores
/// `care` entirely (`nat_sub a 0 == a` by construction). Intended for
/// checking that pattern `x` covers pattern `m` when care == value (full
/// masks); with partial care the numeric comparison is not a bit-set test.
def maskedCovers(m: Masked, x: Masked): Boolean =
    nat_eq (nat_sub (nat_sub m.value x.value) 0) 0

// ============================================================
//  fsm/StateMachine —— 状态机框架（简化版，SpinalHDL fsm 语义）
//  state 寄存器 + 转移表（when/switch 驱动）
// ============================================================

/// Single-register state machine handle: `state` is the state register
/// itself; drive transitions with `stateGoto` (usually inside a `when`) and
/// test the current state with `stateIs`.
struct StateMachine[w: Nat] {
    state: UInt[w]
}

/// Creates the state register (`<bn>` as the let-binding name, async-reset
/// init 0) and wraps it. `w` is the register width and is **independent of**
/// `stateCount`: the argument is documentation only — the register width is
/// whatever `w` the caller passes, so write the width as `maxNat(1,
/// log2Up stateCount)` yourself (the example `20-misc.typort` instantiates
/// `stateMachine` with width 2 for 4 states). No width check is performed; `w`
/// smaller than `log2Up stateCount` silently truncates states.
def stateMachine[w: Nat][bn: BindingName](stateCount: Nat): StateMachine[w] =
    let st = newUIntRegInitNatNamed(bn.name, w, 0);
    StateMachine.mk(st)

/// Transition to `target` (a literal state ordinal): records the clocked
/// assignment `state <= target`. It is **unconditional**, so wrap the call in
/// a `when`/`else` chain to make the transition conditional; two unconditional
/// calls in one scope would be multiple drivers (HDL010). `[bn]` is unused and
/// kept for symmetry with the other hardware factories.
def stateGoto[bn: BindingName][w: Nat](sm: StateMachine[w], target: Nat): Unit =
    let _ = createSignalExpr("", regAssign(sm.state.zz_expr, literal(target)));
    unit

/// Combinational test `state == s`, for use in module logic (elaboration time).
/// `[bn]` is unused, kept for symmetry.
def stateIs[bn: BindingName][w: Nat](sm: StateMachine[w], s: Nat): Bool =
    Bool.mk(None, binary(sm.state.zz_expr, "==", literal(s)))
