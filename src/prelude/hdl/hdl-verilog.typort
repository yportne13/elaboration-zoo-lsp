//! Verilog code generation (designVL and module emission).
// ============================================================
// HDL Verilog Code Generation (pure typort library)
// ============================================================

// Convert Nat to decimal string (for Verilog width ranges like [7:0])
// Uses the Rust builtin nat_to_dec which correctly counts Peano successors
/// Decimal string for a `Nat` (wraps the Rust `nat_to_dec` builtin,
/// which counts Peano successors correctly).  Used for Verilog width ranges like
/// `[7:0]`.
def natToDec(n: Nat): String = nat_to_dec(n)

// String concat helpers (avoid Add trait to prevent typeclass issues with dep-types)

/// Join a `List[String]` with "\n" ("" for the empty list).
def joinLines(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + "\n" + joinLines(tail)
}

// Is an Expr the always-true write enable?  If so the memory write statement is
// emitted without the `if (enable)` guard.  Only a literal whose value is 1
// (constructor form `literal(succ(zero))`) is recognized: numeric literal terms
// may stay stuck through elaboration (see docs/l13-proof-candidates-notes.md
// §2.3), so a stuck literal still falls through to the `if (...)` form, which is
// valid (if redundant) Verilog.
/// Is this Expr the always-true write enable (`literal(succ(zero))`)?
/// Recognising it lets `memWriteLineRaw` drop the redundant `if (enable)` guard.
/// Only the constructor form is recognised: a stuck numeric literal falls through
/// to the guarded form, which is still legal (if redundant) Verilog.
def isTrueLit(e: Expr): Boolean = match e {
    case literal(v) => match v {
        case succ(zero) => true
        case _ => false
    }
    case _ => false
}

// Normalize a Typort-level binary operator to a legal Verilog operator.
// `+^` / `-^` (carry/borrow-generating add/sub, result type width+1) are
// NOT Verilog tokens. The prelude's `+^`/`-^` (hdl-ops.typort) no longer
// emit these op strings: they build "pad-concat + plain +" expressions
// directly (`{1'b0, a} + b` / `{a[w-1], a} + {b[w-1], b}`), so the extra
// top bit is explicit and survives nesting/inlining. The branches below
// are defensive fallbacks for hand-built Exprs that still carry `+^`/`-^`;
// they map to plain `+` / `-` so the emitted Verilog stays legal.
/// Normalize a typort binary operator to a legal Verilog token: the
/// defensive `+^` / `-^` fallbacks map to plain `+` / `-` (neither is a Verilog
/// token); every other operator passes through.  hdl-ops no longer emits
/// `+^`/`-^` (it builds an explicit pad-concat plus plain add/sub), so these
/// branches only protect hand-built Exprs.
def verilogBinOp(op: String): String =
    let is_plus_carry = str_eq(op, "+^");
    match is_plus_carry {
        case true => "+"
        case false =>
            let is_minus_borrow = str_eq(op, "-^");
            match is_minus_borrow {
                case true => "-"
                case false => op
            }
    }

// Arithmetic right shift `>>>` (IEEE 1364-2001 §4.1.10): the shift is
// ARITHMETIC only when the LEFT operand is signed. An SInt value does not
// always live on a signed-declared wire — `b.asSInt >> 1` keeps the unsigned
// wire `b` as its Expr — so a bare `(b >>> 1)` silently degrades to a LOGICAL
// shift (review 2026-09-29 HDL P1-4). Wrapping the left operand in
// `$signed(...)` pins the signedness at the shift site; for operands that
// already carry a signed declaration it is a no-op.
/// Wrap a left operand in `$signed(...)` for an arithmetic right shift.
/// IEEE 1364-2001 §4.1.10 makes `>>>` arithmetic only when the LEFT operand is
/// signed, and an `SInt` value does not always live on a signed-declared wire
/// (`b.asSInt >> 1` keeps the unsigned wire `b`), so a bare `(b >>> 1)` silently
/// degrades to a logical shift.  For an already-signed operand the wrapper is a
/// no-op.
def arithShiftLhsStr(lstr: String): String =
    "$signed(" + lstr + ")"

// Sized literal for a concatenation operand.  IEEE 1364-2001 §4.1.14 forbids
// unsized constants inside concatenations, so `{0, x}` is not legal Verilog.
// A literal can only reach `##` as a Bool (value 0 or 1) — the Cat impls
// (hdl-ops.typort) always concatenate a Bool or a named signal — so it is
// emitted as a sized 1-bit literal; anything else keeps the plain decimal
// form (defensive fallback, not reachable through the Cat impls).
/// Sized 1-bit literal for a concatenation operand: zero -> `1'b0`,
/// succ(zero) -> `1'b1`; anything else keeps the plain decimal form (defensive,
/// unreachable through the Cat impls).  IEEE 1364-2001 §4.1.14 forbids unsized
/// constants inside concatenations, so `{0, x}` is not legal Verilog.
def catLitStr(v: Nat): String = match v {
    case zero => "1'b0"
    case succ(zero) => "1'b1"
    case _ => natToDec(v)
}

// A sized Verilog literal `w'dv` for `sizedLiteral(v, w)` (parser desugar of
// `8'h2A` etc.). Legal inside concatenations, unlike an unsized decimal.
/// A sized Verilog literal `w'dv` for `sizedLiteral(v, w)` (the parser
/// desugar of `8'h2A` etc.).  Legal inside concatenations, unlike an unsized
/// decimal.
def sizedLitStr(v: Nat, w: Nat): String =
    natToDec(w) + "'d" + natToDec(v)

// ---- simulation assert emission (docs/hdl-blackbox-sim-design.md §3.3) ----
// One assert = ONE `if` whose body $displays a `TYPORT_ASSERT_<SEV> %0t %m:
// <msg>` marker line; the whole always block is translate_off-wrapped by
// assertsVL. The marker word + %0t + %m let the sim host (src/sim/dut.rs)
// capture failures off stdout while `%m` fills the hierarchical instance path
// at simulation time (more precise than baking module names into the msg).

/// Marker tag for an assertion severity: `INFO` / `WARNING` / `ERROR`.
/// `AssertFatal` also maps to `ERROR` — its fatality is signalled by the appended
/// `$finish;`, not by a distinct tag.
def assertSevTag(s: AssertSeverity): String = match s {
    case AssertInfo => "INFO"
    case AssertWarning => "WARNING"
    case AssertError => "ERROR"
    case AssertFatal => "ERROR"
}

/// Is this severity fatal (`AssertFatal`)?  Fatal assertions append
/// `$finish;` after the `$display`, so the sim host sees "model closed stdout".
def assertIsFatal(s: AssertSeverity): Boolean = match s {
    case AssertFatal => true
    case _ => false
}

// Procedural form (4-space if indent, display at 6 — the clocked-block body
// style). AssertFatal appends `$finish;` (the model exits early; the host
// sees "model closed stdout" as the fatal signal).
/// One assertion statement in procedural style (4-space `if` indent,
/// 6-space display): `if (!(condStr)) begin` / `$display("TYPORT_ASSERT_<SEV> %0t
/// %m: <msg>", $time);` / (`$finish;` when fatal) / `end`.  The marker word plus
/// `%0t` and `%m` let the sim host capture failures off stdout with the time and
/// the hierarchical instance path.
def assertLineRaw(condStr: String, msg: String, sev: AssertSeverity): String =
    let disp = "      $display(\"TYPORT_ASSERT_" + assertSevTag(sev) + " %0t %m: " + msg + "\", $time);";
    let fin = match assertIsFatal(sev) {
        case true => "\n      $finish;"
        case false => ""
    };
    "    if (!(" + condStr + ")) begin\n" + disp + fin + "\n    end"

// Emit one memory write statement for the clocked always block:
//   if (enable) mem[address] <= data;
// An enable that evaluates to literal 1 (constructor form `literal(succ(zero))`)
// collapses to the bare assignment; any other enable keeps the guard.
// Operand strings are already emitted (avoids a forward ref to exprVL).
/// One memory write statement for the clocked always block:
/// `if (enable) mem[addr] <= data;`, or the bare `mem[addr] <= data;` when
/// `enable` is the recognised always-true literal.  Operand strings are already
/// rendered (avoids a forward reference to `exprVL`).
def memWriteLineRaw(memStr: String, addrStr: String, dataStr: String, enableStr: String, enable: Expr): String =
    let always_en = isTrueLit(enable);
    match always_en {
        case true => "    " + memStr + "[" + addrStr + "] <= " + dataStr + ";"
        case false => "    if (" + enableStr + ") begin\n      " + memStr + "[" + addrStr + "] <= " + dataStr + ";\n    end"
    }

// Emit an expression in "procedural" context (inside always block):
// assign becomes blocking assignment, block/when recurse procedurally.
// Self-contained (no forward ref to exprVL).
/// Render an Expr in PROCEDURAL context (inside an always block):
/// assign becomes blocking (`lhs = rhs`), `regAssign` / `regAssignCd` become
/// non-blocking (`lhs <= rhs`), `when` recurses into `if / else if / else`,
/// `memWrite` / `assertExpr*` go through their line helpers, and the expression
/// forms mirror `exprVL`.  Self-contained (no forward reference to `exprVL`).
def exprVL_proc(e: Expr): String = match e {
    case create(name) => name
    case createIn(name) => name
    case createOut(name) => name
    case createInOut(name) => name
    case createWidth(name, _) => name
    case createInWidth(name, _) => name
    case createOutWidth(name, _) => name
    case createInOutWidth(name, _) => name
    case createReg(name) => name
    case createRegWidth(name, _) => name
    case createRegWidthInit(name, _, _) => name
    case createRegWidthCd(name, _, _) => name
    case createRegWidthInitCd(name, _, _, _) => name
    case createSIntRegWidthCd(name, _, _) => name
    case createSIntRegWidthInitCd(name, _, _, _) => name
    case createOutReg(name) => name
    case createOutRegWidth(name, _) => name
    case createOutRegWidthInit(name, _, _) => name
    case createSIntWidth(name, _) => name
    case createSIntInWidth(name, _) => name
    case createSIntOutWidth(name, _) => name
    case createSIntInOutWidth(name, _) => name
    case createSIntRegWidth(name, _) => name
    case createSIntRegWidthInit(name, _, _) => name
    case createSIntOutRegWidth(name, _) => name
    case createSIntOutRegWidthInit(name, _, _) => name
    case literal(v) => natToDec(v)
    case sizedLiteral(v, w) => sizedLitStr(v, w)
    case unary(op, x) => op + exprVL_proc(x)
    case binary(lhs, op, rhs) =>
        let is_cat = str_eq(op, "##");
        match is_cat {
            case true =>
                let lstr = match lhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL_proc(lhs)
                };
                let rstr = match rhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL_proc(rhs)
                };
                "{" + lstr + ", " + rstr + "}"
            case false =>
                let opv = verilogBinOp(op);
                match str_eq(op, ">>>") {
                    case true => "(" + arithShiftLhsStr(exprVL_proc(lhs)) + " " + opv + " " + exprVL_proc(rhs) + ")"
                    case false => "(" + exprVL_proc(lhs) + " " + opv + " " + exprVL_proc(rhs) + ")"
                }
        }
    case assign(lhs, rhs) =>
        "      " + exprVL_proc(lhs) + " = " + exprVL_proc(rhs) + ";"
    case regAssign(lhs, rhs) =>
        "      " + exprVL_proc(lhs) + " <= " + exprVL_proc(rhs) + ";"
    case regAssignCd(lhs, rhs, _) =>
        "      " + exprVL_proc(lhs) + " <= " + exprVL_proc(rhs) + ";"
    case when(cond, body, elseBody) =>
        "    if (" + exprVL_proc(cond) + ") begin\n" + exprVL_proc(body) + "\n    end" + (
            match elseBody {
                case None => ""
                case Some(eb) => match eb {
                    case when(ec, eb2, eb3) =>
                        " else if (" + exprVL_proc(ec) + ") begin\n" + exprVL_proc(eb2) + "\n    end" + (
                            match eb3 {
                                case None => ""
                                case Some(eb4) => " else begin\n" + exprVL_proc(eb4) + "\n    end"
                            }
                        )
                    case _ =>
                        " else begin\n" + exprVL_proc(eb) + "\n    end"
                }
            }
        )
    case switch(value, cases) =>
        "  case (" + exprVL_proc(value) + ") " + exprVL_proc(cases) + " endcase"
    case block(head, tail) => exprVL_proc(head) + exprVL_proc(tail)
    case nop => ""
    case mux(cond, whenTrue, whenFalse) =>
        "(" + exprVL_proc(cond) + " ? " + exprVL_proc(whenTrue) + " : " + exprVL_proc(whenFalse) + ")"
    case bitsel(x, idx) =>
        exprVL_proc(x) + "[" + exprVL_proc(idx) + "]"
    case partsel(x, hi, lo) =>
        exprVL_proc(x) + "[" + exprVL_proc(hi) + ":" + exprVL_proc(lo) + "]"
    case instance(instName, moduleName) =>
        "  " + moduleName + " " + instName + " ();"
    case instanceWithPorts(instName, moduleName, ports) =>
        "  " + moduleName + " " + instName + " (" + ports + ");"
    case subSignal(instName, signalName) =>
        instName + "_" + signalName
    case createMem(name, _, _) => name
    case memRead(mem, address) =>
        exprVL_proc(mem) + "[" + exprVL_proc(address) + "]"
    case memWrite(mem, address, data, enable) =>
        memWriteLineRaw(exprVL_proc(mem), exprVL_proc(address), exprVL_proc(data), exprVL_proc(enable), enable)
    case assertExpr(cond, msg, sev) =>
        assertLineRaw(exprVL_proc(cond), msg, sev)
    case assertExprCd(cond, msg, sev, _) =>
        assertLineRaw(exprVL_proc(cond), msg, sev)
    // BlackBox parameter marker: pure emission-channel payload, never a
    // Verilog statement — statement-position collectors skip it explicitly
    // (collectAssignLinesFiltered / collectAssertLinesOne / collectInstHelp);
    // this arm is the defensive render ("" like nop) for an unreachable shape.
    case bbMarkerExpr(_, _) => ""
}

// Helper: emit condition string without redundant outer parens
/// Render a condition WITHOUT redundant outer parentheses: a binary node
/// becomes `<lhs> <op> <rhs>` (still `$signed(...)`-wrapped for `>>>`), anything
/// else goes through `exprVL_proc`.
def emitCondStr(cond: Expr): String = match cond {
    case binary(lhs, op, rhs) =>
        match str_eq(op, ">>>") {
            case true => arithShiftLhsStr(exprVL_proc(lhs)) + " " + verilogBinOp(op) + " " + exprVL_proc(rhs)
            case false => exprVL_proc(lhs) + " " + verilogBinOp(op) + " " + exprVL_proc(rhs)
        }
    case _ => exprVL_proc(cond)
}

// Convert a single Expr to a Verilog expression string.
// Handles one level of else-if nesting; deeper nesting may produce
// nested if-statements (still functionally correct).
/// Render one Expr as a Verilog expression or standalone statement string:
/// signals by name; `literal` as decimal; `sizedLiteral` as `w'dv`; `##` as
/// `{lhs, rhs}` with sized literals; other binaries as `(<lhs> <op> <rhs>)` (with
/// `$signed(...)` on a `>>>` left operand); `unary` as `op expr`; `mux` as
/// `(c ? a : b)`; `bitsel` / `partsel` as `x[i]` / `x[hi:lo]`; `subSignal` as the
/// flat name `<inst>_<port>`; `memRead` as `mem[addr]`; `memWrite` and
/// `assertExpr*` via their line helpers; `instance*` as an instantiation line;
/// `assign` / `regAssign*` as a continuous / procedural assignment; `when` as an
/// if-block whose body is rendered procedurally (one level of `else if` nesting;
/// deeper nesting emits nested ifs, still correct); `switch` as a `case`; `nop`
/// and a blackbox marker as "".
def exprVL(e: Expr): String = match e {
    case create(name) => name
    case createIn(name) => name
    case createOut(name) => name
    case createInOut(name) => name
    case createWidth(name, _) => name
    case createInWidth(name, _) => name
    case createOutWidth(name, _) => name
    case createInOutWidth(name, _) => name
    case createReg(name) => name
    case createRegWidth(name, _) => name
    case createRegWidthInit(name, _, _) => name
    case createRegWidthCd(name, _, _) => name
    case createRegWidthInitCd(name, _, _, _) => name
    case createSIntRegWidthCd(name, _, _) => name
    case createSIntRegWidthInitCd(name, _, _, _) => name
    case createOutReg(name) => name
    case createOutRegWidth(name, _) => name
    case createOutRegWidthInit(name, _, _) => name
    case createSIntWidth(name, _) => name
    case createSIntInWidth(name, _) => name
    case createSIntOutWidth(name, _) => name
    case createSIntInOutWidth(name, _) => name
    case createSIntRegWidth(name, _) => name
    case createSIntRegWidthInit(name, _, _) => name
    case createSIntOutRegWidth(name, _) => name
    case createSIntOutRegWidthInit(name, _, _) => name
    case literal(v) => natToDec(v)
    case sizedLiteral(v, w) => sizedLitStr(v, w)
    case unary(op, e) => op + exprVL(e)
    case binary(lhs, op, rhs) =>
        let is_cat = str_eq(op, "##");
        match is_cat {
            case true =>
                let lstr = match lhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL(lhs)
                };
                let rstr = match rhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL(rhs)
                };
                "{" + lstr + ", " + rstr + "}"
            case false =>
                let opv = verilogBinOp(op);
                match str_eq(op, ">>>") {
                    case true => "(" + arithShiftLhsStr(exprVL(lhs)) + " " + opv + " " + exprVL(rhs) + ")"
                    case false => "(" + exprVL(lhs) + " " + opv + " " + exprVL(rhs) + ")"
                }
        }
    case assign(lhs, rhs) =>
        "  assign " + exprVL(lhs) + " = " + exprVL(rhs) + ";"
    case regAssign(lhs, rhs) =>
        "    " + exprVL(lhs) + " <= " + exprVL(rhs) + ";"
    case regAssignCd(lhs, rhs, _) =>
        "    " + exprVL(lhs) + " <= " + exprVL(rhs) + ";"
    case when(cond, body, elseBody) =>
        "    if (" + emitCondStr(cond) + ") begin\n" + exprVL_proc(body) + "\n    end" + (
            match elseBody {
                case None => ""
                case Some(eb) => match eb {
                    case when(ec, eb2, eb3) =>
                        " else if (" + emitCondStr(ec) + ") begin\n" + exprVL_proc(eb2) + "\n    end" + (
                            match eb3 {
                                case None => ""
                                case Some(eb4) => " else begin\n" + exprVL_proc(eb4) + "\n    end"
                            }
                        )
                    case _ =>
                        " else begin\n" + exprVL_proc(eb) + "\n    end"
                }
            }
        )
    case switch(value, cases) =>
        "  case (" + exprVL(value) + ") " + exprVL(cases) + " endcase"
    case block(head, tail) => exprVL(head) + exprVL(tail)
    case nop => ""
    case mux(cond, whenTrue, whenFalse) =>
        "(" + exprVL(cond) + " ? " + exprVL(whenTrue) + " : " + exprVL(whenFalse) + ")"
    case bitsel(e, idx) =>
        exprVL(e) + "[" + exprVL(idx) + "]"
    case partsel(e, hi, lo) =>
        exprVL(e) + "[" + exprVL(hi) + ":" + exprVL(lo) + "]"
    case instance(instName, moduleName) =>
        "  " + moduleName + " " + instName + " ();"
    case instanceWithPorts(instName, moduleName, ports) =>
        "  " + moduleName + " " + instName + " (" + ports + ");"
    case subSignal(instName, signalName) =>
        let sigLine = instName + "_" + signalName;
        sigLine
    case createMem(name, _, _) => name
    case memRead(mem, address) =>
        exprVL(mem) + "[" + exprVL(address) + "]"
    case memWrite(mem, address, data, enable) =>
        memWriteLineRaw(exprVL(mem), exprVL(address), exprVL(data), exprVL(enable), enable)
    case assertExpr(cond, msg, sev) =>
        assertLineRaw(exprVL(cond), msg, sev)
    case assertExprCd(cond, msg, sev, _) =>
        assertLineRaw(exprVL(cond), msg, sev)
    // defensive render (see exprVL_proc); statement collectors skip markers
    case bbMarkerExpr(_, _) => ""
}

/// Is this Expr a `subSignal(inst, port)` handle?
def isSubSignal(e: Expr): Boolean = match e {
    case subSignal(_, _) => true
    case _ => false
}

// Check if an expression is an assign whose RHS is a subSignal (reading a
// sub-module output: `sig := u.port`). Defined here (before assignLineCheck)
// because Typort has no forward references; the expr decomposition helpers
// used by collectInstHelp live further down.
/// Is this `assign(_, rhs)` whose RHS is a subSignal — i.e. a READ of a
/// child output (`sig := u.port`, emitted as a port connection)?
def isSubSignalRhs(e: Expr): Boolean = match e {
    case assign(_, rhs) => isSubSignal(rhs)
    case _ => false
}

// Check if an expression is an assign targeting a subSignal (port connection)
/// Is this an assign TARGETING a subSignal (`u.port := sig`, a port
/// connection on the LHS)?
def isSubSigAssign(e: Expr): Boolean = match e {
    case assign(lhs, _) => isSubSignal(lhs)
    case _ => false
}

// Helper: check if Vec[Expr] contains any port declarations
/// Does the expr list declare ANY port (plain or sized input / output /
/// inout, including `output reg`)?  NOTE: no call site other than its own
/// recursion — kept as a spare predicate, not wired into the emitter.
def hasPorts[ne: Nat](es: Vec[Expr] ne): Boolean = match es {
    case nil => false
    case cons(e, tail) => match e {
        case createIn(_) => true
        case createOut(_) => true
        case createInOut(_) => true
        case createInWidth(_, _) => true
        case createOutWidth(_, _) => true
        case createInOutWidth(_, _) => true
        case createSIntInWidth(_, _) => true
        case createSIntOutWidth(_, _) => true
        case createSIntInOutWidth(_, _) => true
        case createOutReg(_) => true
        case createOutRegWidth(_, _) => true
        case createOutRegWidthInit(_, _, _) => true
        case createSIntOutRegWidth(_, _) => true
        case createSIntOutRegWidthInit(_, _, _) => true
        case _ => hasPorts tail
    }
}

// Check if a string is in a list
/// Membership test for a `String` in a `List[String]`.
def strInList(s: String, ls: List[String]): Boolean = match ls {
    case lnil => false
    case lcons(h, tail) =>
        let eq = str_eq(h, s);
        match eq {
            case true => true
            case false => strInList(s, tail)
        }
}

// Helper: generate output port wire/reg keyword
/// `reg` when `name` is in the non-clocked when-driven set, else `wire` —
/// the declaration keyword for an output port that is not an `output reg` port.
def outWireOrReg(name: String, whenSigs: List[String]): String =
    let isWhen = strInList(name, whenSigs);
    match isWhen {
        case true => "reg"
        case false => "wire"
    }

// Helper: generate width range string, omit for 1-bit signals
// Uses Rust builtin width_range which can force Nat evaluation
/// Verilog width range text `[w-1:0]` (wraps the Rust `width_range` builtin,
/// which forces Nat evaluation); the EMPTY string for 1-bit signals, so callers
/// concatenate it directly.
def widthRange(w: Nat): String = width_range(w)

// ============================================================
//  Memory (Mem) declarations
// ============================================================

// Emit one memory declaration:  reg [w-1:0] name [0:wordCount-1];
// widthRange returns "" for 1-bit cells →  reg name [0:wordCount-1];
/// One memory declaration: `reg [w-1:0] name [0:words-1];`, or
/// `reg name [0:words-1];` for 1-bit cells (since `widthRange` returns "").
def memDeclLine(name: String, wordCount: Nat, width: Nat): String =
    "  reg " + widthRange(width) + name + " [0:" + natToDec(pred(wordCount)) + "];"

// Collect memory declarations from Vec[Expr]
/// `memDeclLine` for every `createMem(name, wordCount, width)` in the
/// expr list.
def collectMemLines[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case createMem(name, wordCount, width) => lcons (memDeclLine(name, wordCount, width)) (collectMemLines tail)
        case _ => collectMemLines tail
    }
}

/// Memory declaration section text: all memory declarations joined by
/// newlines plus a trailing newline ("" when there are none).
def memsVL[ne: Nat](es: Vec[Expr] ne): String =
    let ls = list_reverse(collectMemLines es);
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Helper: process a single port expr
// output-reg ports are ALWAYS emitted `output reg` — no wire/reg inference
// from the when-driven set (outWireOrReg), so a register output port stays a
// reg even when its `:=` drive lives outside any non-clocked when.
/// The Verilog port line(s) for one port declaration expr: `input wire
/// name` / `output wire|reg name` / `inout wire name`, with `[w-1:0]` and
/// `signed` modifiers as applicable.  `output reg` ports are ALWAYS `output reg`
/// (no wire/reg inference from the when-driven set).  Any other expr yields no
/// line.
def portLineSingle(e: Expr, whenSigs: List[String]): List[String] = match e {
    case createIn(name) => lcons ("  input wire " + name) lnil
    case createOut(name) => lcons ("  output " + outWireOrReg(name, whenSigs) + " " + name) lnil
    case createInOut(name) => lcons ("  inout wire " + name) lnil
    case createInWidth(name, w) => lcons ("  input wire " + widthRange(w) + name) lnil
    case createOutWidth(name, w) => lcons ("  output " + outWireOrReg(name, whenSigs) + " " + widthRange(w) + name) lnil
    case createInOutWidth(name, w) => lcons ("  inout wire " + widthRange(w) + name) lnil
    case createSIntInWidth(name, w) => lcons ("  input wire signed " + widthRange(w) + name) lnil
    case createSIntOutWidth(name, w) => lcons ("  output " + outWireOrReg(name, whenSigs) + " signed " + widthRange(w) + name) lnil
    case createSIntInOutWidth(name, w) => lcons ("  inout wire signed " + widthRange(w) + name) lnil
    case createOutReg(name) => lcons ("  output reg " + name) lnil
    case createOutRegWidth(name, w) => lcons ("  output reg " + widthRange(w) + name) lnil
    case createOutRegWidthInit(name, w, _) => lcons ("  output reg " + widthRange(w) + name) lnil
    case createSIntOutRegWidth(name, w) => lcons ("  output reg signed " + widthRange(w) + name) lnil
    case createSIntOutRegWidthInit(name, w, _) => lcons ("  output reg signed " + widthRange(w) + name) lnil
    case _ => lnil
}

// Collect port declarations (input/output) from Vec[Expr]
/// `portLineSingle` over the whole expr list, preserving declaration
/// order.
def collectPortLines[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => list_append(portLineSingle(e, whenSigs), collectPortLines(tail, whenSigs))
}

// Collect the names of all signals declared as ports (input/output). Wire
// declarations skip same-named signals: a port declaration takes precedence
// over a wire — e.g. `AxiLite.create.asMaster` rebuilds its fields as ports
// while the plain TypeName.create wires from the inner call still sit in the
// module tree, and declaring both would emit illegal duplicate Verilog lines.
/// The names of all declared ports.  Wire/reg declarations skip
/// same-named signals, because a port declaration takes precedence over an inner
/// wire — e.g. `AxiLite.create.asMaster` rebuilds its fields as ports while the
/// plain `TypeName.create` wires from the inner call still sit in the module
/// tree, and declaring both would emit illegal duplicate Verilog lines.
def collectPortNames[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case createIn(name) => lcons (name) (collectPortNames tail)
        case createOut(name) => lcons (name) (collectPortNames tail)
        case createInOut(name) => lcons (name) (collectPortNames tail)
        case createInWidth(name, _) => lcons (name) (collectPortNames tail)
        case createOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createInOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntInWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntInOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createOutReg(name) => lcons (name) (collectPortNames tail)
        case createOutRegWidth(name, _) => lcons (name) (collectPortNames tail)
        case createOutRegWidthInit(name, _, _) => lcons (name) (collectPortNames tail)
        case createSIntOutRegWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntOutRegWidthInit(name, _, _) => lcons (name) (collectPortNames tail)
        case _ => collectPortNames tail
    }
}

/// Join port lines with ",\n" for a Verilog port list.
def joinPortLines(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + ",\n" + joinPortLines(tail)
}

/// The complete port list text (declaration order) for a module header.
def portsVL[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    joinPortLines(list_reverse(collectPortLines(es, whenSigs)))

// ---- BlackBox emission (docs/hdl-blackbox-sim-design.md §4.3) ----
// The blackbox macro registers each declared blackbox (name -> generics) in
// the "BlackBoxRegistry" global (hdl-core.typort; DEVIATION from §4.2: the
// registry replaces the ModuleDef.bb field, see the design/deviation notes
// there). DEVIATION (lvl2ix discipline, docs/l13-typeclass-instance-nat-
// param-bug.md, measured 2026-09-27): a def with a reachable global op that
// runs inside a generic ([n: Nat]) caller context or a class-body check
// evaluation poisons the end-of-run mutable_map drain (lvl2ix panic) - even
// a read-only get_global_default. The whole emission chain here is PURE:
// the blackbox parameter strings are rendered at CREATE time (ground params)
// by the blackbox macro and transported as the dedicated Expr marker variant
//   bbMarkerExpr(isInst: Boolean, params: String)
// - the SELF marker (isInst=false) lives in the blackbox def itself (stub
// header params), the INSTANCE marker (isInst=true) in the parent def
// right after its instance node (instance params; prepend order puts it
// right after the instance in walk order). The "BlackBoxRegistry" global
// remains CHECK-time only (hdl-check body-rule gating); its result is
// consumed into a Boolean there and never flows into a quoted string.
//
// HISTORY (R2 review P1 fix, 2026-09-27): the markers were originally
// transported as assertExpr(literal(zero|succ(zero)), <params>, AssertError)
// — a shape byte-identical to a user constant Bool assertion
// (`assert(false.into, msg)` → literal(zero) ≡ SELF marker: bbIsBlackBox
// replaced the whole module body with a malformed stub; `assert(true.into,
// "sanity")` → literal(succ(zero)) ≡ INSTANCE marker: collectInstHelp
// consumed the assert and polluted the instance name with the msg). The
// dedicated Expr variant bbMarkerExpr(isInst, params) (hdl-core.typort)
// ends the aliasing — user asserts and parameter markers now match
// distinct variants, so no literal-cond predicate is needed anywhere.

// NOTE (single definition): the parameter-string RENDERERS live in
// hdl-macros.typort (bbGenValStr / bbParamsDeclStr / bbInstItemsStr /
// bbInstParamsStr) because they must run at CREATE time, inside the blackbox
// macro expansion — hdl-macros loads BEFORE hdl-verilog, so the definition
// here would be a `redefine bbGenValStr` prelude load error, and the
// registry-reading variants (bbParamsDecl/bbInstItems/bbInstParamsOf) are
// dead under the pure-emission discipline: this file only does literal
// pick-up from the marker nodes below.

// Is this def a blackbox (carries the SELF marker, isInst=false)? PURE. The
// INSTANCE marker (isInst=true, living in a PARENT def) must not trip this
// dispatch.
// NOTE: flat element patterns only - nested deconstruction inside a cons
// pattern compiles to dangling-level pattern quotes (lvl2ix, measured).
/// Is this def a blackbox?  True iff its expr list carries a SELF marker
/// (`bbMarkerExpr(isInst=false)`); the INSTANCE marker (`isInst=true`) lives in a
/// PARENT def and must not trip this.  PURE (no global read — the emission chain
/// must stay global-free).  Uses flat element patterns only: nested
/// deconstruction inside a `cons` pattern compiles to dangling-level pattern
/// quotes (lvl2ix).
def bbIsBlackBox[en: Nat](es: Vec[Expr] en): Boolean = match es {
    case nil => false
    case cons(e, tail) =>
        match e {
            case bbMarkerExpr(isInst, _) =>
                match isInst {
                    case true => bbIsBlackBox(tail)
                    case false => true
                }
            case _ => bbIsBlackBox(tail)
        }
}

// The stub header params string carried by the SELF marker ("parameter K = v,
// ..."; "" for a generic-less blackbox). PURE. Flat patterns (see above).
/// The stub-header parameter string carried by the SELF marker
/// (`parameter K = v, ...`; "" for a generic-less blackbox).  PURE, flat
/// patterns (see `bbIsBlackBox`).
def bbStubParams[en: Nat](es: Vec[Expr] en): String = match es {
    case nil => ""
    case cons(e, tail) =>
        match e {
            case bbMarkerExpr(isInst, m) =>
                match isInst {
                    case true => bbStubParams(tail)
                    case false => m
                }
            case _ => bbStubParams(tail)
        }
}

// Empty module stub for a blackbox def, guarded by
//   `ifndef TYPORT_BB_<Name> ... `endif
// so a hand-written behavior model whose first line is
// `define TYPORT_BB_<Name> (joined via the simulator's extra_args channel)
// replaces the stub without duplicate-module errors; without a replacement the
// stub itself elaborates fine. Ports go through the SAME portLineSingle /
// portsVL path as ordinary modules (directions/widths/signedness identical);
// there are no wire/reg/assign/always/instance sections and NO synthesized
// clk/reset ports — the blackbox def's expr list holds only port declarations.
/// Emit a blackbox's guarded EMPTY stub: `` `ifndef TYPORT_BB_<Name> ``,
/// `module <Name> #(<params>) (ports);`, `endmodule`, `` `endif ``.  A hand-written
/// behaviour model whose first line is `` `define TYPORT_BB_<Name> `` (joined via
/// the simulator's extra_args channel) replaces the stub without a
/// duplicate-module error; without a replacement the stub elaborates fine.
/// Ports go through the same `portsVL` path as ordinary modules; there are no
/// wire/reg/assign/always/instance sections and NO synthesized clk/reset
/// ports.
def blackboxDefVL(md: ModuleDef, params: String): String =
    let port_decls = portsVL(md.expr, lnil);
    let genhead = match str_eq(params, "") {
        case true => ""
        case false => " #(" + params + ")"
    };
    "`ifndef TYPORT_BB_" + md.name + "\nmodule " + md.name + genhead + " (\n" + port_decls + "\n);\nendmodule\n`endif"


// Helper: generate wire or reg declaration based on when-driven status
/// One internal-signal declaration line: `reg <width> name;` when the name
/// is driven by a non-clocked when, else `wire <width> name;`.
def wireOrRegLine(name: String, widthStr: String, whenSigs: List[String]): String =
    let isWhen = strInList(name, whenSigs);
    match isWhen {
        case true => "  reg " + widthStr + name + ";"
        case false => "  wire " + widthStr + name + ";"
    }

// Helper: process a single expr for wire/reg declaration.
// A signal whose name already appears in portNames is skipped entirely — the
// port declaration (input/output) takes precedence over a same-named wire.
// whenSigs semantics are unchanged: non-port signals driven by a non-clocked
// when are declared as reg instead of wire.
/// The wire/reg declaration line(s) for one expr: `create` /
/// `createWidth` / `createSIntWidth` become declarations (with `signed` for
/// SInt), unless the name is already a port — the port declaration wins.
def wireLineSingle(e: Expr, portNames: List[String], whenSigs: List[String]): List[String] = match e {
    case create(name) =>
        let isPort = strInList(name, portNames);
        match isPort {
            case true => lnil
            case false => lcons (wireOrRegLine(name, "", whenSigs)) lnil
        }
    case createWidth(name, w) =>
        let isPort = strInList(name, portNames);
        match isPort {
            case true => lnil
            case false => lcons (wireOrRegLine(name, widthRange(w), whenSigs)) lnil
        }
    case createSIntWidth(name, w) =>
        let isPort = strInList(name, portNames);
        match isPort {
            case true => lnil
            case false => lcons (wireOrRegLine(name, "signed " + widthRange(w), whenSigs)) lnil
        }
    case _ => lnil
}

// Collect wire declarations (internal signals) from Vec[Expr]
// When-driven signals are declared as reg instead of wire
/// `wireLineSingle` over the expr list — the internal signal
/// declarations.
def collectWireLines[ne: Nat](es: Vec[Expr] ne, portNames: List[String], whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => list_append(wireLineSingle(e, portNames, whenSigs), collectWireLines(tail, portNames, whenSigs))
}

// Collect reg declarations from Vec[Expr].
// A reg whose name is already a port (e.g. a body `reg [7:0] q = 0;` next to
// the `output reg [7:0] q` header port — the Verilog-compat way to attach a
// reset value) is skipped: the `output reg` port line already declares the
// storage, and emitting both would be an illegal redeclaration. The port's
// own init Expr still feeds the reset branch via collectInitLinesCd.
/// `reg` declaration lines for every register factory (`createReg*`,
/// `createSIntReg*`).  A reg whose name is already a port is skipped: an
/// `output reg` header port plus a body `reg [7:0] q = 0;` would be an illegal
/// redeclaration, and the port's own init still feeds the reset branch through
/// `collectInitLinesCd`.
def collectRegLines[ne: Nat](es: Vec[Expr] ne, portNames: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case createReg(name) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg " + name + ";") (collectRegLines(tail, portNames))
            }
        case createRegWidth(name, w) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case createRegWidthInit(name, w, _) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case createRegWidthCd(name, w, _) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case createRegWidthInitCd(name, w, _, _) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case createSIntRegWidthCd(name, w, _) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg signed " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case createSIntRegWidthInitCd(name, w, _, _) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg signed " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case createSIntRegWidth(name, w) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg signed " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case createSIntRegWidthInit(name, w, _) =>
            match strInList(name, portNames) {
                case true => collectRegLines(tail, portNames)
                case false => lcons ("  reg signed " + widthRange(w) + name + ";") (collectRegLines(tail, portNames))
            }
        case _ => collectRegLines(tail, portNames)
    }
}

// Does the module declare any output-reg PORT? Such ports are sequential
// elements (clocked regAssign targets with optional init), so the module
// header needs the clock (and reset) ports even though no standalone `reg`
// declaration exists — the `output reg` port line itself declares the reg.
/// Does the module declare any `output reg` PORT?  Such a port is a
/// sequential element (clocked regAssign target with optional init), so the
/// module needs clock/reset ports even though the port line itself declares the
/// reg.
def hasOutRegPorts[ne: Nat](es: Vec[Expr] ne): Boolean = match es {
    case nil => false
    case cons(e, tail) => match e {
        case createOutReg(_) => true
        case createOutRegWidth(_, _) => true
        case createOutRegWidthInit(_, _, _) => true
        case createSIntOutRegWidth(_, _) => true
        case createSIntOutRegWidthInit(_, _, _) => true
        case _ => hasOutRegPorts tail
    }
}

// Compare two clock domains by (clockName, resetName)
/// Compare two clock domains by (clockName, resetName).
def cdEq(a: ClockDomain, b: ClockDomain): Boolean = match str_eq(a.clockName, b.clockName) {
    case true => str_eq(a.resetName, b.resetName)
    case false => false
}

// Does an Expr tree contain regAssignCd for THIS cd? (regAssign non-Cd forms do
// NOT count here — they belong to the module default cd.)
/// Does this expr tree contain a `regAssignCd` for THIS clock domain?
/// Plain `regAssign` does not count — it belongs to the module's default cd.
def hasRegAssignCd(e: Expr, cd: ClockDomain): Boolean = match e {
    case regAssignCd(_, _, c) =>
        let same = cdEq(c, cd);
        match same {
            case true => true
            case false => false
        }
    case when(_, body, elseBody) =>
        let b = hasRegAssignCd(body, cd);
        match b {
            case true => true
            case false => match elseBody {
                case None => false
                case Some(eb) => hasRegAssignCd(eb, cd)
            }
        }
    case block(head, tail) =>
        let h = hasRegAssignCd(head, cd);
        match h {
            case true => true
            case false => hasRegAssignCd(tail, cd)
        }
    case _ => false
}

// Does an Expr tree contain MAIN-clock-domain clocked content?  Main-domain
// membership MIRRORS collectClockLinesCd's direct arm table exactly:
//   regAssign   -> isMain only
//   memWrite    -> isMain only
//   regAssignCd -> matched by cdEq against the iterated cd
// so the main-domain predicate must accept `regAssign` AND `memWrite`, and must
// reject `regAssignCd`.
//
// WHY THIS EXISTS (round-3 (K) root fix): the `when` branch of
// collectClockLinesCd gated its MAIN branch with the cd-agnostic `hasRegAssign`
// (which accepts regAssign, regAssignCd and memWrite).  A `when` holding only
// `regAssignCd(cd2)` was therefore collected into the MAIN clocked always block
// *and* (via hasRegAssignCd) into cd2's block — the same assignment emitted
// twice, i.e. a double drive (round 1 worked around it in streamFifoCC with a
// named combinational wire instead of fixing the gate).
//
// MEASURED CATCH — do NOT drop `memWrite` from this predicate: a first version
// that accepted `regAssign` only made examples/hdl/21-crossclock.typort lose its
// `_d_mem[...] <= pushData;` line entirely (before 1 occurrence, after 0).  That
// memory write sits inside a `when` and belongs to the MAIN domain, so a
// regAssign-only predicate routed the whole when to no clocked block at all.
//
// The other four hasRegAssign call sites (:1063/:1109/:1265/:1298) keep the
// cd-agnostic predicate on purpose — they ask "is this clocked?", not "is this
// main-domain?".
/// Does this expr tree contain MAIN-clock-domain clocked content (`regAssign` or
/// `memWrite`)?  `regAssignCd` does not count — it belongs to its own extra clock
/// domain; `when` recurses into body then else-body, `block` into head then tail.
def hasMainClocked(e: Expr): Boolean = match e {
    case regAssign(_, _) => true
    case memWrite(_, _, _, _) => true
    case regAssignCd(_, _, _) => false
    case when(_, body, elseBody) =>
        let b = hasMainClocked(body);
        match b {
            case true => true
            case false => match elseBody {
                case None => false
                case Some(eb) => hasMainClocked(eb)
            }
        }
    case block(head, tail) =>
        let h = hasMainClocked(head);
        match h {
            case true => true
            case false => hasMainClocked(tail)
        }
    case _ => false
}

// Does an Expr tree contain a MAIN-cd assertExpr? (assertExprCd belongs to
// its own extra domain and does NOT count here — mirror hasRegAssign vs
// hasRegAssignCd.)
/// Does this expr tree contain a MAIN-cd `assertExpr`?  `assertExprCd`
/// belongs to its own extra domain and does not count (mirrors
/// hasRegAssign / hasRegAssignCd), and a blackbox parameter marker is explicitly
/// not an assert.
def hasAssert(e: Expr): Boolean = match e {
    case assertExpr(_, _, _) => true
    // blackbox parameter marker: not an assert, never counts (explicit arm —
    // with the old literal-cond channel this needed bbIsMarkerCond)
    case bbMarkerExpr(_, _) => false
    case when(_, body, elseBody) =>
        let b = hasAssert(body);
        match b {
            case true => true
            case false => match elseBody {
                case None => false
                case Some(eb) => hasAssert(eb)
            }
        }
    case block(head, tail) =>
        let h = hasAssert(head);
        match h {
            case true => true
            case false => hasAssert(tail)
        }
    case _ => false
}

// Extra-domain version: assertExprCd nodes matching THIS cd.
/// Does this expr tree contain an `assertExprCd` matching THIS clock
/// domain?
def hasAssertCd(e: Expr, cd: ClockDomain): Boolean = match e {
    case assertExpr(_, _, _) => false
    case assertExprCd(_, _, _, c) =>
        let same = cdEq(c, cd);
        match same {
            case true => true
            case false => false
        }
    case when(_, body, elseBody) =>
        let b = hasAssertCd(body, cd);
        match b {
            case true => true
            case false => match elseBody {
                case None => false
                case Some(eb) => hasAssertCd(eb, cd)
            }
        }
    case block(head, tail) =>
        let h = hasAssertCd(head, cd);
        match h {
            case true => true
            case false => hasAssertCd(tail, cd)
        }
    case _ => false
}

// Any assert (either variant, any cd). Gates the combinational always block:
// when-wrapped asserts must NOT be emitted there (they are clocked, and
// assertsVL owns them) — keeps has-clock and has-assert gating from
// polluting each other (design doc §9-6).
/// Does this expr tree contain any assert (either variant, any cd)?  Gates
/// the combinational always block: when-wrapped asserts are CLOCKED and owned by
/// `assertsVL`, so they must not be emitted there, and a lone assert-when must not
/// produce an empty `always @(*)`.
def hasAnyAssert(e: Expr): Boolean = match e {
    case assertExpr(_, _, _) => true
    case assertExprCd(_, _, _, _) => true
    // blackbox parameter marker: not an assert, never counts
    case bbMarkerExpr(_, _) => false
    case when(_, body, elseBody) =>
        let b = hasAnyAssert(body);
        match b {
            case true => true
            case false => match elseBody {
                case None => false
                case Some(eb) => hasAnyAssert(eb)
            }
        }
    case block(head, tail) =>
        let h = hasAnyAssert(head);
        match h {
            case true => true
            case false => hasAnyAssert(tail)
        }
    case _ => false
}

// Collect the set of extra clock domains referenced by regAssignCd OR
// assertExprCd (dedup by name) — one merged walker so extra-domain asserts
// also get their `input wire <clk>` port (extraCdPortsVL reads this list).
/// The clock domains referenced by `regAssignCd` or `assertExprCd` inside
/// one expr, deduped by clock name against `seen`.  One merged walker, so
/// extra-domain asserts also get their `input wire <clk>` port.
def collectClockCdsOne(e: Expr, seen: List[String]): List[ClockDomain] = match e {
    case regAssignCd(_, _, c) =>
        let nm = c.clockName;
        let dup = strInList(nm, seen);
        match dup {
            case true => lnil
            case false => lcons c lnil
        }
    case assertExprCd(_, _, _, c) =>
        let nm = c.clockName;
        let dup = strInList(nm, seen);
        match dup {
            case true => lnil
            case false => lcons c lnil
        }
    case when(_, body, elseBody) =>
        let fromBody = collectClockCdsOne(body, seen);
        match elseBody {
            case None => fromBody
            case Some(eb) => list_append(fromBody, collectClockCdsOne(eb, seen))
        }
    case block(hd, tl) =>
        list_append(collectClockCdsOne(hd, seen), collectClockCdsOne(tl, seen))
    // blackbox parameter marker carries no clock domain (explicit ignore)
    case bbMarkerExpr(_, _) => lnil
    case _ => lnil
}

// Add clock names of a cd list to the seen-names list (accumulate in reverse)
/// Append the clock names of a cd list onto an accumulator list (accumulates
/// in reverse).
def cdNamesAdd(acc: List[String], cds: List[ClockDomain]): List[String] = match cds {
    case lnil => acc
    case lcons(c, tail) => cdNamesAdd(lcons c.clockName acc, tail)
}

/// `collectClockCdsOne` over an expr list, threading the seen-name list so
/// each clock name is collected once.
def collectClockCdsHelp[ne: Nat](es: Vec[Expr] ne, seen: List[String]): List[ClockDomain] = match es {
    case nil => lnil
    case cons(e, tail) =>
        let fromE = collectClockCdsOne(e, seen);
        let newSeen = cdNamesAdd(seen, fromE);
        list_append(fromE, collectClockCdsHelp(tail, newSeen))
}

/// All extra clock domains a module references (`regAssignCd` /
/// `assertExprCd`), deduped by clock name, in source order.
def collectClockCds[ne: Nat](es: Vec[Expr] ne): List[ClockDomain] =
    list_reverse(collectClockCdsHelp(es, lnil))

// Collect clocked assignments (regAssign + regAssignCd + memWrite) for ONE clock
// domain. regAssign / memWrite belong to the module default cd only (isMain);
// regAssignCd(cd) belongs to that cd. when-nodes go to a cd only if they contain
// its regAssign (main uses any regAssign; extra cds use Cd-matched only).
/// The clocked statements (rendered by `exprVL`) belonging to ONE clock
/// domain: `regAssign` / `memWrite` only when `isMain`, `regAssignCd(cd)` when its
/// cd matches, and a `when` node only when it contains a matching regAssign
/// (main: any regAssign; extra cd: a Cd-matched one).
def collectClockLinesCd[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain, isMain: Boolean): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case regAssign(_, _) =>
            match isMain {
                case true => lcons (exprVL(e)) (collectClockLinesCd(tail, cd, isMain))
                case false => collectClockLinesCd(tail, cd, isMain)
            }
        case regAssignCd(_, _, c) =>
            let same = cdEq(c, cd);
            match same {
                case true => lcons (exprVL(e)) (collectClockLinesCd(tail, cd, isMain))
                case false => collectClockLinesCd(tail, cd, isMain)
            }
        case memWrite(_, _, _, _) =>
            match isMain {
                case true => lcons (exprVL(e)) (collectClockLinesCd(tail, cd, isMain))
                case false => collectClockLinesCd(tail, cd, isMain)
            }
        case when(_, _, _) =>
            // MAIN branch uses the main-domain predicate (regAssign OR memWrite):
            // a when holding only `regAssignCd(cd2)` belongs to cd2's block
            // (isMain=false below) and with the cd-agnostic hasRegAssign it was
            // ALSO collected here — the same assignment emitted twice (round-3
            // (K) root fix).  memWrite must stay included, see hasMainClocked.
            let has_clk = match isMain {
                case true => hasMainClocked(e)
                case false => hasRegAssignCd(e, cd)
            };
            match has_clk {
                case true => lcons (exprVL(e)) (collectClockLinesCd(tail, cd, isMain))
                case false => collectClockLinesCd(tail, cd, isMain)
            }
        case _ => collectClockLinesCd(tail, cd, isMain)
    }
}

// Collect ALL clocked lines regardless of cd (for has-clock detection)
/// ALL clocked lines regardless of clock domain (for has-clock
/// detection).
def collectClockLines[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case regAssign(_, _) => lcons (exprVL(e)) (collectClockLines tail)
        case regAssignCd(_, _, _) => lcons (exprVL(e)) (collectClockLines tail)
        case memWrite(_, _, _, _) => lcons (exprVL(e)) (collectClockLines tail)
        case when(_, _, _) =>
            let has_clk = hasRegAssign(e);
            match has_clk {
                case true => lcons (exprVL(e)) (collectClockLines tail)
                case false => collectClockLines tail
            }
        case _ => collectClockLines tail
    }
}

/// Internal-signal declaration section text (all wire/reg declaration
/// lines plus a trailing newline; "" when empty).
def wiresVL[ne: Nat](es: Vec[Expr] ne, portNames: List[String], whenSigs: List[String]): String =
    let ls = list_reverse(collectWireLines(es, portNames, whenSigs));
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Emit always @* blocks for when-nodes
/// Does the expr list contain a top-level `when` node?  NOTE: no call site
/// other than its own recursion — kept as a spare predicate, not wired into the
/// emitter.
def hasWhenInList[ne: Nat](es: Vec[Expr] ne): Boolean = match es {
    case nil => false
    case cons(e, tail) => match e {
        case when(_, _, _) => true
        case _ => hasWhenInList(tail)
    }
}

// Extract the driven signal name from a when block's body
/// The signal name driven by a when node's body: descends `assign` /
/// `block` / nested `when` and returns the LHS name ("" when the body drives
/// nothing).
def getWhenDrivenSigName(e: Expr): String = match e {
    case assign(lhs, _) => exprVL(lhs)
    case block(h, _) => getWhenDrivenSigName(h)
    case when(_, body, _) => getWhenDrivenSigName(body)
    case _ => ""
}

// Helper: process a single when expression, return its driven sig as a list
/// The driven signal of one when node as a singleton list, or `lnil`
/// when the when contains a clocked regAssign (clocked whens are not declared
/// `reg` from the combinational set).
def whenExprToSigList(e: Expr): List[String] =
    let has_clk = hasRegAssign(e);
    match has_clk {
        case true => lnil
        case false => lcons (getWhenDrivenSigName e) lnil
    }

// Collect signal names driven by non-clocked when blocks
/// The signal names driven by non-clocked when blocks — the set
/// declared `reg` and emitted inside the merged combinational always block.
def collectWhenDrivenSigs[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case when(_, _, _) => list_append(whenExprToSigList(e), collectWhenDrivenSigs tail)
        case _ => collectWhenDrivenSigs tail
    }
}

// Helper: get LHS name from an assign expr
/// The rendered LHS name of an `assign` ("" for other exprs).
def getAssignLhsName(e: Expr): String = match e {
    case assign(lhs, _) => exprVL(lhs)
    case _ => ""
}

// Helper: get RHS string from an assign expr
/// The rendered RHS string of an `assign` ("" for other exprs).
def getAssignRhsStr(e: Expr): String = match e {
    case assign(_, rhs) => exprVL(rhs)
    case _ => ""
}

// Helper: assign 的 LHS 是否 reg/outreg（含其位选/片选）。compat 的
// always @(*) 内 reg 赋值经 pickAssign（HDV002 分支）落成普通 assign
// 节点——此处判别后路由进合并 always 块做阻塞赋值。
/// Is an assign's LHS a reg / `output reg` (including its bit / part
/// selects)?  Verilog-compat `always @(*)` reg assignments arrive as plain
/// `assign` nodes through `pickAssign` (the HDV002 branch), and this predicate
/// routes them into the merged always block as blocking assignments.
def assignLhsIsReg(e: Expr): Boolean = match e {
    case assign(lhs, _) => isRegExpr(lhs)
    case _ => false
}

// Helper: check if a single assign expr should be emitted as a continuous assign
// Assigns touching a subSignal on EITHER side are port connections (collected
// by collectInstHelp), never continuous assigns — `u.port := sig` drives an
// instance input, `sig := u.port` reads an instance output; both become
// `.port(other_side)` connections.
//
// reg-LHS 的裸 assign 也不发连续赋值：IEEE 1364 连续赋值左值只能是 net，
// 对 reg 目标非法（iverilog: "reg y cannot be driven by primitives or
// continuous assignment"，2026-09-29 评审 P0-1，经 iverilog 12 实证）。
// 它们由 collectAlwaysBodyLines 的 reg 臂收进 always @(*) 做阻塞赋值。
/// Decide whether one assign expr becomes a CONTINUOUS assign: not a
/// when-driven LHS, no subSignal on either side (those are port connections), and
/// not a reg-LHS — IEEE 1364 allows only nets on a continuous-assign LHS, and
/// iverilog rejects `reg y` driven by a continuous assignment (review 2026-09-29
/// P0-1).
def assignLineCheck(e: Expr, whenSigs: List[String]): List[String] =
    let lhsName = getAssignLhsName(e);
    let isWhen = strInList(lhsName, whenSigs);
    match isWhen {
        case true => lnil
        case false =>
            let lhsSub = isSubSigAssign(e);
            match lhsSub {
                case true => lnil
                case false =>
                    let rhsSub = isSubSignalRhs(e);
                    match rhsSub {
                        case true => lnil
                        case false => match assignLhsIsReg(e) {
                            case true => lnil
                            case false => lcons (exprVL(e)) lnil
                        }
                    }
            }
    }

// Collect assign lines, skipping assigns whose LHS is in the when-driven set
/// The continuous-assign lines of an expr list, skipping every
/// declaration / regAssign / when / instance / assert / blackbox-marker node.
/// The explicit skip arms exist because the catch-all would otherwise emit
/// asserts and parameter markers as continuous assigns.
def collectAssignLinesFiltered[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case assign(_, _) => list_append(assignLineCheck(e, whenSigs), collectAssignLinesFiltered(tail, whenSigs))
        case create(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createIn(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createOut(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createInOut(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createInWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createInOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createReg(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createRegWidthCd(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createRegWidthInitCd(_, _, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntRegWidthCd(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntRegWidthInitCd(_, _, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutReg(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntInWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntInOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntOutRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntOutRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case regAssign(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case regAssignCd(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case literal(_) => collectAssignLinesFiltered(tail, whenSigs)
        case when(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case instance(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case instanceWithPorts(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case subSignal(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createMem(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case memRead(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case memWrite(_, _, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        // Explicit skip arms (design doc §1.3-6/§3.3): without these the
        // catch-all below would emit assert statements as continuous assigns.
        case assertExpr(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case assertExprCd(_, _, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        // blackbox parameter marker: pure emission channel, never a continuous
        // assign (same catch-all hazard as the asserts above)
        case bbMarkerExpr(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case _ => lcons (exprVL(e)) (collectAssignLinesFiltered(tail, whenSigs))
    }
}

// Helper: get cond from a when expr
/// The condition of a `when` node (`nop` for other exprs).
def getWhenCond(e: Expr): Expr = match e {
    case when(c, _, _) => c
    case _ => nop
}

// Helper: get body from a when expr
/// The body of a `when` node (`nop` for other exprs).
def getWhenBody(e: Expr): Expr = match e {
    case when(_, b, _) => b
    case _ => nop
}

// Emit one non-clocked when node as an independent if-block. The node body is
// a single assignment (createSignalExpr wraps each statement separately), so
// it emits `if (cond) begin lhs = rhs; end`.
/// One NON-clocked, assert-free when node as an independent
/// `if (cond) begin <body> end` ("" when the node is clocked or carries an
/// assert — `assertsVL` owns those).
def emitWhenLine(e: Expr): String =
    let has_clk = hasRegAssign(e);
    let has_asrt = hasAnyAssert(e);
    match has_clk {
        case true => ""
        case false => match has_asrt {
            // when-wrapped asserts are CLOCKED statements — assertsVL emits
            // them inside the translate_off block, never here.
            case true => ""
            case false =>
                let condStr = emitCondStr(getWhenCond(e));
                "    if (" + condStr + ") begin\n" + exprVL_proc(getWhenBody(e)) + "\n    end"
        }
    }

// Collect, in insertion order, the lines that belong in the single merged
// combinational always block:
//   - non-clocked when nodes → `if (cond) begin ... end`
//   - plain assigns whose LHS is a when-driven signal → blocking default in
//     source order (a bare `x := v` after a when is last-wins by insertion
//     order; use `otherwise` for else semantics)
// Each assignment carries its FULL enable condition (see hdl-core.typort
// WhenStack), so independent whens stay independent, nested whens are folded
// into the condition, and no else-if chain reconstruction is needed.
/// In insertion order, the lines of the single merged combinational always
/// block: non-clocked assert-free when nodes as independent `if` blocks, and
/// plain assigns whose LHS is when-driven (or a reg) as blocking assignments.
/// Each assignment carries its FULL enable condition, so independent whens stay
/// independent and nested whens are folded into the condition — a later bare
/// `x := v` is last-wins by source order; use `otherwise` for else semantics.
def collectAlwaysBodyLines[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case when(_, _, _) =>
            let has_clk = hasRegAssign(e);
            let has_asrt = hasAnyAssert(e);
            match has_clk {
                case true => collectAlwaysBodyLines(tail, whenSigs)
                case false => match has_asrt {
                    // assert-only when nodes emit nothing here (assertsVL owns
                    // them) — skip the element entirely so a lone assert-when
                    // does not produce an empty `always @(*)` block.
                    case true => collectAlwaysBodyLines(tail, whenSigs)
                    case false => lcons (emitWhenLine(e)) (collectAlwaysBodyLines(tail, whenSigs))
                }
            }
        case assign(_, _) =>
            let lhsName = getAssignLhsName(e);
            let isWhen = strInList(lhsName, whenSigs);
            match isWhen {
                case true => lcons ("    " + lhsName + " = " + getAssignRhsStr(e) + ";") (collectAlwaysBodyLines(tail, whenSigs))
                case false => match assignLhsIsReg(e) {
                    // P0-1：compat always @(*) 内的 reg 赋值（pickAssign 的
                    // HDV002 分支产出的裸 assign）——阻塞赋值收进本合并块。
                    // 阻塞赋值的 reg 左值允许位选/片选（`y[3:0] = v;` 合法）。
                    case true => lcons ("    " + lhsName + " = " + getAssignRhsStr(e) + ";") (collectAlwaysBodyLines(tail, whenSigs))
                    case false => collectAlwaysBodyLines(tail, whenSigs)
                }
            }
        case _ => collectAlwaysBodyLines(tail, whenSigs)
    }
}

// Build a single merged always block: every when-driven combinational
// assignment becomes an independent if (or blocking default) in source order.
/// Wrap the collected body lines as `always @(*) begin ... end` ("" when
/// there is nothing to drive).
def buildMergedAlwaysBlock[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    let lines = list_reverse(collectAlwaysBodyLines(es, whenSigs));
    match lines {
        case lnil => ""
        case _ => "  always @(*) begin\n" + joinLines(lines) + "\n  end\n"
    }

/// The combinational always-block section text for a module's expr
/// list.
def alwaysVL[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    buildMergedAlwaysBlock(es, whenSigs)

/// The continuous-assign section text (all filtered assign lines plus a
/// trailing newline; "" when empty).
def assignsVL[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    let ls = list_reverse(collectAssignLinesFiltered(es, whenSigs));
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Generate reg declarations (with leading newline if non-empty)
/// The reg-declaration section text (all reg lines plus a trailing newline;
/// "" when empty).
def regsVL[ne: Nat](es: Vec[Expr] ne, portNames: List[String]): String =
    let ls = list_reverse(collectRegLines es portNames);
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Generate clocked always @(posedge clk) block from regAssign entries
/// Are there any clocked lines at all (regAssign / regAssignCd / memWrite /
/// clocked when)?
def hasClockLines[ne: Nat](es: Vec[Expr] ne): Boolean =
    match list_reverse(collectClockLines es) {
        case lnil => false
        case _ => true
    }

// Helper: add 2-space indent to each line in a list (handles multi-line strings)
/// Prepend two spaces to every line of each string (multi-line statements are
/// indented line-by-line).
def indentLines(ls: List[String]): List[String] = match ls {
    case lnil => lnil
    case lcons(s, tail) => lcons ("  " + str_indent2(s)) (indentLines tail)
}

// ---- Clock domain helpers (names / edge keywords from a ClockDomain) ----

/// The clock-domain clock name.
def clockName(cd: ClockDomain): String = cd.clockName

/// The clock-domain reset name.
def resetName(cd: ClockDomain): String = cd.resetName

/// `posedge` / `negedge` for the clock edge.
def clockEdgeStr(cd: ClockDomain): String = match cd.clockEdge {
    case RisingEdge => "posedge"
    case FallingEdge => "negedge"
}

/// `posedge` / `negedge` for the reset POLARITY (ActiveHigh -> posedge,
/// ActiveLow -> negedge).
def resetEdgeStr(cd: ClockDomain): String = match cd.resetPolarity {
    case ActiveHigh => "posedge"
    case ActiveLow => "negedge"
}

// Reset condition text: "reset" or "!reset" for ActiveLow
/// The reset condition text: `reset` for ActiveHigh, `!reset` for
/// ActiveLow.
def resetCondStr(cd: ClockDomain): String = match cd.resetPolarity {
    case ActiveHigh => resetName(cd)
    case ActiveLow => "!" + resetName(cd)
}

// ---- assert collection & block emission (mirror of the clocked family) ----

// Assert lines for ONE statement node, for clock domain `cd` (isMain: plain
// assertExpr belongs to the module default cd only; assertExprCd goes to its
// own cd). when-wrapped asserts nest inside an `if (cond)` — the wrapper is
// collected only when its body contains a matching assert, mirroring
// collectClockLinesCd's when gating. Blocks recurse (defensive; generated
// trees wrap one statement per when node).
/// Assert lines for ONE statement node and clock domain `cd`:
/// `assertExpr` only when `isMain`, `assertExprCd` when its cd matches; a `when`
/// wrapper is emitted as `if (cond) begin` + the indented inner lines + `end`
/// only when its body contains a matching assert.  Blocks recurse (defensive:
/// generated trees wrap one statement per when node).  A blackbox parameter
/// marker contributes nothing.
def collectAssertLinesOne(e: Expr, cd: ClockDomain, isMain: Boolean): List[String] = match e {
    // with the dedicated bbMarkerExpr marker channel, EVERY assertExpr node is
    // a user assert — no marker discrimination left here
    case assertExpr(c, m, s) =>
        match isMain {
            case true => lcons (assertLineRaw(emitCondStr(c), m, s)) lnil
            case false => lnil
        }
    case assertExprCd(c, m, s, cdc) =>
        let same = cdEq(cdc, cd);
        match same {
            case true => lcons (assertLineRaw(emitCondStr(c), m, s)) lnil
            case false => lnil
        }
    // blackbox parameter marker: not an assert — skipping it here is NOT the
    // assert arm's business (bbIsBlackBox/bbStubParams/collectInstHelp own
    // the marker channel). Before the dedicated bbMarkerExpr variant this
    // predicate had to special-case the literal-cond markers.
    case bbMarkerExpr(_, _) => lnil
    case when(cond, body, elseBody) =>
        let inner = match elseBody {
            case None => collectAssertLinesOne(body, cd, isMain)
            case Some(eb) => list_append(collectAssertLinesOne(body, cd, isMain), collectAssertLinesOne(eb, cd, isMain))
        };
        match inner {
            case lnil => lnil
            case _ =>
                // the wrapper stays at base indent; only the nested body is
                // indented one level
                let opened = lcons ("    if (" + emitCondStr(cond) + ") begin") (indentLines inner);
                list_append(opened, lcons "    end" lnil)
        }
    case block(head, tail) =>
        list_append(collectAssertLinesOne(head, cd, isMain), collectAssertLinesOne(tail, cd, isMain))
    case _ => lnil
}

// Collect assert lines across a module's whole expr list, for ONE cd.
// Each statement is folded into ONE string (joinLines) BEFORE consing, so the
// trailing list_reverse in assertsBlockVL flips whole statements — never the
// lines inside one statement (the collectClockLinesCd discipline).
/// Assert lines across a module's whole expr list for ONE cd, one entry
/// per statement: each statement's lines are joined BEFORE consing, so the later
/// `list_reverse` in `assertsBlockVL` flips whole statements and never the lines
/// inside one.
def collectAssertLinesCd[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain, isMain: Boolean): List[String] = match es {
    case nil => lnil
    case cons(e, tail) =>
        let line = joinLines(collectAssertLinesOne(e, cd, isMain));
        match str_eq(line, "") {
            case true => collectAssertLinesCd(tail, cd, isMain)
            case false => lcons line (collectAssertLinesCd(tail, cd, isMain))
        }
}

// The translate_off-wrapped assertion block for ONE clock domain (no reset
// branch — asserts never reset). Empty when the domain has no assert lines:
//   // synthesis translate_off
//   always @(posedge clk) begin
//     if (!(count < 100)) begin
//       $display("TYPORT_ASSERT_ERROR %0t %m: count overflow", $time);
//     end
//   end
//   // synthesis translate_on
/// The assertion block for ONE clock domain (no reset branch — asserts
/// never reset; "" when the domain has no assert lines): `// synthesis
/// translate_off`, `always @(<edge> <clk>) begin`, the assert statements, `end`,
/// `// synthesis translate_on`.  The comment marker is composed from
/// `"/" + "/"` because the typort lexer strips `//` inside string literals.
def assertsBlockVL[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain, isMain: Boolean): String =
    let ls = list_reverse(collectAssertLinesCd(es, cd, isMain));
    match ls {
        case lnil => ""
        case _ =>
            // NOTE: the typort lexer strips `//` inside string literals as a
            // line comment, so the Verilog comment marker is composed here.
            let cm = "/" + "/";
            let header = "  " + cm + " synthesis translate_off
" + "  always @" + "(" + clockEdgeStr(cd) + " " + clockName(cd) + ") begin
";
            let tail_line = "
  end
  " + cm + " synthesis translate_on
";
            header + joinLines(ls) + tail_line
    }

// Recursively emit assert blocks for the EXTRA cds (skipping the main cd),
// using the merged collectClockCds list (assertExprCd domains included).
/// `assertsBlockVL` for every EXTRA clock domain (skipping any cd equal to
/// the main one).
def assertsExtrasVL[ne: Nat](es: Vec[Expr] ne, mainCd: ClockDomain, cds: List[ClockDomain]): String = match cds {
    case lnil => ""
    case lcons(c, tail) =>
        let sameAsMain = cdEq(c, mainCd);
        match sameAsMain {
            case true => assertsExtrasVL(es, mainCd, tail)
            case false =>
                let ab = assertsBlockVL(es, c, false);
                ab + assertsExtrasVL(es, mainCd, tail)
        }
}

// All assert blocks of a module: main cd first, then extra-cd blocks.
/// All assertion blocks of a module: the main clock domain first, then one
/// block per extra cd (`collectClockCds`).
def assertsVL[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain): String =
    let main = assertsBlockVL(es, cd, true);
    let extras = collectClockCds es;
    main + assertsExtrasVL(es, cd, extras)

// Collect reset-init lines for ONE clock domain. Non-Cd init regs belong to
// the module default cd only (isMain=true); createRegWidthInitCd belongs to
// its own cd.
/// Reset-init lines (`    <name> <= <literal>;`) for ONE clock domain: the
/// plain `*Init` factories only when `isMain`, the `*InitCd` factories when their
/// cd matches.  The literal comes from `verilogLiteral`.
def collectInitLinesCd[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain, isMain: Boolean): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case createRegWidthInit(name, _, initVal) =>
            match isMain {
                case true => lcons ("    " + name + " <= " + verilogLiteral(initVal) + ";") (collectInitLinesCd(tail, cd, isMain))
                case false => collectInitLinesCd(tail, cd, isMain)
            }
        case createSIntRegWidthInit(name, _, initVal) =>
            match isMain {
                case true => lcons ("    " + name + " <= " + verilogLiteral(initVal) + ";") (collectInitLinesCd(tail, cd, isMain))
                case false => collectInitLinesCd(tail, cd, isMain)
            }
        case createOutRegWidthInit(name, _, initVal) =>
            match isMain {
                case true => lcons ("    " + name + " <= " + verilogLiteral(initVal) + ";") (collectInitLinesCd(tail, cd, isMain))
                case false => collectInitLinesCd(tail, cd, isMain)
            }
        case createSIntOutRegWidthInit(name, _, initVal) =>
            match isMain {
                case true => lcons ("    " + name + " <= " + verilogLiteral(initVal) + ";") (collectInitLinesCd(tail, cd, isMain))
                case false => collectInitLinesCd(tail, cd, isMain)
            }
        case createRegWidthInitCd(name, _, initVal, c) =>
            let same = cdEq(c, cd);
            match same {
                case true => lcons ("    " + name + " <= " + verilogLiteral(initVal) + ";") (collectInitLinesCd(tail, cd, isMain))
                case false => collectInitLinesCd(tail, cd, isMain)
            }
        case createSIntRegWidthInitCd(name, _, initVal, c) =>
            let same = cdEq(c, cd);
            match same {
                case true => lcons ("    " + name + " <= " + verilogLiteral(initVal) + ";") (collectInitLinesCd(tail, cd, isMain))
                case false => collectInitLinesCd(tail, cd, isMain)
            }
        case _ => collectInitLinesCd(tail, cd, isMain)
    }
}

// Emit ONE clocked always block for an EXTRA cd (non-main: only Cd-init)
/// ONE clocked always block for an EXTRA clock domain (non-main: only the
/// Cd-matched statements and init regs).  The reset edge enters the sensitivity
/// list only for an `Async` domain that actually needs a reset branch; `Sync`
/// keeps it out.
def clockedBlockExtraVL[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain): String =
    let ls = list_reverse(collectClockLinesCd(es, cd, false));
    let has_clk = match ls {
        case lnil => false
        case _ => true
    };
    let init_lines = list_reverse(collectInitLinesCd(es, cd, false));
    let need_reset = match init_lines {
        case lnil => false
        case _ => true
    };
    match has_clk {
        case false => ""
        case true =>
            let clk_edge = clockEdgeStr(cd);
            let clk_nm = clockName(cd);
            let reset_cond = resetCondStr(cd);
            match need_reset {
                case false =>
                    "  always @" + "(" + clk_edge + " " + clk_nm + ") begin
" + joinLines(ls) + "
" + "  end
"
                case true =>
                    let header = match cd.config {
                        case Async =>
                            let reset_edge = resetEdgeStr(cd);
                            let reset_nm = resetName(cd);
                            "  always @" + "(" + clk_edge + " " + clk_nm + " or " + reset_edge + " " + reset_nm + ") begin
"
                        case Sync =>
                            "  always @" + "(" + clk_edge + " " + clk_nm + ") begin
"
                    };
                    let indented_init = indentLines(init_lines);
                    let indented_clk = indentLines(ls);
                    header + "    if (" + reset_cond + ") begin
" + joinLines(indented_init) + "
    end else begin
" + joinLines(indented_clk) + "
    end
  end
"
            }
    }

// Emit ONE clocked always block for the main cd (only if it has lines)
/// ONE clocked always block for the MAIN clock domain ("" when it has no
/// clocked lines).  The reset edge enters the sensitivity list when a generated
/// reset branch exists (init regs) or the source DECLARED the reset as a real
/// port (Verilog-compat writes its own reset body); an `Async` domain is required
/// for the edge to be emitted.  The reset branch itself
/// (`if (<resetCond>) begin <inits> end else begin <clocked> end`) exists only
/// when there are init lines.
def clockedBlockVL[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain, resetDeclared: Boolean): String =
    let ls = list_reverse(collectClockLinesCd(es, cd, true));
    let has_clk = match ls {
        case lnil => false
        case _ => true
    };
    let init_lines = list_reverse(collectInitLinesCd(es, cd, true));
    let need_reset = match init_lines {
        case lnil => false
        case _ => true
    };
    // The reset edge belongs in the sensitivity list in two cases: the module
    // init `reg ... = v` values (generated reset branch, need_reset), or the
    // source declared the reset as a port (Verilog-compat writes the reset
    // body itself). A Sync clock domain keeps the edge out of the list.
    let want_edge = match need_reset {
        case true => true
        case false => resetDeclared
    };
    let is_async = match cd.config {
        case Async => true
        case Sync => false
    };
    let edge_in_header = match want_edge {
        case false => false
        case true => is_async
    };
    match has_clk {
        case false => ""
        case true =>
            let clk_edge = clockEdgeStr(cd);
            let clk_nm = clockName(cd);
            let reset_cond = resetCondStr(cd);
            let header = match edge_in_header {
                case false =>
                    "  always @" + "(" + clk_edge + " " + clk_nm + ") begin
"
                case true =>
                    let reset_edge = resetEdgeStr(cd);
                    let reset_nm = resetName(cd);
                    "  always @" + "(" + clk_edge + " " + clk_nm + " or " + reset_edge + " " + reset_nm + ") begin
"
            };
            let inner = match need_reset {
                case false => joinLines(ls) + "
"
                case true =>
                    let indented_init = indentLines(init_lines);
                    let indented_clk = indentLines(ls);
                    "    if (" + reset_cond + ") begin
" + joinLines(indented_init) + "
    end else begin
" + joinLines(indented_clk) + "
    end
"
            };
            header + inner + "  end
"
    }


/// `clockedBlockExtraVL` for every extra clock domain (skipping the main
/// one).
def clockedExtrasVL[ne: Nat](es: Vec[Expr] ne, mainCd: ClockDomain, cds: List[ClockDomain]): String = match cds {
    case lnil => ""
    case lcons(c, tail) =>
        let sameAsMain = cdEq(c, mainCd);
        match sameAsMain {
            case true => clockedExtrasVL(es, mainCd, tail)
            case false =>
                let eb = clockedBlockExtraVL(es, c);
                eb + clockedExtrasVL(es, mainCd, tail)
        }
}

// Collect reset-init lines for ONE clock domain. Non-Cd init regs belong to
// the module default cd only (isMain=true); createRegWidthInitCd belongs to
// its own cd.
/// ALL clocked always blocks of a module: the main-cd block — with
/// `resetDeclared` mirroring whether the cd's reset name is a REAL port, which is
/// true for Verilog-compat folded `input reset` / `rst_n` — followed by one block
/// per extra cd.
def clockedVL[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain, resetDeclared: Boolean): String =
    let main = clockedBlockVL(es, cd, resetDeclared);
    let extras = collectClockCds es;
    let extraBlocks = clockedExtrasVL(es, cd, extras);
    main + extraBlocks

// ============================================================
//  Hierarchical Verilog Generation (ModuleTree-based)
// ============================================================
//
// Instance port connections ARE implemented — see `collectInstHelp` /
// `filterConns` below (an older note here claimed the port list was still
// empty and deferred to an architecture upgrade; that is obsolete).

/// Join port connections with ", " for an instantiation port list.
def joinPortConns(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + ", " + joinPortConns(tail)
}

// Helpers to decompose assign(lhs, rhs) / subSignal(inst, port) without
// nested constructor patterns (which the match compiler does not handle).
/// The LHS Expr of an `assign` (`nop` for other exprs) — a decomposition
/// helper avoiding nested constructor patterns, which the match compiler does not
/// handle.
def getAssignLhsExpr(e: Expr): Expr = match e {
    case assign(lhs, _) => lhs
    case _ => nop
}

/// The RHS Expr of an `assign` (`nop` for other exprs).
def getAssignRhsExpr(e: Expr): Expr = match e {
    case assign(_, rhs) => rhs
    case _ => nop
}

/// The instance name of a `subSignal(inst, port)` handle ("" otherwise).
def getSubSignalInst(e: Expr): String = match e {
    case subSignal(inst, _) => inst
    case _ => ""
}

/// The port name of a `subSignal(inst, port)` handle ("" otherwise).
def getSubSignalPort(e: Expr): String = match e {
    case subSignal(_, port) => port
    case _ => ""
}

// Collect ".port(sig)" connections for one instance from assign(subSignal(inst, port), rhs) exprs.
// This lets instance port connections be expressed type-safely: the module
// macro's port fields are subSignal handles, so `u.a := sig` in the parent
// records assign(subSignal(inst, port), sig) here.


// Collect ".port(sig)" connections for one instance from assigns touching a
// subSignal on either side:
//   u.port := sig    (subSignal LHS)  →  .port(sig)
//   sig := u.port    (subSignal RHS)  →  .port(sig)   (read child output)
// The connection name comes from the module macro's port fields, which are
// subSignal handles, so `u.a := sig` in the parent records
// assign(subSignal(inst, port), sig) here.
//
// NOTE (direction): the generator has no port-direction knowledge (the child
// ModuleDef is not stored in the parent tree), so a complex RHS on
// `u.port := expr` is emitted as `.port(expr)` verbatim — legal for input
// ports, illegal for output ports. Driving a child's output port is not
// supported: read it instead (`sig := u.port`).


// Generate instance instantiation lines with port connections.
// Filter connections belonging to one instance from parallel seen lists.
// (pattern_match misbinds closure variables referenced inside match branches,
// so everything here is threaded through pattern variables only.)
/// Filter the connections belonging to one instance out of the parallel
/// seen-instance / seen-connection lists.  Everything is threaded through pattern
/// variables only, because the match compiler misbinds closure variables
/// referenced inside match branches.
def filterConns(instName: String, seenInsts: List[String], seenConns: List[String]): List[String] = match seenInsts {
    case lnil => lnil
    case lcons(i, restInsts) => match seenConns {
        case lcons(c, restConns) =>
            let is_inst = str_eq(i, instName);
            match is_inst {
                case true => lcons (c) (filterConns(instName, restInsts, restConns))
                case false => filterConns(instName, restInsts, restConns)
            }
        case lnil => lnil
    }
}

/// Walk the exprs collecting instantiation lines: `instance` nodes become
/// `Name inst (.a(x), ...);` with the connections filtered per instance; an
/// INSTANCE `bbMarkerExpr` immediately after the instance injects the
/// ` #(.K(v), ...)` parameter suffix (a pure literal pick-up — the values come
/// from the declared blackbox's own generics, not the instantiation site);
/// `instanceWithPorts` is emitted verbatim; and assigns touching a subSignal on
/// EITHER side become `.port(other)` connections (`u.port := sig` and
/// `sig := u.port` both work).  There is no port-direction knowledge here — the
/// child ModuleDef is not in the parent tree — so a complex RHS on
/// `u.port := expr` is emitted verbatim: legal for an input port, illegal for an
/// output port (read a child output instead).
def collectInstHelp[elen: Nat](exprs: Vec[Expr] elen, seenInsts: List[String], seenConns: List[String]): List[String] = match exprs {
    case nil => lnil
    case cons(e, tail) => match e {
        case instance(instName, moduleName) =>
            let conns = filterConns(instName, seenInsts, seenConns);
            let portStr = match conns {
                case lnil => "()"
                case _ => "(" + joinPortConns(conns) + ")"
            };
            // BlackBox parameter injection (§4.3, marker channel — see §4.5-3):
            // the INSTANCE marker (bbMarkerExpr(isInst=true, ...)) the blackbox
            // macro left immediately after this instance node carries the
            // create-time-rendered " #(.K(v), ...)" string, so a declared
            // blackbox becomes `Name #(.K(v), ...)` with a pure literal pick-up
            // (no global read: plain modules and generic-less blackboxes carry
            // no marker and keep the bare name). Values come from the declared
            // blackbox's own generic statements, not the instantiation site.
            // USER asserts are never markers (dedicated bbMarkerExpr variant,
            // R2 review P1 fix): a plain `assert(true.into, "sanity")` before
            // the create can no longer be consumed here.
            match tail {
                case cons(e2, t2) =>
                    match e2 {
                        case bbMarkerExpr(isInst, m) =>
                            match isInst {
                                case true =>
                                    lcons ("  " + moduleName + m + " " + instName + " " + portStr + ";") (collectInstHelp(t2, seenInsts, seenConns))
                                case false =>
                                    lcons ("  " + moduleName + " " + instName + " " + portStr + ";") (collectInstHelp(tail, seenInsts, seenConns))
                            }
                        case _ =>
                            lcons ("  " + moduleName + " " + instName + " " + portStr + ";") (collectInstHelp(tail, seenInsts, seenConns))
                    }
                case _ =>
                    lcons ("  " + moduleName + " " + instName + " " + portStr + ";") (collectInstHelp(tail, seenInsts, seenConns))
            }
        case instanceWithPorts(instName, moduleName, ports) =>
            lcons ("  " + moduleName + " " + instName + " (" + ports + ");") (collectInstHelp(tail, seenInsts, seenConns))
        // blackbox parameter marker at walk position (e.g. the SELF marker in
        // the blackbox def itself, or any marker not preceded by its instance):
        // carries no connection — skip explicitly, the subSignal machinery
        // below is assign-shaped only
        case bbMarkerExpr(_, _) => collectInstHelp(tail, seenInsts, seenConns)
        case _ =>
            let lhs = getAssignLhsExpr(e);
            let lhs_ss = isSubSignal(lhs);
            match lhs_ss {
                case true =>
                    let inst = getSubSignalInst(lhs);
                    let port = getSubSignalPort(lhs);
                    let rhs = getAssignRhsExpr(e);
                    let conn = "." + port + "(" + exprVL(rhs) + ")";
                    collectInstHelp(tail, lcons inst seenInsts, lcons conn seenConns)
                case false =>
                    let rhs = getAssignRhsExpr(e);
                    let rhs_ss = isSubSignal(rhs);
                    match rhs_ss {
                        case true =>
                            let inst = getSubSignalInst(rhs);
                            let port = getSubSignalPort(rhs);
                            let conn = "." + port + "(" + exprVL(lhs) + ")";
                            collectInstHelp(tail, lcons inst seenInsts, lcons conn seenConns)
                        case false => collectInstHelp(tail, seenInsts, seenConns)
                    }
            }
    }
}

/// All instantiation lines of a module's expr list (`collectInstHelp`
/// seeded with empty seen lists).
def collectInstanceLinesTree[elen: Nat](exprs: Vec[Expr] elen): List[String] = collectInstHelp(exprs, lnil, lnil)

// Append clk/reset ports for every extra clock domain referenced by
// regAssignCd (dedup list from collectClockCds). Reset port only added when
// that cd has init regs.
/// Append `input wire <clk>` for every extra clock domain, plus
/// `input wire <reset>` when that cd has init regs, skipping the main cd.  Handles
/// the first-port case with no leading comma (an assert-only extra cd can be a
/// module's ONLY clock content).
def extraCdPortsVL[ne: Nat](es: Vec[Expr] ne, cds: List[ClockDomain], acc: String, mainCd: ClockDomain): String = match cds {
    case lnil => acc
    case lcons(c, tail) =>
        let isMain = cdEq(c, mainCd);
        match isMain {
            case true => extraCdPortsVL(es, tail, acc, mainCd)
            case false =>
                let clk_nm = clockName(c);
                let reset_nm = resetName(c);
                let initLines = list_reverse(collectInitLinesCd(es, c, false));
                let hasInit = match initLines {
                    case lnil => false
                    case _ => true
                };
                let acc1 = match str_eq(acc, "") {
                    // First appended port (possible now that an assert-only
                    // extra cd can be a module's ONLY clock content): no
                    // leading comma.
                    case true => "  input wire " + clk_nm
                    case false => acc + "," + "\n" + "  input wire " + clk_nm
                };
                let acc2 = match hasInit {
                    case false => acc1
                    case true => acc1 + "," + "\n" + "  input wire " + reset_nm
                };
                extraCdPortsVL(es, tail, acc2, mainCd)
        }
}

// The ORIGINAL module emission body (plain, non-blackbox path), kept verbatim;
// moduleDefVL above dispatches registered blackboxes to the guarded stub.
/// The plain (non-blackbox) module emission body, in this order: the
/// when-driven set, port names, then each section — ports, wires, regs, memories,
/// continuous assigns, clocked blocks, assertion blocks, merged combinational
/// always, instances.  Synthesizes `input wire <clk>` exactly when a clocked
/// always block (or a main-cd assert) is actually emitted AND the source did not
/// declare it (a Verilog-compat folded `input clk` is already a real port), and
/// `input wire <reset>` when there are main-cd init regs and it is not already a
/// port; appends the extra-cd ports; wraps everything as
/// `module <name> (<ports>); ... endmodule`.
def moduleDefVLPlain(md: ModuleDef): String =
    let whenSigs = list_reverse(collectWhenDrivenSigs md.expr);
    let port_names = collectPortNames md.expr;
    let port_decls = portsVL(md.expr, whenSigs);
    let port_lines = list_reverse(collectPortLines(md.expr, whenSigs));
    let wire_decls = wiresVL(md.expr, port_names, whenSigs);
    let reg_decls = regsVL(md.expr, port_names);
    let mem_decls = memsVL(md.expr);
    let assigns = assignsVL(md.expr, whenSigs);
    let always = alwaysVL(md.expr, whenSigs);
    let clocked = clockedVL(md.expr, md.cd, strInList(resetName(md.cd), port_names));
    let inst_lines = list_reverse(collectInstanceLinesTree md.expr);
    let has_regs = match list_reverse(collectRegLines md.expr port_names) {        case lnil => false
        case _ => true
    };
    let has_out_regs = hasOutRegPorts md.expr;
    // Registers/output-reg ports/memories declare storage declarations, but
    // the CLOCK port is needed exactly when a clocked always block is emitted
    // (any regAssign/regAssignCd/memWrite, possibly under `when`). Counting
    // storage declarations instead would add a spurious clk port to purely
    // combinational modules — Verilog-compat `always @(*)` drives its regs
    // combinationally（经 assignLhsIsReg 路由进合并 always @(*) 块的阻塞
    // 赋值，非时钟块），so `clocked` stays "".
    let has_reg_any = match has_regs {
        case false => has_out_regs
        case true => true
    };
    // A main-cd assert ALSO forces the clock port: assertions are always
    // clocked (SpinalHDL semantics), so a purely combinational module with an
    // assert still gets `input wire clk` (its block lives in assertsVL below).
    // Extra-cd assert ports come via collectClockCds/extraCdPortsVL instead.
    let has_assert_main = match list_reverse(collectAssertLinesCd(md.expr, md.cd, true)) {
        case lnil => false
        case _ => true
    };
    let has_seq = match str_eq(clocked, "") {
        case true => has_assert_main
        case false => true
    };
    let has_ports = match port_lines {
        case lnil => false
        case _ => true
    };
    let has_instances = match inst_lines {
        case lnil => false
        case _ => true
    };
    let mainInitLines = list_reverse(collectInitLinesCd(md.expr, md.cd, true));
    let has_init = match mainInitLines {
        case lnil => false
        case _ => true
    };
    let clk_nm = clockName(md.cd);
    let reset_nm = resetName(md.cd);
    // Verilog-compat modules declare `input clk` / `reset` / `rst_n` and the
    // module arm turns them into real ports, so the synthesized clock/reset
    // ports must not be added a second time (they would duplicate the
    // declaration). Typort-style modules keep the implicit clock: it is
    // synthesized here.
    let clk_declared = strInList(clk_nm, port_names);
    let reset_declared = strInList(reset_nm, port_names);
    let p0 = port_decls;
    let p1 = match has_seq {
        case false => p0
        case true => match clk_declared {
            case true => p0
            case false => match has_ports {
                case false => "  input wire " + clk_nm
                case _ => p0 + ",\n  input wire " + clk_nm
            }
        }
    };
    let p2 = match has_init {
        case false => p1
        case true => match reset_declared {
            case true => p1
            case false => match has_reg_any {
                case false => match has_ports {
                    case false => "  input wire " + reset_nm
                    case true => port_decls + ",\n  input wire " + reset_nm
                }
                case true => p1 + ",\n  input wire " + reset_nm
            }
        }
    };
    let has_no_port_content = match has_ports {
        case false => match has_seq {
            case false => match has_init {
                case false => true
                case true => false
            }
            case true => false
        }
        case true => false
    };
    let extras = collectClockCds md.expr;
    let p3 = extraCdPortsVL(md.expr, extras, p2, md.cd);
    let has_extra_ports = match extras {
        case lnil => false
        case _ => true
    };
    let header = match has_no_port_content {
        case true => match has_extra_ports {
            case true => "module " + md.name + " (\n" + p3 + "\n);\n"
            case false => "module " + md.name + " ();\n"
        }
        case false => "module " + md.name + " (\n" + p3 + "\n);\n"
    };
    let body = header + wire_decls + reg_decls + mem_decls + assigns + clocked + assertsVL(md.expr, md.cd) + always;
    let body_with_inst = match has_instances {
        case false => body
        case true => body + joinLines(inst_lines) + "\n"
    };
    body_with_inst + "endmodule"

// Generate Verilog for a single ModuleDef. A registered blackbox def emits
// the guarded empty stub instead of the full body; everything else takes the
// plain path above (original body, verbatim).
/// Verilog for one ModuleDef: a blackbox (SELF marker present) emits the
/// guarded empty stub `blackboxDefVL(md, bbStubParams(md.expr))`; everything else
/// takes the plain path `moduleDefVLPlain`.
def moduleDefVL(md: ModuleDef): String = match bbIsBlackBox(md.expr) {
    case true => blackboxDefVL(md, bbStubParams(md.expr))
    case false => moduleDefVLPlain(md)
}

// Generate Verilog for all ModuleDefs in a Vec
/// `moduleDefVL` for every ModuleDef in a Vec, in order.
def collectModuleVLs[n: Nat](data: Vec[ModuleDef] n): List[String] = match data {
    case nil => lnil
    case cons(md, tail) => lcons (moduleDefVL(md)) (collectModuleVLs tail)
}

// Generate Verilog for all modules in the design (multi-module hierarchical output)
// Takes a ModuleTree (obtained via `m.tree` on a module value implementing `Module`).
/// Verilog for EVERY module of a module tree (`t.data`), joined by
/// newlines — the multi-module hierarchical output.
def allModulesVL(t: ModuleTree): String =
    let ls = list_reverse(collectModuleVLs t.data);
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Alias: moduleTreeVL is the public API expected by test/legacy_tests
// Extracts the first ModuleDef from a module tree and generates Verilog.
// Usage: moduleTreeVL(myModule.create.tree)
/// Verilog for the FIRST ModuleDef of a tree — the single-module public
/// API (`moduleTreeVL(m.create.tree)`).  A single tree does not carry its
/// submodule definitions; use `designVL` for a self-contained output.
def moduleTreeVL(t: ModuleTree): String =
    let mod_def = headModuleDef(t.data);
    moduleDefVL(mod_def)

// ── Design emission (self-contained output) ──────────────────────────────
// A single ModuleTree does not carry submodule definitions (each module
// builds its own tree; see ModuleRegistry in hdl-core.typort). designVL
// takes the TOP module's tree and pulls every transitively instantiated def
// from the registry, so the output is self-contained — every instantiated
// name has its `module ... endmodule` definition, as verilator requires.

// Instance records sit flat in a ModuleDef's expr list (mkInstance /
// mkInstancePorts add them directly, not under when-wrappers).
/// The module names instantiated by a def (the flat `instance` /
/// `instanceWithPorts` records in its expr list).
def instNamesOfDef[n: Nat](exprs: Vec[Expr] n): List[String] = match exprs {
    case nil => lnil
    case cons(e, rest) => match e {
        case instance(_, m) => lcons(m, instNamesOfDef rest)
        case instanceWithPorts(_, m, _) => lcons(m, instNamesOfDef rest)
        case _ => instNamesOfDef rest
    }
}

/// Find a `ModuleDef` by name, falling back to an EMPTY def (`""` name)
/// when absent.
def lookupModuleDef[n: Nat](defs: Vec[ModuleDef] n, name: String): ModuleDef = match defs {
    case nil => ModuleDef.mk("", defaultClockDomain, 0, nil)
    case cons(md, rest) => match str_eq(md.name, name) {
        case true => md
        case false => lookupModuleDef(rest, name)
    }
}

// Worklist walk from the top over instance edges; returns visited names
// (top first, children deduped by name).
/// Worklist walk from a starting queue over instance edges, returning the
/// visited names (start first, children deduped by name, accumulating in
/// reverse).
def designVisit[n: Nat](defs: Vec[ModuleDef] n, seen: List[String], queue: List[String], acc: List[String]): List[String] = match queue {
    case lnil => acc
    case lcons(name, rest) => match chkStrIn(name, seen) {
        case true => designVisit(defs, seen, rest, acc)
        case false =>
            let md = lookupModuleDef(defs, name);
            let seen2 = lcons(name, seen);
            let queue2 = rest.append(instNamesOfDef(md.expr));
            designVisit(defs, seen2, queue2, lcons(name, acc))
    }
}

/// `moduleDefVL` for each name of a design-closure name list, looking the defs
/// up in the registry.
def renderDesignNames[n: Nat](defs: Vec[ModuleDef] n, names: List[String]): List[String] = match names {
    case lnil => lnil
    case lcons(name, rest) => lcons(moduleDefVL(lookupModuleDef(defs, name)), renderDesignNames(defs, rest))
}

// Public API: Verilog for the top module plus every registered module it
// transitively instantiates. Usage: designVL(myTop.create.tree)
/// PUBLIC API: self-contained Verilog for the top module plus every
/// registered module it transitively instantiates (the `ModuleRegistry` global is
/// reset, then walked from the top).  A single `ModuleTree` does not carry
/// submodule definitions, so this pulls them from the registry — every
/// instantiated name gets its `module ... endmodule`, as verilator requires.
/// Returns "" for an empty top name.
def designVL(t: ModuleTree): String =
    let top = headModuleDef(t.data);
    match str_eq(top.name, "") {
        case true => ""
        case false =>
            let _ = change_mutable_default("ModuleRegistry", x => x, ModuleRegistry.mk(0, nil));
            let reg: ModuleRegistry = get_global("ModuleRegistry");
            let names = list_reverse(designVisit(reg.defs, lnil, lcons(top.name, lnil), lnil));
            joinLines(renderDesignNames(reg.defs, names)) + "\n"
    }

// ── Design manifest (structured metadata for tools) ──────────────────────
// The same design closure as designVL, rendered as JSON: per module the
// ports (name/direction/width/signed/reg-ness), the clock domain, and the
// instance records. Consumed by the simulation harness (src/sim) instead of
// parsing the emitted Verilog. Port variants mirror portLineSingle.

/// `"true"` / `"false"` for a Boolean (manifest JSON helper).
def boolJson(b: Boolean): String = match b {
    case true => "true"
    case false => "false"
}

/// Clock-domain config as JSON text: `"sync"` / `"async"`.
def cdKindJson(c: ClockDomainConfig): String = match c {
    case Sync => "sync"
    case Async => "async"
}

/// Clock edge as JSON text: `"posedge"` / `"negedge"`.
def cdEdgeJson(e: ClockEdge): String = match e {
    case RisingEdge => "posedge"
    case FallingEdge => "negedge"
}

/// Reset polarity as JSON text: `"high"` / `"low"`.
def cdPolJson(p: ResetPolarity): String = match p {
    case ActiveHigh => "high"
    case ActiveLow => "low"
}

/// The manifest JSON object for a clock domain: clock name, reset name, kind,
/// edge and resetActive.
def clockJson(cd: ClockDomain): String =
    let head = "{\"clk\": \"" + cd.clockName + "\", \"reset\": \"" + cd.resetName + "\", ";
    let kind = "\"kind\": \"" + cdKindJson(cd.config) + "\", \"edge\": \"" + cdEdgeJson(cd.clockEdge) + "\", ";
    head + kind + "\"resetActive\": \"" + cdPolJson(cd.resetPolarity) + "\"}"

/// One manifest port entry: name, direction, width, signedness and
/// reg-ness.
def portJsonLine(name: String, dir: String, width: Nat, signed: Boolean, reg: Boolean): String =
    let front = "{\"name\": \"" + name + "\", \"dir\": \"" + dir + "\", \"width\": " + nat_to_dec(width);
    front + ", \"signed\": " + boolJson(signed) + ", \"reg\": " + boolJson(reg) + "}"

/// The manifest port entry (or no entry) for one port declaration expr;
/// mirrors `portLineSingle`'s variant set.
def portJsonSingle(e: Expr): List[String] = match e {
    case createIn(name) => lcons(portJsonLine(name, "input", 1, false, false), lnil)
    case createOut(name) => lcons(portJsonLine(name, "output", 1, false, false), lnil)
    case createInOut(name) => lcons(portJsonLine(name, "inout", 1, false, false), lnil)
    case createInWidth(name, w) => lcons(portJsonLine(name, "input", w, false, false), lnil)
    case createOutWidth(name, w) => lcons(portJsonLine(name, "output", w, false, false), lnil)
    case createInOutWidth(name, w) => lcons(portJsonLine(name, "inout", w, false, false), lnil)
    case createSIntInWidth(name, w) => lcons(portJsonLine(name, "input", w, true, false), lnil)
    case createSIntOutWidth(name, w) => lcons(portJsonLine(name, "output", w, true, false), lnil)
    case createSIntInOutWidth(name, w) => lcons(portJsonLine(name, "inout", w, true, false), lnil)
    case createOutReg(name) => lcons(portJsonLine(name, "output", 1, false, true), lnil)
    case createOutRegWidth(name, w) => lcons(portJsonLine(name, "output", w, false, true), lnil)
    case createOutRegWidthInit(name, w, _) => lcons(portJsonLine(name, "output", w, false, true), lnil)
    case createSIntOutRegWidth(name, w) => lcons(portJsonLine(name, "output", w, true, true), lnil)
    case createSIntOutRegWidthInit(name, w, _) => lcons(portJsonLine(name, "output", w, true, true), lnil)
    case _ => lnil
}

/// The manifest instance entry (`inst` / `module`) for an instance record
/// (no entry for other exprs).
def instJsonSingle(e: Expr): List[String] = match e {
    case instance(i, m) => lcons("{\"inst\": \"" + i + "\", \"module\": \"" + m + "\"}", lnil)
    case instanceWithPorts(i, m, _) => lcons("{\"inst\": \"" + i + "\", \"module\": \"" + m + "\"}", lnil)
    case _ => lnil
}

/// The manifest port entries of an expr list.
def collectPortJson[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => list_append(portJsonSingle(e), collectPortJson(tail))
}

/// The manifest instance entries of an expr list.
def collectInstJson[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => list_append(instJsonSingle(e), collectInstJson(tail))
}

/// Join JSON items with ", ".
def joinJsonList(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + ", " + joinJsonList(tail)
}

/// Join JSON items with ",\n".
def joinJsonLines(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + ",\n" + joinJsonLines(tail)
}

// Manifest-side twin of extraCdPortsVL's port emission: for each extra cd
// (not cdEq to the main cd) the clk input port is always declared and the
// reset input port only when that cd has init regs — the same condition
// extraCdPortsVL uses to emit `input wire <reset>`.
/// Manifest twin of `extraCdPortsVL`: one input entry per extra-cd clock
/// (plus its reset when that cd has init regs), main cd skipped.
def manifestExtraCdPorts[ne: Nat](es: Vec[Expr] ne, cds: List[ClockDomain], mainCd: ClockDomain): List[String] = match cds {
    case lnil => lnil
    case lcons(c, tail) =>
        let isMain = cdEq(c, mainCd);
        match isMain {
            case true => manifestExtraCdPorts(es, tail, mainCd)
            case false =>
                let initLines = list_reverse(collectInitLinesCd(es, c, false));
                let hasInit = match initLines {
                    case lnil => false
                    case _ => true
                };
                let rst_port = match hasInit {
                    case false => lnil
                    case true => lcons(portJsonLine(resetName(c), "input", 1, false, false), lnil)
                };
                list_append(
                    lcons(portJsonLine(clockName(c), "input", 1, false, false), rst_port),
                    manifestExtraCdPorts(es, tail, mainCd))
        }
}

// The clk/reset ports are SYNTHESIZED by moduleDefVL (p1/p2 there) when the
// module does not declare them itself, and every extra clock domain in the
// collectClockCds list (regAssignCd / assertExprCd references) gets its
// clk/reset ports via extraCdPortsVL (p3 there) — mirror both so the
// manifest lists every port the emitted Verilog declares.
/// Manifest twin of the SYNTHESIZED clk/reset ports.  Mirrors
/// `moduleDefVL`'s conditions: the clk exists iff a clocked always block or a
/// main-cd assert is emitted and the name is not already a port; the reset iff
/// there are main-cd init lines and it is not already a port.  Appends the
/// extra-cd ports.
def manifestSynthPorts(md: ModuleDef): List[String] =
    let port_names = collectPortNames md.expr;
    // Mirror moduleDefVL's p1 condition: the clk port exists iff a clocked
    // always block is emitted (see the has_seq note there) and the source did
    // not declare it (Verilog-compat folds `input clk` into a real port).
    let clocked = clockedVL(md.expr, md.cd, strInList(resetName(md.cd), port_names));
    // Mirror moduleDefVL's has_seq, assert disjunct included: a main-cd assert
    // synthesizes the clk port even with no clocked always block.
    let has_assert_main = match list_reverse(collectAssertLinesCd(md.expr, md.cd, true)) {
        case lnil => false
        case _ => true
    };
    let has_seq = match str_eq(clocked, "") {
        case true => has_assert_main
        case false => true
    };
    let clk_out = match strInList(clockName(md.cd), port_names) {
        case true => false
        case false => has_seq
    };
    let has_init = match list_reverse(collectInitLinesCd(md.expr, md.cd, true)) {
        case lnil => false
        case _ => true
    };
    let reset_out = match strInList(resetName(md.cd), port_names) {
        case true => false
        case false => has_init
    };
    let with_clk = match clk_out {
        case false => lnil
        case true => lcons(portJsonLine(clockName(md.cd), "input", 1, false, false), lnil)
    };
    let with_reset = match reset_out {
        case false => with_clk
        case true => with_clk.append(lcons(portJsonLine(resetName(md.cd), "input", 1, false, false), lnil))
    };
    // Mirror extraCdPortsVL: one input entry per extra-cd clk (plus reset
    // when that cd has init regs), main cd skipped — exactly the ports p3
    // appends to the Verilog header.
    with_reset.append(manifestExtraCdPorts(md.expr, collectClockCds md.expr, md.cd))

/// The manifest JSON object for one module: name, clock object, ports
/// (declared + synthesized) and instances.
def moduleJsonFull(md: ModuleDef): String =
    let ports = collectPortJson(md.expr).append(manifestSynthPorts(md));
    let insts = collectInstJson(md.expr);
    let head = "    {\n      \"name\": \"" + md.name + "\",\n      \"clock\": " + clockJson(md.cd);
    let tail = "],\n      \"instances\": [" + joinJsonList(insts) + "]\n    }";
    head + ",\n      \"ports\": [" + joinJsonList(ports) + tail

/// `moduleJsonFull` for each name of a design-closure name list.
def renderManifestNames[n: Nat](defs: Vec[ModuleDef] n, names: List[String]): List[String] = match names {
    case lnil => lnil
    case lcons(name, rest) => lcons(moduleJsonFull(lookupModuleDef(defs, name)), renderManifestNames(defs, rest))
}

// Public API: design manifest for the top module's design closure.
// Usage: designManifestVL(myTop.create.tree)
/// PUBLIC API: structured JSON manifest for the top module's design closure
/// (name, clock domain, ports and instances per module), consumed by the
/// simulation harness instead of parsing the emitted Verilog.  Ports mirror
/// `portLineSingle` and every synthesized clock/reset port is included.  Returns
/// an empty-top object for an empty design.
def designManifestVL(t: ModuleTree): String =
    let top = headModuleDef(t.data);
    match str_eq(top.name, "") {
        case true => "{\"top\": \"\", \"modules\": []}"
        case false =>
            let _ = change_mutable_default("ModuleRegistry", x => x, ModuleRegistry.mk(0, nil));
            let reg: ModuleRegistry = get_global("ModuleRegistry");
            let names = list_reverse(designVisit(reg.defs, lnil, lcons(top.name, lnil), lnil));
            "{\"top\": \"" + top.name + "\", \"modules\": [\n" + joinJsonLines(renderManifestNames(reg.defs, names)) + "\n  ]}"
    }
