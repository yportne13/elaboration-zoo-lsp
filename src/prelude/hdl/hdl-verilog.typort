// ============================================================
// HDL Verilog Code Generation (pure typort library)
// ============================================================

// Convert Nat to decimal string (for Verilog width ranges like [7:0])
// Uses the Rust builtin nat_to_dec which correctly counts Peano successors
def natToDec(n: Nat): String = nat_to_dec(n)

// String concat helpers (avoid Add trait to prevent typeclass issues with dep-types)

def joinLines(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + "\n" + joinLines(tail)
}

// Is an Expr the always-true write enable?  If so the memory write statement is
// emitted without the `if (enable)` guard.  Only a literal whose value is 1
// (constructor form `literal(succ(zero))`) is recognized: numeric literal terms
// may stay stuck through elaboration (see docs/l13-proof-candidates-notes.md
// §2.3), so a stuck literal still falls through to the `if (...)` form, which is
// valid (if redundant) Verilog.
def isTrueLit(e: Expr): Boolean = match e {
    case literal(v) => match v {
        case succ(zero) => true
        case _ => false
    }
    case _ => false
}

// Normalize a Typort-level binary operator to a legal Verilog operator.
// `+^` / `-^` (carry/borrow-generating add/sub, result type width+1) are
// NOT Verilog tokens. The prelude's `+^`/`-^` (hdl-ops.typort) no longer
// emit these op strings: they build "pad-concat + plain +" expressions
// directly (`{1'b0, a} + b` / `{a[w-1], a} + {b[w-1], b}`), so the extra
// top bit is explicit and survives nesting/inlining. The branches below
// are defensive fallbacks for hand-built Exprs that still carry `+^`/`-^`;
// they map to plain `+` / `-` so the emitted Verilog stays legal.
def verilogBinOp(op: String): String =
    let is_plus_carry = str_eq(op, "+^");
    match is_plus_carry {
        case true => "+"
        case false =>
            let is_minus_borrow = str_eq(op, "-^");
            match is_minus_borrow {
                case true => "-"
                case false => op
            }
    }

// Sized literal for a concatenation operand.  IEEE 1364-2001 §4.1.14 forbids
// unsized constants inside concatenations, so `{0, x}` is not legal Verilog.
// A literal can only reach `##` as a Bool (value 0 or 1) — the Cat impls
// (hdl-ops.typort) always concatenate a Bool or a named signal — so it is
// emitted as a sized 1-bit literal; anything else keeps the plain decimal
// form (defensive fallback, not reachable through the Cat impls).
def catLitStr(v: Nat): String = match v {
    case zero => "1'b0"
    case succ(zero) => "1'b1"
    case _ => natToDec(v)
}

// Emit one memory write statement for the clocked always block:
//   if (enable) mem[address] <= data;
// An enable that evaluates to literal 1 (constructor form `literal(succ(zero))`)
// collapses to the bare assignment; any other enable keeps the guard.
// Operand strings are already emitted (avoids a forward ref to exprVL).
def memWriteLineRaw(memStr: String, addrStr: String, dataStr: String, enableStr: String, enable: Expr): String =
    let always_en = isTrueLit(enable);
    match always_en {
        case true => "    " + memStr + "[" + addrStr + "] <= " + dataStr + ";"
        case false => "    if (" + enableStr + ") begin\n      " + memStr + "[" + addrStr + "] <= " + dataStr + ";\n    end"
    }

// Emit an expression in "procedural" context (inside always block):
// assign becomes blocking assignment, block/when recurse procedurally.
// Self-contained (no forward ref to exprVL).
def exprVL_proc(e: Expr): String = match e {
    case create(name) => name
    case createIn(name) => name
    case createOut(name) => name
    case createInOut(name) => name
    case createWidth(name, _) => name
    case createInWidth(name, _) => name
    case createOutWidth(name, _) => name
    case createInOutWidth(name, _) => name
    case createReg(name) => name
    case createRegWidth(name, _) => name
    case createRegWidthInit(name, _, _) => name
    case createOutReg(name) => name
    case createOutRegWidth(name, _) => name
    case createOutRegWidthInit(name, _, _) => name
    case createSIntWidth(name, _) => name
    case createSIntInWidth(name, _) => name
    case createSIntOutWidth(name, _) => name
    case createSIntInOutWidth(name, _) => name
    case createSIntRegWidth(name, _) => name
    case createSIntRegWidthInit(name, _, _) => name
    case createSIntOutRegWidth(name, _) => name
    case createSIntOutRegWidthInit(name, _, _) => name
    case literal(v) => natToDec(v)
    case unary(op, x) => op + exprVL_proc(x)
    case binary(lhs, op, rhs) =>
        let is_cat = str_eq(op, "##");
        match is_cat {
            case true =>
                let lstr = match lhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL_proc(lhs)
                };
                let rstr = match rhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL_proc(rhs)
                };
                "{" + lstr + ", " + rstr + "}"
            case false =>
                let opv = verilogBinOp(op);
                "(" + exprVL_proc(lhs) + " " + opv + " " + exprVL_proc(rhs) + ")"
        }
    case assign(lhs, rhs) =>
        "      " + exprVL_proc(lhs) + " = " + exprVL_proc(rhs) + ";"
    case regAssign(lhs, rhs) =>
        "      " + exprVL_proc(lhs) + " <= " + exprVL_proc(rhs) + ";"
    case when(cond, body, elseBody) =>
        "    if (" + exprVL_proc(cond) + ") begin\n" + exprVL_proc(body) + "\n    end" + (
            match elseBody {
                case None => ""
                case Some(eb) => match eb {
                    case when(ec, eb2, eb3) =>
                        " else if (" + exprVL_proc(ec) + ") begin\n" + exprVL_proc(eb2) + "\n    end" + (
                            match eb3 {
                                case None => ""
                                case Some(eb4) => " else begin\n" + exprVL_proc(eb4) + "\n    end"
                            }
                        )
                    case _ =>
                        " else begin\n" + exprVL_proc(eb) + "\n    end"
                }
            }
        )
    case switch(value, cases) =>
        "  case (" + exprVL_proc(value) + ") " + exprVL_proc(cases) + " endcase"
    case block(head, tail) => exprVL_proc(head) + exprVL_proc(tail)
    case nop => ""
    case mux(cond, whenTrue, whenFalse) =>
        "(" + exprVL_proc(cond) + " ? " + exprVL_proc(whenTrue) + " : " + exprVL_proc(whenFalse) + ")"
    case bitsel(x, idx) =>
        exprVL_proc(x) + "[" + exprVL_proc(idx) + "]"
    case partsel(x, hi, lo) =>
        exprVL_proc(x) + "[" + exprVL_proc(hi) + ":" + exprVL_proc(lo) + "]"
    case instance(instName, moduleName) =>
        "  " + moduleName + " " + instName + " ();"
    case instanceWithPorts(instName, moduleName, ports) =>
        "  " + moduleName + " " + instName + " (" + ports + ");"
    case subSignal(instName, signalName) =>
        instName + "_" + signalName
    case createMem(name, _, _) => name
    case memRead(mem, address) =>
        exprVL_proc(mem) + "[" + exprVL_proc(address) + "]"
    case memWrite(mem, address, data, enable) =>
        memWriteLineRaw(exprVL_proc(mem), exprVL_proc(address), exprVL_proc(data), exprVL_proc(enable), enable)
}

// Helper: emit condition string without redundant outer parens
def emitCondStr(cond: Expr): String = match cond {
    case binary(lhs, op, rhs) =>
        exprVL_proc(lhs) + " " + verilogBinOp(op) + " " + exprVL_proc(rhs)
    case _ => exprVL_proc(cond)
}

// Convert a single Expr to a Verilog expression string.
// Handles one level of else-if nesting; deeper nesting may produce
// nested if-statements (still functionally correct).
def exprVL(e: Expr): String = match e {
    case create(name) => name
    case createIn(name) => name
    case createOut(name) => name
    case createInOut(name) => name
    case createWidth(name, _) => name
    case createInWidth(name, _) => name
    case createOutWidth(name, _) => name
    case createInOutWidth(name, _) => name
    case createReg(name) => name
    case createRegWidth(name, _) => name
    case createRegWidthInit(name, _, _) => name
    case createOutReg(name) => name
    case createOutRegWidth(name, _) => name
    case createOutRegWidthInit(name, _, _) => name
    case createSIntWidth(name, _) => name
    case createSIntInWidth(name, _) => name
    case createSIntOutWidth(name, _) => name
    case createSIntInOutWidth(name, _) => name
    case createSIntRegWidth(name, _) => name
    case createSIntRegWidthInit(name, _, _) => name
    case createSIntOutRegWidth(name, _) => name
    case createSIntOutRegWidthInit(name, _, _) => name
    case literal(v) => natToDec(v)
    case unary(op, e) => op + exprVL(e)
    case binary(lhs, op, rhs) =>
        let is_cat = str_eq(op, "##");
        match is_cat {
            case true =>
                let lstr = match lhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL(lhs)
                };
                let rstr = match rhs {
                    case literal(v) => catLitStr(v)
                    case _ => exprVL(rhs)
                };
                "{" + lstr + ", " + rstr + "}"
            case false =>
                let opv = verilogBinOp(op);
                "(" + exprVL(lhs) + " " + opv + " " + exprVL(rhs) + ")"
        }
    case assign(lhs, rhs) =>
        "  assign " + exprVL(lhs) + " = " + exprVL(rhs) + ";"
    case regAssign(lhs, rhs) =>
        "    " + exprVL(lhs) + " <= " + exprVL(rhs) + ";"
    case when(cond, body, elseBody) =>
        "    if (" + emitCondStr(cond) + ") begin\n" + exprVL_proc(body) + "\n    end" + (
            match elseBody {
                case None => ""
                case Some(eb) => match eb {
                    case when(ec, eb2, eb3) =>
                        " else if (" + emitCondStr(ec) + ") begin\n" + exprVL_proc(eb2) + "\n    end" + (
                            match eb3 {
                                case None => ""
                                case Some(eb4) => " else begin\n" + exprVL_proc(eb4) + "\n    end"
                            }
                        )
                    case _ =>
                        " else begin\n" + exprVL_proc(eb) + "\n    end"
                }
            }
        )
    case switch(value, cases) =>
        "  case (" + exprVL(value) + ") " + exprVL(cases) + " endcase"
    case block(head, tail) => exprVL(head) + exprVL(tail)
    case nop => ""
    case mux(cond, whenTrue, whenFalse) =>
        "(" + exprVL(cond) + " ? " + exprVL(whenTrue) + " : " + exprVL(whenFalse) + ")"
    case bitsel(e, idx) =>
        exprVL(e) + "[" + exprVL(idx) + "]"
    case partsel(e, hi, lo) =>
        exprVL(e) + "[" + exprVL(hi) + ":" + exprVL(lo) + "]"
    case instance(instName, moduleName) =>
        "  " + moduleName + " " + instName + " ();"
    case instanceWithPorts(instName, moduleName, ports) =>
        "  " + moduleName + " " + instName + " (" + ports + ");"
    case subSignal(instName, signalName) =>
        let sigLine = instName + "_" + signalName;
        sigLine
    case createMem(name, _, _) => name
    case memRead(mem, address) =>
        exprVL(mem) + "[" + exprVL(address) + "]"
    case memWrite(mem, address, data, enable) =>
        memWriteLineRaw(exprVL(mem), exprVL(address), exprVL(data), exprVL(enable), enable)
}

def isSubSignal(e: Expr): Boolean = match e {
    case subSignal(_, _) => true
    case _ => false
}

// Check if an expression is an assign targeting a subSignal (port connection)
def isSubSigAssign(e: Expr): Boolean = match e {
    case assign(lhs, _) => isSubSignal(lhs)
    case _ => false
}

// Helper: check if Vec[Expr] contains any port declarations
def hasPorts[ne: Nat](es: Vec[Expr] ne): Boolean = match es {
    case nil => false
    case cons(e, tail) => match e {
        case createIn(_) => true
        case createOut(_) => true
        case createInOut(_) => true
        case createInWidth(_, _) => true
        case createOutWidth(_, _) => true
        case createInOutWidth(_, _) => true
        case createSIntInWidth(_, _) => true
        case createSIntOutWidth(_, _) => true
        case createSIntInOutWidth(_, _) => true
        case createOutReg(_) => true
        case createOutRegWidth(_, _) => true
        case createOutRegWidthInit(_, _, _) => true
        case createSIntOutRegWidth(_, _) => true
        case createSIntOutRegWidthInit(_, _, _) => true
        case _ => hasPorts tail
    }
}

// Check if a string is in a list
def strInList(s: String, ls: List[String]): Boolean = match ls {
    case lnil => false
    case lcons(h, tail) =>
        let eq = str_eq(h, s);
        match eq {
            case true => true
            case false => strInList(s, tail)
        }
}

// Helper: generate output port wire/reg keyword
def outWireOrReg(name: String, whenSigs: List[String]): String =
    let isWhen = strInList(name, whenSigs);
    match isWhen {
        case true => "reg"
        case false => "wire"
    }

// Helper: generate width range string, omit for 1-bit signals
// Uses Rust builtin width_range which can force Nat evaluation
def widthRange(w: Nat): String = width_range(w)

// ============================================================
//  Memory (Mem) declarations
// ============================================================

// Emit one memory declaration:  reg [w-1:0] name [0:wordCount-1];
// widthRange returns "" for 1-bit cells →  reg name [0:wordCount-1];
def memDeclLine(name: String, wordCount: Nat, width: Nat): String =
    "  reg " + widthRange(width) + name + " [0:" + natToDec(pred(wordCount)) + "];"

// Collect memory declarations from Vec[Expr]
def collectMemLines[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case createMem(name, wordCount, width) => lcons (memDeclLine(name, wordCount, width)) (collectMemLines tail)
        case _ => collectMemLines tail
    }
}

def memsVL[ne: Nat](es: Vec[Expr] ne): String =
    let ls = list_reverse(collectMemLines es);
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Helper: process a single port expr
// output-reg ports are ALWAYS emitted `output reg` — no wire/reg inference
// from the when-driven set (outWireOrReg), so a register output port stays a
// reg even when its `:=` drive lives outside any non-clocked when.
def portLineSingle(e: Expr, whenSigs: List[String]): List[String] = match e {
    case createIn(name) => lcons ("  input wire " + name) lnil
    case createOut(name) => lcons ("  output " + outWireOrReg(name, whenSigs) + " " + name) lnil
    case createInOut(name) => lcons ("  inout wire " + name) lnil
    case createInWidth(name, w) => lcons ("  input wire " + widthRange(w) + name) lnil
    case createOutWidth(name, w) => lcons ("  output " + outWireOrReg(name, whenSigs) + " " + widthRange(w) + name) lnil
    case createInOutWidth(name, w) => lcons ("  inout wire " + widthRange(w) + name) lnil
    case createSIntInWidth(name, w) => lcons ("  input wire signed " + widthRange(w) + name) lnil
    case createSIntOutWidth(name, w) => lcons ("  output " + outWireOrReg(name, whenSigs) + " signed " + widthRange(w) + name) lnil
    case createSIntInOutWidth(name, w) => lcons ("  inout wire signed " + widthRange(w) + name) lnil
    case createOutReg(name) => lcons ("  output reg " + name) lnil
    case createOutRegWidth(name, w) => lcons ("  output reg " + widthRange(w) + name) lnil
    case createOutRegWidthInit(name, w, _) => lcons ("  output reg " + widthRange(w) + name) lnil
    case createSIntOutRegWidth(name, w) => lcons ("  output reg signed " + widthRange(w) + name) lnil
    case createSIntOutRegWidthInit(name, w, _) => lcons ("  output reg signed " + widthRange(w) + name) lnil
    case _ => lnil
}

// Collect port declarations (input/output) from Vec[Expr]
def collectPortLines[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => list_append(portLineSingle(e, whenSigs), collectPortLines(tail, whenSigs))
}

// Collect the names of all signals declared as ports (input/output). Wire
// declarations skip same-named signals: a port declaration takes precedence
// over a wire — e.g. `AxiLite.create.asMaster` rebuilds its fields as ports
// while the plain TypeName.create wires from the inner call still sit in the
// module tree, and declaring both would emit illegal duplicate Verilog lines.
def collectPortNames[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case createIn(name) => lcons (name) (collectPortNames tail)
        case createOut(name) => lcons (name) (collectPortNames tail)
        case createInOut(name) => lcons (name) (collectPortNames tail)
        case createInWidth(name, _) => lcons (name) (collectPortNames tail)
        case createOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createInOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntInWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntInOutWidth(name, _) => lcons (name) (collectPortNames tail)
        case createOutReg(name) => lcons (name) (collectPortNames tail)
        case createOutRegWidth(name, _) => lcons (name) (collectPortNames tail)
        case createOutRegWidthInit(name, _, _) => lcons (name) (collectPortNames tail)
        case createSIntOutRegWidth(name, _) => lcons (name) (collectPortNames tail)
        case createSIntOutRegWidthInit(name, _, _) => lcons (name) (collectPortNames tail)
        case _ => collectPortNames tail
    }
}

def joinPortLines(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + ",\n" + joinPortLines(tail)
}

def portsVL[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    joinPortLines(list_reverse(collectPortLines(es, whenSigs)))

// Helper: generate wire or reg declaration based on when-driven status
def wireOrRegLine(name: String, widthStr: String, whenSigs: List[String]): String =
    let isWhen = strInList(name, whenSigs);
    match isWhen {
        case true => "  reg " + widthStr + name + ";"
        case false => "  wire " + widthStr + name + ";"
    }

// Helper: process a single expr for wire/reg declaration.
// A signal whose name already appears in portNames is skipped entirely — the
// port declaration (input/output) takes precedence over a same-named wire.
// whenSigs semantics are unchanged: non-port signals driven by a non-clocked
// when are declared as reg instead of wire.
def wireLineSingle(e: Expr, portNames: List[String], whenSigs: List[String]): List[String] = match e {
    case create(name) =>
        let isPort = strInList(name, portNames);
        match isPort {
            case true => lnil
            case false => lcons (wireOrRegLine(name, "", whenSigs)) lnil
        }
    case createWidth(name, w) =>
        let isPort = strInList(name, portNames);
        match isPort {
            case true => lnil
            case false => lcons (wireOrRegLine(name, widthRange(w), whenSigs)) lnil
        }
    case createSIntWidth(name, w) =>
        let isPort = strInList(name, portNames);
        match isPort {
            case true => lnil
            case false => lcons (wireOrRegLine(name, "signed " + widthRange(w), whenSigs)) lnil
        }
    case _ => lnil
}

// Collect wire declarations (internal signals) from Vec[Expr]
// When-driven signals are declared as reg instead of wire
def collectWireLines[ne: Nat](es: Vec[Expr] ne, portNames: List[String], whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => list_append(wireLineSingle(e, portNames, whenSigs), collectWireLines(tail, portNames, whenSigs))
}

// Collect reg declarations from Vec[Expr]
def collectRegLines[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case createReg(name) => lcons ("  reg " + name + ";") (collectRegLines tail)
        case createRegWidth(name, w) => lcons ("  reg " + widthRange(w) + name + ";") (collectRegLines tail)
        case createRegWidthInit(name, w, _) => lcons ("  reg " + widthRange(w) + name + ";") (collectRegLines tail)
        case createSIntRegWidth(name, w) => lcons ("  reg signed " + widthRange(w) + name + ";") (collectRegLines tail)
        case createSIntRegWidthInit(name, w, _) => lcons ("  reg signed " + widthRange(w) + name + ";") (collectRegLines tail)
        case _ => collectRegLines tail
    }
}

// Does the module declare any output-reg PORT? Such ports are sequential
// elements (clocked regAssign targets with optional init), so the module
// header needs the clock (and reset) ports even though no standalone `reg`
// declaration exists — the `output reg` port line itself declares the reg.
def hasOutRegPorts[ne: Nat](es: Vec[Expr] ne): Boolean = match es {
    case nil => false
    case cons(e, tail) => match e {
        case createOutReg(_) => true
        case createOutRegWidth(_, _) => true
        case createOutRegWidthInit(_, _, _) => true
        case createSIntOutRegWidth(_, _) => true
        case createSIntOutRegWidthInit(_, _, _) => true
        case _ => hasOutRegPorts tail
    }
}

// Collect clocked assignments (regAssign) from Vec[Expr]
// Also collects when nodes that wrap regAssign (e.g., when(cond, regAssign(...), None))
// and memory writes (memWrite).
def collectClockLines[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case regAssign(_, _) => lcons (exprVL(e)) (collectClockLines tail)
        case memWrite(_, _, _, _) => lcons (exprVL(e)) (collectClockLines tail)
        case when(_, _, _) =>
            // When nodes with regAssign inside go to the clocked block
            let has_clk = hasRegAssign(e);
            match has_clk {
                case true => lcons (exprVL(e)) (collectClockLines tail)
                case false => collectClockLines tail
            }
        case _ => collectClockLines tail
    }
}

def wiresVL[ne: Nat](es: Vec[Expr] ne, portNames: List[String], whenSigs: List[String]): String =
    let ls = list_reverse(collectWireLines(es, portNames, whenSigs));
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Emit always @* blocks for when-nodes
def hasWhenInList[ne: Nat](es: Vec[Expr] ne): Boolean = match es {
    case nil => false
    case cons(e, tail) => match e {
        case when(_, _, _) => true
        case _ => hasWhenInList(tail)
    }
}

// Extract the driven signal name from a when block's body
def getWhenDrivenSigName(e: Expr): String = match e {
    case assign(lhs, _) => exprVL(lhs)
    case block(h, _) => getWhenDrivenSigName(h)
    case when(_, body, _) => getWhenDrivenSigName(body)
    case _ => ""
}

// Helper: process a single when expression, return its driven sig as a list
def whenExprToSigList(e: Expr): List[String] =
    let has_clk = hasRegAssign(e);
    match has_clk {
        case true => lnil
        case false => lcons (getWhenDrivenSigName e) lnil
    }

// Collect signal names driven by non-clocked when blocks
def collectWhenDrivenSigs[ne: Nat](es: Vec[Expr] ne): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case when(_, _, _) => list_append(whenExprToSigList(e), collectWhenDrivenSigs tail)
        case _ => collectWhenDrivenSigs tail
    }
}

// Helper: get LHS name from an assign expr
def getAssignLhsName(e: Expr): String = match e {
    case assign(lhs, _) => exprVL(lhs)
    case _ => ""
}

// Helper: get RHS string from an assign expr
def getAssignRhsStr(e: Expr): String = match e {
    case assign(_, rhs) => exprVL(rhs)
    case _ => ""
}

// Helper: check if a single assign expr should be emitted as a continuous assign
def assignLineCheck(e: Expr, whenSigs: List[String]): List[String] =
    let lhsName = getAssignLhsName(e);
    let isWhen = strInList(lhsName, whenSigs);
    match isWhen {
        case true => lnil
        case false =>
            let isPort = isSubSigAssign(e);
            match isPort {
                case true => lnil
                case false => lcons (exprVL(e)) lnil
            }
    }

// Collect assign lines, skipping assigns whose LHS is in the when-driven set
def collectAssignLinesFiltered[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case assign(_, _) => list_append(assignLineCheck(e, whenSigs), collectAssignLinesFiltered(tail, whenSigs))
        case create(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createIn(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createOut(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createInOut(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createInWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createInOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createReg(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutReg(_) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createOutRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntInWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntInOutWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntOutRegWidth(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createSIntOutRegWidthInit(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case regAssign(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case literal(_) => collectAssignLinesFiltered(tail, whenSigs)
        case when(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case instance(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case instanceWithPorts(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case subSignal(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case createMem(_, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case memRead(_, _) => collectAssignLinesFiltered(tail, whenSigs)
        case memWrite(_, _, _, _) => collectAssignLinesFiltered(tail, whenSigs)
        case _ => lcons (exprVL(e)) (collectAssignLinesFiltered(tail, whenSigs))
    }
}

// Helper: collect default lines that appear AFTER the last non-clocked when in
// insertion order — i.e. otherwise bodies, which become the else branch of the
// if/else-if chain. `es` is the reverse-ordered module expr Vec, so these are
// the default lines before the first when encountered walking it.
def collectTailDefaultLines[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case when(_, _, _) => lnil
        case assign(_, _) =>
            let lhsName = getAssignLhsName(e);
            let isWhen = strInList(lhsName, whenSigs);
            match isWhen {
                case true => lcons ("      " + lhsName + " = " + getAssignRhsStr(e) + ";") (collectTailDefaultLines(tail, whenSigs))
                case false => collectTailDefaultLines(tail, whenSigs)
            }
        case _ => collectTailDefaultLines(tail, whenSigs)
    }
}

// Helper: collect default lines after the first when seen while walking the
// reverse-ordered Vec (i.e. defaults before the first when in insertion order).
def collectHeadDefaultsAfter[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case assign(_, _) =>
            let lhsName = getAssignLhsName(e);
            let isWhen = strInList(lhsName, whenSigs);
            match isWhen {
                case true => lcons ("    " + lhsName + " = " + getAssignRhsStr(e) + ";") (collectHeadDefaultsAfter(tail, whenSigs))
                case false => collectHeadDefaultsAfter(tail, whenSigs)
            }
        case _ => collectHeadDefaultsAfter(tail, whenSigs)
    }
}

// Helper: collect default lines that appear BEFORE the first non-clocked when in
// insertion order — standalone defaults written before a when (e.g. an explicit
// default assign followed by a when without otherwise). These stay as plain
// lines emitted before the if chain.
def collectHeadDefaultLines[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): List[String] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case when(_, _, _) => collectHeadDefaultsAfter(tail, whenSigs)
        case _ => collectHeadDefaultLines(tail, whenSigs)
    }
}

// Helper: collect all non-clocked when exprs from Vec
def collectNonClockedWhens[ne: Nat](es: Vec[Expr] ne): List[Expr] = match es {
    case nil => lnil
    case cons(e, tail) => match e {
        case when(_, _, _) =>
            let has_clk = hasRegAssign(e);
            match has_clk {
                case true => collectNonClockedWhens(tail)
                case false => lcons(e, collectNonClockedWhens(tail))
            }
        case _ => collectNonClockedWhens(tail)
    }
}

// Helper: emit a single when as if-block (no else)
def emitIfBlock(cond: Expr, body: Expr): String =
    "if (" + emitCondStr(cond) + ") begin\n" + exprVL_proc(body) + "\n    end"

// Helper: get cond from a when expr
def getWhenCond(e: Expr): Expr = match e {
    case when(c, _, _) => c
    case _ => nop
}

// Helper: get body from a when expr
def getWhenBody(e: Expr): Expr = match e {
    case when(_, b, _) => b
    case _ => nop
}

// Helper: check if expr is a when
def isWhenExpr(e: Expr): Boolean = match e {
    case when(_, _, _) => true
    case _ => false
}

// Helper: emit else-if chain from a list of when nodes
def emitElseIfChain(ls: List[Expr]): String = match ls {
    case lnil => ""
    case lcons(e, tail) =>
        let is_w = isWhenExpr(e);
        match is_w {
            case true => " else " + emitIfBlock(getWhenCond(e), getWhenBody(e)) + emitElseIfChain(tail)
            case false => "\n" + exprVL(e) + emitElseIfChain(tail)
        }
}

// Helper: join multiple when bodies, chaining consecutive whens into if/else-if
def joinWhenBodies(ls: List[Expr]): String = match ls {
    case lnil => ""
    case lcons(e, tail) =>
        let is_w = isWhenExpr(e);
        match is_w {
            case true => "    " + emitIfBlock(getWhenCond(e), getWhenBody(e)) + emitElseIfChain(tail)
            case false => exprVL(e) + "\n" + joinWhenBodies(tail)
        }
}

// Build a single merged always block from all non-clocked when nodes.
// Standalone defaults (written before the when) stay as plain lines before the
// if chain; otherwise bodies (defaults after the last when) become the else
// branch, yielding if / else if / else instead of "default assign + if override".
def buildMergedAlwaysBlock[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    let whens = list_reverse(collectNonClockedWhens(es));
    match whens {
        case lnil => ""
        case _ =>
            let head_defaults = list_reverse(collectHeadDefaultLines(es, whenSigs));
            let tail_defaults = list_reverse(collectTailDefaultLines(es, whenSigs));
            let headStr = match head_defaults {
                case lnil => ""
                case _ => joinLines(head_defaults) + "\n"
            };
            let elseStr = match tail_defaults {
                case lnil => ""
                case _ => " else begin\n" + joinLines(tail_defaults) + "\n    end"
            };
            "  always @(*) begin\n" + headStr + joinWhenBodies(whens) + elseStr + "\n  end\n"
    }

def alwaysVL[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    buildMergedAlwaysBlock(es, whenSigs)

def assignsVL[ne: Nat](es: Vec[Expr] ne, whenSigs: List[String]): String =
    let ls = list_reverse(collectAssignLinesFiltered(es, whenSigs));
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Generate reg declarations (with leading newline if non-empty)
def regsVL[ne: Nat](es: Vec[Expr] ne): String =
    let ls = list_reverse(collectRegLines es);
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Generate clocked always @(posedge clk) block from regAssign entries
def hasClockLines[ne: Nat](es: Vec[Expr] ne): Boolean =
    match list_reverse(collectClockLines es) {
        case lnil => false
        case _ => true
    }

// Helper: add 2-space indent to each line in a list (handles multi-line strings)
def indentLines(ls: List[String]): List[String] = match ls {
    case lnil => lnil
    case lcons(s, tail) => lcons ("  " + str_indent2(s)) (indentLines tail)
}

// ---- Clock domain helpers (names / edge keywords from a ClockDomain) ----

def clockName(cd: ClockDomain): String = cd.clockName

def resetName(cd: ClockDomain): String = cd.resetName

def clockEdgeStr(cd: ClockDomain): String = match cd.clockEdge {
    case RisingEdge => "posedge"
    case FallingEdge => "negedge"
}

def resetEdgeStr(cd: ClockDomain): String = match cd.resetPolarity {
    case ActiveHigh => "posedge"
    case ActiveLow => "negedge"
}

// Reset condition text: "reset" or "!reset" for ActiveLow
def resetCondStr(cd: ClockDomain): String = match cd.resetPolarity {
    case ActiveHigh => resetName(cd)
    case ActiveLow => "!" + resetName(cd)
}

def clockedVL[ne: Nat](es: Vec[Expr] ne, cd: ClockDomain): String =
    let ls = list_reverse(collectClockLines es);
    let has_clk = hasClockLines es;
    let init_lines = list_reverse(collectInitLines es);
    let need_reset = match init_lines {
        case lnil => false
        case _ => true
    };
    match has_clk {
        case false => ""
        case true =>
            let clk_edge = clockEdgeStr(cd);
            let clk_nm = clockName(cd);
            let reset_cond = resetCondStr(cd);
            match need_reset {
                // No reset values: plain clocked block
                case false =>
                    "  always @" + "(" + clk_edge + " " + clk_nm + ") begin\n" + joinLines(ls) + "\n" + "  end\n"
                // Async:  always @(clk_edge clk or reset_edge reset) begin if (reset_cond) ...
                // Sync:   always @(clk_edge clk) begin if (reset_cond) ...
                case true =>
                    let header = match cd.config {
                        case Async =>
                            let reset_edge = resetEdgeStr(cd);
                            let reset_nm = resetName(cd);
                            "  always @" + "(" + clk_edge + " " + clk_nm + " or " + reset_edge + " " + reset_nm + ") begin\n"
                        case Sync =>
                            "  always @" + "(" + clk_edge + " " + clk_nm + ") begin\n"
                    };
                    let indented_init = indentLines(init_lines);
                    let indented_clk = indentLines(ls);
                    header + "    if (" + reset_cond + ") begin\n" + joinLines(indented_init) + "\n    end else begin\n" + joinLines(indented_clk) + "\n    end\n  end\n"
            }
    }

// ============================================================
//  Hierarchical Verilog Generation (ModuleTree-based)
// ============================================================

// Collect port connections for a given instance from assign(subSignal(...), ...) patterns.
// TODO: requires mutual recursion support or Expr AST extension for full port mapping.
// Currently generates empty port list; port connections deferred to architecture upgrade.

def joinPortConns(ls: List[String]): String = match ls {
    case lnil => ""
    case lcons(s, lnil) => s
    case lcons(s, tail) => s + ", " + joinPortConns(tail)
}

// Helpers to decompose assign(lhs, rhs) / subSignal(inst, port) without
// nested constructor patterns (which the match compiler does not handle).
def getAssignLhsExpr(e: Expr): Expr = match e {
    case assign(lhs, _) => lhs
    case _ => nop
}

def getAssignRhsExpr(e: Expr): Expr = match e {
    case assign(_, rhs) => rhs
    case _ => nop
}

def getSubSignalInst(e: Expr): String = match e {
    case subSignal(inst, _) => inst
    case _ => ""
}

def getSubSignalPort(e: Expr): String = match e {
    case subSignal(_, port) => port
    case _ => ""
}

// Collect ".port(sig)" connections for one instance from assign(subSignal(inst, port), rhs) exprs.
// This lets instance port connections be expressed type-safely: the module
// macro's port fields are subSignal handles, so `u.a := sig` in the parent
// records assign(subSignal(inst, port), sig) here.


// Generate instance instantiation lines with port connections.
// Filter connections belonging to one instance from parallel seen lists.
// (pattern_match misbinds closure variables referenced inside match branches,
// so everything here is threaded through pattern variables only.)
def filterConns(instName: String, seenInsts: List[String], seenConns: List[String]): List[String] = match seenInsts {
    case lnil => lnil
    case lcons(i, restInsts) => match seenConns {
        case lcons(c, restConns) =>
            let is_inst = str_eq(i, instName);
            match is_inst {
                case true => lcons (c) (filterConns(instName, restInsts, restConns))
                case false => filterConns(instName, restInsts, restConns)
            }
        case lnil => lnil
    }
}

def collectInstHelp[elen: Nat](exprs: Vec[Expr] elen, seenInsts: List[String], seenConns: List[String]): List[String] = match exprs {
    case nil => lnil
    case cons(e, tail) => match e {
        case instance(instName, moduleName) =>
            let conns = filterConns(instName, seenInsts, seenConns);
            let portStr = match conns {
                case lnil => "()"
                case _ => "(" + joinPortConns(conns) + ")"
            };
            lcons ("  " + moduleName + " " + instName + " " + portStr + ";") (collectInstHelp(tail, seenInsts, seenConns))
        case instanceWithPorts(instName, moduleName, ports) =>
            lcons ("  " + moduleName + " " + instName + " (" + ports + ");") (collectInstHelp(tail, seenInsts, seenConns))
        case _ =>
            let lhs = getAssignLhsExpr(e);
            let is_ss = isSubSignal(lhs);
            match is_ss {
                case true =>
                    let inst = getSubSignalInst(lhs);
                    let port = getSubSignalPort(lhs);
                    let rhs = getAssignRhsExpr(e);
                    let conn = "." + port + "(" + exprVL(rhs) + ")";
                    collectInstHelp(tail, lcons inst seenInsts, lcons conn seenConns)
                case false => collectInstHelp(tail, seenInsts, seenConns)
            }
    }
}

def collectInstanceLinesTree[elen: Nat](exprs: Vec[Expr] elen): List[String] = collectInstHelp(exprs, lnil, lnil)

// Generate Verilog for a single ModuleDef
def moduleDefVL(md: ModuleDef): String =
    let whenSigs = list_reverse(collectWhenDrivenSigs md.expr);
    let port_names = collectPortNames md.expr;
    let port_decls = portsVL(md.expr, whenSigs);
    let port_lines = list_reverse(collectPortLines(md.expr, whenSigs));
    let wire_decls = wiresVL(md.expr, port_names, whenSigs);
    let reg_decls = regsVL(md.expr);
    let mem_decls = memsVL(md.expr);
    let assigns = assignsVL(md.expr, whenSigs);
    let always = alwaysVL(md.expr, whenSigs);
    let clocked = clockedVL(md.expr, md.cd);
    let inst_lines = list_reverse(collectInstanceLinesTree md.expr);
    let has_regs = match list_reverse(collectRegLines md.expr) {
        case lnil => false
        case _ => true
    };
    let has_out_regs = hasOutRegPorts md.expr;
    let has_mem = match list_reverse(collectMemLines md.expr) {
        case lnil => false
        case _ => true
    };
    // Sequential elements (registers, output-reg ports, or memories) need the
    // clock port; output-reg ports count even though the port line itself
    // declares the reg (no standalone `reg` declaration is emitted).
    let has_reg_any = match has_regs {
        case false => has_out_regs
        case true => true
    };
    // Sequential elements (registers or memories) need the clock port.
    let has_seq = match has_reg_any {
        case false => has_mem
        case true => true
    };
    let has_ports = match port_lines {
        case lnil => false
        case _ => true
    };
    let has_instances = match inst_lines {
        case lnil => false
        case _ => true
    };
    let has_init = hasInitRegs md.expr;
    let clk_nm = clockName(md.cd);
    let reset_nm = resetName(md.cd);
    let p0 = port_decls;
    let p1 = match has_seq {
        case false => p0
        case true => match has_ports {
            case false => "  input wire " + clk_nm
            case _ => p0 + ",\n  input wire " + clk_nm
        }
    };
    let p2 = match has_init {
        case false => p1
        case true => match has_reg_any {
            case false => match has_ports {
                case false => "  input wire " + reset_nm
                case true => port_decls + ",\n  input wire " + reset_nm
            }
            case true => p1 + ",\n  input wire " + reset_nm
        }
    };
    let has_no_port_content = match has_ports {
        case false => match has_seq {
            case false => match has_init {
                case false => true
                case true => false
            }
            case true => false
        }
        case true => false
    };
    let header = match has_no_port_content {
        case true => "module " + md.name + " ();\n"
        case false => "module " + md.name + " (\n" + p2 + "\n);\n"
    };
    let body = header + wire_decls + reg_decls + mem_decls + assigns + clocked + always;
    let body_with_inst = match has_instances {
        case false => body
        case true => body + joinLines(inst_lines) + "\n"
    };
    body_with_inst + "endmodule"

// Generate Verilog for all ModuleDefs in a Vec
def collectModuleVLs[n: Nat](data: Vec[ModuleDef] n): List[String] = match data {
    case nil => lnil
    case cons(md, tail) => lcons (moduleDefVL(md)) (collectModuleVLs tail)
}

// Generate Verilog for all modules in the design (multi-module hierarchical output)
// Takes a ModuleTree (obtained via `m.tree` on a module value implementing `Module`).
def allModulesVL(t: ModuleTree): String =
    let ls = list_reverse(collectModuleVLs t.data);
    match ls {
        case lnil => ""
        case _ => joinLines(ls) + "\n"
    }

// Alias: moduleTreeVL is the public API expected by test/legacy_tests
// Extracts the first ModuleDef from a module tree and generates Verilog.
// Usage: moduleTreeVL(myModule.create.tree)
def moduleTreeVL(t: ModuleTree): String =
    let mod_def = headModuleDef(t.data);
    moduleDefVL(mod_def)
