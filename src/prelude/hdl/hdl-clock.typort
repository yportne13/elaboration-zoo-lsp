// ============================================================
//  HDL Clock / Registers / Memory
// ============================================================

// ClockDomain, ClockEdge, ResetPolarity, ClockDomainConfig,
// defaultClockDomain are defined in hdl-core.typort (ModuleDef bakes the
// clock domain at record time, so the definition must precede the module
// system). Pass a ClockDomain to the module macro to customize:
//   module foo(cd: ClockDomain) { ... }   // let t = foo.create(myCd).tree

// ============================================================
//  Mem (Memory)
// ============================================================

struct Mem[T] {
    wordCount: Nat
    initialValue: T
    clockDomain: ClockDomain
}

impl[T] Mem[T] {
    // TODO(stub): 占位实现 —— 不产生真实内存行为，仅保证类型检查通过。
    def write(address: UInt[log2Up (maxNat this.wordCount 1)], data: T, enable: Bool): Unit = unit
    def readAsync(address: UInt[log2Up (maxNat this.wordCount 1)]): T = this.initialValue
    def readSync(address: UInt[log2Up (maxNat this.wordCount 1)]): T = this.initialValue
    def readSyncCC(address: UInt[log2Up (maxNat this.wordCount 1)], crossClock: Bool): T = this.initialValue
}
