//! Signal construction, registers and combinational/sequential assignment.
// ============================================================
// HDL Signal Creation Functions
// ============================================================

// ---- Auto-named signal creation (SpinalHDL style) ----
// These functions take an implicit BindingName parameter.
// The compiler automatically fills it with the let-binding name.
// Usage:  let mySignal = autoUInt(8)
//         => mySignal gets name "mySignal" automatically

/// Auto-named UInt[w] wire: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createWidth`. Plain wire: no clock, no reset, driven only by `:=` assignments.
def autoUInt[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] wire: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createWidth`. Plain wire: no clock, no reset, driven only by `:=` assignments.
def autoBits[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed wire: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntWidth`. Plain wire: no clock, no reset, driven only by `:=` assignments.
def autoSInt[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit wire: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `create`. Plain wire: no clock, no reset, driven only by `:=` assignments.
def autoBool[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), create(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] input port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createInWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoUIntInput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createInWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] input port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createInWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoBitsInput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createInWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed input port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntInWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoSIntInput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntInWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit input port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createIn`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoBoolInput[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createIn(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] output port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoUIntOutput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createOutWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] output port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoBitsOutput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createOutWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed output port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntOutWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoSIntOutput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntOutWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit output port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOut`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoBoolOutput[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createOut(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] inout port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createInOutWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoUIntInOut[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createInOutWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] inout port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createInOutWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoBitsInOut[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createInOutWidth(loopName(bn.name), w));
