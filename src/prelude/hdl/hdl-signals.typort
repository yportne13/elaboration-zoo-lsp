    SInt.mk(Some(name), e)

def newBoolRegInitCdNamed(name: String, initVal: Nat, cd: ClockDomain): Bool =
    let e = createSignalExpr(name, createRegWidthInitCd(name, 1, literal(initVal), cd));
    Bool.mk(Some(name), e)

def newUIntOutRegNamed(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createOutRegWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsOutRegNamed(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createOutRegWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntOutRegNamed(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntOutRegWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolOutRegNamed(name: String): Bool =
    let e = createSignalExpr(name, createOutReg(name));
    Bool.mk(Some(name), e)

def newUIntOutRegInitNatNamed(name: String, w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(name, createOutRegWidthInit(name, w, literal(initVal)));
    UInt.mk(Some(name), e)

def newBitsOutRegInitNatNamed(name: String, w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(name, createOutRegWidthInit(name, w, literal(initVal)));
    Bits.mk(Some(name), e)

