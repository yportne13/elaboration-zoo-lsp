// ============================================================
// HDL Signal Creation Functions
// ============================================================

// ---- Auto-named signal creation (SpinalHDL style) ----
// These functions take an implicit BindingName parameter.
// The compiler automatically fills it with the let-binding name.
// Usage:  let mySignal = autoUInt(8)
//         => mySignal gets name "mySignal" automatically

def autoUInt[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBits[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSInt[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBool[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, create(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntInput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createInWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBitsInput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createInWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSIntInput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntInWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBoolInput[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, createIn(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntOutput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createOutWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBitsOutput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createOutWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSIntOutput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntOutWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBoolOutput[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, createOut(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntReg[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createRegWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBitsReg[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createRegWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSIntReg[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntRegWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBoolReg[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, createReg(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntRegInit[bn: BindingName](w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createRegWidthInit(bn.name, w, literal(initVal)));
    UInt.mk(Some(bn.name), e)

def autoBitsRegInit[bn: BindingName](w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createRegWidthInit(bn.name, w, literal(initVal)));
    Bits.mk(Some(bn.name), e)

def autoSIntRegInit[bn: BindingName](w: Nat, initVal: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntRegWidthInit(bn.name, w, literal(initVal)));
    SInt.mk(Some(bn.name), e)

def autoBoolRegInit[bn: BindingName](initVal: Nat): Bool =
    let e = createSignalExpr(bn.name, createRegWidthInit(bn.name, 1, literal(initVal)));
    Bool.mk(Some(bn.name), e)

// ---- Explicit-name signal creation (legacy) ----

def newBits(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    Bits.mk(Some(name), e)

def newUInt(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    UInt.mk(Some(name), e)

def newSInt(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntWidth(name, w));
    SInt.mk(Some(name), e)

def newBool(name: String): Bool =
    let e = createSignalExpr(name, create(name));
    Bool.mk(Some(name), e)

def newUIntInput(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createInWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsInput(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createInWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntInput(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntInWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolInput(name: String): Bool =
    let e = createSignalExpr(name, createIn(name));
    Bool.mk(Some(name), e)

def newBitsOutput(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createOutWidth(name, w));
    Bits.mk(Some(name), e)

def newUIntOutput(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createOutWidth(name, w));
    UInt.mk(Some(name), e)

def newSIntOutput(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntOutWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolOutput(name: String): Bool =
    let e = createSignalExpr(name, createOut(name));
    Bool.mk(Some(name), e)

// ---- Register signal creation ----

def newUIntReg(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createRegWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsReg(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createRegWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntReg(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntRegWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolReg(name: String): Bool =
    let e = createSignalExpr(name, createReg(name));
    Bool.mk(Some(name), e)

// Register with Nat literal reset value (for use in macros)
def newUIntRegInitNat(name: String, w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(name, createRegWidthInit(name, w, literal(initVal)));
    UInt.mk(Some(name), e)

def newSIntRegInitNat(name: String, w: Nat, initVal: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntRegWidthInit(name, w, literal(initVal)));
    SInt.mk(Some(name), e)

def newBitsRegInitNat(name: String, w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(name, createRegWidthInit(name, w, literal(initVal)));
    Bits.mk(Some(name), e)

def newBoolRegInitNat(name: String, initVal: Nat): Bool =
    let e = createSignalExpr(name, createRegWidthInit(name, 1, literal(initVal)));
    Bool.mk(Some(name), e)

// ---- Direction annotation helpers (SpinalHDL style) ----
// These are for use inside Bundle declarations.
// For regular signal declarations, use the Expr macro:
//   input a = UInt[8]    instead of   let a = in(UInt[8]())

def in_u[width: Nat](t: UInt[width]): UInt[width] =
    newUIntInput("", width)

def out_u[width: Nat](t: UInt[width]): UInt[width] =
    newUIntOutput("", width)

def in_b[width: Nat](t: Bits[width]): Bits[width] =
    newBitsInput("", width)

def out_b[width: Nat](t: Bits[width]): Bits[width] =
    newBitsOutput("", width)

def in_s[width: Nat](t: SInt[width]): SInt[width] =
    newSIntInput("", width)

def out_s[width: Nat](t: SInt[width]): SInt[width] =
    newSIntOutput("", width)

def in_bool(t: Bool): Bool =
    newBoolInput("")

def out_bool(t: Bool): Bool =
    newBoolOutput("")

// ============================================================
//  RegNext: delay register (SpinalHDL-style)
//  Creates a register of the same type and connects the input.
//  Usage: let r = regNextUInt(signal)   // r: UInt[w], r := signal
// ============================================================

def regNextUInt[bn: BindingName, w: Nat](value: UInt[w]): UInt[w] =
    let r = autoUIntReg(w);
    let _ = addSignalAssignment(r.expr, value.expr);
    r

def regNextBits[bn: BindingName, w: Nat](value: Bits[w]): Bits[w] =
    let r = autoBitsReg(w);
    let _ = addSignalAssignment(r.expr, value.expr);
    r

def regNextSInt[bn: BindingName, w: Nat](value: SInt[w]): SInt[w] =
    let r = autoSIntReg(w);
    let _ = addSignalAssignment(r.expr, value.expr);
    r

def regNextBool[bn: BindingName](value: Bool): Bool =
    let r = autoBoolReg;
    let _ = addSignalAssignment(r.expr, value.expr);
    r

// ============================================================
//  RegNextWhen: conditional delay register
//  Creates a register updated only when cond is true.
//  Usage: let r = regNextWhenUInt(signal, cond)
// ============================================================
// NOTE: regNextWhen* functions use whenBegin/whenEnd from hdl-core.typort.
// They cannot be defined here due to evaluation order.
// Define them in user code when needed:
//   when(cond) { r := value }
