    Bool.mk(Some(loopName(bn.name)), e)

// ---- Explicit-name signal creation (internal helpers) ----
// The `Named` variants build signals with an explicit name string. They are
// used where the signal's name does NOT come from a let binding: the Bundle
// derive (TypeName.create / asMaster / asSlave prefix fields with the
// factory's bn), the in_u/out_u direction helpers (reuse the source signal's
// name), the RegNext impls and counter (register named after the caller's
// binding), and explicit-name call sites. The public new* family below
// delegates to these with loopName(bn.name), so `let mySignal = newUInt(8)` behaves
// exactly like `let mySignal = autoUInt(8)`.

def newBitsNamed(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    Bits.mk(Some(name), e)

def newUIntNamed(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    UInt.mk(Some(name), e)

def newSIntNamed(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolNamed(name: String): Bool =
    let e = createSignalExpr(name, create(name));
    Bool.mk(Some(name), e)

def newUIntInputNamed(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createInWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsInputNamed(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createInWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntInputNamed(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntInWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolInputNamed(name: String): Bool =
    let e = createSignalExpr(name, createIn(name));
    Bool.mk(Some(name), e)

def newBitsOutputNamed(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createOutWidth(name, w));
    Bits.mk(Some(name), e)

def newUIntOutputNamed(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createOutWidth(name, w));
    UInt.mk(Some(name), e)

def newSIntOutputNamed(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntOutWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolOutputNamed(name: String): Bool =
    let e = createSignalExpr(name, createOut(name));
    Bool.mk(Some(name), e)

def newUIntInOutNamed(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createInOutWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsInOutNamed(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createInOutWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntInOutNamed(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntInOutWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolInOutNamed(name: String): Bool =
    let e = createSignalExpr(name, createInOut(name));
    Bool.mk(Some(name), e)

def newUIntRegNamed(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createRegWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsRegNamed(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createRegWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntRegNamed(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntRegWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolRegNamed(name: String): Bool =
    let e = createSignalExpr(name, createReg(name));
    Bool.mk(Some(name), e)

def newUIntRegInitNatNamed(name: String, w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(name, createRegWidthInit(name, w, literal(initVal)));
    UInt.mk(Some(name), e)

def newSIntRegInitNatNamed(name: String, w: Nat, initVal: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntRegWidthInit(name, w, literal(initVal)));
    SInt.mk(Some(name), e)

def newBitsRegInitNatNamed(name: String, w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(name, createRegWidthInit(name, w, literal(initVal)));
    Bits.mk(Some(name), e)

def newBoolRegInitNatNamed(name: String, initVal: Nat): Bool =
    let e = createSignalExpr(name, createRegWidthInit(name, 1, literal(initVal)));
    Bool.mk(Some(name), e)

// ---------- named per-clock-domain registers ----------

def newUIntRegCdNamed(name: String, w: Nat, cd: ClockDomain): UInt[w] =
