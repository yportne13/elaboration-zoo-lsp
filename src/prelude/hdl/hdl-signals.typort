/// Auto-named SInt[w] signed inout port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntInOutWidth`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoSIntInOut[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntInOutWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit inout port: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createInOut`. Records a port-port node directly, so the generated Verilog port list gains `port wire` plus the width for UInt/Bits/SInt (Bool has no width).
def autoBoolInOut[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createInOut(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] register: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidth`. Registers are driven by clocked assignments, so the module gains a clock port (and a reset port once an init value is used).
def autoUIntReg[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] register: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidth`. Registers are driven by clocked assignments, so the module gains a clock port (and a reset port once an init value is used).
def autoBitsReg[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed register: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntRegWidth`. Registers are driven by clocked assignments, so the module gains a clock port (and a reset port once an init value is used).
def autoSIntReg[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntRegWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit register: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createReg`. Registers are driven by clocked assignments, so the module gains a clock port (and a reset port once an init value is used).
def autoBoolReg[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createReg(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

// ---------- per-clock-domain registers (multi-clock support) ----------

/// Auto-named UInt[w] register on `cd`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthCd`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoUIntRegCd[bn: BindingName](w: Nat, cd: ClockDomain): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthCd(loopName(bn.name), w, cd));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] register on `cd`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthCd`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoBitsRegCd[bn: BindingName](w: Nat, cd: ClockDomain): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthCd(loopName(bn.name), w, cd));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed register on `cd`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntRegWidthCd`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoSIntRegCd[bn: BindingName](w: Nat, cd: ClockDomain): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntRegWidthCd(loopName(bn.name), w, cd));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit register on `cd`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthCd(..., 1, cd)`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoBoolRegCd[bn: BindingName](cd: ClockDomain): Bool =
    let e = createSignalExpr(loopName(bn.name), createRegWidthCd(loopName(bn.name), 1, cd));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] register on `cd` with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthInitCd`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoUIntRegInitCd[bn: BindingName](w: Nat, initVal: Nat, cd: ClockDomain): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInitCd(loopName(bn.name), w, literal(initVal), cd));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] register on `cd` with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthInitCd`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoBitsRegInitCd[bn: BindingName](w: Nat, initVal: Nat, cd: ClockDomain): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInitCd(loopName(bn.name), w, literal(initVal), cd));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed register on `cd` with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntRegWidthInitCd`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoSIntRegInitCd[bn: BindingName](w: Nat, initVal: Nat, cd: ClockDomain): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntRegWidthInitCd(loopName(bn.name), w, literal(initVal), cd));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit register on `cd` with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthInitCd(..., 1, ...)`. The register lives in the clock domain `cd` (createRegWidthCd / createRegWidthInitCd), so the Verilog generator emits it in `cd`'s own always block and adds that domain's clk (and reset when an init value is given) ports.
def autoBoolRegInitCd[bn: BindingName](initVal: Nat, cd: ClockDomain): Bool =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInitCd(loopName(bn.name), 1, literal(initVal), cd));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] register with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthInit`. `initVal` is a plain `Nat` and becomes the async-reset value (`literal(initVal)`), so the module also gains a reset port and a reset branch.
def autoUIntRegInit[bn: BindingName](w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInit(loopName(bn.name), w, literal(initVal)));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] register with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthInit`. `initVal` is a plain `Nat` and becomes the async-reset value (`literal(initVal)`), so the module also gains a reset port and a reset branch.
def autoBitsRegInit[bn: BindingName](w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInit(loopName(bn.name), w, literal(initVal)));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed register with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntRegWidthInit`. `initVal` is a plain `Nat` and becomes the async-reset value (`literal(initVal)`), so the module also gains a reset port and a reset branch.
def autoSIntRegInit[bn: BindingName](w: Nat, initVal: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntRegWidthInit(loopName(bn.name), w, literal(initVal)));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit register with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createRegWidthInit(..., 1, ...)`. `initVal` is a plain `Nat` and becomes the async-reset value (`literal(initVal)`), so the module also gains a reset port and a reset branch.
def autoBoolRegInit[bn: BindingName](initVal: Nat): Bool =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInit(loopName(bn.name), 1, literal(initVal)));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] `output reg` port (its `:=` drives are clocked): the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutRegWidth`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoUIntOutReg[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createOutRegWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] `output reg` port (clocked drives): the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutRegWidth`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoBitsOutReg[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createOutRegWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed `output reg` port (clocked drives): the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntOutRegWidth`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoSIntOutReg[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntOutRegWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit `output reg` port (clocked drives): the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutReg`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoBoolOutReg[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createOutReg(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

/// Auto-named UInt[w] `output reg` port with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutRegWidthInit`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoUIntOutRegInit[bn: BindingName](w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createOutRegWidthInit(loopName(bn.name), w, literal(initVal)));
    UInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bits[w] `output reg` port with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutRegWidthInit`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoBitsOutRegInit[bn: BindingName](w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createOutRegWidthInit(loopName(bn.name), w, literal(initVal)));
    Bits.mk(Some(loopName(bn.name)), e)

/// Auto-named SInt[w] signed `output reg` port with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createSIntOutRegWidthInit`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoSIntOutRegInit[bn: BindingName](w: Nat, initVal: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntOutRegWidthInit(loopName(bn.name), w, literal(initVal)));
    SInt.mk(Some(loopName(bn.name)), e)

/// Auto-named Bool 1-bit `output reg` port with async-reset value `initVal`: the signal name is the caller's let binding (`loopName(bn.name)`, which appends the `_<i>` loop index inside `rangeFor`/`genFrom` loops), and the node recorded is `createOutRegWidthInit(..., 1, ...)`. The declaration is forced to `output reg` and every `:=` drive of the signal is clocked; without an init value there is no reset branch.
def autoBoolOutRegInit[bn: BindingName](initVal: Nat): Bool =
    let e = createSignalExpr(loopName(bn.name), createOutRegWidthInit(loopName(bn.name), 1, literal(initVal)));
    Bool.mk(Some(loopName(bn.name)), e)

// ---- Explicit-name signal creation (internal helpers) ----
// The `Named` variants build signals with an explicit name string. They are
// used where the signal's name does NOT come from a let binding: the Bundle
// derive (TypeName.create / asMaster / asSlave prefix fields with the
// factory's bn), the in_u/out_u direction helpers (reuse the source signal's
// name), the RegNext impls and counter (register named after the caller's
// binding), and explicit-name call sites. The public new* family below
// delegates to these with loopName(bn.name), so `let mySignal = newUInt(8)` behaves
// exactly like `let mySignal = autoUInt(8)`.

/// Explicit-name variant of the `auto*` factory: same Bits[w] wire and `createWidth` node, but the name is the `name` argument verbatim (no `BindingName`). Used where no let binding exists — the Bundle derive, direction helpers, RegNext impls and library internals.
def newBitsNamed(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    Bits.mk(Some(name), e)

/// Explicit-name variant of the `auto*` factory: same UInt[w] wire and `createWidth` node, but the name is the `name` argument verbatim (no `BindingName`). Used where no let binding exists — the Bundle derive, direction helpers, RegNext impls and library internals.
def newUIntNamed(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    UInt.mk(Some(name), e)

/// Explicit-name variant of the `auto*` factory: same SInt[w] signed wire and `createSIntWidth` node, but the name is the `name` argument verbatim (no `BindingName`). Used where no let binding exists — the Bundle derive, direction helpers, RegNext impls and library internals.
def newSIntNamed(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntWidth(name, w));
    SInt.mk(Some(name), e)

/// Explicit-name variant of the `auto*` factory: same Bool 1-bit wire and `create` node, but the name is the `name` argument verbatim (no `BindingName`). Used where no let binding exists — the Bundle derive, direction helpers, RegNext impls and library internals.
def newBoolNamed(name: String): Bool =
    let e = createSignalExpr(name, create(name));
    Bool.mk(Some(name), e)

/// Explicit-name variant of the `auto*` factory: same UInt[w] input port and `createInWidth` node, but the name is the `name` argument verbatim (no `BindingName`). Used where no let binding exists — the Bundle derive, direction helpers, RegNext impls and library internals.
