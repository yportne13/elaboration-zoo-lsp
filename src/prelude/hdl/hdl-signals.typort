def newBitsOutRegInitNat[bn: BindingName](w: Nat, initVal: Nat): Bits[w] = newBitsOutRegInitNatNamed(loopName(bn.name), w, initVal)

/// Legacy-name wrapper for `autoBoolOutRegInit`: identical semantics and node, with the signal name taken from the caller's let binding, so `let s = newBoolOutRegInitNat(...)` behaves exactly like `let s = autoBoolOutRegInit(...)`.
def newBoolOutRegInitNat[bn: BindingName](initVal: Nat): Bool = newBoolOutRegInitNatNamed(loopName(bn.name), initVal)

// ---- Port creation helpers (used by the module macro's port list) ----
// The module macro declares ports in its pattern (`input a = UInt[8]`) and
// records them via these helpers; the returned Expr is the module's own
// signal (createInWidth etc.) so the body wires against real signals while
// the macro's subSignal field provides the hierarchical `u.a` handle.
// The port name comes from the module macro's let binding (`let $p = ...`),
// so the implicit BindingName carries exactly the port name $p.

// Create a typed port signal (UInt/Bits share createInWidth/createOutWidth/
// createInOutWidth; SInt uses the signed variants, Bool the no-width
// variants). ty is the stringified type name; w is ignored for Bool.
/// Module-macro port builder for a typed port: dispatches on the stringified type name `ty` (`"Bool"`, `"SInt"`, anything else = UInt/Bits) and on `dir` (`"input"` / `"inout"` / anything else = output), recording the matching `createIn*` / `createOut*` / `createInOut*` node under the port name from the macro's let binding (`bn`). `w` is ignored for Bool.
def createPortExpr[bn: BindingName](dir: String, ty: String, w: Nat): Expr = match str_eq(ty, "Bool") {
    case true => match str_eq(dir, "input") {
        case true => createSignalExpr(loopName(bn.name), createIn(loopName(bn.name)))
        case false => match str_eq(dir, "inout") {
            case true => createSignalExpr(loopName(bn.name), createInOut(loopName(bn.name)))
            case false => createSignalExpr(loopName(bn.name), createOut(loopName(bn.name)))
        }
    }
    case false => match str_eq(ty, "SInt") {
        case true => match str_eq(dir, "input") {
            case true => createSignalExpr(loopName(bn.name), createSIntInWidth(loopName(bn.name), w))
            case false => match str_eq(dir, "inout") {
                case true => createSignalExpr(loopName(bn.name), createSIntInOutWidth(loopName(bn.name), w))
                case false => createSignalExpr(loopName(bn.name), createSIntOutWidth(loopName(bn.name), w))
            }
        }
        case false => match str_eq(dir, "input") {
            case true => createSignalExpr(loopName(bn.name), createInWidth(loopName(bn.name), w))
            case false => match str_eq(dir, "inout") {
                case true => createSignalExpr(loopName(bn.name), createInOutWidth(loopName(bn.name), w))
                case false => createSignalExpr(loopName(bn.name), createOutWidth(loopName(bn.name), w))
            }
        }
    }
}

// Create a Bool port signal (no width).
/// Bool-only variant of `createPortExpr`: maps `dir` to `createIn` / `createInOut` / `createOut` with no width, for the module macro's `input flag = Bool` style ports.
def createBoolPortExpr[bn: BindingName](dir: String): Expr = match str_eq(dir, "input") {
    case true => createSignalExpr(loopName(bn.name), createIn(loopName(bn.name)))
    case false => match str_eq(dir, "inout") {
        case true => createSignalExpr(loopName(bn.name), createInOut(loopName(bn.name)))
        case false => createSignalExpr(loopName(bn.name), createOut(loopName(bn.name)))
    }
}

// Create an `output reg` port signal: an output port whose declaration is
// forced to `output reg` (Verilog) and whose `:=` drives are clocked, with an
// optional async-reset init value. ty is the stringified type name; UInt and
// Bits share the createOutRegWidth(Init) variants, SInt the signed ones.
// Bool ports use the no-width / width-1 init variants (via
// createOutRegBoolPortExpr below).
/// Module-macro builder for an `output reg` port: `SInt` uses `createSIntOutRegWidth`, every other type `createOutRegWidth`, so the port declaration is `output reg` and its drives are clocked. No reset value (see `createOutRegPortExprInit`).
def createOutRegPortExpr[bn: BindingName](ty: String, w: Nat): Expr = match str_eq(ty, "SInt") {
    case true => createSignalExpr(loopName(bn.name), createSIntOutRegWidth(loopName(bn.name), w))
    case false => createSignalExpr(loopName(bn.name), createOutRegWidth(loopName(bn.name), w))
}

/// `output reg` port builder with an async-reset init value: `SInt` uses `createSIntOutRegWidthInit`, others `createOutRegWidthInit`, with `literal(initVal)` as the reset value.
def createOutRegPortExprInit[bn: BindingName](ty: String, w: Nat, initVal: Nat): Expr = match str_eq(ty, "SInt") {
    case true => createSignalExpr(loopName(bn.name), createSIntOutRegWidthInit(loopName(bn.name), w, literal(initVal)))
    case false => createSignalExpr(loopName(bn.name), createOutRegWidthInit(loopName(bn.name), w, literal(initVal)))
}

/// 1-bit `output reg` port builder for Bool (`createOutReg`); the module gains a clock port and the port's drives are clocked.
def createOutRegBoolPortExpr[bn: BindingName]: Expr = createSignalExpr(loopName(bn.name), createOutReg(loopName(bn.name)))

/// 1-bit `output reg` port builder for Bool with an async-reset value: `createOutRegWidthInit(name, 1, literal(initVal))`, which also adds the reset port/branch.
def createOutRegBoolPortExprInit[bn: BindingName](initVal: Nat): Expr = createSignalExpr(loopName(bn.name), createOutRegWidthInit(loopName(bn.name), 1, literal(initVal)))

// ---- Direction annotation helpers (SpinalHDL style) ----
// These are for use inside Bundle declarations.
// For regular signal declarations, use the Expr macro:
//   input a = UInt[8]    instead of   let a = in(UInt[8]())
// The given signal's name (if any) is reused for the new directed port.

/// SpinalHDL-style direction helper: rebuilds the given UInt signal of width `width` as a input port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newUIntInputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def in_u[width: Nat](t: UInt[width]): UInt[width] =
    match t.name {
        case Some(n) => newUIntInputNamed(n, width)
        case None => newUIntInputNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given UInt signal of width `width` as a output port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newUIntOutputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def out_u[width: Nat](t: UInt[width]): UInt[width] =
    match t.name {
        case Some(n) => newUIntOutputNamed(n, width)
        case None => newUIntOutputNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given Bits signal of width `width` as a input port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newBitsInputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def in_b[width: Nat](t: Bits[width]): Bits[width] =
    match t.name {
        case Some(n) => newBitsInputNamed(n, width)
        case None => newBitsInputNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given Bits signal of width `width` as a output port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newBitsOutputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def out_b[width: Nat](t: Bits[width]): Bits[width] =
    match t.name {
        case Some(n) => newBitsOutputNamed(n, width)
        case None => newBitsOutputNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given SInt signal of width `width` as a input port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newSIntInputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def in_s[width: Nat](t: SInt[width]): SInt[width] =
    match t.name {
        case Some(n) => newSIntInputNamed(n, width)
        case None => newSIntInputNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given SInt signal of width `width` as a output port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newSIntOutputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def out_s[width: Nat](t: SInt[width]): SInt[width] =
    match t.name {
        case Some(n) => newSIntOutputNamed(n, width)
        case None => newSIntOutputNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given UInt signal of width `width` as a inout port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newUIntInOutNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def inout_u[width: Nat](t: UInt[width]): UInt[width] =
    match t.name {
        case Some(n) => newUIntInOutNamed(n, width)
        case None => newUIntInOutNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given Bits signal of width `width` as a inout port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newBitsInOutNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def inout_b[width: Nat](t: Bits[width]): Bits[width] =
    match t.name {
        case Some(n) => newBitsInOutNamed(n, width)
        case None => newBitsInOutNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given SInt signal of width `width` as a inout port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newSIntInOutNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def inout_s[width: Nat](t: SInt[width]): SInt[width] =
    match t.name {
        case Some(n) => newSIntInOutNamed(n, width)
        case None => newSIntInOutNamed("", width)
    }

/// SpinalHDL-style direction helper: rebuilds the given Bool signal as a inout port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newBoolInOutNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def inout_bool(t: Bool): Bool =
    match t.name {
        case Some(n) => newBoolInOutNamed(n)
        case None => newBoolInOutNamed("")
    }

/// SpinalHDL-style direction helper: rebuilds the given Bool signal as a input port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newBoolInputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def in_bool(t: Bool): Bool =
    match t.name {
        case Some(n) => newBoolInputNamed(n)
        case None => newBoolInputNamed("")
    }

/// SpinalHDL-style direction helper: rebuilds the given Bool signal as a output port with the **same name** as the source signal (`Some(n)` → that name, `None` → empty name), via `newBoolOutputNamed`. Used inside Bundle direction specs; for module ports use the `Expr` macro (`input a = ...`) instead.
def out_bool(t: Bool): Bool =
    match t.name {
        case Some(n) => newBoolOutputNamed(n)
        case None => newBoolOutputNamed("")
    }

// ============================================================
//  RegNext: delay register (SpinalHDL-style)
//  Creates a register of the same type and connects the input.
//  Works for any Data (UInt / SInt / Bits / Bool) via the RegNext
//  typeclass — no per-type function names needed.
//  The register is named after the caller's let binding:
//    let r = regNext(signal)         // r: same type as signal, named "r"
//    let r = regNextWhen(sig, cond)  // conditional update
//
//  Trait methods take the value as the implicit receiver ($this):
//  `r.mkReg(value, name)` desugars to the trait method with value as
//  Self, and the impl methods read it via `this`.
// ============================================================

/// Delay-register typeclass: `mkReg` creates a register of the **same** type as the receiver and connects the receiver to it (one-cycle delay), `mkRegWhen` does the same under a `when(cond)` enable (the register holds when `cond` is low). Impls exist for UInt/Bits/SInt/Bool in this file and for EnumCraft in hdl-enum, so no per-type function names are needed. The register is named by the `name` argument (the `regNext` wrappers pass the caller's let binding).
trait RegNext[T] {
    def mkReg(name: String): T
    def mkRegWhen(name: String, cond: Bool): T
}

impl[w: Nat] RegNext[UInt[w]] for UInt[w] {
    def mkReg(name: String): UInt[w] =
        let r = newUIntRegNamed(name, w);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): UInt[w] =
        let r = newUIntRegNamed(name, w);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

impl[w: Nat] RegNext[Bits[w]] for Bits[w] {
    def mkReg(name: String): Bits[w] =
        let r = newBitsRegNamed(name, w);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): Bits[w] =
        let r = newBitsRegNamed(name, w);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

impl[w: Nat] RegNext[SInt[w]] for SInt[w] {
    def mkReg(name: String): SInt[w] =
        let r = newSIntRegNamed(name, w);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): SInt[w] =
        let r = newSIntRegNamed(name, w);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

impl RegNext[Bool] for Bool {
    def mkReg(name: String): Bool =
        let r = newBoolRegNamed(name);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): Bool =
        let r = newBoolRegNamed(name);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

/// One-cycle delay: creates a register of the receiver's type, names it after the caller's let binding (`let r = regNext(sig)` → register `r`) and drives it from `sig` every cycle. Dispatches through the `RegNext[T]` typeclass, so it works for any `T` that has an impl (UInt/Bits/SInt/Bool here, EnumCraft in hdl-enum).
def regNext[bn: BindingName, T][r: RegNext[T]](value: T): T = r.mkReg(value, loopName(bn.name))
/// Conditional one-cycle delay: same register as `regNext` but the clocked assignment is wrapped in `when(cond)`, so the register only updates on cycles where `cond` is high (it holds its value otherwise; there is no reset value).
def regNextWhen[bn: BindingName, T][r: RegNext[T]](value: T, cond: Bool): T = r.mkRegWhen(value, loopName(bn.name), cond)

// ============================================================
//  Counter — SpinalHDL 风格计数器
//  counter(w)       自增计数器：每周期 value := value + 1
//  counterInc(w, en) 使能计数：when(en) { value := value + 1 }
//  value 寄存器按 let 绑定名自动命名；willOverflow 为组合信号，
//  按 hdl-utils counterIncMod 的口径由使能门控：
//  counter: (~value == 0)；counterInc: enable && (~value == 0)。
// ============================================================

/// Free-running / enable-counted counter handle: `value` is the `UInt[w]` register (init 0, named after the let binding) and `willOverflow` is a combinational flag for the cycle in which the counter reaches its maximum and the next increment wraps to 0.
struct Counter[w: Nat] {
    value: UInt[w]
    willOverflow: Bool
}

/// Free-running counter of width `w`: creates the register `value` (init 0) and drives it with `value + 1` every cycle, so it wraps from all-ones back to 0. `willOverflow` is `(~value == 0)` — high exactly on the cycle before the wrap (the counter is always enabled here).
def counter[bn: BindingName](w: Nat): Counter[w] =
    let v = newUIntRegNamed(loopName(bn.name), w);
    let _ = createSignalExpr("", regAssign(v.expr, binary(v.expr, "+", literal(1))));
    Counter.mk(v, Bool.mk(None, binary(unary("~", v.expr), "==", literal(0))))

/// Enable-counted counter of width `w`: the increment `value + 1` is wrapped in `when(enable)`, so the register holds while `enable` is low. `willOverflow` is `enable && (~value == 0)` — gated by the enable, matching the `counterIncMod` convention in hdl-utils (`willOverflow = inc && value == end`); an ungated flag would report a wrap on a cycle where the counter does not move.
def counterInc[bn: BindingName](w: Nat, enable: Bool): Counter[w] =
    let v = newUIntRegNamed(loopName(bn.name), w);
    let _ = whenBegin(enable.expr);
    let _ = createSignalExpr("", regAssign(v.expr, binary(v.expr, "+", literal(1))));
    let _ = whenEnd(unit);
    Counter.mk(v, Bool.mk(None, binary(enable.expr, "&&", binary(unary("~", v.expr), "==", literal(0)))))
