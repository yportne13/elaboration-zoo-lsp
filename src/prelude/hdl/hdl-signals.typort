// ============================================================
// HDL Signal Creation Functions
// ============================================================

// ---- Auto-named signal creation (SpinalHDL style) ----
// These functions take an implicit BindingName parameter.
// The compiler automatically fills it with the let-binding name.
// Usage:  let mySignal = autoUInt(8)
//         => mySignal gets name "mySignal" automatically

def autoUInt[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

def autoBits[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

def autoSInt[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

def autoBool[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), create(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

def autoUIntInput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createInWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

def autoBitsInput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createInWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

def autoSIntInput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntInWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

def autoBoolInput[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createIn(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

def autoUIntOutput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createOutWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

def autoBitsOutput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createOutWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

def autoSIntOutput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntOutWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

def autoBoolOutput[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createOut(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

def autoUIntInOut[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createInOutWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

def autoBitsInOut[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createInOutWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

def autoSIntInOut[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntInOutWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

def autoBoolInOut[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createInOut(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

def autoUIntReg[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidth(loopName(bn.name), w));
    UInt.mk(Some(loopName(bn.name)), e)

def autoBitsReg[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidth(loopName(bn.name), w));
    Bits.mk(Some(loopName(bn.name)), e)

def autoSIntReg[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntRegWidth(loopName(bn.name), w));
    SInt.mk(Some(loopName(bn.name)), e)

def autoBoolReg[bn: BindingName]: Bool =
    let e = createSignalExpr(loopName(bn.name), createReg(loopName(bn.name)));
    Bool.mk(Some(loopName(bn.name)), e)

// ---------- per-clock-domain registers (multi-clock support) ----------

def autoUIntRegCd[bn: BindingName](w: Nat, cd: ClockDomain): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthCd(loopName(bn.name), w, cd));
    UInt.mk(Some(loopName(bn.name)), e)

def autoBitsRegCd[bn: BindingName](w: Nat, cd: ClockDomain): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthCd(loopName(bn.name), w, cd));
    Bits.mk(Some(loopName(bn.name)), e)

def autoSIntRegCd[bn: BindingName](w: Nat, cd: ClockDomain): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntRegWidthCd(loopName(bn.name), w, cd));
    SInt.mk(Some(loopName(bn.name)), e)

def autoBoolRegCd[bn: BindingName](cd: ClockDomain): Bool =
    let e = createSignalExpr(loopName(bn.name), createRegWidthCd(loopName(bn.name), 1, cd));
    Bool.mk(Some(loopName(bn.name)), e)

def autoUIntRegInitCd[bn: BindingName](w: Nat, initVal: Nat, cd: ClockDomain): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInitCd(loopName(bn.name), w, literal(initVal), cd));
    UInt.mk(Some(loopName(bn.name)), e)

def autoBitsRegInitCd[bn: BindingName](w: Nat, initVal: Nat, cd: ClockDomain): Bits[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInitCd(loopName(bn.name), w, literal(initVal), cd));
    Bits.mk(Some(loopName(bn.name)), e)

def autoSIntRegInitCd[bn: BindingName](w: Nat, initVal: Nat, cd: ClockDomain): SInt[w] =
    let e = createSignalExpr(loopName(bn.name), createSIntRegWidthInitCd(loopName(bn.name), w, literal(initVal), cd));
    SInt.mk(Some(loopName(bn.name)), e)

def autoBoolRegInitCd[bn: BindingName](initVal: Nat, cd: ClockDomain): Bool =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInitCd(loopName(bn.name), 1, literal(initVal), cd));
    Bool.mk(Some(loopName(bn.name)), e)

def autoUIntRegInit[bn: BindingName](w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(loopName(bn.name), createRegWidthInit(loopName(bn.name), w, literal(initVal)));
    UInt.mk(Some(loopName(bn.name)), e)

