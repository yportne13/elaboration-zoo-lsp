// ============================================================
// HDL Signal Creation Functions
// ============================================================

// ---- Auto-named signal creation (SpinalHDL style) ----
// These functions take an implicit BindingName parameter.
// The compiler automatically fills it with the let-binding name.
// Usage:  let mySignal = autoUInt(8)
//         => mySignal gets name "mySignal" automatically

def autoUInt[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBits[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSInt[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBool[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, create(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntInput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createInWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBitsInput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createInWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSIntInput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntInWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBoolInput[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, createIn(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntOutput[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createOutWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBitsOutput[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createOutWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSIntOutput[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntOutWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBoolOutput[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, createOut(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntInOut[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createInOutWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBitsInOut[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createInOutWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSIntInOut[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntInOutWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBoolInOut[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, createInOut(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntReg[bn: BindingName](w: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createRegWidth(bn.name, w));
    UInt.mk(Some(bn.name), e)

def autoBitsReg[bn: BindingName](w: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createRegWidth(bn.name, w));
    Bits.mk(Some(bn.name), e)

def autoSIntReg[bn: BindingName](w: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntRegWidth(bn.name, w));
    SInt.mk(Some(bn.name), e)

def autoBoolReg[bn: BindingName]: Bool =
    let e = createSignalExpr(bn.name, createReg(bn.name));
    Bool.mk(Some(bn.name), e)

def autoUIntRegInit[bn: BindingName](w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(bn.name, createRegWidthInit(bn.name, w, literal(initVal)));
    UInt.mk(Some(bn.name), e)

def autoBitsRegInit[bn: BindingName](w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(bn.name, createRegWidthInit(bn.name, w, literal(initVal)));
    Bits.mk(Some(bn.name), e)

def autoSIntRegInit[bn: BindingName](w: Nat, initVal: Nat): SInt[w] =
    let e = createSignalExpr(bn.name, createSIntRegWidthInit(bn.name, w, literal(initVal)));
    SInt.mk(Some(bn.name), e)

def autoBoolRegInit[bn: BindingName](initVal: Nat): Bool =
    let e = createSignalExpr(bn.name, createRegWidthInit(bn.name, 1, literal(initVal)));
    Bool.mk(Some(bn.name), e)

// ---- Explicit-name signal creation (legacy) ----

def newBits(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    Bits.mk(Some(name), e)

def newUInt(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createWidth(name, w));
    UInt.mk(Some(name), e)

def newSInt(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntWidth(name, w));
    SInt.mk(Some(name), e)

def newBool(name: String): Bool =
    let e = createSignalExpr(name, create(name));
    Bool.mk(Some(name), e)

def newUIntInput(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createInWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsInput(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createInWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntInput(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntInWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolInput(name: String): Bool =
    let e = createSignalExpr(name, createIn(name));
    Bool.mk(Some(name), e)

def newBitsOutput(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createOutWidth(name, w));
    Bits.mk(Some(name), e)

def newUIntOutput(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createOutWidth(name, w));
    UInt.mk(Some(name), e)

def newSIntOutput(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntOutWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolOutput(name: String): Bool =
    let e = createSignalExpr(name, createOut(name));
    Bool.mk(Some(name), e)

def newUIntInOut(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createInOutWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsInOut(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createInOutWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntInOut(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntInOutWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolInOut(name: String): Bool =
    let e = createSignalExpr(name, createInOut(name));
    Bool.mk(Some(name), e)

// ---- Port creation helpers (used by the module macro's port list) ----
// The module macro declares ports in its pattern (`input a = UInt[8]`) and
// records them via these helpers; the returned Expr is the module's own
// signal (createInWidth etc.) so the body wires against real signals while
// the macro's subSignal field provides the hierarchical `u.a` handle.

// Create a typed port signal (UInt/Bits share createInWidth/createOutWidth/
// createInOutWidth; SInt uses the signed variants, Bool the no-width
// variants). ty is the stringified type name; w is ignored for Bool.
def createPortExpr(dir: String, ty: String, name: String, w: Nat): Expr = match str_eq(ty, "Bool") {
    case true => match str_eq(dir, "input") {
        case true => createSignalExpr(name, createIn(name))
        case false => match str_eq(dir, "inout") {
            case true => createSignalExpr(name, createInOut(name))
            case false => createSignalExpr(name, createOut(name))
        }
    }
    case false => match str_eq(ty, "SInt") {
        case true => match str_eq(dir, "input") {
            case true => createSignalExpr(name, createSIntInWidth(name, w))
            case false => match str_eq(dir, "inout") {
                case true => createSignalExpr(name, createSIntInOutWidth(name, w))
                case false => createSignalExpr(name, createSIntOutWidth(name, w))
            }
        }
        case false => match str_eq(dir, "input") {
            case true => createSignalExpr(name, createInWidth(name, w))
            case false => match str_eq(dir, "inout") {
                case true => createSignalExpr(name, createInOutWidth(name, w))
                case false => createSignalExpr(name, createOutWidth(name, w))
            }
        }
    }
}

// Create a Bool port signal (no width).
def createBoolPortExpr(dir: String, name: String): Expr = match str_eq(dir, "input") {
    case true => createSignalExpr(name, createIn(name))
    case false => match str_eq(dir, "inout") {
        case true => createSignalExpr(name, createInOut(name))
        case false => createSignalExpr(name, createOut(name))
    }
}

// ---- Register signal creation ----

def newUIntReg(name: String, w: Nat): UInt[w] =
    let e = createSignalExpr(name, createRegWidth(name, w));
    UInt.mk(Some(name), e)

def newBitsReg(name: String, w: Nat): Bits[w] =
    let e = createSignalExpr(name, createRegWidth(name, w));
    Bits.mk(Some(name), e)

def newSIntReg(name: String, w: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntRegWidth(name, w));
    SInt.mk(Some(name), e)

def newBoolReg(name: String): Bool =
    let e = createSignalExpr(name, createReg(name));
    Bool.mk(Some(name), e)

// Register with Nat literal reset value (for use in macros)
def newUIntRegInitNat(name: String, w: Nat, initVal: Nat): UInt[w] =
    let e = createSignalExpr(name, createRegWidthInit(name, w, literal(initVal)));
    UInt.mk(Some(name), e)

def newSIntRegInitNat(name: String, w: Nat, initVal: Nat): SInt[w] =
    let e = createSignalExpr(name, createSIntRegWidthInit(name, w, literal(initVal)));
    SInt.mk(Some(name), e)

def newBitsRegInitNat(name: String, w: Nat, initVal: Nat): Bits[w] =
    let e = createSignalExpr(name, createRegWidthInit(name, w, literal(initVal)));
    Bits.mk(Some(name), e)

def newBoolRegInitNat(name: String, initVal: Nat): Bool =
    let e = createSignalExpr(name, createRegWidthInit(name, 1, literal(initVal)));
    Bool.mk(Some(name), e)

// ---- Direction annotation helpers (SpinalHDL style) ----
// These are for use inside Bundle declarations.
// For regular signal declarations, use the Expr macro:
//   input a = UInt[8]    instead of   let a = in(UInt[8]())
// The given signal's name (if any) is reused for the new directed port.

def in_u[width: Nat](t: UInt[width]): UInt[width] =
    match t.name {
        case Some(n) => newUIntInput(n, width)
        case None => newUIntInput("", width)
    }

def out_u[width: Nat](t: UInt[width]): UInt[width] =
    match t.name {
        case Some(n) => newUIntOutput(n, width)
        case None => newUIntOutput("", width)
    }

def in_b[width: Nat](t: Bits[width]): Bits[width] =
    match t.name {
        case Some(n) => newBitsInput(n, width)
        case None => newBitsInput("", width)
    }

def out_b[width: Nat](t: Bits[width]): Bits[width] =
    match t.name {
        case Some(n) => newBitsOutput(n, width)
        case None => newBitsOutput("", width)
    }

def in_s[width: Nat](t: SInt[width]): SInt[width] =
    match t.name {
        case Some(n) => newSIntInput(n, width)
        case None => newSIntInput("", width)
    }

def out_s[width: Nat](t: SInt[width]): SInt[width] =
    match t.name {
        case Some(n) => newSIntOutput(n, width)
        case None => newSIntOutput("", width)
    }

def inout_u[width: Nat](t: UInt[width]): UInt[width] =
    match t.name {
        case Some(n) => newUIntInOut(n, width)
        case None => newUIntInOut("", width)
    }

def inout_b[width: Nat](t: Bits[width]): Bits[width] =
    match t.name {
        case Some(n) => newBitsInOut(n, width)
        case None => newBitsInOut("", width)
    }

def inout_s[width: Nat](t: SInt[width]): SInt[width] =
    match t.name {
        case Some(n) => newSIntInOut(n, width)
        case None => newSIntInOut("", width)
    }

def inout_bool(t: Bool): Bool =
    match t.name {
        case Some(n) => newBoolInOut(n)
        case None => newBoolInOut("")
    }

def in_bool(t: Bool): Bool =
    match t.name {
        case Some(n) => newBoolInput(n)
        case None => newBoolInput("")
    }

def out_bool(t: Bool): Bool =
    match t.name {
        case Some(n) => newBoolOutput(n)
        case None => newBoolOutput("")
    }

// ============================================================
//  RegNext: delay register (SpinalHDL-style)
//  Creates a register of the same type and connects the input.
//  Works for any Data (UInt / SInt / Bits / Bool) via the RegNext
//  typeclass — no per-type function names needed.
//  The register is named after the caller's let binding:
//    let r = regNext(signal)         // r: same type as signal, named "r"
//    let r = regNextWhen(sig, cond)  // conditional update
//
//  Trait methods take the value as the implicit receiver ($this):
//  `r.mkReg(value, name)` desugars to the trait method with value as
//  Self, and the impl methods read it via `this`.
// ============================================================

trait RegNext[T] {
    def mkReg(name: String): T
    def mkRegWhen(name: String, cond: Bool): T
}

impl[w: Nat] RegNext[UInt[w]] for UInt[w] {
    def mkReg(name: String): UInt[w] =
        let r = newUIntReg(name, w);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): UInt[w] =
        let r = newUIntReg(name, w);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

impl[w: Nat] RegNext[Bits[w]] for Bits[w] {
    def mkReg(name: String): Bits[w] =
        let r = newBitsReg(name, w);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): Bits[w] =
        let r = newBitsReg(name, w);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

impl[w: Nat] RegNext[SInt[w]] for SInt[w] {
    def mkReg(name: String): SInt[w] =
        let r = newSIntReg(name, w);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): SInt[w] =
        let r = newSIntReg(name, w);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

impl RegNext[Bool] for Bool {
    def mkReg(name: String): Bool =
        let r = newBoolReg(name);
        let _ = createSignalExpr("", regAssign(r.expr, this.expr));
        r
    def mkRegWhen(name: String, cond: Bool): Bool =
        let r = newBoolReg(name);
        let _ = whenBegin(cond.expr);
        let _assignment = createSignalExpr("", regAssign(r.expr, this.expr));
        let _ = whenEnd(unit);
        r
}

def regNext[bn: BindingName, T][r: RegNext[T]](value: T): T = r.mkReg(value, bn.name)
def regNextWhen[bn: BindingName, T][r: RegNext[T]](value: T, cond: Bool): T = r.mkRegWhen(value, bn.name, cond)

// ============================================================
//  Counter — SpinalHDL 风格计数器
//  counter(w)       自增计数器：每周期 value := value + 1
//  counterInc(w, en) 使能计数：when(en) { value := value + 1 }
//  value 寄存器按 let 绑定名自动命名；willOverflow 为组合信号
//  （value 全 1，即 (~value == 0)，下一个周期回绕到 0）。
// ============================================================

struct Counter[w: Nat] {
    value: UInt[w]
    willOverflow: Bool
}

def counter[bn: BindingName](w: Nat): Counter[w] =
    let v = newUIntReg(bn.name, w);
    let _ = createSignalExpr("", regAssign(v.expr, binary(v.expr, "+", literal(1))));
    Counter.mk(v, Bool.mk(None, binary(unary("~", v.expr), "==", literal(0))))

def counterInc[bn: BindingName](w: Nat, enable: Bool): Counter[w] =
    let v = newUIntReg(bn.name, w);
    let _ = whenBegin(enable.expr);
    let _ = createSignalExpr("", regAssign(v.expr, binary(v.expr, "+", literal(1))));
    let _ = whenEnd(unit);
    Counter.mk(v, Bool.mk(None, binary(unary("~", v.expr), "==", literal(0))))
