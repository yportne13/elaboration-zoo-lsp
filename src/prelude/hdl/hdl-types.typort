// ============================================================
// HDL Types: Data trait, Bool/Bits/UInt/SInt structs
// ============================================================

// ---------- Data trait ----------

// Is an Expr an input/inout port? Used by the derive-generated Bundle `:=`
// (and the Data `<>` default) to skip assignments whose LHS is an input port
// (driving an input is illegal Verilog), so a master/slave pair can be
// connected both ways. Inout ports are treated like inputs here: the module
// does not drive its own inout pins with a continuous assign (tri-state
// drive is not modeled). Defined before `trait Data` because Data's `<>`
// default body references it (default bodies elaborate when an impl is
// filled, i.e. within this same file).
def isInputPort(e: Expr): Boolean = match e {
    case createIn(_) => true
    case createInWidth(_, _) => true
    case createSIntInWidth(_, _) => true
    case createInOut(_) => true
    case createInOutWidth(_, _) => true
    case createSIntInOutWidth(_, _) => true
    case _ => false
}

// Drive `lhs` from `rhs`, respecting register semantics (a reg signal is
// assigned inside the clocked always block). Shared by the Data `:=` impls
// and the `<>` default; keep them in sync when changing assignment rules.
def driveExpr(lhs: Expr, rhs: Expr): Unit =
    let isReg = isRegExpr(lhs);
    let assignment = match isReg {
        case true => regAssign(lhs, rhs)
        case false => assign(lhs, rhs)
    };
    let dummy_expr = createSignalExpr("", assignment);
    unit

trait Data {
    def :=[T](that: T): Unit where T: Into[Self]
    def expr: Expr
    // `<>` — SpinalHDL-style bidirectional connection for plain signals:
    // drives each side, skipping the side that is an input/inout port (the
    // module never drives its own input or bidirectional pins). Both sides
    // must have the same type; wiring two undirected wires both ways is
    // legal Verilog but usually meaningless — use it for direction-complementary
    // ports (e.g. `output` on one module ↔ `input` on the other).
    // NOTE: implemented via driveExpr (not `:=`) because a `:=` method-call
    // dispatch inside a trait default body leaves the where-clause's implicit
    // solver unsolved; driveExpr keeps the same assignment semantics.
    def <>(that: Self): Unit =
        let _ = match isInputPort(this.zz_expr) {
            case true => unit
            case false => driveExpr(this.zz_expr, that.zz_expr)
        };
        let _ = match isInputPort(that.zz_expr) {
            case true => unit
            case false => driveExpr(that.zz_expr, this.zz_expr)
        };
        unit
}

// ============================================================
//  Hardware Bit Type (wire-level boolean)
// ============================================================

struct Bool {
    name: Option[String]
    zz_expr: Expr
}

impl Data for Bool {
    // `_into_T` 是 `where T: Into[Bool]` 子句在 parser（mod.rs）自动生成的
    // 隐式参数名：`_{trait_lowercased}_{TypeName}`（此处 Into → _into_T）。
    def :=[T](that: T): Unit where T: Into[Bool] =
        let converted: Bool = _into_T.into that;
        let ass = isRegExpr(this.zz_expr);
        let assignment = match ass {
            case true => regAssign(this.zz_expr, converted.zz_expr)
            case false => assign(this.zz_expr, converted.zz_expr)
        };
        let dummy_expr = createSignalExpr("", assignment);
        unit
    def expr: Expr = this.zz_expr
}

impl Into[Bool] for Bool {
    def into: Bool = this
}

impl Into[Bool] for Boolean {
    def into: Bool = Bool.mk(None, literal(bool_to_nat(this)))
}

// ---------- Bits (raw bit vector) ----------

struct Bits[width: Nat] {
    name: Option[String]
    zz_expr: Expr
}

impl[width: Nat] Into[Bits[width]] for Bits[width] {
    def into: Bits[width] = this
}

impl[width: Nat] Data for Bits[width] {
    def :=[T](that: T): Unit where T: Into[Bits[width]] =
        let converted = _into_T.into that;
        let isReg = isRegExpr(this.zz_expr);
        let assignment = match isReg {
            case true => regAssign(this.zz_expr, converted.zz_expr)
            case false => assign(this.zz_expr, converted.zz_expr)
        };
        let dummy_expr = createSignalExpr("", assignment);
        unit
    def expr: Expr = this.zz_expr
}

// ---------- UInt (unsigned integer) ----------

struct UInt[width: Nat] {
    name: Option[String]
    zz_expr: Expr
}

// Check if a Nat value fits in a given bit width
def natFitsIn(width: Nat, value: Nat): Boolean = match value {
    case zero => true
    case succ(v) => match width {
        case zero => false
        case succ(w) => natFitsIn(w, v)
    }
}

impl[width: Nat] Into[UInt[width]] for Nat {
    def into: UInt[width] = UInt.mk(None, literal(this))
}

impl[width: Nat] Into[UInt[width]] for UInt[width] {
    def into: UInt[width] = this
}

impl[width: Nat] Data for UInt[width] {
    def :=[T](that: T): Unit where T: Into[UInt[width]] =
        let converted = _into_T.into that;
        let isReg = isRegExpr(this.zz_expr);
        let assignment = match isReg {
            case true => regAssign(this.zz_expr, converted.zz_expr)
            case false => assign(this.zz_expr, converted.zz_expr)
        };
        let dummy_expr = createSignalExpr("", assignment);
        unit
    def expr: Expr = this.zz_expr
}

