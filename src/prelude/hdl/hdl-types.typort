//! HDL data types (UInt/SInt/Bits/Bool) and their representation.
// ============================================================
// HDL Types: Data trait, Bool/Bits/UInt/SInt structs
// ============================================================

// ---------- Data trait ----------

// Is an Expr an input/inout port? Used by the derive-generated Bundle `:=`
// (and the Data `<>` default) to skip assignments whose LHS is an input port
// (driving an input is illegal Verilog), so a master/slave pair can be
// connected both ways. Inout ports are treated like inputs here: the module
// does not drive its own inout pins with a continuous assign (tri-state
// drive is not modeled). Defined before `trait Data` because Data's `<>`
// default body references it (default bodies elaborate when an impl is
// filled, i.e. within this same file).
/// True when `e` is an input or inout port node (`createIn`, `createInWidth`,
/// `createSIntInWidth`, `createInOut`, `createInOutWidth`, `createSIntInOutWidth`).
/// Bidirectional `<>` connections use this to never drive a module's own input or
/// inout pin (driving an input is illegal Verilog; tri-state drive is not modeled).
def isInputPort(e: Expr): Boolean = match e {
    case createIn(_) => true
    case createInWidth(_, _) => true
    case createSIntInWidth(_, _) => true
    case createInOut(_) => true
    case createInOutWidth(_, _) => true
    case createSIntInOutWidth(_, _) => true
    case _ => false
}

// Drive `lhs` from `rhs`, respecting register semantics (a reg signal is
// assigned inside the clocked always block). Used ONLY by the `<>` default
// below: the `Data` `:=` impls go through hdl-core's pickAssign instead,
// which adds the Verilog-compat branch (a plain `assign` plus HDV002 when
// combDepth > 0), so the two paths are not interchangeable.
/// Records one directional drive of `lhs` from `rhs`: `regAssign` when `lhs` names a
/// register (the assignment must land inside the clocked block), plain `assign`
/// otherwise. The assignment is emitted through a throwaway `createSignalExpr` so it
/// is picked up by the module accumulator.
///
/// Callers: only the `Data` `<>` default below. The four `Data` `:=` impls use
/// hdl-core's `pickAssign`, whose register branch additionally handles the
/// Verilog-compat `always @(*)` context (`assign` + HDV002 when `combDepth > 0`); this
/// helper deliberately does not reproduce that branch.
def driveExpr(lhs: Expr, rhs: Expr): Unit =
    let isReg = isRegExpr(lhs);
    let assignment = match isReg {
        case true => regAssign(lhs, rhs)
        case false => assign(lhs, rhs)
    };
    let dummy_expr = createSignalExpr("", assignment);
    unit

/// A value that can appear in generated hardware. `expr` exposes the underlying
/// `Expr`; `:=` converts the right-hand side with `Into[Self]` and drives the left;
/// `<>` is the SpinalHDL-style bidirectional connect.
///
/// The `<>` default body drives both directions and skips any side that
/// `isInputPort` reports as an input/inout, so a master/slave port pair can be
/// connected either way. Both sides must have the same type.
trait Data {
    /// Assign a value convertible into Self to this signal.
    def :=[T](that: T): Unit where T: Into[Self]
    /// The underlying IR expression for this data value.
    def expr: Expr
    // `<>` — SpinalHDL-style bidirectional connection for plain signals:
    // drives each side, skipping the side that is an input/inout port (the
    // module never drives its own input or bidirectional pins). Both sides
    // must have the same type; wiring two undirected wires both ways is
    // legal Verilog but usually meaningless — use it for direction-complementary
    // ports (e.g. `output` on one module ↔ `input` on the other).
    // NOTE: implemented via driveExpr (not `:=`) because a `:=` method-call
    // dispatch inside a trait default body leaves the where-clause's implicit
    // solver unsolved; driveExpr keeps the same assignment semantics.
    /// Bidirectional connect used for differential/stream bundles.
    def <>(that: Self): Unit =
        let _ = match isInputPort(this.zz_expr) {
            case true => unit
            case false => driveExpr(this.zz_expr, that.zz_expr)
        };
        let _ = match isInputPort(that.zz_expr) {
            case true => unit
            case false => driveExpr(that.zz_expr, this.zz_expr)
        };
        unit
}

// ============================================================
//  Hardware Bit Type (wire-level boolean)
// ============================================================

/// Hardware boolean: a single bit in generated Verilog. `zz_expr` is the backing
/// expression and `name` is `Some` only once a `LetNamed` instance has materialized
/// the value as a named wire.
struct Bool {
    /// Name the signal was created with, when it has one.
    name: Option[String]
    /// The IR this Bool value refers to.
    zz_expr: Expr
}

impl Data for Bool {
    // `_into_T` 是 `where T: Into[Bool]` 子句在 parser（mod.rs）自动生成的
    // 隐式参数名：`_{trait_lowercased}_{TypeName}`（此处 Into → _into_T）。
    def :=[T](that: T): Unit where T: Into[Bool] =
        let converted: Bool = _into_T.into that;
        let assignment = pickAssign(this.zz_expr, converted.zz_expr);
        let dummy_expr = createSignalExpr("", assignment);
        unit
    def expr: Expr = this.zz_expr
}

impl Into[Bool] for Bool {
    def into: Bool = this
}

impl Into[Bool] for Boolean {
    def into: Bool = Bool.mk(None, literal(bool_to_nat(this)))
}

// ---------- Bits (raw bit vector) ----------

/// A raw `width`-bit vector with no arithmetic interpretation. Only bit-level
/// operations are provided (`Cat`, shifts, `|`, `&`, `^`); use `UInt`/`SInt` for
/// numeric operators.
struct Bits[width: Nat] {
    /// Name the signal was created with, when it has one.
    name: Option[String]
    /// The IR this Bits value refers to.
    zz_expr: Expr
}

impl[width: Nat] Into[Bits[width]] for Bits[width] {
    def into: Bits[width] = this
}

impl[width: Nat] Data for Bits[width] {
    def :=[T](that: T): Unit where T: Into[Bits[width]] =
        let converted = _into_T.into that;
        let assignment = pickAssign(this.zz_expr, converted.zz_expr);
        let dummy_expr = createSignalExpr("", assignment);
        unit
    def expr: Expr = this.zz_expr
}

// ---------- UInt (unsigned integer) ----------

/// Unsigned `width`-bit integer. Width growth on `+`/`-`/`*`, comparison and the
/// `Nat` literal conversions are supplied by instances in `hdl-ops.typort`;
/// `UInt` itself only carries the expression and an optional wire name.
struct UInt[width: Nat] {
    /// Name the signal was created with, when it has one.
    name: Option[String]
    /// The IR this UInt value refers to.
    zz_expr: Expr
}

// Check if a Nat value fits in a given bit width
/// True iff the literal `value` is representable in `width` bits, i.e. `value < 2^width`.
/// Recurses in lockstep on `succ value` and on `width`, returning `false` when `value`
/// still has bits left but `width` has reached `zero`.
def natFitsIn(width: Nat, value: Nat): Boolean = match value {
    case zero => true
    case succ(v) => match width {
        case zero => false
        case succ(w) => natFitsIn(w, v)
    }
}

impl[width: Nat] Into[UInt[width]] for Nat {
    def into: UInt[width] = UInt.mk(None, literal(this))
}

impl[width: Nat] Into[UInt[width]] for UInt[width] {
    def into: UInt[width] = this
}

impl[width: Nat] Data for UInt[width] {
    def :=[T](that: T): Unit where T: Into[UInt[width]] =
        let converted = _into_T.into that;
        let assignment = pickAssign(this.zz_expr, converted.zz_expr);
        let dummy_expr = createSignalExpr("", assignment);
        unit
    def expr: Expr = this.zz_expr
}

// ---------- SInt (signed integer) ----------

/// Two's-complement signed `width`-bit integer. `literal` seeds it and the operator
/// instances in `hdl-ops.typort` use signed comparison, unlike `UInt`.
struct SInt[width: Nat] {
    /// Name the signal was created with, when it has one.
    name: Option[String]
    /// The IR this SInt value refers to.
    zz_expr: Expr
}

impl[width: Nat] Into[SInt[width]] for SInt[width] {
    def into: SInt[width] = this
}

impl[width: Nat] Into[SInt[width]] for Nat {
    def into: SInt[width] = SInt.mk(None, literal(this))
}

impl[width: Nat] Data for SInt[width] {
    def :=[T](that: T): Unit where T: Into[SInt[width]] =
        let converted = _into_T.into that;
        let assignment = pickAssign(this.zz_expr, converted.zz_expr);
        let dummy_expr = createSignalExpr("", assignment);
        unit
    def expr: Expr = this.zz_expr
}

// ============================================================
// LetNamed — expression lets become named wires (SpinalHDL semantics)
// ============================================================
// `let x = a + b` in a module body emits a real Verilog wire:
//     wire [7:0] x;
//     assign x = (a + b);
// instead of inlining at every use site. The Expr macro's generic let arm
// (hdl-macros.typort) wraps the RHS as nameWire($y): the def's implicit
// `bn: BindingName` is synthesized from the let binder's name, and the
// LetNamed instance for the value's type materializes the wire — a create
// node plus an assign recorded through createSignalExpr — returning a
// signal whose zz_expr READS the wire, so later uses reference `x`.
// Already-declared signals (factory products, ports, regs —
// isDeclaredSignal) pass through unchanged: their let is plain aliasing.
// SHAPE: dispatched like regNext (hdl-signals.typort) — a top-level def
// with a `[ln: LetNamed[T]]` implicit constraint, NOT method-call syntax
// (the method-call path misbinds an impl Nat parameter on parameterized
// modules).
// KNOWN LIMIT: in a width-parameterized module (`module m[w: Nat]`), the
// impl's `w` freezes as a dangling elaboration-time variable at
// materialization time — the SAME pre-existing typeclass gap that gives
// `regNext` a 1-bit `reg d;` there (no runtime width has ever flown through
// an impl type parameter; the working widths all come from explicit value
// arguments like memUInt(64, 8) or macro-transcribed port expressions).
// Fixed-width modules are exact. The HDL004 self-check (hdl-check.typort)
// reports the degraded signal instead of letting it pass silently — see
// docs/l13-typeclass-instance-nat-param-bug.md.
/// Turns a `let`-bound expression into a real named Verilog wire. `mkNamed(name)`
/// returns a value whose `zz_expr` *reads* the freshly created wire (and emits
/// `wire [w-1:0] name; assign name = <expr>;`) instead of the expression itself, so
/// every later use of the binder refers to the wire.
///
/// Already-declared signals (ports, regs, factory products) are returned unchanged:
/// for those the `let` stays a plain alias.
trait LetNamed[T] {
    /// Create a value under an explicit name.
    def mkNamed(name: String): T
}

impl[w: Nat] LetNamed[UInt[w]] for UInt[w] {
    def mkNamed(name: String): UInt[w] =
        match isDeclaredSignal(this.zz_expr) {
            case true => this
            case false =>
                let wire = createSignalExpr(name, createWidth(name, w));
                let d = createSignalExpr("", assign(wire, this.zz_expr));
                UInt.mk(Some(name), wire)
        }
}

impl[w: Nat] LetNamed[Bits[w]] for Bits[w] {
    def mkNamed(name: String): Bits[w] =
        match isDeclaredSignal(this.zz_expr) {
            case true => this
            case false =>
                let wire = createSignalExpr(name, createWidth(name, w));
                let d = createSignalExpr("", assign(wire, this.zz_expr));
                Bits.mk(Some(name), wire)
        }
}

impl[w: Nat] LetNamed[SInt[w]] for SInt[w] {
    def mkNamed(name: String): SInt[w] =
        match isDeclaredSignal(this.zz_expr) {
            case true => this
            case false =>
                let wire = createSignalExpr(name, createSIntWidth(name, w));
                let d = createSignalExpr("", assign(wire, this.zz_expr));
                SInt.mk(Some(name), wire)
        }
}

impl LetNamed[Bool] for Bool {
    def mkNamed(name: String): Bool =
        match isDeclaredSignal(this.zz_expr) {
            case true => this
            case false =>
                let wire = createSignalExpr(name, create(name));
                let d = createSignalExpr("", assign(wire, this.zz_expr));
                Bool.mk(Some(name), wire)
        }
}

// Reflexive no-op fallback — MUST stay last (the trait solver takes the
// first registered matching instance). Covers every other receiver type:
// bundles, sub-module instances, Nat/String locals.
impl[T] LetNamed[T] for T {
    def mkNamed(name: String): T = this
}

// The let-RHS wrapper: bn is synthesized from the let binder name by the
// compiler, exactly like the new- and auto- factories.
/// The `let` macro arm's entry point: names the wire from the synthesized let binder
/// (`bn.name`, passed through `loopName`) and dispatches the materialization to the
/// `LetNamed` instance for the value's type.
def nameWire[bn: BindingName, T][ln: LetNamed[T]](value: T): T = ln.mkNamed(value, loopName(bn.name))
