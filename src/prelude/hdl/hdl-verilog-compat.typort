//! Verilog compatibility helpers.
// ============================================================
// Verilog syntax compatibility layer (M1)
// ============================================================
// Lets common Verilog syntax be written directly inside .typort files.
// A Verilog-shaped `module top(input clk, input [7:0] a, ...); ...
// endmodule` is matched by a dedicated arm of the `module` macro
// (hdl-macros.typort) whose body statements dispatch through THIS file's
// `VExpr` statement macro — a Verilog statement table kept strictly
// separate from typort's `Expr` table, so the two syntaxes never pollute
// each other. Every arm transcribes to the same factories the typort HDL
// uses (newUInt / newUIntReg / whenBegin / ...); elaboration, Verilog
// codegen and LSP span mapping are fully reused.
//
// Mapping summary — M1 (skeleton) + M2 (expressions / codegen) + M3 (reset &
// clock hierarchy) are all implemented; the full table lives in
// docs/verilog-compat.md §2 and the milestone tables in §4.
//   input clk / reset / rst_n (leading AND trailing scalar ports)
//                                               -> folded into the module
//       ClockDomain by compatFoldPort (clk => clock name, reset =>
//       ActiveHigh, rst_n => ActiveLow) AND emitted as a REAL Bool port, so
//       the body can reference them (`if (!rst_n) q <= 0; else q <= d;`)
//   wire/reg [msb:lsb] x;  (= init)             -> newUInt / newUIntReg(InitNat)
//   assign y = e;  /  assign y[i] = e;  /  assign y[hi:lo] = e;
//                                               -> y := e / y[i] / y.slice[hi,lo]
//   always @(posedge clk [or posedge|negedge rst]) begin ... end
//                                               -> body verbatim + HDV001
//       clock/reset-name checks; the reset edge goes into the sensitivity list
//   always @(*) / @* begin ... end              -> combBegin/combEnd context;
//       a reg assigned there is driven COMBINATIONALLY (combBegin + HDV002,
//       routed into the merged always @(*) block as blocking assignments)
//   q <= d;  q = d;                             -> q := d (reg-ness decides
//       clocked vs combinational; inside @(*) a reg is forced combinational)
//   if (c) ... else ...                         -> when/otherwise chain
//   case (x) L: ... default: ... endcase        -> exclusive when/elsewhen
//       chain comparing through CaseEq; `default` is an always-true label
//   child u1 (.a(x), .sum(s));                  -> u1 = child.create; vconnT(...)
//       (direction-aware: an input becomes `.a(x)`, an output `sig := u.a`)
//   8'h2A / 5'd10 / 4'b1010                     -> sizedLit (parser desugar;
//       the width rides in the Expr, so `{4'h3, nib}` keeps its 4 bits)
//   a == b / a != b                             -> === / =/= through VEq
//   a[3] / a[7:4] / {a,b} / &a / |a / ^a        -> bitsel / slice / ##-chain /
//       andR / orR / xorR (parser desugar, M2)
//
// Constraints: one clock domain per module; the folded names are exactly clk /
// reset / rst_n; port groups are matched as contiguous runs (leading scalar
// inputs, `[hi:lo]` ports, `output reg [hi:lo]`, scalar `output reg`,
// remaining scalars) and width ports must precede scalar outputs; every
// statement ends with `;` (or begin/end). Still unsupported (M4): parameter
// headers, generate, initial, delays (`#`), `$display`, the `wire` type
// modifier on ports (`input wire [7:0] a` — matching has no lookahead, so
// write the bare direction), empty `.port()` / positional connections and
// multi-clock domains.

// ---------- sized literals ----------
// The parser rewrites `8'h2A` (Num "8", Op "'", Ident "h2A") to
// sizedLit(8, 42) with the value computed on the Rust side; overflow past
// the width is rejected there. The width lives in the TYPE, and (since the
// `sizedLiteral` Expr variant) is also carried in the Expr so codegen emits
// a legal sized constant `8'd42` — IEEE 1364 forbids unsized constants inside
// concatenations, and `{4'h3, nib}` must keep its 4-bit width.

/// A sized Verilog literal `w'dv` as a `UInt[w]` — the parser's desugar target
/// for `8'h2A` / `5'd10` / `4'b1010` (the Rust side computes the value and
/// rejects overflow past the width).  The width lives in the TYPE and in the
/// `sizedLiteral` Expr, so codegen emits a legal sized constant: IEEE 1364
/// forbids unsized constants inside concatenations.
def sizedLit(w: Nat, v: Nat): UInt[w] = UInt.mk(None, sizedLiteral(v, w))

// ---------- Verilog comparison aliases ----------
// `a == b` / `a != b` desugar to method calls. Inherent impl blocks allow
// only one method per name and their where-clause implicits don't get
// inserted at call sites, so follow the Equal pattern instead: a small
// trait with per-argument-type instances (UInt vs UInt, UInt vs Nat, ...),
// exactly how === overloads in hdl-ops.

/// `==` / `!=` for Verilog-style comparison: generated Verilog `==` / `!=`,
/// built from typort's `===` / `=/=`.  A trait rather than an inherent impl
/// because an inherent block allows only one method per name and its
/// where-clause implicits are not inserted at call sites (the `Equal` pattern).
/// Instances: UInt/UInt, UInt/Nat, SInt/SInt, Bool/Bool.
trait VEq[A] {
    def ==(that: A): Bool
    def !=(that: A): Bool
}

impl[width: Nat] VEq[UInt[width]] for UInt[width] {
    def ==(that: UInt[width]): Bool = this === that
    def !=(that: UInt[width]): Bool = this =/=(that)
}

impl[width: Nat] VEq[Nat] for UInt[width] {
    def ==(that: Nat): Bool = this === that
    def !=(that: Nat): Bool = this =/=(that)
}

impl[width: Nat] VEq[SInt[width]] for SInt[width] {
    def ==(that: SInt[width]): Bool = this === that
    def !=(that: SInt[width]): Bool = this =/=(that)
}

impl VEq[Bool] for Bool {
    def ==(that: Bool): Bool = this === that
    def !=(that: Bool): Bool = this =/=(that)
}

// ---------- case/endcase label comparison ----------
// The VExpr `case` arm transcribes `case (x) L1: ... default: ... endcase`
// into a flat when/elsewhen chain. Labels go through CaseEq instead of `===`
// so the `default` label needs no dedicated macro arm: `default` is an
// ordinary identifier here (the typort switch builder uses it only as a
// method name), bound to a marker value whose instance is always true. The
// signal-vs-signal and signal-vs-Nat instances delegate to `===`, so `2'b01`
// and `1` labels behave exactly as in typort.
// NOTE: a trait (not an inherent impl) so the method is found at the call
// site — same reason as VEq above.

/// Marker type for the `case ... default:` label.  Lets `default` be captured
/// as an ordinary identifier by the VExpr `case` arm, so no dedicated macro
/// arm is needed for it.
enum CaseDefault {
    caseDefault
}

/// The always-true `case` label.  The `CaseEq[CaseDefault]` instances return
/// literal `1`, so a `default:` branch matches every selector value; in the
/// emitted when/elsewhen chain it contributes an unconstrained condition.
def default: CaseDefault = caseDefault

/// Label comparison for `case` (`caseEq(that)`): `this === that` for
/// UInt/SInt-vs-signal and UInt/SInt-vs-Nat labels, always true for
/// `CaseDefault` (`default:`).  A trait for the same call-site reason as `VEq`.
trait CaseEq[B] {
    def caseEq(that: B): Bool
}

impl[width: Nat] CaseEq[UInt[width]] for UInt[width] {
    def caseEq(that: UInt[width]): Bool = this === that
}

impl[width: Nat] CaseEq[Nat] for UInt[width] {
    def caseEq(that: Nat): Bool = this === that
}

impl[width: Nat] CaseEq[CaseDefault] for UInt[width] {
    def caseEq(that: CaseDefault): Bool = Bool.mk(None, literal(1))
}

impl[width: Nat] CaseEq[SInt[width]] for SInt[width] {
    def caseEq(that: SInt[width]): Bool = this === that
}

impl[width: Nat] CaseEq[Nat] for SInt[width] {
    def caseEq(that: Nat): Bool = this === that
}

impl[width: Nat] CaseEq[CaseDefault] for SInt[width] {
    def caseEq(that: CaseDefault): Bool = Bool.mk(None, literal(1))
}

// ---------- folded clock-domain state ----------
// The Verilog module arm's prologue creates this global fresh on every
// create/tree run, then the per-port `compatSetClk/compatSetRst` markers
// fire for each folded port; compatCD() reads it when the ModuleDef is
// recorded. The struct wrapper exists because a mutable global's name
// must be an existing type name (see hdl-core's CombCtx note).

/// Folded clock-domain state (the "CompatCD" mutable global), filled by
/// `compatSetClk` / `compatSetRst` while the module arm walks its scalar input
/// ports and read back by `compatCD` when the `ModuleDef` is recorded.  The
/// struct wrapper exists because a mutable global's name must be an existing
/// type name (same pattern as hdl-core's `CombCtx`).
struct CompatCD {
    clk: String
    rst: String
    rstHigh: Boolean
}

/// Fold `input clk` into the module's clock domain: set the clock name; a
/// folded clock with no explicit reset keeps the canonical reset name
/// `reset` (so `compatCD` needs no empty-reset special case).  Does not touch
/// an already-folded reset name.
def compatSetClk(n: String): Unit =
    // A folded clock with no explicit reset keeps the canonical reset name
    // (compatCD then needs no empty-reset special case).
    let _ = change_mutable("CompatCD", x => match str_eq(x.rst, "") {
        case true => CompatCD.mk(n, "reset", true)
        case false => x
    });
    unit

/// Fold `input reset` / `input rst_n` into the module's clock domain: set the
/// reset name and polarity (`activeHigh` true for `reset`, false for `rst_n`).
def compatSetRst(n: String, activeHigh: Boolean): Unit =
    let _ = change_mutable("CompatCD", x => CompatCD.mk(x.clk, n, activeHigh));
    unit

// One folded-port marker per declared scalar input, dispatched by NAME at run
// time (the module macro cannot branch on a literal keyword in its pattern, so
// it captures every leading scalar input and calls this). Only clk / reset /
// rst_n touch the clock-domain fold; any other scalar input is a plain port.
// Deliberately one `str_eq` per `match` (matching compatCD's note: nested
// str_eq scrutinees made declaration-time elaboration loop).
/// Dispatch one declared scalar input port by name at run time (the module
/// macro cannot branch on a literal keyword in its pattern, so it captures
/// EVERY leading and trailing scalar input and calls this for each).  Only
/// `clk` / `reset` / `rst_n` touch the clock-domain fold; any other scalar
/// input is a plain Bool port.  Deliberately one `str_eq` per `match`: nested
/// `str_eq` scrutinees made declaration-time elaboration loop.
def compatFoldPort(n: String): Unit =
    let _a = match str_eq(n, "clk") {
        case true => compatSetClk(n)
        case false => unit
    };
    let _b = match str_eq(n, "reset") {
        case true => compatSetRst(n, true)
        case false => unit
    };
    let _c = match str_eq(n, "rst_n") {
        case true => compatSetRst(n, false)
        case false => unit
    };
    unit

// NOTE: keep this match NESTING SHALLOW (one str_eq level) — a three-level
// nested str_eq match here made declaration-time elaboration loop.
/// Read the folded clock domain for the module being recorded: a
/// `ClockDomain` with the folded clock/reset names, `Async` + `RisingEdge`,
/// and `ActiveHigh` / `ActiveLow` from the fold; `defaultClockDomain` when no
/// `clk` was folded.  `mname` is unused (report attribution comes from the
/// fold state).  NOTE: keep the match nesting shallow (one `str_eq` level) — a
/// three-level nested `str_eq` match here made declaration-time elaboration
/// loop.
def compatCD(mname: String): ClockDomain =
    let _ = change_mutable_default("CompatCD", x => x, CompatCD.mk("", "", true));
    let cd = get_global("CompatCD");
    match str_eq(cd.clk, "") {
        case true => defaultClockDomain
        case false => match cd.rstHigh {
            case true => ClockDomain.mk cd.clk cd.rst Async RisingEdge ActiveHigh
            case false => ClockDomain.mk cd.clk cd.rst Async RisingEdge ActiveLow
        }
    }

// Report module names come from the FOLDED state (cd.clk / cd.rst), never
// literals or the checked def's parameters: at class-decl check time the
// fold state is still empty, so report_check_issue skips the line (empty
// module — the same protection hdl-check gets from parameter-passed module
// names); at module-run time a folded clock exists and mismatches report
// for real.

/// HDV001 check for `always @(posedge <clk>)`: the written clock name must
/// equal the module's folded `input clk`.  Report attribution comes from the
/// FOLD state (`cd.clk`), never from the checked def's parameters — at
/// class-declaration check time the fold is still empty, so `report_check_issue`
/// skips the line (empty module name) and at module-run time a mismatch reports
/// for real.
def compatCheckClk(clkArg: String): Unit =
    let _ = change_mutable_default("CompatCD", x => x, CompatCD.mk("", "", true));
    let cd = get_global("CompatCD");
    match str_eq(clkArg, cd.clk) {
        case true => unit
        case false =>
            let _ = report_check_issue("HDV001", cd.clk, clkArg, "always @(posedge ...) clock must match the module's folded `input clk` port");
            unit
    }

/// HDV001 check for `always @(posedge clk or posedge|negedge <rst>)`: the
/// written reset name must equal the module's folded `input reset` /
/// `input rst_n`.  Same empty-module skip at declaration-check time as
/// `compatCheckClk`.
def compatCheckRst(rstArg: String): Unit =
    let _ = change_mutable_default("CompatCD", x => x, CompatCD.mk("", "", true));
    let cd = get_global("CompatCD");
    match str_eq(rstArg, cd.rst) {
        case true => unit
        case false =>
            let _ = report_check_issue("HDV001", cd.rst, rstArg, "always @(posedge clk or ...) reset must match the module's folded `input reset` / `input rst_n` port");
            unit
    }

// ---------- port direction validation ----------

// NOTE: like compatCD above — keep str_eq OUT of nested scrutinee positions
// (let-bind the comparisons first); three nested str_eq scrutinees made
// declaration-time elaboration loop.
/// Validate a port direction keyword and return it unchanged (`input` /
/// `inout` / `output`).  Anything else reports HDV003 and falls back to
/// `"input"`.  The three `str_eq` calls are let-bound instead of nested in
/// scrutinee position — nested `str_eq` scrutinees made declaration-time
/// elaboration loop.
def compatDir(d: String): String =
    let isInput = str_eq(d, "input");
    let isInout = str_eq(d, "inout");
    let isOutput = str_eq(d, "output");
    match isInput {
        case true => d
        case false => match isInout {
            case true => d
            case false => match isOutput {
                case true => d
                case false =>
                    let _ = report_check_issue("HDV003", d, d, "unknown port direction (expected input / output / inout)");
                    "input"
            }
        }
    }

// ---------- direction-aware named-port connection ----------
// `child u1 (.a(x), .sum(s));` — Verilog's `.p(x)` looks the same for
// inputs and outputs; typort needs `u.a := x` vs `x := u.a`. vconn looks
// the child ModuleDef up in the design-wide registry (registered when the
// child's create ran, earlier in the same body) and emits the assign node
// with the subSignal on the correct side — the Verilog generator already
// renders assign-to/from-subSignal as port connections.

/// Is `e` an input-port declaration expression named `pname`?  Only the
/// `createIn*` variants count (output / inout declarations are false).
def isInputPortExpr(e: Expr, pname: String): Boolean = match e {
    case createIn(n) => str_eq(n, pname)
    case createInWidth(n, _) => str_eq(n, pname)
    case createSIntInWidth(n, _) => str_eq(n, pname)
    case _ => false
}

/// Does a declared expr list contain an input port named `pname`?  Lets the
/// port-connection dispatch choose the direction side of `.p(x)`.
def anyInputPort[n: Nat](exprs: Vec[Expr] n, pname: String): Boolean = match exprs {
    case nil => false
    case cons(e, rest) => match isInputPortExpr(e, pname) {
        case true => true
        case false => anyInputPort(rest, pname)
    }
}

/// Find the module name of instance `iname` in a def's expr list (the
/// `instance(n, mdl)` records), `None` if the instance is not there.  PURE
/// navigation: binder arms only, no global ops — the shape the elaborator
/// needs at declaration time.
def instModuleOf[n: Nat](exprs: Vec[Expr] n, iname: String): Option[String] = match exprs {
    case nil => None
    case cons(e, rest) => match e {
        case instance(n, mdl) => match str_eq(n, iname) {
            case true => Some(mdl)
            case false => instModuleOf(rest, iname)
        }
        case _ => instModuleOf(rest, iname)
    }
}

/// Find a `ModuleDef` by name in a Vec (first match); `None` when absent.
def findModuleDef[n: Nat](defs: Vec[ModuleDef] n, name: String): Option[ModuleDef] = match defs {
    case nil => None
    case cons(md, rest) => match str_eq(md.name, name) {
        case true => Some(md)
        case false => findModuleDef(rest, name)
    }
}

// Entry: dispatch a `.port(sig)` connection. Reads go through ensure-exists
// + get_global (the mkInstanceIfParent pattern); the assign side effect is
// created OUTSIDE any change_mutable lambda — a change_mutable on ModuleTree
// from inside a ModuleTree lambda (vconnInTree's earlier shape) made
// declaration-time elaboration loop.
// Verilog-compat named-port connection (`.a(x)`): direction dispatch is
// split so every piece keeps a shape the elaborator handles at declaration
// time (see def_needs_replay / the bisection notes):
//   - vconnLookup: PURE navigation (the instModuleOf class — binder arms,
//     no global ops).
//   - vconnEmit: Boolean-match arms + createSignalExpr (the pickAssign
//     class).
//   - the `vconn` BUILTIN (cxt.rs) glues them: reads ModuleTree /
//     ModuleRegistry from the mutable map, applies vconnLookup, then
//     vconnEmit — or the HDV003 lint when the child module is not in the
//     registry. All-typort versions of this dispatch looped declaration-
//     time elaboration on infinite Sum normalization (Expr-typed ctor
//     payloads + global reads under binder-pattern arms).
/// Emit the assign node for a Verilog-compat named-port connection `.p(x)`,
/// on the correct side for the child port's direction: an input port becomes
/// `port := sig` (emitted `.p(x)`), an output port becomes `sig := port`
/// (reading the child output).  Deliberately shaped as Boolean-match arms plus
/// `createSignalExpr` (the `pickAssign` class); the `vconn` BUILTIN in
/// `src/L13_namespace/cxt.rs` glues the `instModuleOf`-style lookup to this —
/// all-typort versions of the dispatch loop declaration-time elaboration on
/// infinite Sum normalization.
def vconnEmit(isIn: Boolean, port: Expr, sig: Expr): Unit =
    match isIn {
        case true =>
            let dummy = createSignalExpr("", assign(port, sig));
            unit
        case false =>
            let dummy = createSignalExpr("", assign(sig, port));
            unit
    }

// ============================================================
// VExpr — the Verilog statement table
// ============================================================
// Dispatched ONLY from the Verilog arm of the `module` macro via
// `$( $body: VExpr )*` fragments (nested statement bodies below also use
// `$x: VExpr`, expanded at match time exactly like typort's `Expr`
// fragments). Arms are ordered most-specific-first: rule order is the only
// backtracking. `raw` fragments are greedy and non-backtracking, so they
// only appear at end-of-statement (bounded by the literal `;`) or inside
// bracket/paren delimiters. The final catch-all also requires a `;`, so
// the closing `end` / `endmodule` tokens are never swallowed as
// expression statements.

/// The Verilog STATEMENT table, dispatched ONLY from the Verilog arm of the
/// `module` macro through `$( $body: VExpr )*` fragments (nested statement
/// bodies below also use `$x: VExpr`).  Kept strictly separate from typort's
/// `Expr` table so the two syntaxes never pollute each other.  Every arm
/// transcribes to the same factories typort HDL uses (`newUInt` /
/// `newUIntReg` / `whenBegin` / ...), so elaboration, Verilog codegen and LSP
/// span mapping are fully reused.  What each arm generates:
///   `wire [hi:lo] w [= v];` / `wire w [= v];`
///       -> `newUInt(hi-lo+1)` (plus `w := v` when initialised)
///   `reg [hi:lo] q [= v];` / `reg q [= v];`
///       -> `newUIntReg` / `newUIntRegInitNat` (init is a plain decimal Nat)
///   `assign l = r;` / `assign l[i] = r;` / `assign l[hi:lo] = r;`
///       -> `l := r` / `l[i] := r` / `l.slice[hi,lo] := r`
///   `always @(posedge clk [or posedge|negedge rst]) begin ... end`
///       -> HDV001 clock/reset name checks, then the body verbatim; the folded
///          clock domain makes `q <= d` a clocked regAssign and the reset edge
///          lands in the sensitivity list
///   `always @(*) begin ... end` / `always @ * ...`
///       -> `combBegin()` / `combEnd()` (a reg assigned here is driven
///          combinationally; HDV002 lint)
///   `if (c) ... [else ...]` (begin-forms tried before single-statement forms)
///       -> `whenBegin` / `whenOtherwiseBegin` / `whenEnd`
///   `begin ... end` (bare grouping) -> the statements spliced flat
///   `child u1 (.a(x), ...);` -> `u1 = child.create` + `vconnT` per named port
///          (direction-aware: input -> `u.p := x`, output -> `x := u.p`)
///   `l <= r;` / `l[i] <= r;` / `l[hi:lo] <= r;` (and the `=` forms)
///       -> procedural assignment, same desugar as `assign`
///   `case (e) L1: s1; ... default: sd; endcase`
///       -> flat when/elsewhen chain comparing labels through `CaseEq` (no
///          trailing `;`, so only this arm can match it)
///   `$x: raw ;` -> expression statement; the `;` is required so the closing
///          `end` / `endmodule` tokens are never swallowed
/// Arms are ordered most-specific-first (rule order is the only
/// backtracking).  `raw` fragments are greedy and non-backtracking, so they
/// appear only at end-of-statement (bounded by the literal `;`) or inside
/// bracket/paren delimiters.
#[macro_export]
macro_rules VExpr {
    // ---- wire declarations (width = msb - lsb + 1, written `1 + hi - lo`
    //      so a `)` never directly precedes `+` inside group transcriptions) ----
    (wire [ $hi: raw : $lo: raw ] $w: ident = $v: raw ;) => {
        let $w: UInt[1 + ($hi) - ($lo)] = newUInt(1 + ($hi) - ($lo));
        let _ = ($w := ($v));
    };
    (wire [ $hi: raw : $lo: raw ] $w: ident ;) => {
        let $w: UInt[1 + ($hi) - ($lo)] = newUInt(1 + ($hi) - ($lo));
    };
    (wire $w: ident = $v: raw ;) => {
        let $w: UInt[1] = newUInt(1);
        let _ = ($w := ($v));
    };
    (wire $w: ident ;) => {
        let $w: UInt[1] = newUInt(1);
    };

    // ---- reg declarations (init value: plain decimal only — the Nat-typed
    //      factory; sized literals as init are M2) ----
    (reg [ $hi: raw : $lo: raw ] $q: ident = $v: raw ;) => {
        let $q: UInt[1 + ($hi) - ($lo)] = newUIntRegInitNat(1 + ($hi) - ($lo), ($v));
    };
    (reg [ $hi: raw : $lo: raw ] $q: ident ;) => {
        let $q: UInt[1 + ($hi) - ($lo)] = newUIntReg(1 + ($hi) - ($lo));
    };
    (reg $q: ident = $v: raw ;) => {
        let $q: UInt[1] = newUIntRegInitNat(1, ($v));
    };
    (reg $q: ident ;) => {
        let $q: UInt[1] = newUIntReg(1);
    };

    // ---- continuous assignment (LHS: bit-select, part-select, plain) ----
    (assign $l: ident [ $i: raw ] = $r: raw ;) => {
        let _ = ($l[$i] := ($r));
    };
    (assign $l: ident [ $hi: raw : $lo: raw ] = $r: raw ;) => {
        let _ = ($l.slice[$hi, $lo] := ($r));
    };
    (assign $l: ident = $r: raw ;) => {
        let _ = ($l := ($r));
    };

    // ---- always @(posedge clk [or posedge/negedge rst]) begin ... end ----
    // Sequential block: the statements are transcribed verbatim — `q <= d`
    // already becomes a clocked regAssign via the module's folded clock
    // domain; only the clock/reset names are validated.
    (always @ ( posedge $clk: ident or posedge $rst: ident ) begin $( $s: VExpr )* end) => {
        let _ = compatCheckClk(stringify $clk);
        let _ = compatCheckRst(stringify $rst);
        $($s)*
    };
    (always @ ( posedge $clk: ident or negedge $rst: ident ) begin $( $s: VExpr )* end) => {
        let _ = compatCheckClk(stringify $clk);
        let _ = compatCheckRst(stringify $rst);
        $($s)*
    };
    (always @ ( posedge $clk: ident ) begin $( $s: VExpr )* end) => {
        let _ = compatCheckClk(stringify $clk);
        $($s)*
    };

    // ---- always @(*) / @* begin ... end (combinational) ----
    // combBegin/combEnd mark the context: a reg assigned here is driven
    // combinationally (pickAssign in hdl-core + HDV002 lint).
    (always @ ( * ) begin $( $s: VExpr )* end) => {
        let _ = combBegin();
        $($s)*
        let _ = combEnd();
    };
    (always @ * begin $( $s: VExpr )* end) => {
        let _ = combBegin();
        $($s)*
        let _ = combEnd();
    };

    // ---- if / else (begin-forms before single-statement forms; the else
    //      branch is a VExpr fragment so `else if` chains recurse) ----
    (if ( $c: raw ) begin $( $t: VExpr )* end else begin $( $e: VExpr )* end) => {
        let _ = whenBegin(($c).expr);
        $({$t})*
        let _ = whenOtherwiseBegin(unit);
        $({$e})*
        let _ = whenEnd(unit);
    };
    (if ( $c: raw ) begin $( $t: VExpr )* end else $f: VExpr) => {
        let _ = whenBegin(($c).expr);
        $({$t})*
        let _ = whenOtherwiseBegin(unit);
        $f
        let _ = whenEnd(unit);
    };
    (if ( $c: raw ) begin $( $t: VExpr )* end) => {
        let _ = whenBegin(($c).expr);
        $({$t})*
        let _ = whenEnd(unit);
    };
    (if ( $c: raw ) $t: VExpr else begin $( $e: VExpr )* end) => {
        let _ = whenBegin(($c).expr);
        $t
        let _ = whenOtherwiseBegin(unit);
        $({$e})*
        let _ = whenEnd(unit);
    };
    (if ( $c: raw ) $t: VExpr else $f: VExpr) => {
        let _ = whenBegin(($c).expr);
        $t
        let _ = whenOtherwiseBegin(unit);
        $f
        let _ = whenEnd(unit);
    };
    (if ( $c: raw ) $t: VExpr) => {
        let _ = whenBegin(($c).expr);
        $t
        let _ = whenEnd(unit);
    };

    // ---- bare begin/end block (pure grouping, spliced flat) ----
    (begin $( $s: VExpr )* end) => {
        $($s)*
    };

    // ---- sub-module instantiation with named ports ----
    // The child's OWN `.tree` carries its port directions (fresh values, no
    // laziness) — the design-wide ModuleRegistry is built through
    // registerModuleTree's change_mutable lambda and can hold stuck Match
    // values there, so it is deliberately NOT consulted here.
    ( $m: ident $u: ident ( $( . $p: ident ( $x: raw ) $(,)? )* ) ;) => {
        let $u = $m.create;
        let __vct = $u.tree;
        $( let _ = vconnT(__vct, $u . $p . zz_expr, ($x) . zz_expr); )*
    };

    // ---- procedural nonblocking/blocking assignment (LHS variants) ----
    ( $l: ident [ $i: raw ] <= $r: raw ;) => {
        let _ = ($l[$i] := ($r));
    };
    ( $l: ident [ $hi: raw : $lo: raw ] <= $r: raw ;) => {
        let _ = ($l.slice[$hi, $lo] := ($r));
    };
    ( $l: ident <= $r: raw ;) => {
        let _ = ($l := ($r));
    };
    ( $l: ident [ $i: raw ] = $r: raw ;) => {
        let _ = ($l[$i] := ($r));
    };
    ( $l: ident [ $hi: raw : $lo: raw ] = $r: raw ;) => {
        let _ = ($l.slice[$hi, $lo] := ($r));
    };
    ( $l: ident = $r: raw ;) => {
        let _ = ($l := ($r));
    };

    // ---- case (x) L: stmt ... default: stmt endcase ----
    // Flat when/elsewhen chain: whenBegin for the first label, whenElseBegin
    // for the rest (it replaces the stack top and accumulates `!prev`, giving
    // the exclusive-branch conditions). Labels compare through CaseEq, so
    // `default` (a marker value) is just another label and may appear last.
    // Placed before the `$x: raw ;` catch-all: a case statement has no
    // trailing `;`, so only this arm can match it.
    (case ( $e: raw ) $v1: raw : $s1: VExpr $( $v: raw : $s: VExpr )* endcase) => {
        let _ = whenBegin((($e).caseEq($v1)).expr);
        $s1
        $( let _ = whenElseBegin((($e).caseEq($v)).expr); $s )*
        let _ = whenEnd(unit);
    };

    // ---- expression statement (requires `;` so end/endmodule survive) ----
    ( $x: raw ;) => {
        let _ = ($x);
    };
}
