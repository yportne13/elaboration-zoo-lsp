//! HDL surface-syntax macros: `module` (typort + Verilog-compat arms),
//! `when` (expression form), `Expr` (statement DSL table), `blackbox`, plus
//! the simulation-assertion and blackbox-parameter helper defs those macros
//! call.  This file is the last HDL file before hdl-verilog-compat /
//! hdl-verilog, so everything here may reference any earlier HDL name.
// ============================================================
// HDL Macros: Expr (ergonomic hardware DSL), when, and module
// ============================================================

// ---------- assert 工厂（SpinalHDL 风格仿真断言，docs/hdl-blackbox-sim-design.md §3） ----------
// 普通 typort def（非宏臂）：裸调用经 Expr 宏的 raw 直通臂即可工作。实现走
// createSignalExpr 默认臂 → 当前 when 语境自动折叠（`when c { assert(a, "m") }`
// 落树为 when(完整使能条件, assertExpr(...), None)，与 assign 同机制）。
// 设计文档建议放 hdl-signals 工厂族旁；本批 hdl-signals 所有权受限，故落在
// hdl-macros（加载序 hdl-types 之后，Bool 可见；hdl-verilog 更晚，不受影响）。
/// Emit a simulation assertion with an explicit severity.  Records one
/// `assertExpr(cond, msg, sev)` statement; inside a `when` context it folds
/// into that when's full enable condition exactly like an assignment.
/// Verilog: a `// synthesis translate_off` / `always @(posedge <clk>)` block
/// holding `if (!(cond)) $display("TYPORT_ASSERT_<SEV> %0t %m: <msg>", $time);`
/// (`AssertFatal` additionally appends `$finish;`).
def assertSev(cond: Bool, msg: String, sev: AssertSeverity): Unit =
    let dummy = createSignalExpr("", assertExpr(cond.expr, msg, sev));
    unit

// 默认严重级 ERROR（与 SpinalHDL 的偏差：不用 FAILURE/$finish 默认——
// 标记行 + 继续跑让宿主一次仿真收集全部违规，见设计文档 §8）。
/// Emit an ERROR-severity simulation assertion (`assertSev` with
/// `AssertError`).  Deviation from SpinalHDL: the default is not
/// FAILURE/`$finish`, so one simulation run collects every violation.
def assert(cond: Bool, msg: String): Unit = assertSev(cond, msg, AssertError)

/// Emit a FATAL-severity simulation assertion (`assertSev` with
/// `AssertFatal`).  Tagged `ERROR` in the marker line and followed by
/// `$finish;`, so the sim host reads "model closed stdout" as the fatal signal.
def assertFatal(cond: Bool, msg: String): Unit = assertSev(cond, msg, AssertFatal)

/// Emit an INFO-severity simulation assertion (`assertSev` with `AssertInfo`).
def assertInfo(cond: Bool, msg: String): Unit = assertSev(cond, msg, AssertInfo)

/// Emit a WARNING-severity simulation assertion (`assertSev` with
/// `AssertWarning`).
def assertWarning(cond: Bool, msg: String): Unit = assertSev(cond, msg, AssertWarning)

// 额外时钟域变体：产码进 cd 自己的 translate_off 断言块，clk 端口经
// collectClockCds 合并收集器进端口表。
/// Emit a simulation assertion clocked by the explicit domain `cd` instead of
/// the module's default clock domain.  Records `assertExprCd`; `cd`'s clock
/// (and its reset, when that domain has init regs) reach the port table via
/// `collectClockCds` / `extraCdPortsVL`.
def assertSevCd(cond: Bool, msg: String, sev: AssertSeverity, cd: ClockDomain): Unit =
    let dummy = createSignalExpr("", assertExprCd(cond.expr, msg, sev, cd));
    unit

/// Emit an ERROR-severity assertion clocked by `cd` (`assertSevCd` with
/// `AssertError`).
def assertCd(cond: Bool, msg: String, cd: ClockDomain): Unit = assertSevCd(cond, msg, AssertError, cd)


// ---------- BlackBox 宏（docs/hdl-blackbox-sim-design.md §4，P2） ----------
// 语法（端口分组 = module 宏的连续 run 机制；分组间不允许空行/交错）：
//   blackbox SyncRam[depth: Nat, w: Nat]
//       generic WIDTH = w
//       input  clk  = Bool
//       input  addr = UInt[log2Up depth]
//       output dout = UInt[w]
//   {
//   }
// 展开镜像 module 宏 plain 臂的声明链骨架（同一端口工厂 createPortExpr /
// createBoolPortExpr、同一 ModuleTree push/restore 三明治、同一
// ModuleRegistry 登记、同一 checkModuleTree 自检、同一 bn/subSignal 层次
// 句柄与 def tree 形态），差异仅两处：
//   1. 黑盒无体——体区必须是空 `{}`（宏字面匹配，非 Expr 表），黑盒 def 的
//      exprs 只有端口声明；
//   2. 黑盒专属副作用：
//      a. prologue create_global("BlackBoxCtx", ...) 每次求值从空开始
//         （WhenStack/HdlLoopIdx 的 per-create 重置纪律——类体在检查期会被
//         求值多次）；`generic K = v` 逐条 bbGenericAddNat（v 为 elaboration
//         期 Nat 表达式；String 泛型 v1 不经宏暴露，bbGenericAddStr 供 def
//         直调）；
//      b. checkModuleTree 之前 blackboxCtxTake() 读走并清空，bbRegisterLast
//         注册进 "BlackBoxRegistry"（设计记录用；该注册表查询在类体检查求值
//         上下文不可归约，故 hdl-check 的门控**不读它**——改用同一枚 SELF 标记
//         上的纯谓词 chkBbDefIsBlackBox(md.expr)，见 hdl-check.typort 与设计
//         文档 §4.5-4）；
//      c. 两枚**参数标记**（纯发射通道）：createSignalExpr 追加
//         bbMarkerExpr(isInst=false, <stub 头参数串>)——SELF 标记进黑盒
//         自身 def；bbMarkerExpr(isInst=true, <实例参数串>)——INSTANCE 标记
//         在 restore 之后、mkInstanceIfParent 之前追加进父级 def（prepend 序
//         使父级 exprs 里它紧跟 instance 节点）。hdl-verilog 的发射链**零全局
//         读**（实测任何可达全局 op 的 def 被 generic 上下文调用即触发 lvl2ix
//         drain panic，docs/l13-typeclass-instance-nat-param-bug.md），参数串
//         在 create 期（参数 ground）渲染为纯字符串，发射端按变体字面拾取。
//         专用变体（R2 评审 P1 修复，2026-09-27）：旧载体
//         assertExpr(literal(zero|succ(zero)), <参数串>, AssertError) 与用户
//         常量 Bool 断言逐字节同构（assert(false.into, msg) ≡ SELF 标记 →
//         普通模块被误判黑盒、体被 stub 替换；assert(true.into, "sanity") ≡
//         INSTANCE 标记 → 实例名被 msg 污染、断言本体被吞），bbMarkerExpr
//         终结混叠；hdl-check 侧同步补零读零驱动臂。
// 注册语义偏差（相对设计 §4.3 bbRegister 的 first-wins）：**last-wins**。
// 类体在两阶段检查期被求值 ~3 次、create 再 replay 一次，检查期求值时类
// 参数是 neutral——first-wins 会定格检查轮的 neutral 值；last-wins 让最后
// 一次求值（= create，参数 ground）覆盖。同一黑盒多种参数化的 create 碰撞
// 仍取最后一次（已知限制，setDefinitionName 列 P3）。
// 泛型值 v1 仅支持 Nat（宏无法按类型分派 raw 值——宏系统无 literal 片段）。
// 端口分组：generic 连续 run → Bool 端口连续 run → 类型化端口连续 run →
// 再一段 Bool 端口连续 run（覆盖 Bool-先/类型-先两种顺序；typed-Bool-typed
// 交错不支持，与 module 宏"连续 run"约束同类）。`output reg` 端口与显式
// 时钟域参数不支持（设计 §4.3：黑盒 cd 恒 defaultClockDomain、不合成
// clk/reset）。
/// Remove the first registry entry named `name` (recursively keeps the rest).
/// Helper for `bbRegisterLast`'s last-wins upsert.
def bbDropEntryHelp(es: List[BlackBoxEntry], name: String): List[BlackBoxEntry] = match es {
    case lnil => lnil
    case lcons(e, t) => match str_eq(e.name, name) {
        case true => bbDropEntryHelp(t, name)
        case false => lcons (e) (bbDropEntryHelp(t, name))
    }
}

// 地面化种子（lvl2ix 纪律）：全局 seed 里的多态 lnil 会在类体求值上下文
// （含类参 rigid）中使后续 List match 停滞——先用带类型注记的 let 解出
// 具体元素类型，再构造，全局里永远只存 ground 值。
/// Empty `BlackBoxCtx` seed.  The typed `let` is deliberate: a polymorphic
/// `lnil` stored in a global stalls later `List` matches under class-body
/// evaluation (lvl2ix discipline), so globals only ever hold ground values.
def bbCtxFresh: BlackBoxCtx =
    let empty: List[BbGeneric] = lnil;
    BlackBoxCtx.mk(empty)

/// Empty `BlackBoxRegistry` seed (typed `lnil`, same ground-value rule as
/// `bbCtxFresh`).
def bbRegistryFresh: BlackBoxRegistry =
    let empty: List[BlackBoxEntry] = lnil;
    BlackBoxRegistry.mk(empty)

// last-wins 注册（见上）：同名项先摘除再前插，检查轮被 create 轮覆盖。
// 仅在 blackbox 宏展开体内（用户文件上下文）调用——prelude 加载期不会执行。
/// Register a blackbox as `name -> info`, LAST-WINS: the existing same-named
/// entry is dropped first, then the new one is prepended.  The class body is
/// evaluated several times before `create` runs with ground params, so
/// last-wins lets the ground `create` round overwrite the neutral check
/// rounds.  Only called from the `blackbox` macro expansion (never at prelude
/// load).
def bbRegisterLast(name: String, info: BlackBoxInfo): Unit =
    let _ = change_mutable_default("BlackBoxRegistry", x => x, bbRegistryFresh);
    let _ = change_mutable("BlackBoxRegistry", x => BlackBoxRegistry.mk(lcons (BlackBoxEntry.mk(name, info)) (bbDropEntryHelp(x.entries, name))));
    unit

// 读走并清空：清空时写入 ground 种子（不用 hdl-core 的 blackboxCtxTake——
// 其清空分支写入多态 lnil，同样会毒化 drain）。
/// Read and clear the `BlackBoxCtx` generic list collected by the `blackbox`
/// macro prologue, leaving the ground seed `bbCtxFresh` behind (hdl-core's
/// `blackboxCtxTake` writes a polymorphic `lnil` instead, which poisons the
/// end-of-run drain).
def bbCtxTakeGround: List[BbGeneric] =
    let gens = (get_global("BlackBoxCtx")).gens;
    let _ = create_global("BlackBoxCtx", bbCtxFresh);
    gens

// 参数串渲染（create 期、参数 ground 时调用；从 hdl-verilog 移来——发射链
// 零全局读纪律下，渲染必须在 create 期完成，hdl-verilog 只做字面拾取）。
/// Render one generic value as a Verilog decimal/string literal (`Nat` via
/// `nat_to_dec`, `String` verbatim).  Runs at CREATE time where the params are
/// ground; the emission chain in hdl-verilog only picks the finished string up.
def bbGenValStr(v: BbGenVal): String = match v {
    case bbGenNat(n) => nat_to_dec(n)
    case bbGenStr(s) => s
}

// stub 头参数串："parameter WIDTH = 8, parameter DEPTH = 64"。
/// Verilog parameter declaration list for a blackbox stub header, e.g.
/// `parameter WIDTH = 8, parameter DEPTH = 64` ("" when there are no
/// generics).  Carried on the SELF `bbMarkerExpr` and emitted by
/// `blackboxDefVL` as `module Name #(<this>) (...)`.
def bbParamsDeclStr(gs: List[BbGeneric]): String = match list_reverse(gs) {
    case lnil => ""
    case lcons(g, lnil) => "parameter " + g.key + " = " + bbGenValStr(g.val)
    case lcons(g, tail) => "parameter " + g.key + " = " + bbGenValStr(g.val) + ", " + bbParamsDeclStr(tail)
}

// 实例参数项：".WIDTH(8), .DEPTH(64)"。
/// Named instance-parameter item list, e.g. `.WIDTH(8), .DEPTH(64)`
/// (interior of `bbInstParamsStr`).
def bbInstItemsStr(gs: List[BbGeneric]): String = match list_reverse(gs) {
    case lnil => ""
    case lcons(g, lnil) => "." + g.key + "(" + bbGenValStr(g.val) + ")"
    case lcons(g, tail) => "." + g.key + "(" + bbGenValStr(g.val) + "), " + bbInstItemsStr(tail)
}

// 实例参数串：" #(.WIDTH(8), .DEPTH(64))"；无泛型黑盒为 ""。
/// Verilog instance-parameter suffix, e.g. ` #(.WIDTH(8), .DEPTH(64))`; ""
/// for a generic-less blackbox.  Carried on the INSTANCE `bbMarkerExpr` so
/// `collectInstHelp` emits `Name #(.K(v), ...) inst (...)`.
def bbInstParamsStr(gs: List[BbGeneric]): String = match gs {
    case lnil => ""
    case _ => " #(" + bbInstItemsStr(gs) + ")"
}

// 黑盒声明宏：展开为与 module 宏同构的 class 声明链（骨架照抄 plain 臂）。
// 每个脚手架绑定都是 `let _ = ...`（class 体里折叠进同一个 `_` 字段）；
// 端口先以 Some(name) 句柄声明，restore 后以 subSignal 句柄覆盖，父级
// `u.port := sig` 层次连接免费复用。
/// Declare a blackbox: `blackbox Name[args] generic K = v <ports> {}`.
/// Expands to a `class Name ... impl Module` mirroring the plain `module` arm
/// (same port factories, same ModuleTree push/restore sandwich, same
/// ModuleRegistry registration, same `checkModuleTreeAll` self-check, same
/// subSignal handles).  Two differences: (1) the body must be the empty `{}`
/// — a blackbox carries only port declarations; (2) the blackbox side effects:
/// a fresh `BlackBoxCtx` per evaluation, `generic K = v` appended via
/// `bbGenericAddNat`, `bbCtxTakeGround` + `bbRegisterLast` registration, and
/// two `bbMarkerExpr` parameter-string channels — SELF (`isInst=false`, stub
/// header params, stays in the blackbox def) and INSTANCE (`isInst=true`,
/// ` #(...)` suffix, appended to the parent right before `mkInstanceIfParent`
/// so it follows the instance node in walk order).  Generated Verilog:
/// `ifndef TYPORT_BB_<Name>` / `module <Name> #(parameter K = v, ...) (ports);`
/// / `endmodule` / `endif`, or `Name #(.K(v), ...) inst (...)` at each use
/// site.  Limits: generics are Nat-only (no literal fragment), `output reg`
/// ports and explicit clock domains are unsupported (always
/// `defaultClockDomain`, no synthesized clk/reset).
#[macro_export]
macro_rules blackbox {
    ($name: ident $( $args: params )* $( generic $gk: ident = $gv: raw )* $( $db: ident $pb: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db2: ident $pb2: ident = Bool )* {}) => {
        class $name $({$args})* impl Module {
            let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil))
            let _ = create_global("WhenStack", whenStackEmpty)
            // for 循环索引栈每次运行从空开始（早停的检查期 eval 会留下未弹出的帧）
            let _ = create_global("HdlLoopIdx", hdlLoopIdxEmpty)
            // BlackBoxCtx 每次求值从空开始：generic 语句逐条落入，随后一次性读走
            let _ = create_global("BlackBoxCtx", bbCtxFresh)
            let _prev: ModuleTree = get_global("ModuleTree")
            let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, defaultClockDomain, 0, nil) :: nil))
            $( let _ = bbGenericAddNat(stringify $gk, $gv); )*
            $( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db)); )*
            $( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, $w)); )*
            $( let $pb2: Bool = Bool.mk(Some(stringify $pb2), createBoolPortExpr(stringify $db2)); )*
            // 登记（设计记录；检查侧门控见 hdl-check 的纯标记谓词）+
            // 自身 stub 参数标记（hdl-verilog 纯发射读）
            let __bbgens: List[BbGeneric] = bbCtxTakeGround
            let _ = bbRegisterLast(stringify $name, BlackBoxInfo.mk(__bbgens))
            // SELF 标记（isInst=false）：stub 头参数串，留在黑盒 def 自身
            let _ = createSignalExpr("", bbMarkerExpr(false, bbParamsDeclStr(__bbgens)))
            let _res: ModuleTree = checkModuleTreeAll(get_global("ModuleTree"))
            let _ = create_global("ModuleTree", _prev)
            // 实例参数标记（isInst=true）：必须先于 mkInstanceIfParent 追加——
            // exprs 为 prepend 序（后写在前），这样父级 exprs 走序里 marker 紧跟
            // 其 instance 节点，collectInstHelp 原地拾取。顶层 create 无父级，
            // 标记落空树无害。
            let _ = createSignalExpr("", bbMarkerExpr(true, bbInstParamsStr(__bbgens)))
            let _ = mkInstanceIfParent(bn.name, stringify $name)
            $( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
            $( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
            $( let $pb2: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb2)); )*
            // tree reads the create-time `_res` field (same as the module macro).
            def tree: ModuleTree = this._res
        }
    };
}

// Standalone when macro: expands at raw-expression positions where the first
// token is a macro name (p_raw dispatch) — unbraced def bodies
// (`def f(): Unit = when ...`), plain match case arms
// (`case p => when ...`), etc. Module/when/switch/for bodies dispatch their
// statements through the `Expr` macro's own when arms instead (statement
// position, `;`-terminated); this standalone form must be a COMPLETE
// expression, so every arm ends with a `unit` value tail after the final `;`.
// NOTE: 与下方 `Expr` macro 内的 when 臂逻辑重复、独立维护，
//       修改任一处必须同步另一处（same when-begin/else-begin/end 序列，
//       区别仅在于末尾：此处 `; unit`（表达式），彼处 `;`（语句））。
// NOTE: 所有脚手架绑定都用 `let _ = ...` 丢弃：在 module 宏展开的 class
//       体里每个 let 都是 struct 字段（用户语义：class body 的每个 let
//       都是字段，无特例），丢弃名让它们折叠进同一个 `_` 字段（last-wins），
//       而不是成为 w_push/w_pop 之类的额外成员。
/// Standalone `when` expression:
/// `when c { ... } elsewhen c2 { ... } otherwise { ... }`.
/// Expands to ONE shared WhenStack level — `whenBegin(cond)`, the body, one
/// `whenElseBegin(cond2)` per `elsewhen`, `whenOtherwiseBegin(unit)` for
/// `otherwise`, then a single `whenEnd(unit)` — with a `unit` tail so the form
/// is a complete expression.  Each assignment is recorded as an independent
/// `when(cond, assign, None)` node carrying its FULL accumulated enable
/// condition, so the generator emits independent ifs (no else-if chain
/// reconstruction).  Used at raw-expression positions (unbraced `def` bodies,
/// plain match arms); statement positions in module/when/switch/for bodies
/// dispatch through the `Expr` macro's own when arms instead.  The two tables
/// are duplicated and independently maintained — change both together.
#[macro_export]
macro_rules when {
    // when + elsewhen* + otherwise
    // NOTE: the whole chain shares ONE WhenStack level — no whenEnd between
    // branches — so whenElseBegin / whenOtherwiseBegin can accumulate the
    // negation of earlier branches into each assignment's enable condition
    // (see hdl-core.typort WhenStack). whenEnd pops the level once, after
    // the last branch. The module records each assignment as an independent
    // when(cond, assign, None) node with its FULL condition; the generator
    // emits independent ifs (no else-if chain reconstruction).
    ($cond:raw {$( $body: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})* otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$body})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
        unit
    };
    // when + otherwise (no elsewhen)
    ($cond:raw {$( $body: Expr )*} otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$body})*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
        unit
    };
    // when without otherwise (optional elsewhen)
    ($cond:raw {$( $body: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})*) => {
        let _ = whenBegin(($cond).expr);
        $({$body})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenEnd(unit);
        unit
    };
}

// The Expr macro provides convenient syntax for hardware expressions.
// Its rules are dispatched from every statement-block context via the
// `$x: Expr` named fragment: module bodies, when/elsewhen/otherwise/switch/
// for bodies, braced def bodies (def f(): T = { ... }) and braced match
// case arms (case p => { ... }) — plus p_expr_block_stmt (the shared
// statement-block parser). A leading `{` never reaches p_raw, so a block
// body and a plain expression body never overlap.
// Usage:
//   let mySignal = UInt[8]           -- creates a UInt[8] named "mySignal"
//   input myInput = UInt[4]          -- creates an input UInt[4] named "myInput"
//   output myOutput = Bits[16]       -- creates an output Bits[16] named "myOutput"
//   when condition {                  -- conditional assignment block
//     a := b
//   } otherwise {
//     a := c
//   }
//   switch x {                        -- switch statement
//     is value1 { ... }
//     is value2 { ... }
//     default { ... }
//   }

/// The statement-level hardware DSL table.  Dispatched from every statement
/// block through the `$x: Expr` named fragment: module bodies,
/// when/elsewhen/otherwise/switch/for bodies, braced `def` bodies and braced
/// match arms.  Signal arms transcribe `let x = UInt[8]` / `input x = ...` /
/// `output reg x = ...` into ANNOTATED `let`s bound to the matching `new*`
/// factory (`newUInt` / `newUIntInput` / `newUIntReg` /
/// `newUIntOutRegInitNat` / ...), the binder name reaching the factory through
/// the implicit `BindingName`; the annotation pins a concrete type up front so
/// a field whose type depends on a class Nat parameter leaves no unsolved meta.
/// `reg x = T[w] init v` -> the `*RegInitNat` factory; `output reg` ports stay
/// `reg` in Verilog.  Control-flow arms expand `when` / `switch` into one
/// shared WhenStack level (`whenBegin` / `whenElseBegin` /
/// `whenOtherwiseBegin` / `whenEnd`; a `switch` becomes a plain when chain and
/// runs NO HDL040 exhaustiveness check) and `for i in a until b { ... }` into
/// `rangeFor(a until b, i => ...)`.  `let x = expr` becomes `nameWire(expr)`
/// (named wire for arithmetic results, plain alias otherwise); `let _ = e`
/// passes through unchanged.  The trailing `$x: raw` arm is a raw passthrough.
#[macro_export]
macro_rules Expr {
    // ---- signal declarations ----
    // new* factories take an implicit BindingName filled with the let
    // binder's name, so `input myInput = UInt[4]` still names the port
    // "myInput" (bn == stringify $x).
    // NOTE: every signal arm emits an ANNOTATED let. In a module macro body
    // the statements become class fields (user semantics: every class-body
    // let is a struct field), and an unannotated field whose type depends on
    // the class's Nat params (e.g. `let x = Bits[left + right]`) leaves an
    // unsolved meta ("can't unify for unsolved meta", see
    // docs/module-redesign-analysis.md §2.1); the explicit annotation gives
    // the field a concrete type up front. The factory return types match the
    // annotations exactly (Bits[w]/UInt[w]/SInt[w]/Bool).
    (input $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsInput($width);};
    (output $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsOutput($width);};
    (inout $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsInOut($width);};
    (let $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBits($width);};

    (input $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntInput($width);};
    (output $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntOutput($width);};
    (inout $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntInOut($width);};
    (let $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUInt($width);};

    (input $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntInput($width);};
    (output $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntOutput($width);};
    (inout $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntInOut($width);};
    (let $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSInt($width);};

    (input $x:ident = Bool) => {let $x: Bool = newBoolInput;};
    (output $x:ident = Bool) => {let $x: Bool = newBoolOutput;};
    (inout $x:ident = Bool) => {let $x: Bool = newBoolInOut;};
    (let $x:ident = Bool) => {let $x: Bool = newBool;};

    // ---- `Boolean` port spelling: HDV004 diagnostic + hard failure (X1) ----
    // `boolean` is the DEFINING type name of `Bool` (src/prelude/core/bool.typort
    // is `enum Boolean { false, true }`), but every port arm above matches the
    // literal token `Bool`.  Writing `input sel = Boolean` therefore used to fall
    // through to the raw-passthrough arm at the bottom of this table, which
    // expanded it to the illegal `let _ = input sel = Boolean`; the resulting
    // parse error failed the WHOLE `module` macro expansion, so the user only saw
    // `expected def, found identifier` at the `module` line (round-1 X1).
    //
    // These arms are deliberately NARROW: they specialize on the literal token
    // `Boolean` only.  A generic `= $ty:ident` arm was prototyped and REJECTED
    // (round-2): macro arms are chosen per WHOLE invocation, so once any port in
    // the list fails the `= Bool` group, a generic repetition captures EVERY
    // scalar port — including legitimate `x = Bool` ones — and would warn about
    // types that are perfectly valid.  `MyTypo` therefore keeps its original loud
    // failure (`expected def, found identifier` + `name not in scope: <module>`)
    // and stays undiagnosed (recorded as a next-round item).
    //
    // They create NO port and always fail hard (the sentinel name below makes the
    // class body fail), so the module can never silently elaborate as a Bool port.
    // The HDV004 issue is reported INLINE with literal arguments on purpose:
    //   * a helper `def` wrapping this call is executed by the prelude-load
    //     DECLARATION CHECK, and with a constant module slot that pushed a line
    //     into the CACHED "CheckIssues" global, leaking a warning into every
    //     run_with_prelude output and reddening whole test families;
    //   * `report_check_issue` reads LITERAL arguments only, so a def parameter
    //     would arrive empty;
    //   * an EMPTY string argument inside a transcriber breaks the expansion
    //     (`expected \`}\`, found \`let\``), so both slots are non-empty here.
    // The module slot carries `Boolean` and the signal slot the port name, which
    // is what lib.rs::check_issue_span resolves to the port declaration line.
    (input $x:ident = Boolean) => {
        let _ = report_check_issue("HDV004", "Boolean", stringify $x, "`Boolean` is `Bool`'s defining type name - write `Bool` for a scalar port; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };
    (output $x:ident = Boolean) => {
        let _ = report_check_issue("HDV004", "Boolean", stringify $x, "`Boolean` is `Bool`'s defining type name - write `Bool` for a scalar port; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };
    (inout $x:ident = Boolean) => {
        let _ = report_check_issue("HDV004", "Boolean", stringify $x, "`Boolean` is `Bool`'s defining type name - write `Bool` for a scalar port; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };

    // ---- any OTHER unsupported scalar port type: same treatment (J①) ----
    // Placed AFTER the `= Boolean` arms so the one spelling whose text deserves
    // the "defining type name" hint keeps its own wording; these catch every
    // other type token (a typo such as `= MyTypo`, an omitted width such as
    // `= UInt`, ...).
    //
    // SAFE HERE, UNLIKE THE MODULE MACRO (round-2 finding): the `Expr` table is
    // matched ONE STATEMENT AT A TIME — the `$x: Expr` fragment parses a single
    // port declaration — so a generic repetition captures only the offending
    // port.  The `module` macro matches a WHOLE invocation, so its scalar group
    // would capture every scalar port (including legitimate `= Bool` ones); that
    // is why the module macro keeps its narrow `= Boolean`-only fallback and the
    // mixed body-preceding port table stays undiagnosed (round 4 candidate).
    //
    // MEASURED (round-4 counter-example matrix): a single formB module with
    // `= Bool` / `= UInt[w]` / `= Bits[w]` / `= SInt[w]` + `= MyTypo` produces
    // EXACTLY ONE HDV004, naming `MyTypo` — the legal arms above win for their
    // own statements.
    // Neutral wording on purpose (it must not claim the user wrote `Boolean`);
    // the offending type token rides in the check issue's MODULE slot and the
    // port name in its SIGNAL slot (literal arguments only, and never an empty
    // string literal — see the RED LINE note above).
    (input $x:ident = $ty:ident) => {
        let _ = report_check_issue("HDV004", stringify $ty, stringify $x, "this port type is not accepted - a scalar port must be the literal `Bool`; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };
    (output $x:ident = $ty:ident) => {
        let _ = report_check_issue("HDV004", stringify $ty, stringify $x, "this port type is not accepted - a scalar port must be the literal `Bool`; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };
    (inout $x:ident = $ty:ident) => {
        let _ = report_check_issue("HDV004", stringify $ty, stringify $x, "this port type is not accepted - a scalar port must be the literal `Bool`; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };

    // ---- register declarations ----
    // `reg x = T[w] init v` — register with reset value (async reset, verilog init)
    (reg $x:ident = Bits[$width:raw] init $init:raw) => {let $x: Bits[$width] = newBitsRegInitNat($width, $init);};
    (reg $x:ident = UInt[$width:raw] init $init:raw) => {let $x: UInt[$width] = newUIntRegInitNat($width, $init);};
    (reg $x:ident = SInt[$width:raw] init $init:raw) => {let $x: SInt[$width] = newSIntRegInitNat($width, $init);};
    (reg $x:ident = Bool init $init:raw) => {let $x: Bool = newBoolRegInitNat($init);};

    (reg $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsReg($width);};
    (reg $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntReg($width);};
    (reg $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntReg($width);};
    (reg $x:ident = Bool) => {let $x: Bool = newBoolReg;};

    // ---- output reg port declarations ----
    // `output reg x = T[w]` — an output port forced to `output reg` in
    // Verilog (with optional `init v` async-reset value). `:=` on it drives
    // the register (clocked); isRegExpr treats the variant as a reg.
    (output reg $x:ident = Bits[$width:raw] init $init:raw) => {let $x: Bits[$width] = newBitsOutRegInitNat($width, $init);};
    (output reg $x:ident = UInt[$width:raw] init $init:raw) => {let $x: UInt[$width] = newUIntOutRegInitNat($width, $init);};
    (output reg $x:ident = SInt[$width:raw] init $init:raw) => {let $x: SInt[$width] = newSIntOutRegInitNat($width, $init);};
    (output reg $x:ident = Bool init $init:raw) => {let $x: Bool = newBoolOutRegInitNat($init);};

    (output reg $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsOutReg($width);};
    (output reg $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntOutReg($width);};
    (output reg $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntOutReg($width);};
    (output reg $x:ident = Bool) => {let $x: Bool = newBoolOutReg;};

    // ---- `output reg q = Boolean`: same narrow `Boolean` diagnostic (X1) ----
    // Placed AFTER every valid `output reg` arm so the sized/Bool forms still
    // take their own arms; same inline-literal / no-helper-def discipline (see
    // the note on the `input`/`output`/`inout` Boolean arms above).
    (output reg $x:ident = Boolean) => {
        let _ = report_check_issue("HDV004", "Boolean", stringify $x, "`Boolean` is `Bool`'s defining type name - write `Bool` for a scalar port; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };
    // Same generic treatment as the input/output/inout arms above (J①): place AFTER
    // the narrow `= Boolean` arm so that spelling keeps its specialized text.
    (output reg $x:ident = $ty:ident) => {
        let _ = report_check_issue("HDV004", stringify $ty, stringify $x, "this port type is not accepted - a scalar port must be the literal `Bool`; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form");
        let _ = __port_type_must_be_the_literal_Bool__;
    };

    // ---- sub-module instantiation ----
    // `let u = myAdder.create[8]` needs no special branch: the class
    // constructor's `create` records the instance itself (mkInstanceIfParent
    // at the end of the module class body), so a plain generic let suffices.

    // ---- generic let ----
    // `let u = myAdder.create[8]` needs no special branch: the class
    // constructor's `create` records the instance itself (mkInstanceIfParent
    // at the end of the module class body), so a plain generic let suffices.
    // Expression lets become named wires: `letNamed` (LetNamed instances in
    // hdl-types.typort, dispatched regNext-style) materializes
    // `wire x; assign x = <expr>;` for signal arithmetic results and passes
    // every other value (declared signals, bundles, sub-module instances,
    // plain locals) through unchanged. Its `bn: BindingName` implicit is
    // synthesized from the let binder's name.
    (let $x:ident = $y:raw) => {let $x = nameWire($y);};
    // ---- discard-named generic let: pass the binding through unchanged ----
    // `_` is a Hole token, not an ident, so without these arms a user
    // `let _ = <expr>` falls into the raw-passthrough catch-all below, which
    // wraps it as `let _ = (let _ = <expr>; ...)`: the captured let-expression
    // then chains through the wrapper's `;`, swallowing the sibling statements
    // and ending in a recovery Hole. The wrapper's own annotation meta (spine
    // includes bn inside a class body) has no solver left, and the class
    // create/tree checks fail with `find unsolved meta`
    // (docs/l13-constraint-meta-fix-plan.md). No nameWire either: a discarded
    // binding names no wire.
    (let _ = $y:raw) => {let _ = $y;};
    (let _ : $t:raw = $y:raw) => {let _ : $t = $y;};

    // ---- when/otherwise control flow ----
    // Pushes one WhenStack level per chain (see the standalone `when` macro's
    // note: no whenEnd between branches — negation accumulation needs the
    // level alive until after the last branch). All scaffolding bindings use
    // `let _ = ...` discards (they collapse into the module struct's single
    // `_` field instead of becoming named members).
    (when $cond:raw {$( $bodywhen: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})* otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$bodywhen})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
    };
    // when with otherwise (no elsewhen)
    (when $cond:raw {$( $bodywhen: Expr )*} otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$bodywhen})*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
    };
    // when without otherwise (optional elsewhen)
    (when $cond:raw {$( $bodywhen: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})*) => {
        let _ = whenBegin(($cond).expr);
        $({$bodywhen})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenEnd(unit);
    };

    // ---- switch — desugar to a when chain with one shared level ----
    // switch sel { is 0 { body } is 1 { body2 } default { body3 } }
    // The first is-case pushes the switch's level; subsequent is-cases use
    // whenElseBegin (replace + accumulate); default uses whenOtherwiseBegin.
    // Conditions: `sel==v1`, `sel==v2 && !(sel==v1)`, `!(sel==v1) && !(sel==v2)`.
    // Note: $val can be a Nat literal, an enum element (State.IDLE) or a
    // signal; uses === operator for comparison.
    //
    // EXHAUSTIVENESS (hdl-enum.typort HDL040, design doc §4.7): the arms
    // below generate a PLAIN when chain only — no case heads are recorded
    // and no check runs (a dotted is-value is captured by the raw matcher
    // fragment as an apply-block before a dedicated dotted arm could see
    // it, so per-case head recording is not wired). The no-default switch
    // is therefore legal but UNCHECKED; the HDL040 exhaustiveness WARNING
    // for EnumCraft selectors is available via the explicit one-line
    // `switchFinalEnum(sel, cases, false)` direct call — see
    // hdl-enum.typort for the form.
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} $( is $val2:raw {$( $body2: Expr )*})* default {$( $default_body: Expr )*} }) => {
        let _ = whenBegin(($sel === $val).expr);
        $({$body})*
        $( let _ = whenElseBegin(($sel === $val2).expr); $({$body2})* )*
        let _ = whenOtherwiseBegin(unit);
        $({$default_body})*
        let _ = whenEnd(unit);
    };
    // Single is + default (no elsewhen)
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} default {$( $default_body: Expr )*} }) => {
        let _ = whenBegin(($sel === $val).expr);
        $({$body})*
        let _ = whenOtherwiseBegin(unit);
        $({$default_body})*
        let _ = whenEnd(unit);
    };
    // Single is + no default: needs its own arm (same matcher-shape reason as
    // single-is + default). Plain when chain — the last branch's assignments
    // keep the level's negation semantics, so uncovered selector values keep
    // the previous value (SpinalHDL semantics). The arm body runs NO
    // exhaustiveness check; for an HDL040 WARNING on an EnumCraft selector,
    // call switchFinalEnum (hdl-enum) explicitly after the switch.
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} }) => {
        let _ = whenBegin(($sel === $val).expr);
        $({$body})*
        let _ = whenEnd(unit);
    };
    // No default with two or more generic is-values: previously a macro match
    // failure, now a plain when chain (behavior relaxation, design doc §4.7).
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} $( is $val2:raw {$( $body2: Expr )*})* }) => {
        let _ = whenBegin(($sel === $val).expr);
        $({$body})*
        $( let _ = whenElseBegin(($sel === $val2).expr); $({$body2})* )*
        let _ = whenEnd(unit);
    };
    // for i in 0 until 4 { ... }  →  let __hloop: Unit = rangeFor(0 until 4, i => ...)
    // 修复记录（2026-08-27）：输出必须带尾分号。module 宏把本臂的输出作为
    // class 体/`def tree` 体的 let 链片段转写；tree 侧是一条完整 let-expr 链，
    // 链接靠 `;` —— 缺分号时 __hloop 链接不到下一条模板 let，解析器给链尾补
    // recovery Hole，tree 检查即报 unsolved meta（typed ModuleTree）。
    // body 用裸 let 链（$($body)*，各 Expr 片段自带 `;` 结尾）——不能用
    // $({$body})*：花括号在 lambda 体内是裸块，尾值会污染 lambda 类型。
    (for $i:ident in $it:raw {$( $body: Expr )*}) => {
        let __hloop: Unit = rangeFor($it, $i => $($body)* unit);
    };

    // ---- raw expression passthrough ----
    ($x: raw) => {let _ = $x;}
}

// The module macro provides convenient module definition syntax.
// It expands to a `class` (scala-style) whose struct implements the `Module` trait:
//   struct $name { _, _prev, _res: ModuleTree-chain fields, a: UInt[8], ... }
//     — ports become fields; the side-effect chain bindings become fields too
//     (user semantics: every class-body `let` is a struct field, no special
//     cases — see the WHY note below). NO storage field.
//   def $name.create[args]: $name[args] = ...   — runs the side-effect chain eagerly
//   impl Module for $name { def tree = this._res }  — reads the create-time tree
// Usage:
//   module myAdder[w: Nat]
//       input a = UInt[w]
//       output sum = UInt[w + 1]
//       input en = Bool          — Bool ports mix freely with typed ports
//   {
//       sum := a +^ a
//   }
//   module foo[myClockDomain] ... { ... }   — explicit clock domain (optional)
//
// Ports must be declared BEFORE the body braces. Inside the braces,
// `input x = T[w]` / `output x = T[w]` / `let x = T[w]` declare MODULE-INTERNAL
// signals (no port handle), so a parent cannot connect to them via `u.x`.
//
// `output reg x = T[w]` (optional `init v`) declares a register output port:
// the Verilog port line is forced to `output reg` (no wire/reg inference),
// `:=` drives are clocked (regAssign), and `init v` emits an async-reset
// value. NOTE (matcher structure): `output reg` ports must be declared BEFORE
// any regular typed ports, and regular typed ports before Bool ports — the
// macro's port groups are matched as contiguous runs (same constraint as the
// existing typed-then-Bool grouping); `init` ports must sit on their own line
// (the init value is captured as a raw expression up to end-of-line).
//
// Each port is declared TWICE in the class body (both collapse into one struct
// field; the last wins): first as the module's own signal inside the flattened
// side-effect chain so the body can use `sum := a` with real signals, then
// after the chain as a subSignal handle so a parent can write `u.a := sig` —
// SpinalHDL-style hierarchical access, where the instance name comes from the
// implicit bn constructor parameter.
// NOTE: 依赖"同名字段后者覆盖前者"的编译器行为；若解析器对字段重名报错
//       或改变语义，此宏必须重写（不要再声明同名端口）。
//
// The resulting value `myAdder.create` is a new type implementing `Module`; the
// tree is accessed via the trait method, so `moduleTreeVL(myAdder.create.tree)`
// produces the Verilog.
//
// Sub-module instantiation needs no call-site special case: the constructor
// records `instance(bn.name, name)` itself via mkInstanceIfParent (dropped at
// top level, where no parent module exists).
//
// WHY the side-effect chain is FLATTENED into class-body fields (方案 C2;
// 前置分析见 docs/module-redesign-analysis.md §2/§8.3，摊平形态探针见
// class_tests.rs::class_module_shape_flattened_chain):
// user semantics: EVERY `let` in a class body is a struct field — no special
// cases, no create-locals. The module's side-effect chain is therefore
// transcribed as plain class-body fields in execution order; the create's let
// chain binds fields in declaration order, so FIELD ORDER == SIDE-EFFECT ORDER
// (reset → push → ports → body → pop → instance record). The chain is
// transcribed TWICE, byte-identical apart from the instance-recording line:
//   1. create side — the chain fields at the top of the class body. Each
//      binding is a struct field (no storage field): the repeated
//      `let _ = ...` bindings collapse last-wins into a single `_ : Unit`
//      field (the LAST `_` is mkInstanceIfParent's; the earlier ones still
//      run in the constructor via shadowing), `_prev`/`_res` are the
//      sandwich's ModuleTree values (exposed on the struct deliberately),
//      and the ports are the real signals (overwritten below by the handle
//      declarations). The constructor runs them EAGERLY — a nested
//      `let u = child.create` inside the body records its instance into the
//      parent's in-progress tree (the mkInstanceIfParent line runs after the
//      restore, against the parent frame), so the instance lands in the tree
//      exactly once per create run.
//   2. `def tree` side — reads the create-time tree straight off the
//      instance: `def tree: ModuleTree = this._res` (the def has a `this`
//      receiver — prepended by the inherent-impl method registration — and
//      `this._res` projects the struct field through the ordinary Obj
//      field-access path). The body does NOT replay the chain: replaying it
//      re-ran every signal factory / child create on EVERY `.tree` access
//      and again inside the Phase-B check of the method body (measured
//      ~34% of per-keystroke user time on examples/hdl; the create-time
//      `_res` was dead weight). Semantics: `_res` is captured at create
//      time, AFTER the full chain ran and checkModuleTree validated it but
//      BEFORE the module records itself into its parent (mkInstanceIfParent
//      targets the parent frame only, so the module's own tree never
//      contains the self-instance in either design); sub-module instances
//      ARE inside `_res` (recorded by the children's own creates during the
//      chain). The tree value is immutable, so returning the shared field
//      is idempotent — repeated accesses print the same Verilog. The old
//      replay only differed if ambient mutable state outside the tree
//      preamble's resets (e.g. a user mutable global read by the body)
//      changed between create and access — reading `_res` freezes the
//      create-time snapshot instead, which is the more deterministic of the
//      two. Note `def_needs_replay` no longer fires for `X.tree` (the body
//      has no global ops), so Tm::Decl references return the registered
//      closure instead of re-evaluating it.
// RED LINE (§8.3): the create side keeps the ModuleDef push in constant form
// `ModuleTree.mk(0 + 1, ... :: nil)` — deriving the head from the lambda
// parameter (`x.num + 1` / `:: x.data`) leaves stuck GADT indices that make
// every later tree access O(n²).

/// The module-definition macro; expands to a `class ... impl Module`.
/// Two shapes: (1) the Verilog-compat ANSI arm
/// `module m(input clk, input [hi:lo] a, output reg [hi:lo] q); <VExpr>... endmodule`,
/// tried FIRST because it requires a literal `(` right after the name — its
/// body statements dispatch through hdl-verilog-compat's `VExpr` table, leading
/// and trailing scalar inputs are folded into the clock domain by
/// `compatFoldPort` (clk / reset / rst_n) and also become real Bool ports, and
/// the port groups are matched as contiguous runs (scalar inputs, `[hi:lo]`
/// ports, `output reg [hi:lo]`, scalar `output reg`, remaining scalars);
/// (2) the typort arms `module m[cd]?[args] <ports> { <Expr>* }`, with
/// `output reg` / typed / Bool port groups likewise matched as contiguous runs.
/// The expansion is a class whose body holds the side-effect chain FLATTENED
/// into fields (every class-body `let` is a struct field, so the repeated
/// `let _ = ...` scaffolding collapses last-wins into one `_` field) and whose
/// constructor binds them in declaration order, so field order == side-effect
/// order (reset -> push -> ports -> body -> pop -> instance record).  Ports are
/// declared TWICE — once as the module's own signal, once as a subSignal handle
/// after the restore — so a parent can write `u.a := sig`; the module records
/// itself into its parent via `mkInstanceIfParent(bn.name, ...)` at the end of
/// the create chain.  `def tree: ModuleTree = this._res` returns the create-time
/// snapshot instead of replaying the chain, and the ModuleDef push keeps the
/// constant shape `ModuleTree.mk(0 + 1, ... :: nil)` (deriving the head from
/// the lambda parameter leaves stuck GADT indices and makes later tree access
/// O(n^2)).
#[macro_export]
macro_rules module {
	// ---- Verilog-compat arm (M1): ANSI header + endmodule -------------
	// `module top(input clk, input rst_n, input [7:0] a, output reg [7:0] q,
	//             output [7:0] s, input en); <Verilog statements> endmodule`
	// Tried FIRST: it requires a literal `(` right after the module name, so
	// typort-shaped modules (`[` / port keyword / `{` next) fail it in one
	// token comparison and fall through to the arms below, and vice versa.
	// Body statements dispatch through the VExpr table (hdl-verilog-compat).
	// Port grouping is positional (the transcriber cannot branch on an
	// optional marker, so differently-transcribed shapes are separate
	// contiguous runs): leading scalar `input NAME` ports first (clk / reset /
	// rst_n additionally folded into the ClockDomain at run time by
	// `compatFoldPort`, and every one of them — folded or not — becomes a real
	// Bool port), then plain `[w]` ports, then `output reg [w]`, then scalar
	// `output reg`, then remaining scalar ports. Width is msb-lsb+1.
	// NOTE: the transcriber repetition MUST reference a metavar — a `$( ... )*`
	// group with no metavariable expands ZERO times (macros.rs
	// MacroTranscriber::Group), which silently killed the M1 folded-clock
	// helpers. `$ik` (leading scalar inputs) exists partly for that reason.
	($name: ident ( $( input $ik: ident $(,)? )* $( $dir: ident [ $hi: raw : $lo: raw ] $p: ident $(,)? )* $( output reg [ $rhi: raw : $rlo: raw ] $rp: ident $(,)? )* $( output reg $rb: ident $(,)? )* $( $db: ident $pb: ident $(,)? )* ) ; $( $body: VExpr )* endmodule) => {
		class $name impl Module {
			let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil))
			let _ = create_global("WhenStack", whenStackEmpty)
			let _ = create_global("HdlLoopIdx", hdlLoopIdxEmpty)
			let _ = create_global("CombCtx", CombCtx.mk(zero))
			let _ = create_global("CompatCD", CompatCD.mk("", "", true))
			$( let _ = compatFoldPort(stringify $ik); )*
			$( let _ = compatFoldPort(stringify $pb); )*
			let __vcd: ClockDomain = compatCD(stringify $name)
			let _prev: ModuleTree = get_global("ModuleTree")
			let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, __vcd, 0, nil) :: nil))
			$( let $ik: Bool = Bool.mk(Some(stringify $ik), createBoolPortExpr("input")); )*
			$( let $p: UInt[1 + ($hi) - ($lo)] = UInt.mk(Some(stringify $p), createPortExpr(compatDir(stringify $dir), "UInt", 1 + ($hi) - ($lo))); )*
			$( let $rp: UInt[1 + ($rhi) - ($rlo)] = UInt.mk(Some(stringify $rp), createOutRegPortExpr("UInt", 1 + ($rhi) - ($rlo))); )*
			$( let $rb: Bool = Bool.mk(Some(stringify $rb), createOutRegBoolPortExpr); )*
			$( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(compatDir(stringify $db))); )*
			$($body)*
			let _res: ModuleTree = checkModuleTreeAll(get_global("ModuleTree"))
			let _ = create_global("ModuleTree", _prev)
			let _ = mkInstanceIfParent(bn.name, stringify $name)
			$( let $ik: Bool = Bool.mk(None, subSignal(bn.name, stringify $ik)); )*
			$( let $p: UInt[1 + ($hi) - ($lo)] = UInt.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $rp: UInt[1 + ($rhi) - ($rlo)] = UInt.mk(None, subSignal(bn.name, stringify $rp)); )*
			$( let $rb: Bool = Bool.mk(None, subSignal(bn.name, stringify $rb)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			// tree reads the create-time `_res` field (see the WHY note above).
			def tree: ModuleTree = this._res
		}
	};
	// With explicit clock domain: module foo[myCd] ... { ... }
	// The cd parameter is implicitly a ClockDomain; it is baked into the
	// ModuleDef at record time so the Verilog generator can emit the
	// configured clock/reset edges and names.
	// Usage: let t = foo.create[myClockDomain].tree
	($name: ident [$cd: ident] $( $args: params )* $( output reg $rp: ident = $rt: ident [$rw: raw] init $rv: raw )* $( output reg $rp2: ident = $rt2: ident [$rw2: raw] )* $( output reg $rb: ident = Bool init $rbv: raw )* $( output reg $rb2: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db: ident $pb: ident = Bool )* {$( $body: Expr )*}) => {
		class $name [$cd: ClockDomain] $({$args})* impl Module {
			// Create side (see the WHY note above): the side-effect chain
			// FLATTENED into class-body fields — every `let` is a struct
			// field (user semantics, no special cases). The constructor binds
			// them in declaration order, so field order == side-effect order;
			// the repeated `let _ = ...` bindings collapse last-wins into one
			// `_ : Unit` field (mkInstanceIfParent's return).
			let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil))
			let _ = create_global("WhenStack", whenStackEmpty)
			// for 循环索引栈每次运行从空开始（早停的检查期 eval 会留下未弹出的帧）
			let _ = create_global("HdlLoopIdx", hdlLoopIdxEmpty)
			let _ = fsmCtxModuleReset()
			let _prev: ModuleTree = get_global("ModuleTree")
			let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, $cd, 0, nil) :: nil))
			$( let $rp: $rt[$rw] = $rt.mk(Some(stringify $rp), createOutRegPortExprInit(stringify $rt, $rw, $rv)); )*
			$( let $rp2: $rt2[$rw2] = $rt2.mk(Some(stringify $rp2), createOutRegPortExpr(stringify $rt2, $rw2)); )*
			$( let $rb: Bool = Bool.mk(Some(stringify $rb), createOutRegBoolPortExprInit($rbv)); )*
			$( let $rb2: Bool = Bool.mk(Some(stringify $rb2), createOutRegBoolPortExpr); )*
			$( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, $w)); )*
			$( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db)); )*
			$($body)*
			let _res: ModuleTree = checkModuleTreeAll(get_global("ModuleTree"))
			let _ = create_global("ModuleTree", _prev)
			let _ = mkInstanceIfParent(bn.name, stringify $name)
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			// tree reads the create-time `_res` field (see the WHY note above).
			def tree: ModuleTree = this._res
		}
	};
	// Without clock domain: uses defaultClockDomain
	($name: ident $( $args: params )* $( output reg $rp: ident = $rt: ident [$rw: raw] init $rv: raw )* $( output reg $rp2: ident = $rt2: ident [$rw2: raw] )* $( output reg $rb: ident = Bool init $rbv: raw )* $( output reg $rb2: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db: ident $pb: ident = Bool )* {$( $body: Expr )*}) => {
		class $name $({$args})* impl Module {
			// Create side (see the WHY note above): the side-effect chain
			// FLATTENED into class-body fields — every `let` is a struct
			// field (user semantics, no special cases). The constructor binds
			// them in declaration order, so field order == side-effect order;
			// the repeated `let _ = ...` bindings collapse last-wins into one
			// `_ : Unit` field (mkInstanceIfParent's return).
			let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil))
			let _ = create_global("WhenStack", whenStackEmpty)
			// for 循环索引栈每次运行从空开始（早停的检查期 eval 会留下未弹出的帧）
			let _ = create_global("HdlLoopIdx", hdlLoopIdxEmpty)
			// FSM 转移记录（hdl-fsm HDL060-064）：每次 create 先排水上一轮已完成的
			// 记录再清空（对齐 WhenStack/HdlLoopIdx 的 per-module 重置纪律）
			let _ = fsmCtxModuleReset()
			let _prev: ModuleTree = get_global("ModuleTree")
			let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, defaultClockDomain, 0, nil) :: nil))
			$( let $rp: $rt[$rw] = $rt.mk(Some(stringify $rp), createOutRegPortExprInit(stringify $rt, $rw, $rv)); )*
			$( let $rp2: $rt2[$rw2] = $rt2.mk(Some(stringify $rp2), createOutRegPortExpr(stringify $rt2, $rw2)); )*
			$( let $rb: Bool = Bool.mk(Some(stringify $rb), createOutRegBoolPortExprInit($rbv)); )*
			$( let $rb2: Bool = Bool.mk(Some(stringify $rb2), createOutRegBoolPortExpr); )*
			$( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, $w)); )*
			$( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db)); )*
			$($body)*
			let _res: ModuleTree = checkModuleTreeAll(get_global("ModuleTree"))
			let _ = create_global("ModuleTree", _prev)
			let _ = mkInstanceIfParent(bn.name, stringify $name)
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			// tree reads the create-time `_res` field (see the WHY note above).
			def tree: ModuleTree = this._res
		}
	};
	// ---- `Boolean` port spelling with ports BEFORE the body brace (X1) ----
	// Appended LAST and narrow: the final group accepts the literal token
	// `Boolean` only, so it matches exactly those body-preceding port lists whose
	// scalar ports are ALL spelled `Boolean` (that is the only shape that used to
	// leave the macro with no arm at all and make the parser report
	// `expected def, found identifier` at the `module` line).
	//
	// KNOWN LIMITATION (recorded, accepted): a MIXED body-preceding list such as
	// `input sel = Boolean` + `output y = Bool` does NOT match this arm (the
	// `= Boolean` group stops before `y = Bool` and the strict arms already
	// failed), so it keeps the original undiagnosed error.  A generic
	// `= $bt:ident` arm was prototyped and REJECTED because its repetition
	// captures EVERY scalar port — including legitimate `x = Bool` ones — and
	// would warn about valid types.  See the Expr-macro note above.
	//
	// It creates NO port and always fails hard (sentinel below), so the module can
	// never silently elaborate; the HDV004 issue is inline with literal arguments
	// for the same reasons as the Expr arms.
	($name: ident $( $args: params )* $( output reg $rp: ident = $rt: ident [$rw: raw] init $rv: raw )* $( output reg $rp2: ident = $rt2: ident [$rw2: raw] )* $( output reg $rb: ident = Bool init $rbv: raw )* $( output reg $rb2: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db: ident $pb: ident = Boolean )* {$( $body: Expr )*}) => {
		class $name $({$args})* impl Module {
			$( let _ = report_check_issue("HDV004", "Boolean", stringify $pb, "`Boolean` is `Bool`'s defining type name - write `Bool` for a scalar port; sized ports use the NAME = UInt[w] / Bits[w] / SInt[w] form"); )*
			let _ = __port_type_must_be_the_literal_Bool__;
			def tree: ModuleTree = ModuleTree.mk(0, nil)
		}
	};
}
