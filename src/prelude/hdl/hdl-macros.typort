// ============================================================
// HDL Macros: Expr (ergonomic hardware DSL), when, and module
// ============================================================

// Standalone when macro for direct use outside Expr.
// Bodies use `Expr` fragment for consistency with Expr macro's when handlers.
// NOTE: 与下方 `Expr` macro 内的 when arm 逻辑重复、独立维护，
//       修改任一处必须同步另一处（same when-begin/else-begin/end 序列）。
#[macro_export]
macro_rules when {
    // when + elsewhen* + otherwise
    // Note: otherwise emitted FIRST (becomes default assign before when node)
    ($cond:raw {$( $body: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})* otherwise {$( $bodyother: Expr )*}) => {
        let w_opush = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let w_opop = whenEnd(unit);
        let w_push = whenBegin(($cond).expr);
        $({$body})*
        let w_pop = whenEnd(unit);
        $( let w_epush = whenElseBegin(($cond2).expr);
           $({$bodyelse})*
           let w_epop = whenEnd(unit); )*
    };
    // when + otherwise (no elsewhen)
    ($cond:raw {$( $body: Expr )*} otherwise {$( $bodyother: Expr )*}) => {
        let w_opush = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let w_opop = whenEnd(unit);
        let w_push = whenBegin(($cond).expr);
        $({$body})*
        let w_pop = whenEnd(unit);
    };
    // when without otherwise
    ($cond:raw {$( $body: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})*) => {
        let w_push = whenBegin(($cond).expr);
        $({$body})*
        let w_pop = whenEnd(unit);
        $( let w_epush = whenElseBegin(($cond2).expr);
           $({$bodyelse})*
           let w_epop = whenEnd(unit); )*
    };
}

// The Expr macro provides convenient syntax for hardware expressions
// Usage:
//   let mySignal = UInt[8]           -- creates a UInt[8] named "mySignal"
//   input myInput = UInt[4]          -- creates an input UInt[4] named "myInput"  
//   output myOutput = Bits[16]       -- creates an output Bits[16] named "myOutput"
//   when condition {                  -- conditional assignment block
//     a := b
//   } otherwise {
//     a := c
//   }
//   switch x {                        -- switch statement
//     is value1 { ... }
//     is value2 { ... }
//     default { ... }
//   }

#[macro_export]
macro_rules Expr {
    // ---- signal declarations ----
    (input $x:ident = Bits[$width:raw]) => {let $x = newBitsInput(stringify $x, $width);};
    (output $x:ident = Bits[$width:raw]) => {let $x = newBitsOutput(stringify $x, $width);};
    (let $x:ident = Bits[$width:raw]) => {let $x = newBits(stringify $x, $width);};

    (input $x:ident = UInt[$width:raw]) => {let $x = newUIntInput(stringify $x, $width);};
    (output $x:ident = UInt[$width:raw]) => {let $x = newUIntOutput(stringify $x, $width);};
    (let $x:ident = UInt[$width:raw]) => {let $x = newUInt(stringify $x, $width);};

    (input $x:ident = SInt[$width:raw]) => {let $x = newSIntInput(stringify $x, $width);};
    (output $x:ident = SInt[$width:raw]) => {let $x = newSIntOutput(stringify $x, $width);};
    (let $x:ident = SInt[$width:raw]) => {let $x = newSInt(stringify $x, $width);};

    (input $x:ident = Bool) => {let $x = newBoolInput(stringify $x);};
    (output $x:ident = Bool) => {let $x = newBoolOutput(stringify $x);};
    (let $x:ident = Bool) => {let $x = newBool(stringify $x);};

    // ---- register declarations ----
    // `reg x = T[w] init v` — register with reset value (async reset, verilog init)
    (reg $x:ident = Bits[$width:raw] init $init:raw) => {let $x = newBitsRegInitNat(stringify $x, $width, $init);};
    (reg $x:ident = UInt[$width:raw] init $init:raw) => {let $x = newUIntRegInitNat(stringify $x, $width, $init);};
    (reg $x:ident = SInt[$width:raw] init $init:raw) => {let $x = newSIntRegInitNat(stringify $x, $width, $init);};
    (reg $x:ident = Bool init $init:raw) => {let $x = newBoolRegInitNat(stringify $x, $init);};

    (reg $x:ident = Bits[$width:raw]) => {let $x = newBitsReg(stringify $x, $width);};
    (reg $x:ident = UInt[$width:raw]) => {let $x = newUIntReg(stringify $x, $width);};
    (reg $x:ident = SInt[$width:raw]) => {let $x = newSIntReg(stringify $x, $width);};
    (reg $x:ident = Bool) => {let $x = newBoolReg(stringify $x);};

    // ---- sub-module instantiation ----
    // `let u = myAdder.create[8]` also records the instance in the current
    // module (mkInstance), so the generator emits the instance line and the
    // `u.a := sig` port connections are aggregated into it.
    (let $x:ident = $m:ident . create $( [$w: raw] )* ) => {let $x = $m.create $({[$w]})*; let _zz_inst = mkInstance(stringify $x, stringify $m);};

    // ---- generic let ----
    (let $x:ident = $y:raw) => {let $x = $y;};

    // ---- when/otherwise control flow ----
    // Pushes condition scope, evaluates body, pops scope.
    // Note: otherwise body is emitted FIRST so it appears as the default assign
    // before the when node in the module (required for correct Verilog generation).
    (when $cond:raw {$( $bodywhen: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})* otherwise {$( $bodyother: Expr )*}) => {
        let w_opush = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let w_opop = whenEnd(unit);
        let w_push = whenBegin(($cond).expr);
        $({$bodywhen})*
        let w_pop = whenEnd(unit);
        $( let w_epush = whenElseBegin(($cond2).expr);
           $({$bodyelse})*
           let w_epop = whenEnd(unit); )*
    };
    // when with otherwise (no elsewhen)
    (when $cond:raw {$( $bodywhen: Expr )*} otherwise {$( $bodyother: Expr )*}) => {
        let w_opush = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let w_opop = whenEnd(unit);
        let w_push = whenBegin(($cond).expr);
        $({$bodywhen})*
        let w_pop = whenEnd(unit);
    };
    // when without otherwise
    (when $cond:raw {$( $bodywhen: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})*) => {
        let w_push = whenBegin(($cond).expr);
        $({$bodywhen})*
        let w_pop = whenEnd(unit);
        $( let w_epush = whenElseBegin(($cond2).expr);
           $({$bodyelse})*
           let w_epop = whenEnd(unit); )*
    };

    // ---- switch — desugar to when-based pattern matching ----
    // switch sel { is 0 { body } is 1 { body2 } default { body3 } }
    // default body emitted first (becomes the default assign before the when node)
    // Note: $val can be a Nat literal or a signal; uses === operator for comparison
    // Multiple is cases: first uses whenBegin, rest use whenElseBegin
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} $( is $val2:raw {$( $body2: Expr )*})* default {$( $default_body: Expr )*} }) => {
        let _wob = whenOtherwiseBegin(unit);
        $({$default_body})*
        let _we2 = whenEnd(unit);
        let _wb = whenBegin(($sel === $val).expr);
        $({$body})*
        let _we = whenEnd(unit);
        $( let _web = whenElseBegin(($sel === $val2).expr);
           $({$body2})*
           let _we3 = whenEnd(unit); )*
    };
    // Single is + default (no elsewhen)
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} default {$( $default_body: Expr )*} }) => {
        let _wob = whenOtherwiseBegin(unit);
        $({$default_body})*
        let _we2 = whenEnd(unit);
        let _wb = whenBegin(($sel === $val).expr);
        $({$body})*
        let _we = whenEnd(unit);
    };

    // ---- raw expression passthrough ----
    ($x: raw) => {let _ = $x;}
}

// The module macro provides convenient module definition syntax.
// It expands to a `class` (scala-style) whose struct implements the `Module` trait:
//   struct $name { a: UInt[8], ..., zz_tree: ModuleTree }  — ports become fields
//   def $name.create[args]: $name[args] = ...              — runs the body, captures the tree
//   impl Module for $name { def tree = this.zz_tree }
// Usage:
//   module myAdder[w: Nat]
//       input a = UInt[w]
//       output sum = UInt[w + 1]
//       input en = Bool          — Bool ports go after typed ports (or before)
//   {
//       sum := a +^ a
//   }
// Each port is declared TWICE in the class body (both collapse into one struct
// field; the last wins): first as the module's own signal so the body can use
// `sum := a` with real signals, then after zz_tree as a subSignal handle so a
// parent can write `u.a := sig` — SpinalHDL-style hierarchical access, where
// the instance name comes from the implicit bn constructor parameter.
// NOTE: 依赖"同名字段后者覆盖前者"的编译器行为；若解析器对字段重名报错
//       或改变语义，此宏必须重写（不要再声明同名端口）。
// The resulting value `myAdder.create` is a new type implementing `Module`; the
// tree is accessed via the trait method, so `moduleTreeVL(myAdder.create.tree)`
// produces the Verilog.

#[macro_export]
macro_rules module {
	// With explicit clock domain: module foo[cd] { ... }
	// The cd parameter is implicitly a ClockDomain; it is baked into the
	// ModuleDef at record time so the Verilog generator can emit the
	// configured clock/reset edges and names.
	// Usage: let t = foo.create[myClockDomain].tree
	($name: ident [$cd: ident] $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db: ident $pb: ident = Bool )* {$( $body: Expr )*}) => {
		class $name [$cd: ClockDomain] impl Module {
			let zz_tree: ModuleTree = let _init = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil)); let _ws = create_global("WhenStack", whenStackEmpty); let _prev = get_global("ModuleTree"); let _creat = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, $cd, 0, nil) :: nil)); $( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, stringify $p, $w)); )* $( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db, stringify $pb)); )* $($body)* let module_result = get_global("ModuleTree"); let _restore = create_global("ModuleTree", _prev); module_result;
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			def tree: ModuleTree = this.zz_tree
		}
	};
	($name: ident [$cd: ident] $( $db: ident $pb: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* {$( $body: Expr )*}) => {
		class $name [$cd: ClockDomain] impl Module {
			let zz_tree: ModuleTree = let _init = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil)); let _ws = create_global("WhenStack", whenStackEmpty); let _prev = get_global("ModuleTree"); let _creat = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, $cd, 0, nil) :: nil)); $( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, stringify $p, $w)); )* $( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db, stringify $pb)); )* $($body)* let module_result = get_global("ModuleTree"); let _restore = create_global("ModuleTree", _prev); module_result;
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			def tree: ModuleTree = this.zz_tree
		}
	};
	// Without clock domain parameter: uses defaultClockDomain
	($name: ident $( $args: params )* $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db: ident $pb: ident = Bool )* {$( $body: Expr )*}) => {
		class $name $({$args})* impl Module {
			let zz_tree: ModuleTree = let _init = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil)); let _ws = create_global("WhenStack", whenStackEmpty); let _prev = get_global("ModuleTree"); let _creat = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, defaultClockDomain, 0, nil) :: nil)); $( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, stringify $p, $w)); )* $( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db, stringify $pb)); )* $($body)* let module_result = get_global("ModuleTree"); let _restore = create_global("ModuleTree", _prev); module_result;
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			def tree: ModuleTree = this.zz_tree
		}
	};
	($name: ident $( $args: params )* $( $db: ident $pb: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* {$( $body: Expr )*}) => {
		class $name $({$args})* impl Module {
			let zz_tree: ModuleTree = let _init = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil)); let _ws = create_global("WhenStack", whenStackEmpty); let _prev = get_global("ModuleTree"); let _creat = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, defaultClockDomain, 0, nil) :: nil)); $( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, stringify $p, $w)); )* $( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db, stringify $pb)); )* $($body)* let module_result = get_global("ModuleTree"); let _restore = create_global("ModuleTree", _prev); module_result;
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			def tree: ModuleTree = this.zz_tree
		}
	};
}

	