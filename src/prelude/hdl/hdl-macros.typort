// ============================================================
// HDL Macros: Expr (ergonomic hardware DSL), when, and module
// ============================================================

// Standalone when macro for direct use outside Expr.
// Bodies use `Expr` fragment for consistency with Expr macro's when handlers.
// NOTE: 与下方 `Expr` macro 内的 when arm 逻辑重复、独立维护，
//       修改任一处必须同步另一处（same when-begin/else-begin/end 序列）。
// NOTE: 所有脚手架绑定都用 `let _ = ...` 丢弃：在 module 宏展开的 class
//       体里每个 let 都是 struct 字段（用户语义：class body 的每个 let
//       都是字段，无特例），丢弃名让它们折叠进同一个 `_` 字段（last-wins），
//       而不是成为 w_push/w_pop 之类的额外成员。
#[macro_export]
macro_rules when {
    // when + elsewhen* + otherwise
    // NOTE: the whole chain shares ONE WhenStack level — no whenEnd between
    // branches — so whenElseBegin / whenOtherwiseBegin can accumulate the
    // negation of earlier branches into each assignment's enable condition
    // (see hdl-core.typort WhenStack). whenEnd pops the level once, after
    // the last branch. The module records each assignment as an independent
    // when(cond, assign, None) node with its FULL condition; the generator
    // emits independent ifs (no else-if chain reconstruction).
    ($cond:raw {$( $body: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})* otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$body})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
    };
    // when + otherwise (no elsewhen)
    ($cond:raw {$( $body: Expr )*} otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$body})*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
    };
    // when without otherwise (optional elsewhen)
    ($cond:raw {$( $body: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})*) => {
        let _ = whenBegin(($cond).expr);
        $({$body})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenEnd(unit);
    };
}

// The Expr macro provides convenient syntax for hardware expressions
// Usage:
//   let mySignal = UInt[8]           -- creates a UInt[8] named "mySignal"
//   input myInput = UInt[4]          -- creates an input UInt[4] named "myInput"  
//   output myOutput = Bits[16]       -- creates an output Bits[16] named "myOutput"
//   when condition {                  -- conditional assignment block
//     a := b
//   } otherwise {
//     a := c
//   }
//   switch x {                        -- switch statement
//     is value1 { ... }
//     is value2 { ... }
//     default { ... }
//   }

#[macro_export]
macro_rules Expr {
    // ---- signal declarations ----
    // new* factories take an implicit BindingName filled with the let
    // binder's name, so `input myInput = UInt[4]` still names the port
    // "myInput" (bn == stringify $x).
    // NOTE: every signal arm emits an ANNOTATED let. In a module macro body
    // the statements become class fields (user semantics: every class-body
    // let is a struct field), and an unannotated field whose type depends on
    // the class's Nat params (e.g. `let x = Bits[left + right]`) leaves an
    // unsolved meta ("can't unify for unsolved meta", see
    // docs/module-redesign-analysis.md §2.1); the explicit annotation gives
    // the field a concrete type up front. The factory return types match the
    // annotations exactly (Bits[w]/UInt[w]/SInt[w]/Bool).
    (input $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsInput($width);};
    (output $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsOutput($width);};
    (inout $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsInOut($width);};
    (let $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBits($width);};

    (input $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntInput($width);};
    (output $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntOutput($width);};
    (inout $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntInOut($width);};
    (let $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUInt($width);};

    (input $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntInput($width);};
    (output $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntOutput($width);};
    (inout $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntInOut($width);};
    (let $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSInt($width);};

    (input $x:ident = Bool) => {let $x: Bool = newBoolInput;};
    (output $x:ident = Bool) => {let $x: Bool = newBoolOutput;};
    (inout $x:ident = Bool) => {let $x: Bool = newBoolInOut;};
    (let $x:ident = Bool) => {let $x: Bool = newBool;};

    // ---- register declarations ----
    // `reg x = T[w] init v` — register with reset value (async reset, verilog init)
    (reg $x:ident = Bits[$width:raw] init $init:raw) => {let $x: Bits[$width] = newBitsRegInitNat($width, $init);};
    (reg $x:ident = UInt[$width:raw] init $init:raw) => {let $x: UInt[$width] = newUIntRegInitNat($width, $init);};
    (reg $x:ident = SInt[$width:raw] init $init:raw) => {let $x: SInt[$width] = newSIntRegInitNat($width, $init);};
    (reg $x:ident = Bool init $init:raw) => {let $x: Bool = newBoolRegInitNat($init);};

    (reg $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsReg($width);};
    (reg $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntReg($width);};
    (reg $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntReg($width);};
    (reg $x:ident = Bool) => {let $x: Bool = newBoolReg;};

    // ---- output reg port declarations ----
    // `output reg x = T[w]` — an output port forced to `output reg` in
    // Verilog (with optional `init v` async-reset value). `:=` on it drives
    // the register (clocked); isRegExpr treats the variant as a reg.
    (output reg $x:ident = Bits[$width:raw] init $init:raw) => {let $x: Bits[$width] = newBitsOutRegInitNat($width, $init);};
    (output reg $x:ident = UInt[$width:raw] init $init:raw) => {let $x: UInt[$width] = newUIntOutRegInitNat($width, $init);};
    (output reg $x:ident = SInt[$width:raw] init $init:raw) => {let $x: SInt[$width] = newSIntOutRegInitNat($width, $init);};
    (output reg $x:ident = Bool init $init:raw) => {let $x: Bool = newBoolOutRegInitNat($init);};

    (output reg $x:ident = Bits[$width:raw]) => {let $x: Bits[$width] = newBitsOutReg($width);};
    (output reg $x:ident = UInt[$width:raw]) => {let $x: UInt[$width] = newUIntOutReg($width);};
    (output reg $x:ident = SInt[$width:raw]) => {let $x: SInt[$width] = newSIntOutReg($width);};
    (output reg $x:ident = Bool) => {let $x: Bool = newBoolOutReg;};

    // ---- sub-module instantiation ----
    // `let u = myAdder.create[8]` needs no special branch: the class
    // constructor's `create` records the instance itself (mkInstanceIfParent
    // at the end of the module class body), so a plain generic let suffices.

    // ---- generic let ----
    // `let u = myAdder.create[8]` needs no special branch: the class
    // constructor's `create` records the instance itself (mkInstanceIfParent
    // at the end of the module class body), so a plain generic let suffices.
    // Expression lets become named wires: `letNamed` (LetNamed instances in
    // hdl-types.typort, dispatched regNext-style) materializes
    // `wire x; assign x = <expr>;` for signal arithmetic results and passes
    // every other value (declared signals, bundles, sub-module instances,
    // plain locals) through unchanged. Its `bn: BindingName` implicit is
    // synthesized from the let binder's name.
    (let $x:ident = $y:raw) => {let $x = nameWire($y);};

    // ---- when/otherwise control flow ----
    // Pushes one WhenStack level per chain (see the standalone `when` macro's
    // note: no whenEnd between branches — negation accumulation needs the
    // level alive until after the last branch). All scaffolding bindings use
    // `let _ = ...` discards (they collapse into the module struct's single
    // `_` field instead of becoming named members).
    (when $cond:raw {$( $bodywhen: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})* otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$bodywhen})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
    };
    // when with otherwise (no elsewhen)
    (when $cond:raw {$( $bodywhen: Expr )*} otherwise {$( $bodyother: Expr )*}) => {
        let _ = whenBegin(($cond).expr);
        $({$bodywhen})*
        let _ = whenOtherwiseBegin(unit);
        $({$bodyother})*
        let _ = whenEnd(unit);
    };
    // when without otherwise (optional elsewhen)
    (when $cond:raw {$( $bodywhen: Expr )*} $( elsewhen $cond2:raw {$( $bodyelse: Expr )*})*) => {
        let _ = whenBegin(($cond).expr);
        $({$bodywhen})*
        $( let _ = whenElseBegin(($cond2).expr);
           $({$bodyelse})* )*
        let _ = whenEnd(unit);
    };

    // ---- switch — desugar to a when chain with one shared level ----
    // switch sel { is 0 { body } is 1 { body2 } default { body3 } }
    // The first is-case pushes the switch's level; subsequent is-cases use
    // whenElseBegin (replace + accumulate); default uses whenOtherwiseBegin.
    // Conditions: `sel==v1`, `sel==v2 && !(sel==v1)`, `!(sel==v1) && !(sel==v2)`.
    // Note: $val can be a Nat literal or a signal; uses === operator for comparison.
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} $( is $val2:raw {$( $body2: Expr )*})* default {$( $default_body: Expr )*} }) => {
        let _ = whenBegin(($sel === $val).expr);
        $({$body})*
        $( let _ = whenElseBegin(($sel === $val2).expr);
           $({$body2})* )*
        let _ = whenOtherwiseBegin(unit);
        $({$default_body})*
        let _ = whenEnd(unit);
    };
    // Single is + default (no elsewhen)
    (switch $sel:raw { is $val:raw {$( $body: Expr )*} default {$( $default_body: Expr )*} }) => {
        let _ = whenBegin(($sel === $val).expr);
        $({$body})*
        let _ = whenOtherwiseBegin(unit);
        $({$default_body})*
        let _ = whenEnd(unit);
    };

    // ---- for 循环 — 编译期展开（term 级 Nat 递归）----
    // NOTE: 绑定名不能用 `let _ =` —— class 体内 `let _ = <调用>` 在现有
    // elaborator 下会卡 meta（pre-existing，master 可复现：`let _ = whenEnd(unit)`）。
    // 命名绑定会产生一个 Unit 字段，与 module 宏的 `_res` 同理，无副作用面。
    (for $i:ident in $it:raw {$( $body: Expr )*}) => {
        let __hloop = rangeFor($it, $i => $({$body})* unit)
    };

    // ---- raw expression passthrough ----
    ($x: raw) => {let _ = $x;}
}

// The module macro provides convenient module definition syntax.
// It expands to a `class` (scala-style) whose struct implements the `Module` trait:
//   struct $name { _, _prev, _res: ModuleTree-chain fields, a: UInt[8], ... }
//     — ports become fields; the side-effect chain bindings become fields too
//     (user semantics: every class-body `let` is a struct field, no special
//     cases — see the WHY note below). NO storage field.
//   def $name.create[args]: $name[args] = ...   — runs the side-effect chain eagerly
//   impl Module for $name { def tree = <chain minus instance recording> }
// Usage:
//   module myAdder[w: Nat]
//       input a = UInt[w]
//       output sum = UInt[w + 1]
//       input en = Bool          — Bool ports mix freely with typed ports
//   {
//       sum := a +^ a
//   }
//   module foo[myClockDomain] ... { ... }   — explicit clock domain (optional)
//
// Ports must be declared BEFORE the body braces. Inside the braces,
// `input x = T[w]` / `output x = T[w]` / `let x = T[w]` declare MODULE-INTERNAL
// signals (no port handle), so a parent cannot connect to them via `u.x`.
//
// `output reg x = T[w]` (optional `init v`) declares a register output port:
// the Verilog port line is forced to `output reg` (no wire/reg inference),
// `:=` drives are clocked (regAssign), and `init v` emits an async-reset
// value. NOTE (matcher structure): `output reg` ports must be declared BEFORE
// any regular typed ports, and regular typed ports before Bool ports — the
// macro's port groups are matched as contiguous runs (same constraint as the
// existing typed-then-Bool grouping); `init` ports must sit on their own line
// (the init value is captured as a raw expression up to end-of-line).
//
// Each port is declared TWICE in the class body (both collapse into one struct
// field; the last wins): first as the module's own signal inside the flattened
// side-effect chain so the body can use `sum := a` with real signals, then
// after the chain as a subSignal handle so a parent can write `u.a := sig` —
// SpinalHDL-style hierarchical access, where the instance name comes from the
// implicit bn constructor parameter.
// NOTE: 依赖"同名字段后者覆盖前者"的编译器行为；若解析器对字段重名报错
//       或改变语义，此宏必须重写（不要再声明同名端口）。
//
// The resulting value `myAdder.create` is a new type implementing `Module`; the
// tree is accessed via the trait method, so `moduleTreeVL(myAdder.create.tree)`
// produces the Verilog.
//
// Sub-module instantiation needs no call-site special case: the constructor
// records `instance(bn.name, name)` itself via mkInstanceIfParent (dropped at
// top level, where no parent module exists).
//
// WHY the side-effect chain is FLATTENED into class-body fields (方案 C2;
// 前置分析见 docs/module-redesign-analysis.md §2/§8.3，摊平形态探针见
// class_tests.rs::class_module_shape_flattened_chain):
// user semantics: EVERY `let` in a class body is a struct field — no special
// cases, no create-locals. The module's side-effect chain is therefore
// transcribed as plain class-body fields in execution order; the create's let
// chain binds fields in declaration order, so FIELD ORDER == SIDE-EFFECT ORDER
// (reset → push → ports → body → pop → instance record). The chain is
// transcribed TWICE, byte-identical apart from the instance-recording line:
//   1. create side — the chain fields at the top of the class body. Each
//      binding is a struct field (no storage field): the repeated
//      `let _ = ...` bindings collapse last-wins into a single `_ : Unit`
//      field (the LAST `_` is mkInstanceIfParent's; the earlier ones still
//      run in the constructor via shadowing), `_prev`/`_res` are the
//      sandwich's ModuleTree values (exposed on the struct deliberately),
//      and the ports are the real signals (overwritten below by the handle
//      declarations). The constructor runs them EAGERLY — a nested
//      `let u = child.create` inside the body records its instance into the
//      parent's in-progress tree (the mkInstanceIfParent line runs after the
//      restore, against the parent frame), so the instance lands in the tree
//      exactly once per create run. The `_res` value is dead weight by
//      design; the create-side side effects are what matter.
//   2. `def tree` side — the same chain minus mkInstanceIfParent (the def has
//      no `bn` and must not re-record instances) runs on EVERY `.tree`
//      access, rebuilding the identical tree from a clean push. Idempotent:
//      each run starts with change_mutable_default reset and ends by
//      restoring the previous global tree, so repeated accesses print the
//      same Verilog.
// RED LINE (§8.3): both copies keep the ModuleDef push in constant form
// `ModuleTree.mk(0 + 1, ... :: nil)` — deriving the head from the lambda
// parameter (`x.num + 1` / `:: x.data`) leaves stuck GADT indices that make
// every later tree access O(n²).

#[macro_export]
macro_rules module {
	// With explicit clock domain: module foo[myCd] ... { ... }
	// The cd parameter is implicitly a ClockDomain; it is baked into the
	// ModuleDef at record time so the Verilog generator can emit the
	// configured clock/reset edges and names.
	// Usage: let t = foo.create[myClockDomain].tree
	($name: ident [$cd: ident] $( $args: params )* $( output reg $rp: ident = $rt: ident [$rw: raw] init $rv: raw )* $( output reg $rp2: ident = $rt2: ident [$rw2: raw] )* $( output reg $rb: ident = Bool init $rbv: raw )* $( output reg $rb2: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db: ident $pb: ident = Bool )* {$( $body: Expr )*}) => {
		class $name [$cd: ClockDomain] $({$args})* impl Module {
			// Create side (see the WHY note above): the side-effect chain
			// FLATTENED into class-body fields — every `let` is a struct
			// field (user semantics, no special cases). The constructor binds
			// them in declaration order, so field order == side-effect order;
			// the repeated `let _ = ...` bindings collapse last-wins into one
			// `_ : Unit` field (mkInstanceIfParent's return).
			let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil))
			let _ = create_global("WhenStack", whenStackEmpty)
			let _prev: ModuleTree = get_global("ModuleTree")
			let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, $cd, 0, nil) :: nil))
			$( let $rp: $rt[$rw] = $rt.mk(Some(stringify $rp), createOutRegPortExprInit(stringify $rt, $rw, $rv)); )*
			$( let $rp2: $rt2[$rw2] = $rt2.mk(Some(stringify $rp2), createOutRegPortExpr(stringify $rt2, $rw2)); )*
			$( let $rb: Bool = Bool.mk(Some(stringify $rb), createOutRegBoolPortExprInit($rbv)); )*
			$( let $rb2: Bool = Bool.mk(Some(stringify $rb2), createOutRegBoolPortExpr); )*
			$( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, $w)); )*
			$( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db)); )*
			$($body)*
			let _res: ModuleTree = checkModuleTree(get_global("ModuleTree"))
			let _ = create_global("ModuleTree", _prev)
			let _ = mkInstanceIfParent(bn.name, stringify $name)
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			// tree recomputes the chain on every access (minus instance recording).
			def tree: ModuleTree =
				let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil));
				let _ = create_global("WhenStack", whenStackEmpty);
				let _prev = get_global("ModuleTree");
				let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, $cd, 0, nil) :: nil));
				$( let $rp: $rt[$rw] = $rt.mk(Some(stringify $rp), createOutRegPortExprInit(stringify $rt, $rw, $rv)); )*
				$( let $rp2: $rt2[$rw2] = $rt2.mk(Some(stringify $rp2), createOutRegPortExpr(stringify $rt2, $rw2)); )*
				$( let $rb: Bool = Bool.mk(Some(stringify $rb), createOutRegBoolPortExprInit($rbv)); )*
				$( let $rb2: Bool = Bool.mk(Some(stringify $rb2), createOutRegBoolPortExpr); )*
				$( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, $w)); )*
				$( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db)); )*
				$($body)*
				let _res = get_global("ModuleTree");
				let _ = create_global("ModuleTree", _prev);
				_res
		}
	};
	// Without clock domain: uses defaultClockDomain
	($name: ident $( $args: params )* $( output reg $rp: ident = $rt: ident [$rw: raw] init $rv: raw )* $( output reg $rp2: ident = $rt2: ident [$rw2: raw] )* $( output reg $rb: ident = Bool init $rbv: raw )* $( output reg $rb2: ident = Bool )* $( $d: ident $p: ident = $t: ident [$w: raw] )* $( $db: ident $pb: ident = Bool )* {$( $body: Expr )*}) => {
		class $name $({$args})* impl Module {
			// Create side (see the WHY note above): the side-effect chain
			// FLATTENED into class-body fields — every `let` is a struct
			// field (user semantics, no special cases). The constructor binds
			// them in declaration order, so field order == side-effect order;
			// the repeated `let _ = ...` bindings collapse last-wins into one
			// `_ : Unit` field (mkInstanceIfParent's return).
			let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil))
			let _ = create_global("WhenStack", whenStackEmpty)
			let _prev: ModuleTree = get_global("ModuleTree")
			let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, defaultClockDomain, 0, nil) :: nil))
			$( let $rp: $rt[$rw] = $rt.mk(Some(stringify $rp), createOutRegPortExprInit(stringify $rt, $rw, $rv)); )*
			$( let $rp2: $rt2[$rw2] = $rt2.mk(Some(stringify $rp2), createOutRegPortExpr(stringify $rt2, $rw2)); )*
			$( let $rb: Bool = Bool.mk(Some(stringify $rb), createOutRegBoolPortExprInit($rbv)); )*
			$( let $rb2: Bool = Bool.mk(Some(stringify $rb2), createOutRegBoolPortExpr); )*
			$( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, $w)); )*
			$( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db)); )*
			$($body)*
			let _res: ModuleTree = checkModuleTree(get_global("ModuleTree"))
			let _ = create_global("ModuleTree", _prev)
			let _ = mkInstanceIfParent(bn.name, stringify $name)
			$( let $p: $t[$w] = $t.mk(None, subSignal(bn.name, stringify $p)); )*
			$( let $pb: Bool = Bool.mk(None, subSignal(bn.name, stringify $pb)); )*
			// tree recomputes the chain on every access (minus instance recording).
			def tree: ModuleTree =
				let _ = change_mutable_default("ModuleTree", x => x, ModuleTree.mk(0, nil));
				let _ = create_global("WhenStack", whenStackEmpty);
				let _prev = get_global("ModuleTree");
				let _ = change_mutable("ModuleTree", x => ModuleTree.mk(0 + 1, ModuleDef.mk(stringify $name, defaultClockDomain, 0, nil) :: nil));
				$( let $rp: $rt[$rw] = $rt.mk(Some(stringify $rp), createOutRegPortExprInit(stringify $rt, $rw, $rv)); )*
				$( let $rp2: $rt2[$rw2] = $rt2.mk(Some(stringify $rp2), createOutRegPortExpr(stringify $rt2, $rw2)); )*
				$( let $rb: Bool = Bool.mk(Some(stringify $rb), createOutRegBoolPortExprInit($rbv)); )*
				$( let $rb2: Bool = Bool.mk(Some(stringify $rb2), createOutRegBoolPortExpr); )*
				$( let $p: $t[$w] = $t.mk(Some(stringify $p), createPortExpr(stringify $d, stringify $t, $w)); )*
				$( let $pb: Bool = Bool.mk(Some(stringify $pb), createBoolPortExpr(stringify $db)); )*
				$($body)*
				let _res = get_global("ModuleTree");
				let _ = create_global("ModuleTree", _prev);
				_res
		}
	};
}
