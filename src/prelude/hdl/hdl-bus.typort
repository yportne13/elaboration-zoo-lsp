//! Bus / bundle infrastructure.
// ============================================================
// HDL Bus/Interface Types: Bundle, Stream, Flow, BlackBox, FSM
// ============================================================

// ============================================================
//  Bundle (structured IO) — SpinalHDL-style trait-based Bundle
// ============================================================

// Direction spec functions (SpinalHDL style). Bundle fields carry NO
// direction markers in the struct; directionality is introduced only when
// implementing `IMasterSlave` — `def asMaster` declares each field's
// direction from the master's point of view with `in(...)` / `out(...)` /
// `inout(...)`:
//   #[derive(Bundle)]
//   struct AxiLite {
//       awaddr:  UInt[32]   // plain field types — no markers
//       awready: Bool
//       …
//   }
//   impl IMasterSlave for AxiLite {
//       def asMaster: AxiLite =
//           let _ = out(this.awaddr);   // driven by the master → output port
//           let _ = in(this.awready);   // received by the master → input port
//           …
//           this
//   }
// The functions are identities, so they can never change a value at runtime;
// the parser (src/L13_namespace/parser/derive.rs) reads the asMaster body
// syntactically to generate the asMaster / asSlave direction methods.
/// Master-side direction marker: identity function (`in(t) == t`), so it can
/// never change a value at runtime. It exists only so the `#[derive(Bundle)]`
/// expansion of an `IMasterSlave.asMaster` body can read the call
/// syntactically (`src/L13_namespace/parser/derive.rs`) and mark `t`'s field
/// as an output port of the master.
def in[T](t: T): T = t
/// Master-side output port marker — sibling of `in`; identity at runtime, read
/// syntactically by the Bundle derive.
def out[T](t: T): T = t
/// Bidirectional port marker — identity at runtime; the Bundle derive keeps it
/// InOut on both `asMaster` and `asSlave` (only In ↔ Out are flipped), and an
/// InOut field is never driven by `:=` / `<>`.
def inout[T](t: T): T = t

// IMasterSlave — SpinalHDL-style master/slave directionality.
// A Bundle implementing this trait gains the direction methods used on
// `TypeName.create` factories:
//   let master = AxiLite.create.asMaster   // ports: awaddr… output, awready… input
//   let slave  = AxiLite.create.asSlave    // ports: awaddr… input, awready… output
// The user writes ONLY the asMaster direction spec (see in/out/inout above);
// the derive fills both methods — asSlave is asMaster with every direction
// flipped (In ↔ Out, InOut stays InOut). The `[bn: BindingName]` implicit
// parameter picks up the caller's let-binding name, so
// `let master = AxiLite.create.asMaster` still names its ports
// "master_awaddr", …
//
// Nested bundles (SpinalHDL's Axi4 ⊃ Axi4AW): a field whose type is itself a
// `#[derive(Bundle)]` struct of the same file takes `out(...)` / `in(...)`
// to direct the whole child through its own asMaster / asSlave:
//   let _ = out(this.aw);   // aw: Axi4AW — the child is built as a master
// The child type must itself implement IMasterSlave. `inout` is only valid
// for primitive fields. The binding-name prefix flows down:
// `let master = Axi4.create.asMaster` names the child's ports
// "master_addr", …. The plain wires left behind by the child's factory are
// dropped by the Verilog generator (ports take precedence over same-named
// wires).
/// SpinalHDL-style master/slave directionality for a Bundle. A bundle that
/// implements this trait gets `asMaster` / `asSlave`, which rebuild the bundle
/// with directed ports, and can be chained onto the derived factory:
/// `let master = AxiLite.create.asMaster`. The user only writes the `asMaster`
/// direction spec (`out(this.x)` / `in(this.x)` / `inout(this.x)`); the derive
/// fills both methods, with `asSlave` flipping every In ↔ Out and keeping InOut.
/// `[bn: BindingName]` is the implicit parameter that carries the caller's let
/// binding, so the directed ports keep the `master_x` prefix. Nested bundles are
/// supported when the child also implements `IMasterSlave` (the child is rebuilt
/// through its own factory and the binding-name prefix flows down); `inout` is
/// only valid for primitive fields. `.asMaster` / `.asSlave` must be called
/// inside a module body or class field (a `def` body has no let binding to
/// name the ports) and must not be chained twice on an already-directed bundle
/// (a second pass would declare duplicate ports).
trait IMasterSlave {
    /// View the bundle from the master side (drives the request channels).
    def asMaster[bn: BindingName]: Self
    /// View the bundle from the slave side (drives the response channels).
    def asSlave[bn: BindingName]: Self
}

// The Bundle trait — analogous to SpinalHDL's Bundle.
// Any struct that groups multiple signals together can implement
// this trait to enable bulk assignment (:=) and composition.
//
// Use #[derive(Bundle)] to auto-generate the impl.
//
// The derive generates:
//   1. impl Bundle for TypeName { def :=(that: TypeName): Unit = … }
//      — field-by-field bulk assignment (like SpinalHDL's :=); assignments
//        whose LHS is an input port are skipped (see isInputPort)
//   2. impl Into[TypeName] for TypeName { def into = this }
//      — identity conversion so the Expr macro's `:=` works with bundles
//   3. def TypeName.create$(typeParams)[bn: BindingName]: TypeName = …
//      — automatic wire factory; every signal is named after the caller's
//        let binding plus the field name (`bn.name + "_" + field`), e.g.
//        `let master = AxiLite.create` creates "master_awaddr", …
//      — nested bundle fields are created recursively through their own
//        factories (`OuterBus.create` calls `InnerBus.create[bn]`, so the
//        binding-name prefix flows down: `let outer = OuterBus.create` names
//        the inner signals "outer_value", …). The nested type must be a
//        `#[derive(Bundle)]` struct declared in the same file.
//
// Directionality (SpinalHDL master/slave) is NOT part of the struct — fields
// carry plain types. Implement `IMasterSlave` to introduce directions:
//   4. impl IMasterSlave for TypeName { def asMaster … }
//      — the derive reads the asMaster direction spec and generates both
//        direction methods:
//          def asMaster[bn: BindingName]: TypeName = …  (directed ports)
//          def asSlave[bn: BindingName]: TypeName = …   (directions flipped)
//        asMaster: out-marked fields become output ports, in-marked fields
//        input ports; asSlave: exactly the opposite (InOut stays InOut).
//        Both rebuild the bundle with directed ports; the plain wires from
//        the inner TypeName.create call are dropped by the Verilog generator
//        (ports take precedence over same-named wires, see collectPortNames
//        in hdl-verilog.typort).
//
// Example:
//   #[derive(Bundle)]
//   struct AxiLite {
//       awaddr:  UInt[32]
//       awvalid: Bool
//       awready: Bool
//       wdata:   UInt[32]
//       wvalid:  Bool
//       wready:  Bool
//   }
//
//   impl IMasterSlave for AxiLite {
//       def asMaster: AxiLite =
//           let _ = out(this.awaddr);
//           let _ = out(this.awvalid);
//           let _ = in(this.awready);
//           let _ = out(this.wdata);
//           let _ = out(this.wvalid);
//           let _ = in(this.wready);
//           this
//   }
//
//   // Usage inside a module:
//   module Top {
//     let master = AxiLite.create    // wires, auto-named "master_awaddr", …
//     let slave  = AxiLite.create    // wires, auto-named "slave_awaddr", …
//     master := slave                // bulk assignment
//   }
//
//   // Directed interfaces (SpinalHDL master/slave):
//   module Bridge {
//     let master = AxiLite.create.asMaster   // ports: awaddr… output, awready… input
//     let slave  = AxiLite.create.asSlave    // ports: awaddr… input, awready… output
//     master <> slave                        // bidirectional (drives both sides, skips inputs)
//   }
//
//   // Parametric bundles:
//   #[derive(Bundle)]
//   struct MyBus[w: Nat] { data: UInt[w]; valid: Bool }
//
//   let bus = MyBus.create[8]        // auto-creates with width 8
//
// NOTE — call sites: the factories (and `.asMaster` / `.asSlave`) must be
// called inside a module body or a class field, where the implicit
// BindingName picks up the caller's let-binding name. Inside a `def` body the
// binding name is not available (signals get empty names / no ports), and
// `.asMaster`/`.asSlave` must not be chained on an already-directed bundle
// (a second direction pass would produce duplicate port declarations).
//
// `#[derive(Bundle)]` 的实现在 src/L13_namespace/parser/derive.rs，
// 此处注释仅为使用文档；修改派生逻辑时请同步两处。

/// The Bundle trait — SpinalHDL's `Bundle` counterpart, for structs that group
/// signals. `#[derive(Bundle)]` generates the impl: field-by-field `:=`
/// (assignments whose LHS is an input port are skipped, see `isInputPort`), an
/// identity `Into[TypeName]` so the `:=` macro accepts bundles, and the
/// `TypeName.create[bn]` wire factory that names every field `bn + "_" + field`.
/// Two methods are abstract rather than defaulted: a default body cannot
/// dispatch sibling methods through `this` (filled-trait-default limitation), so
/// a manual `impl Bundle` must provide `<>` explicitly — a missing one is a
/// loud impl-time error instead of a silent no-op.
trait Bundle {
    /// Connect this bundle to another one, driving every field.
    def :=(that: Self): Unit
    // `<>` — SpinalHDL-style bidirectional connection. The derive generates
    // it with a two-way body (drive both sides, each through its own `:=`
    // which skips input-port LHS), so `master <> slave` connects a
    // master/slave pair in one statement. The method is ABSTRACT here (no
    // default body): a default that dispatches `this := that` does not
    // elaborate inside a filled trait default (sibling-method dispatch via
    // `this` is not supported there), so manual `impl Bundle` blocks must
    // provide `<>` explicitly — a missing one is a loud impl-time error
    // instead of a silent no-op. Inout fields are never driven (a module
    // does not drive its own bidirectional pins).
    /// Bidirectional connect (alias used for differential/stream bundles).
    def <>(that: Self): Unit
}

// ============================================================
//  Stream / Flow Buses
// ============================================================

/// Ready/valid handshake channel: a transfer happens on the clock edge where
/// `valid && ready` (SpinalHDL's `fire`). Responsibility split: the **master**
/// drives `valid` and `payload` and consumes `ready`; the **slave** drives
/// `ready` and consumes `valid`/`payload`. `payload` may only be sampled when
/// `valid` is high, and a valid transfer must not be retracted before `ready`
/// (the hdl-stream pipe/fifo primitives implement the buffering that keeps
/// that invariant). The struct carries no direction of its own — ports are
/// made with `input`/`output` declarations or the direction helpers.
struct Stream[T] {
    /// Producer-side handshake: the payload is present.
    valid: Bool
    /// Consumer-side handshake: the payload is accepted this cycle.
    ready: Bool
    /// The payload transferred when valid and ready are both high.
    payload: T
}

/// Payload-plus-valid channel without backpressure (`ready` does not exist):
/// the producer must hold `payload` stable while `valid` is high, and the
/// consumer either samples every cycle or adds a `Stream` stage. Handshake
/// helpers live in hdl-stream (`flowToStream` gives `ready = True`).
struct Flow[T] {
    /// The payload (Flow has no back-pressure, only `valid`).
    /// The payload (Flow has no back-pressure, only `valid`).
    payload: T
    /// The payload is present; a Flow is consumed every cycle.
    valid: Bool
}

impl[T] Stream[T] {
    /// One successful transfer this cycle: `valid && ready` (SpinalHDL
    /// `Stream.fire`). Use it to gate state updates that must happen exactly
    /// once per accepted beat.
    def fire: Bool = this.valid && this.ready
    /// Placeholder: returns `this` and emits no register. SpinalHDL's
    /// `Stream.stage` is a `m2sPipe` (one-stage skid buffer); that pipeline is
    /// provided by hdl-stream instead, so this method must not be used as a
    /// timing cut (it is an exact identity, not a delay).
    def stage: Stream[T] = this
}

impl[T] Flow[T] {
    /// Same placeholder as `Stream.stage`: identity, no register — the
    /// registered flow pipe lives in hdl-stream (`flowM2sPipe`).
    def stage: Flow[T] = this
}

// ============================================================
//  BlackBox (external module)
// ============================================================

/// Vestigial BlackBox placeholder: an unused struct that only stores a `name`.
/// The working blackbox path is the `blackbox` macro in hdl-macros.typort
/// (registry in hdl-core.typort, emission in hdl-verilog.typort); nothing in
/// the prelude, examples or test corpus constructs this struct (verified by
/// grep). Kept only as a syntactic placeholder — its methods are no-ops.
struct BlackBox {
    /// Blackbox module name.
    name: String
}

impl BlackBox {
    /// No-op stub: does not record the generic, returns `this`. Generic
    /// parameters are today emitted only through the `blackbox` macro's
    /// `generic K = v` statements (hdl-macros.typort).
    def addGeneric(name: String, value: String): BlackBox = this
    /// No-op stub: returns `this` without changing any definition name
    /// (docs/hdl-blackbox-sim-design.md lists real `setDefinitionName` as
    /// future work).
    def setDefinitionName(name: String): BlackBox = this
}

// ============================================================
//  FSM (Finite State Machine)
// ============================================================

/// Vestigial FSM-DSL tag: which lifecycle accessor a recorded state action
/// belongs to (`boot` = reset/entry-time action, `entry` = state-entry action,
/// `exit` = state-exit action). Unused — the FSM framework that consumed it is
/// now hdl-fsm.typort (`fsmNew` / `fsmStateEq` / `ctrl.state(idx)` handles, with
/// the HDL060-064 rule set). Declared here only; no prelude, example or test code
/// matches on it.
enum StateAccess {
    /// Access made during the boot / reset phase.
    boot
    /// Access made on entering this state.
    entry
    /// Access made on leaving this state.
    exit
}

/// Vestigial FSM state handle: a state name plus optional entry/exit action
/// values. Unused by the current FSM framework — hdl-fsm.typort identifies a
/// state by its ordinal (`ctrl.state(0)`) and keeps the transition table in the
/// recorded `FsmCtx` global, so nothing constructs `State[T]` in the prelude,
/// examples or verification corpus.
struct State[T] {
    /// State name as written in the source.
    /// State name as written in the source.
    name: String
    /// Value loaded on entry, when the state carries one.
    stateEntry: Option[T]
    /// Value produced on exit, when the state carries one.
    stateExit: Option[T]
}

/// Vestigial single-constructor tag for "this action runs on FSM entry".
/// Unused — superseded by the `whenIsActive` / `whenIsNext` forms of
/// hdl-fsm.typort; kept because removing it would change the exported API
/// surface.
enum FSMEntryPoint {
    /// Default entry point used when no explicit one is given.
    entryPoint
}

// ============================================================
//  Switch Statement DSL
// ============================================================

/// Vestigial marker for the default arm of the switch DSL. Unused — the checked
/// switch form states exhaustiveness explicitly through `switchFinalEnum` and
/// the `scCons`/`shEnum` case chain of hdl-enum.typort (HDL040). Kept as the
/// placeholder name for a future dedicated default arm.
enum SwitchKey {
    /// Fallback entry point (the first declared state).
    default
}
