// ============================================================
// HDL Bus/Interface Types: Bundle, Stream, Flow, BlackBox, FSM
// ============================================================

// ============================================================
//  Bundle (structured IO) — SpinalHDL-style trait-based Bundle
// ============================================================

// IO direction tags
// Used as type-level markers on Bundle fields (see in/out/inout below).
enum IODirection {
    In
    Out
    InOut
}

// Type-level direction markers (SpinalHDL style). Wrap a field's type inside
// a Bundle declaration to mark its direction from the master's point of view:
//   #[derive(Bundle)]
//   struct AxiLite {
//       awaddr:  out(UInt[32])   // driven by the master   → output port on master
//       awready: in(Bool)        // received by the master → input port on master
//       …
//   }
// The markers are identity functions, so a field's type is unchanged for
// ordinary use (create_TypeName still creates plain wires); the derive
// (src/L13_namespace/parser/derive.rs) reads them to generate the directed
// master_TypeName / slave_TypeName port factories. Unmarked fields default to
// out on master / in on slave. InOut is treated as in (no inout Expr support).
def in[T](t: T): T = t
def out[T](t: T): T = t
def inout[T](t: T): T = t

// Is an Expr an input port? Used by the derive-generated Bundle := to skip
// assignments whose LHS is an input port (driving an input is illegal
// Verilog), so a master/slave pair can be connected with `:=` both ways.
def isInputPort(e: Expr): Boolean = match e {
    case createIn(_) => true
    case createInWidth(_, _) => true
    case createSIntInWidth(_, _) => true
    case _ => false
}

// The Bundle trait — analogous to SpinalHDL's Bundle.
// Any struct that groups multiple signals together can implement
// this trait to enable bulk assignment (:=) and composition.
//
// Use #[derive(Bundle)] to auto-generate the impl.
//
// The derive generates:
//   1. impl Bundle for TypeName { def :=(that: TypeName): Unit = … }
//      — field-by-field bulk assignment (like SpinalHDL's :=); assignments
//        whose LHS is an input port are skipped (see isInputPort)
//   2. impl Into[TypeName] for TypeName { def into = this }
//      — identity conversion so the Expr macro's `:=` works with bundles
//   3. def create_TypeName$(typeParams)[bn: BindingName]: TypeName = …
//      — automatic wire factory; every signal is named after the caller's
//        let binding plus the field name (`bn.name + "_" + field`), e.g.
//        `let master = create_AxiLite` creates "master_awaddr", …
//      — when at least one field carries an in()/out() direction marker, two
//        more port factories are generated:
//          def master_TypeName$(typeParams)[bn: BindingName]: TypeName = …
//          def slave_TypeName$(typeParams)[bn: BindingName]: TypeName = …
//        master: out-marked fields become output ports, in-marked fields
//        input ports; slave: exactly the opposite.
//
// Example:
//   #[derive(Bundle)]
//   struct AxiLite {
//       awaddr:  out(UInt[32])
//       awvalid: out(Bool)
//       awready: in(Bool)
//       wdata:   out(UInt[32])
//       wvalid:  out(Bool)
//       wready:  in(Bool)
//   }
//
//   // Usage inside a module:
//   module Top {
//     let master = create_AxiLite    // wires, auto-named "master_awaddr", …
//     let slave  = create_AxiLite    // wires, auto-named "slave_awaddr", …
//     master := slave                // bulk assignment
//   }
//
//   // Directed interfaces (SpinalHDL master/slave):
//   module Bridge {
//     let master = master_AxiLite    // ports: m_awaddr… output, m_awready… input
//     let slave  = slave_AxiLite     // ports: s_awaddr… input, s_awready… output
//     master := slave                // drives the master's outputs (skips inputs)
//     slave := master                // drives the slave's outputs (skips inputs)
//   }
//
//   // Parametric bundles:
//   #[derive(Bundle)]
//   struct MyBus[w: Nat] { data: UInt[w]; valid: Bool }
//
//   let bus = create_MyBus[8]        // auto-creates with width 8
//
// `#[derive(Bundle)]` 的实现在 src/L13_namespace/parser/derive.rs，
// 此处注释仅为使用文档；修改派生逻辑时请同步两处。

trait Bundle {
    def :=(that: Self): Unit
}

// ============================================================
//  Stream / Flow Buses
// ============================================================

struct Stream[T] {
    valid: Bool
    ready: Bool
    payload: T
}

struct Flow[T] {
    payload: T
    valid: Bool
}

impl[T] Stream[T] {
    // SpinalHDL 语义：fire = valid && ready（一次传输成功握手）
    def fire: Bool = this.valid && this.ready
    def stage: Stream[T] = this
}

impl[T] Flow[T] {
    def stage: Flow[T] = this
}

// ============================================================
//  BlackBox (external module)
// ============================================================

struct BlackBox {
    name: String
}

impl BlackBox {
    // TODO(stub): 占位实现 —— 不存储任何信息，仅作语法占位。
    def addGeneric(name: String, value: String): BlackBox = this
    def setDefinitionName(name: String): BlackBox = this
}

// ============================================================
//  FSM (Finite State Machine)
// ============================================================

enum StateAccess {
    boot
    entry
    exit
}

struct State[T] {
    name: String
    stateEntry: Option[T]
    stateExit: Option[T]
}

enum FSMEntryPoint {
    entryPoint
}

// ============================================================
//  Switch Statement DSL
// ============================================================

enum SwitchKey {
    default
}
