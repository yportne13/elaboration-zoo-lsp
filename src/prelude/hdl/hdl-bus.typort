// ============================================================
// HDL Bus/Interface Types: Bundle, Stream, Flow, BlackBox, FSM
// ============================================================

// ============================================================
//  Bundle (structured IO) — SpinalHDL-style trait-based Bundle
// ============================================================

// Direction spec functions (SpinalHDL style). Bundle fields carry NO
// direction markers in the struct; directionality is introduced only when
// implementing `IMasterSlave` — `def asMaster` declares each field's
// direction from the master's point of view with `in(...)` / `out(...)` /
// `inout(...)`:
//   #[derive(Bundle)]
//   struct AxiLite {
//       awaddr:  UInt[32]   // plain field types — no markers
//       awready: Bool
//       …
//   }
//   impl IMasterSlave for AxiLite {
//       def asMaster: AxiLite =
//           let _ = out(this.awaddr);   // driven by the master → output port
//           let _ = in(this.awready);   // received by the master → input port
//           …
//           this
//   }
// The functions are identities, so they can never change a value at runtime;
// the parser (src/L13_namespace/parser/derive.rs) reads the asMaster body
// syntactically to generate the asMaster / asSlave direction methods.
def in[T](t: T): T = t
def out[T](t: T): T = t
def inout[T](t: T): T = t

// IMasterSlave — SpinalHDL-style master/slave directionality.
// A Bundle implementing this trait gains the direction methods used on
// `TypeName.create` factories:
//   let master = AxiLite.create.asMaster   // ports: awaddr… output, awready… input
//   let slave  = AxiLite.create.asSlave    // ports: awaddr… input, awready… output
// The user writes ONLY the asMaster direction spec (see in/out/inout above);
// the derive fills both methods — asSlave is asMaster with every direction
// flipped (In ↔ Out, InOut stays InOut). The `[bn: BindingName]` implicit
// parameter picks up the caller's let-binding name, so
// `let master = AxiLite.create.asMaster` still names its ports
// "master_awaddr", …
//
// Nested bundles (SpinalHDL's Axi4 ⊃ Axi4AW): a field whose type is itself a
// `#[derive(Bundle)]` struct of the same file takes `out(...)` / `in(...)`
// to direct the whole child through its own asMaster / asSlave:
//   let _ = out(this.aw);   // aw: Axi4AW — the child is built as a master
// The child type must itself implement IMasterSlave. `inout` is only valid
// for primitive fields. The binding-name prefix flows down:
// `let master = Axi4.create.asMaster` names the child's ports
// "master_addr", …. The plain wires left behind by the child's factory are
// dropped by the Verilog generator (ports take precedence over same-named
// wires).
trait IMasterSlave {
    def asMaster[bn: BindingName]: Self
    def asSlave[bn: BindingName]: Self
}

// The Bundle trait — analogous to SpinalHDL's Bundle.
// Any struct that groups multiple signals together can implement
// this trait to enable bulk assignment (:=) and composition.
//
// Use #[derive(Bundle)] to auto-generate the impl.
//
// The derive generates:
//   1. impl Bundle for TypeName { def :=(that: TypeName): Unit = … }
//      — field-by-field bulk assignment (like SpinalHDL's :=); assignments
//        whose LHS is an input port are skipped (see isInputPort)
//   2. impl Into[TypeName] for TypeName { def into = this }
//      — identity conversion so the Expr macro's `:=` works with bundles
//   3. def TypeName.create$(typeParams)[bn: BindingName]: TypeName = …
//      — automatic wire factory; every signal is named after the caller's
//        let binding plus the field name (`bn.name + "_" + field`), e.g.
//        `let master = AxiLite.create` creates "master_awaddr", …
//      — nested bundle fields are created recursively through their own
//        factories (`OuterBus.create` calls `InnerBus.create[bn]`, so the
//        binding-name prefix flows down: `let outer = OuterBus.create` names
//        the inner signals "outer_value", …). The nested type must be a
//        `#[derive(Bundle)]` struct declared in the same file.
//
// Directionality (SpinalHDL master/slave) is NOT part of the struct — fields
// carry plain types. Implement `IMasterSlave` to introduce directions:
//   4. impl IMasterSlave for TypeName { def asMaster … }
//      — the derive reads the asMaster direction spec and generates both
//        direction methods:
//          def asMaster[bn: BindingName]: TypeName = …  (directed ports)
//          def asSlave[bn: BindingName]: TypeName = …   (directions flipped)
//        asMaster: out-marked fields become output ports, in-marked fields
//        input ports; asSlave: exactly the opposite (InOut stays InOut).
//        Both rebuild the bundle with directed ports; the plain wires from
//        the inner TypeName.create call are dropped by the Verilog generator
//        (ports take precedence over same-named wires, see collectPortNames
//        in hdl-verilog.typort).
//
// Example:
//   #[derive(Bundle)]
//   struct AxiLite {
//       awaddr:  UInt[32]
//       awvalid: Bool
//       awready: Bool
//       wdata:   UInt[32]
//       wvalid:  Bool
//       wready:  Bool
//   }
//
//   impl IMasterSlave for AxiLite {
//       def asMaster: AxiLite =
//           let _ = out(this.awaddr);
//           let _ = out(this.awvalid);
//           let _ = in(this.awready);
//           let _ = out(this.wdata);
//           let _ = out(this.wvalid);
//           let _ = in(this.wready);
//           this
//   }
//
//   // Usage inside a module:
//   module Top {
//     let master = AxiLite.create    // wires, auto-named "master_awaddr", …
//     let slave  = AxiLite.create    // wires, auto-named "slave_awaddr", …
//     master := slave                // bulk assignment
//   }
//
//   // Directed interfaces (SpinalHDL master/slave):
//   module Bridge {
//     let master = AxiLite.create.asMaster   // ports: awaddr… output, awready… input
//     let slave  = AxiLite.create.asSlave    // ports: awaddr… input, awready… output
//     master <> slave                        // bidirectional (drives both sides, skips inputs)
//   }
//
//   // Parametric bundles:
//   #[derive(Bundle)]
//   struct MyBus[w: Nat] { data: UInt[w]; valid: Bool }
//
//   let bus = MyBus.create[8]        // auto-creates with width 8
//
// NOTE — call sites: the factories (and `.asMaster` / `.asSlave`) must be
// called inside a module body or a class field, where the implicit
// BindingName picks up the caller's let-binding name. Inside a `def` body the
// binding name is not available (signals get empty names / no ports), and
// `.asMaster`/`.asSlave` must not be chained on an already-directed bundle
// (a second direction pass would produce duplicate port declarations).
//
// `#[derive(Bundle)]` 的实现在 src/L13_namespace/parser/derive.rs，
// 此处注释仅为使用文档；修改派生逻辑时请同步两处。

trait Bundle {
    def :=(that: Self): Unit
    // `<>` — SpinalHDL-style bidirectional connection. The derive generates
    // it with a two-way body (drive both sides, each through its own `:=`
    // which skips input-port LHS), so `master <> slave` connects a
    // master/slave pair in one statement. The method is ABSTRACT here (no
    // default body): a default that dispatches `this := that` does not
    // elaborate inside a filled trait default (sibling-method dispatch via
    // `this` is not supported there), so manual `impl Bundle` blocks must
    // provide `<>` explicitly — a missing one is a loud impl-time error
    // instead of a silent no-op. Inout fields are never driven (a module
    // does not drive its own bidirectional pins).
    def <>(that: Self): Unit
}

// ============================================================
//  Stream / Flow Buses
// ============================================================

struct Stream[T] {
    valid: Bool
    ready: Bool
    payload: T
}

struct Flow[T] {
    payload: T
    valid: Bool
}

impl[T] Stream[T] {
    // SpinalHDL 语义：fire = valid && ready（一次传输成功握手）
    def fire: Bool = this.valid && this.ready
    def stage: Stream[T] = this
}

impl[T] Flow[T] {
    def stage: Flow[T] = this
}

// ============================================================
//  BlackBox (external module)
// ============================================================

struct BlackBox {
    name: String
}

impl BlackBox {
    // TODO(stub): 占位实现 —— 不存储任何信息，仅作语法占位。
    def addGeneric(name: String, value: String): BlackBox = this
    def setDefinitionName(name: String): BlackBox = this
}

// ============================================================
//  FSM (Finite State Machine)
// ============================================================

enum StateAccess {
    boot
    entry
    exit
}

struct State[T] {
    name: String
    stateEntry: Option[T]
    stateExit: Option[T]
}

enum FSMEntryPoint {
    entryPoint
}

// ============================================================
//  Switch Statement DSL
// ============================================================

enum SwitchKey {
    default
}
