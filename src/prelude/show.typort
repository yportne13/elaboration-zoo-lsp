//! Rendering values as strings (`Show`) and the integer type `Int`.
//!
//! `Int` is a sign-magnitude encoding built from `Nat`: `ofNat n` is `n` and
//! `negSucc n` is `-(n + 1)` (so zero has a single representation).  The usual
//! arithmetic traits are implemented on top of the helpers here.

/// Types that can be rendered as a `String`.
trait Show {
    /// Render `this` as a string.
    def show: String
}

impl Nat {
    def show: String = nat_to_dec this
}

// === Int 类型 ===

/// Arbitrary-precision integers as a sign-magnitude pair over `Nat`.
enum Int {
    /// A non-negative integer: `n`.
    ofNat(n: Nat)
    /// A negative integer: `-(n + 1)`.
    negSucc(n: Nat)
}

// === 基础运算 ===

/// Negate an `Int`.
def int_neg(i: Int): Int =
    match i {
        case ofNat(n) =>
            match n {
                case zero => ofNat(zero)
                case succ(m) => negSucc(m)
            }
        case negSucc(n) => ofNat(succ(n))
    }

/// Add two `Int`s.
def int_add(x: Int, y: Int): Int =
    match x {
        case ofNat(a) =>
            match y {
                case ofNat(b) => ofNat(a + b)
                case negSucc(b) =>
                    // a - (b+1)
                    // a > b: ofNat(a - b - 1) = ofNat(pred(nat_sub a b))
                    // a <= b: -(b - a + 1) = negSucc(nat_sub b a)
                    match nat_compare a b {
                        case gt => ofNat (pred (nat_sub a b))
                        case _ => negSucc (nat_sub b a)
                    }
            }
        case negSucc(a) =>
            match y {
                case ofNat(b) => int_add (ofNat b) (negSucc a)
                case negSucc(b) => negSucc(succ(a + b))
            }
    }

/// Subtract two `Int`s (`x - y` is `x + (-y)`).
def int_sub(x: Int, y: Int): Int =
    let ny: Int = int_neg y;
    int_add x ny

/// Multiply two `Int`s.
def int_mul(x: Int, y: Int): Int =
    match x {
        case ofNat(n) =>
            match n {
                case zero => ofNat(zero)
                case succ(a) =>
                    let p: Int = int_mul (ofNat a) y;
                    int_add y p
            }
        case negSucc(a) =>
            // -(a+1) * y = -((a+1) * y)
            int_neg (int_mul (ofNat (succ a)) y)
    }

// === 转换 ===

/// Embed a `Nat` into `Int`.
def int_of_nat(n: Nat): Int = ofNat n

/// Truncate an `Int` to `Nat` (negative values become `zero`).
def nat_of_int(i: Int): Nat =
    match i {
        case ofNat(n) => n
        case negSucc(_) => zero
    }

// === Show ===

/// Render an `Int` in decimal, with a leading `-` for negatives.
def int_to_string(i: Int): String =
    match i {
        case ofNat(n) => nat_to_dec n
        case negSucc(n) => "-" + nat_to_dec (succ n)
    }

impl Show for Int {
    def show: String = int_to_string this
}

impl Neg for Int {
    def - : Int = int_neg this
}

impl Add[Int, Int] for Int {
    def +(that: Int): Int = int_add this that
}

impl Sub[Int, Int] for Int {
    def -(that: Int): Int = int_sub this that
}

impl Mul[Int, Int] for Int {
    def *(that: Int): Int = int_mul this that
}

impl Into[Int] for Nat {
    def into: Int = int_of_nat this
}

impl Into[Nat] for Int {
    def into: Nat = nat_of_int this
}
