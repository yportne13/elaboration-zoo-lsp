// ============================================================
// calc — Lean4 `calc` / Agda `reasoning` style equality chains
//
//   def foo: Eq a d =
//       calc {
//           a = b by p1
//           b = c by p2
//           c = d by p3
//       }
//
// Each step is `<term> = <term> by <proof>`; steps are newline-separated
// (the macro system cannot match `;`). A single-line chain
// `calc a = b by p1 = c by p2` is also accepted.
//
// Expansion is a let chain instead of nested `trans` (repetition
// transcription is flat, so nested parentheses cannot be generated):
//   let _c : Eq (a) (b) = (p1);
//   let _ : Eq (b) (c) = (p2);     -- per-step check of the WRITTEN terms
//   let _c = trans (_c) (p2);
//   let _ : Eq (c) (d) = (p3);
//   let _c = trans (_c) (p3);
//   _c
// The first step's annotated let checks both written ends against the
// proof; every later step gets an annotated check-let that verifies the
// written `$x2 = $z` against the proof `$q` (BOTH ends written out — the
// earlier hole-annotated `Eq _ _ ($z)` left unsolved metas `?x n n`, see
// docs/calc-reasoning-design.md §9.2.1/§9.6), then the trans let composes
// the running chain and forces step continuity (previous right end == next
// left end). The final `_c : Eq a d` is checked against the enclosing
// annotation.
//
// Design notes: see docs/calc-reasoning-design.md. The `by` keyword is a
// dedicated token (TokenKind::ByKeyword): it is not an Op and not an Ident,
// so the expression parser never consumes it, and the `$y: raw` fragment
// stops cleanly right before it. This is what makes the
// `a = b by p1` shape parseable — a Lean-style `:=` would be lexed as an
// infix Op and swallowed by the raw fragment (see docs §4.2).
// ============================================================

#[macro_export]
macro_rules calc {
    // Braced multi-line form: calc { a = b by p1 ... } (steps newline-separated)
    // Each repetition unit starts with the next step's LEFT term, so a
    // newline (skipped by the repetition separator) is followed by an ident
    // and matches; a unit starting with `=` would fail after any newline.
    // The matcher opens with `{` (not `( {`) because the call site is
    // `calc {` — a leading LParen would never match.
    ( { $( $x: raw = $y: raw by $p: raw $( $x2: raw = $z: raw by $q: raw )* )+ } ) => {
        let _c : Eq ($x) ($y) = ($p);
        $( let _ : Eq ($x2) ($z) = ($q);
           let _c = trans (_c) ($q); )*
        _c
    };
    // Single-line form: calc a = b by p1 = c = d by p2
    // (steps chained by `=` — after a step's proof comes `=` then the next
    // step's LEFT term, so the repetition unit must LEAD with `=`; a unit
    // starting with `$x2` would fail on the chain's `=` separator, matching
    // only the first step and dropping the rest)
    ($x: raw = $y: raw by $p: raw $( = $x2: raw = $z: raw by $q: raw )*) => {
        let _c : Eq ($x) ($y) = ($p);
        $( let _ : Eq ($x2) ($z) = ($q);
           let _c = trans (_c) ($q); )*
        _c
    };
}
