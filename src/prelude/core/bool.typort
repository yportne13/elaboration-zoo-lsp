//! The inductive boolean type `Boolean` and boolean/`Nat` predicates.
//!
//! Note: `Boolean` is the *runtime* truth type.  It is distinct from the HDL
//! hardware-signal `Bool` defined in `hdl-types.typort`; see
//! `impl Into[Bool] for Boolean` there (via `bool_to_nat`) to convert.

// Boolean：归纳布尔类型（运行时真值）。
// 与 HDL 的 `Bool`（hdl-types.typort 的硬件信号 struct {name, zz_expr}）不同。
// 转换见 hdl-types.typort: `impl Into[Bool] for Boolean`（bool_to_nat）。
/// The inductive boolean type: logical truth (`true`) and falsity (`false`).
///
/// It is the *runtime* truth type, distinct from the HDL hardware-signal `Bool`
/// (a struct `{name, zz_expr}` in `hdl-types.typort`); `impl Into[Bool] for
/// Boolean` there converts via `bool_to_nat`.  The intrinsic `&&` / `||`
/// methods are registered after the `And` / `Or` instances below.
enum Boolean {
    /// Logical truth.
    true
    /// Logical falsity.
    false
}

impl Boolean {
    def not: Boolean =
        match this {
            case false => true
            case true => false
        }
}

impl Xor[Boolean, Boolean] for Boolean {
    def ^(that: Boolean): Boolean =
        match this {
            case false => that
            case true => that.not
        }
}

impl And[Boolean, Boolean] for Boolean {
    def &(that: Boolean): Boolean =
        match this {
            case false => false
            case true => that
        }
}

impl Or[Boolean, Boolean] for Boolean {
    def |(that: Boolean): Boolean =
        match this {
            case false => that
            case true => true
        }
}

// && / || 按接收者方法名分派（hdl Bool 同款机制）；放在 And/Or 实例之后，
// 方法体里的 & / | 才能在 elaborate 时解析到已注册的实例。
impl Boolean {
    /// Logical AND via the `&&` token; same truth table as `&`.
    def &&(that: Boolean): Boolean = this & that
    /// Logical OR via the `||` token; same truth table as `|`.
    def ||(that: Boolean): Boolean = this | that
}

impl Not for Boolean {
    def ! : Boolean =
        match this {
            case false => true
            case true => false
        }
}

impl Equal[Boolean, Boolean] for Boolean {
    def ===(that: Boolean): Boolean =
        match this {
            case true => that
            case false => that.not
        }
    def =/=(that: Boolean): Boolean =
        match this {
            case true => that.not
            case false => that
        }
}

/// If-then-else as a function: `if_then_else cond t e`.
def if_then_else[A](cond: Boolean, t: A, e: A): A =
    match cond {
        case true => t
        case false => e
    }

/// Decidable equality on `Nat`.
def nat_eq(x: Nat, y: Nat): Boolean =
    match x {
        case zero =>
            match y {
                case zero => true
                case succ(_) => false
            }
        case succ(xs) =>
            match y {
                case zero => false
                case succ(ys) => nat_eq xs ys
            }
    }

/// Strict less-than on `Nat`.
def nat_lt(x: Nat, y: Nat): Boolean =
    match x {
        case zero =>
            match y {
                case zero => false
                case succ(_) => true
            }
        case succ(xs) =>
            match y {
                case zero => false
                case succ(ys) => nat_lt xs ys
            }
    }

/// Less-than-or-equal on `Nat`.
def nat_lte(x: Nat, y: Nat): Boolean =
    match x {
        case zero => true
        case succ(xs) =>
            match y {
                case zero => false
                case succ(ys) => nat_lte xs ys
            }
    }

/// Greater-than on `Nat` (defined as `nat_lt` with arguments swapped).
def nat_gt(x: Nat, y: Nat): Boolean = nat_lt y x

/// Greater-than-or-equal on `Nat`.
def nat_gte(x: Nat, y: Nat): Boolean = nat_lte y x

// `Equal` / `Compare` 的 Nat 实例放在本文件而非 nat.typort：结果类型是
// `Boolean`，而 bool.typort 在 nat.typort 之后加载（op → eq → nat → calc → bool）。
impl Equal[Nat, Boolean] for Nat {
    def ===(that: Nat): Boolean = nat_eq this that
    def =/=(that: Nat): Boolean = (nat_eq this that).not
}

impl Compare[Nat, Boolean] for Nat {
    def <(that: Nat): Boolean = nat_lt this that
    def <=(that: Nat): Boolean = nat_lte this that
    def >(that: Nat): Boolean = nat_gt this that
    def >=(that: Nat): Boolean = nat_gte this that
}

/// True when `n` is even.
def is_even(n: Nat): Boolean =
    match n {
        case zero => true
        case succ(m) =>
            match m {
                case zero => false
                case succ(k) => is_even k
            }
    }

/// True when `n` is odd.
def is_odd(n: Nat): Boolean =
    match n {
        case zero => false
        case succ(m) => is_even m
    }

impl Default for Boolean {
    def default: Boolean = false
}

/// `zero` is false, any successor is true.
def nat_to_bool(n: Nat): Boolean =
    match n {
        case zero => false
        case succ(_) => true
    }

/// `true` is `1`, `false` is `0`.
def bool_to_nat(b: Boolean): Nat =
    match b {
        case true => 1
        case false => 0
    }

/// Boolean implication: `a -> b`.
def implies(a: Boolean, b: Boolean): Boolean =
    match a {
        case true => b
        case false => true
    }

// ---------- 证明层引理 ----------
// 把 Boolean 层的判定（`not`/`!`、`===`、`nat_eq`、`nat_lte`、`nat_lt`）与命题层
// 的 `Eq` 钉在一起：结果形如 `Eq ... true` / `Eq ... false`，用
// `match lem { case refl(a) => a }` 即可取出归一化后的值。

// 注意：不在此处加 `not_not`（`b.not.not = b`）——`examples/theorem_proving.typort`
// 已定义同名引理，prelude 是扁平命名空间，重名会让该 example 报 `redefine`。

/// `!` is an involution: `!(!b) = b`.
def not_not_neg(b: Boolean): Eq (!(!b)) b =
    match b {
        case true => rfl
        case false => rfl
    }

/// `b === b` reduces to `true`: equality is reflexive at the proof level.
def eq_self_true(b: Boolean): Eq (b === b) true =
    match b {
        case true => rfl
        case false => rfl
    }

/// `nat_eq a a` is `true`, by induction on `a`.
def nat_eq_refl(a: Nat): Eq (nat_eq a a) true =
    match a {
        case zero => rfl
        case succ(k) => nat_eq_refl k
    }

/// `nat_lte a a` is `true`, by induction on `a`.
def nat_lte_refl(a: Nat): Eq (nat_lte a a) true =
    match a {
        case zero => rfl
        case succ(k) => nat_lte_refl k
    }

/// `nat_lt a a` is `false` (irreflexivity), by induction on `a`.
def nat_lt_irrefl(a: Nat): Eq (nat_lt a a) false =
    match a {
        case zero => rfl
        case succ(k) => nat_lt_irrefl k
    }

/// `nat_lte a (succ a)` is `true`: `succ` is an upper bound.
def nat_lte_succ(a: Nat): Eq (nat_lte a (succ a)) true =
    match a {
        case zero => rfl
        case succ(k) => nat_lte_succ k
    }

/// `nat_lt a (succ a)` is `true`: `succ` is strictly larger.
def nat_lt_succ(a: Nat): Eq (nat_lt a (succ a)) true =
    match a {
        case zero => rfl
        case succ(k) => nat_lt_succ k
    }

// ---------- Boolean ordering ----------

/// `<` on `Boolean`: `false` is less than `true`.
def bool_lt(a: Boolean, b: Boolean): Boolean =
    match a {
        case false => b
        case true => false
    }

/// `<=` on `Boolean`.
def bool_lte(a: Boolean, b: Boolean): Boolean =
    match a {
        case false => true
        case true => b
    }

/// `>` on `Boolean`, by swapping the arguments of `bool_lt`.
def bool_gt(a: Boolean, b: Boolean): Boolean = bool_lt b a

/// `>=` on `Boolean`, by swapping the arguments of `bool_lte`.
def bool_gte(a: Boolean, b: Boolean): Boolean = bool_lte b a

// `Compare[Boolean, Boolean]`：与 `Compare[Nat, Boolean]` 同构（结果类型也是
// Boolean）。放在上面四个自由函数之后，方法体才能在 elaborate 时解析到它们。
impl Compare[Boolean, Boolean] for Boolean {
    def <(that: Boolean): Boolean = bool_lt this that
    def <=(that: Boolean): Boolean = bool_lte this that
    def >(that: Boolean): Boolean = bool_gt this that
    def >=(that: Boolean): Boolean = bool_gte this that
}
