//! The inductive boolean type `Boolean` and boolean/`Nat` predicates.
//!
//! Note: `Boolean` is the *runtime* truth type.  It is distinct from the HDL
//! hardware-signal `Bool` defined in `hdl-types.typort`; see
//! `impl Into[Bool] for Boolean` there (via `bool_to_nat`) to convert.

// Boolean：归纳布尔类型（运行时真值）。
// 与 HDL 的 `Bool`（hdl-types.typort 的硬件信号 struct {name, zz_expr}）不同。
// 转换见 hdl-types.typort: `impl Into[Bool] for Boolean`（bool_to_nat）。
enum Boolean {
    /// Logical truth.
    true
    /// Logical falsity.
    false
}

impl Boolean {
    def not: Boolean =
        match this {
            case false => true
            case true => false
        }
}

impl Xor[Boolean, Boolean] for Boolean {
    def ^(that: Boolean): Boolean =
        match this {
            case false => that
            case true => that.not
        }
}

impl And[Boolean, Boolean] for Boolean {
    def &(that: Boolean): Boolean =
        match this {
            case false => false
            case true => that
        }
}

impl Or[Boolean, Boolean] for Boolean {
    def |(that: Boolean): Boolean =
        match this {
            case false => that
            case true => true
        }
}

// && / || 按接收者方法名分派（hdl Bool 同款机制）；放在 And/Or 实例之后，
// 方法体里的 & / | 才能在 elaborate 时解析到已注册的实例。
impl Boolean {
    /// Logical AND via the `&&` token; same truth table as `&`.
    def &&(that: Boolean): Boolean = this & that
    /// Logical OR via the `||` token; same truth table as `|`.
    def ||(that: Boolean): Boolean = this | that
}

impl Not for Boolean {
    def ! : Boolean =
        match this {
            case false => true
            case true => false
        }
}

impl Equal[Boolean, Boolean] for Boolean {
    def ===(that: Boolean): Boolean =
        match this {
            case true => that
            case false => that.not
        }
    def =/=(that: Boolean): Boolean =
        match this {
            case true => that.not
            case false => that
        }
}

/// If-then-else as a function: `if_then_else cond t e`.
def if_then_else[A](cond: Boolean, t: A, e: A): A =
    match cond {
        case true => t
        case false => e
    }

/// Decidable equality on `Nat`.
def nat_eq(x: Nat, y: Nat): Boolean =
    match x {
        case zero =>
            match y {
                case zero => true
                case succ(_) => false
            }
        case succ(xs) =>
            match y {
                case zero => false
                case succ(ys) => nat_eq xs ys
            }
    }

/// Strict less-than on `Nat`.
def nat_lt(x: Nat, y: Nat): Boolean =
    match x {
        case zero =>
            match y {
                case zero => false
                case succ(_) => true
            }
        case succ(xs) =>
            match y {
                case zero => false
                case succ(ys) => nat_lt xs ys
            }
    }

/// Less-than-or-equal on `Nat`.
def nat_lte(x: Nat, y: Nat): Boolean =
    match x {
        case zero => true
        case succ(xs) =>
            match y {
                case zero => false
                case succ(ys) => nat_lte xs ys
            }
    }

/// Greater-than on `Nat` (defined as `nat_lt` with arguments swapped).
def nat_gt(x: Nat, y: Nat): Boolean = nat_lt y x

/// Greater-than-or-equal on `Nat`.
def nat_gte(x: Nat, y: Nat): Boolean = nat_lte y x

// `Equal` / `Compare` 的 Nat 实例放在本文件而非 nat.typort：结果类型是
// `Boolean`，而 bool.typort 在 nat.typort 之后加载（op → eq → nat → calc → bool）。
impl Equal[Nat, Boolean] for Nat {
    def ===(that: Nat): Boolean = nat_eq this that
    def =/=(that: Nat): Boolean = (nat_eq this that).not
}

impl Compare[Nat, Boolean] for Nat {
    def <(that: Nat): Boolean = nat_lt this that
    def <=(that: Nat): Boolean = nat_lte this that
    def >(that: Nat): Boolean = nat_gt this that
    def >=(that: Nat): Boolean = nat_gte this that
}

/// True when `n` is even.
def is_even(n: Nat): Boolean =
    match n {
        case zero => true
        case succ(m) =>
            match m {
                case zero => false
                case succ(k) => is_even k
            }
    }

/// True when `n` is odd.
def is_odd(n: Nat): Boolean =
    match n {
        case zero => false
        case succ(m) => is_even m
    }

impl Default for Boolean {
    def default: Boolean = false
}

/// `zero` is false, any successor is true.
def nat_to_bool(n: Nat): Boolean =
    match n {
        case zero => false
        case succ(_) => true
    }

/// `true` is `1`, `false` is `0`.
def bool_to_nat(b: Boolean): Nat =
    match b {
        case true => 1
        case false => 0
    }

/// Boolean implication: `a -> b`.
def implies(a: Boolean, b: Boolean): Boolean =
    match a {
        case true => b
        case false => true
    }
