//! Propositional equality (Martin-Löf identity type) and its combinators.
//!
//! `Eq[A] x y` is the identity type; it has the single constructor `refl`,
//! which proves `Eq a a`.  `rfl` is the convenient proof of `Eq a a` for any
//! `a`, and `cong` / `symm` / `trans` / `subst` are the standard eliminators.

/// The identity type: a proof that `x` and `y` are definitionally equal.
enum Eq[A](x: A, y: A) {
    /// Reflexivity: proves `Eq a a` for any `a`.
    refl(a: A) -> Eq a a
}

/// Reflexivity, with the type arguments inferred: `rfl : Eq a a`.
def rfl[A][a: A]: Eq a a =
    refl a

/// Congruence: equal arguments give equal results under any function.
def cong[A, B, x: A, y: A](f: A -> B, e: Eq x y): Eq (f x) (f y) =
    match e {
        case refl(a) => refl (f a)
    }

/// Symmetry: `Eq x y` implies `Eq y x`.
def symm[A, x: A, y: A](e: Eq[A] x y): Eq[A] y x =
    match e {
        case refl(a) => refl[A] a
    }

/// Transitivity: `Eq x y` and `Eq y z` imply `Eq x z`.
def trans[A, x: A, y: A, z: A](e1: Eq[A] x y, e2: Eq[A] y z): Eq[A] x z =
    match e1 {
        case refl(a) => e2
    }

/// Safe casts: convert `Self` to `U` given a proof `Eq(Self, U)`.
trait Cast[U] {
    /// Cast `this` to `U` using an equality proof.
    def cast(prove: Eq(Self, U)): U
}

impl[T, U] Cast[U] for T {
    def cast(prove: Eq(T, U)): U =
        match prove {
            case refl(a) => this
        }
}

/// Substitution: if `x` equals `y`, a proof of `P x` yields a proof of `P y`.
def subst[A, P: A -> Type 0, x: A, y: A](e: Eq[A] x y, p: P x): P y =
    match e {
        case refl(a) => p
    }

/// `eq_comm` is `symm` under a different name.
def eq_comm[A, x: A, y: A](e: Eq[A] x y): Eq[A] y x = symm e

/// `eq_congr` is `cong` with the function argument last.
def eq_congr[A, B, x: A, y: A, f: A -> B](e: Eq[A] x y): Eq[B] (f x) (f y) = cong f e

/// Two-argument congruence: equal first arguments and equal second arguments
/// give equal results under any two-argument function.
def cong2[A, B, C, x: A, y: A, u: B, v: B](f: A -> B -> C, e1: Eq x y, e2: Eq u v): Eq (f x u) (f y v) =
    match e1 {
        case refl(a) =>
            match e2 {
                case refl(b) => refl (f a b)
            }
    }

/// Congruence of application: equal functions applied to equal arguments give
/// equal results.
def cong_ap[A, B, f: A -> B, g: A -> B, x: A, y: A](e1: Eq f g, e2: Eq x y): Eq (f x) (g y) =
    match e1 {
        case refl(h) =>
            match e2 {
                case refl(a) => refl (h a)
            }
    }

/// Three-step transitivity: `x = y`, `y = z` and `z = w` imply `x = w`.
def trans3[A, x: A, y: A, z: A, w: A](e1: Eq[A] x y, e2: Eq[A] y z, e3: Eq[A] z w): Eq[A] x w =
    trans (trans e1 e2) e3

/// Three-argument congruence: equal arguments give equal results under any
/// three-argument function.  Built from three `cong` steps; the triple nested
/// `match` formulation (cong2-style) does not scale here.
def cong3[A, B, C, D, x: A, y: A, u: B, v: B, p: C, q: C](f: A -> B -> C -> D, e1: Eq x y, e2: Eq u v, e3: Eq p q): Eq (f x u p) (f y v q) =
    trans (trans (cong (z => f z u p) e1) (cong (z => f y z p) e2)) (cong (f y v) e3)

/// Two-argument substitution: `P x u` transports to `P y v` along `x = y` and
/// `u = v`.
///
/// `P` is the first implicit argument and the solver cannot invert it from a
/// bare call, so instantiate the implicit telescope explicitly whenever `P` is
/// not already determined by the expected type:
/// `subst2[Nat, Nat, eqfam, x, y, u, v] e1 e2 p`.
def subst2[A, B, P: A -> B -> Type 0, x: A, y: A, u: B, v: B](e1: Eq[A] x y, e2: Eq[B] u v, p: P x u): P y v =
    match e1 {
        case refl(a) =>
            match e2 {
                case refl(b) => p
            }
    }
