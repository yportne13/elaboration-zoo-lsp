//! The result type `Result[Ok, Err]` and its combinators.

/// Either a success `ok v` or a failure `err e`.
enum Result[Ok, Err] {
    /// A successful value.
    ok(val: Ok)
    /// A failure value.
    err(val: Err)
}

impl[Ok, Err] Result[Ok, Err] {
    /// Whether this is `ok`.
    def is_ok: Boolean =
        match this {
            case ok(_) => true
            case err(_) => false
        }
    /// Whether this is `err`.
    def is_err: Boolean =
        match this {
            case ok(_) => false
            case err(_) => true
        }
    /// Map `f` over the success value, leaving an error untouched.
    def map[U](f: Ok -> U): Result[U, Err] =
        match this {
            case ok(v) => ok(f v)
            case err(e) => err(e)
        }
    /// Map `f` over the error value, leaving a success untouched.
    def map_err[F](f: Err -> F): Result[Ok, F] =
        match this {
            case ok(v) => ok(v)
            case err(e) => err(f e)
        }
    /// The success value, or `default` on error.
    def unwrap_or(default: Ok): Ok =
        match this {
            case ok(v) => v
            case err(_) => default
        }
    /// The success value as an `Option`.
    def ok_to_option: Option[Ok] =
        match this {
            case ok(v) => Some v
            case err(_) => None
        }
    /// The error value as an `Option`.
    def err_to_option: Option[Err] =
        match this {
            case ok(_) => None
            case err(e) => Some e
        }
    /// Monadic bind on the success value.
    def and_then[U](f: Ok -> Result[U, Err]): Result[U, Err] =
        match this {
            case ok(v) => f v
            case err(e) => err(e)
        }
    /// Recover from an error with `f`.
    def or_else[F](f: Err -> Result[Ok, F]): Result[Ok, F] =
        match this {
            case ok(v) => ok(v)
            case err(e) => f e
        }
    /// Map `f` over the success value, falling back to `default` on error.
    def map_or[U](default: U, f: Ok -> U): U =
        match this {
            case ok(v) => f v
            case err(_) => default
        }
    /// Exchange success and failure.
    def swap: Result[Err, Ok] =
        match this {
            case ok(v) => err(v)
            case err(e) => ok(e)
        }
    /// Case analysis: apply `on_ok` to a success value or `on_err` to an error.
    def elim[O](on_ok: Ok -> O, on_err: Err -> O): O =
        match this {
            case ok(v) => on_ok v
            case err(e) => on_err e
        }
}

/// `Some a` becomes `ok a`; `None` becomes `err default_err`.
def option_to_result[A, E](o: Option[A], default_err: E): Result[A, E] =
    match o {
        case Some(a) => ok(a)
        case None => err(default_err)
    }

/// Keep the success value as an `Option`, discarding the error.
def result_to_option[A, E](r: Result[A, E]): Option[A] = r.ok_to_option

// Option 的 `ok_or` 必须住本文件：`Result` 定义在 option.typort 之后，
// option.typort 内部引用不到 `Result`（加载序所迫，与 list.typort 里
// 为 Option/Vec 补 `to_list` 同一先例）。
impl[T] Option[T] {
    /// `Some t` becomes `ok t`; `None` becomes `err e`.
    def ok_or[E](e: E): Result[T, E] =
        match this {
            case Some(t) => ok(t)
            case None => err(e)
        }
}

// 本轮补齐：惰性错误恢复形式（与 unwrap_or / map_or 的立即求值形式互补）。
impl[Ok, Err] Result[Ok, Err] {
    /// The success value, or `f e` on error.
    def unwrap_or_else(f: Err -> Ok): Ok =
        match this {
            case ok(v) => v
            case err(e) => f e
        }
    /// Map the success value, or fall back to `default e` on error.
    def map_or_else[U](default: Err -> U, f: Ok -> U): U =
        match this {
            case ok(v) => f v
            case err(e) => default e
        }
}
