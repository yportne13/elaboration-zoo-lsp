//! The optional-value type `Option[T]` and its combinators.

/// An optional value: either `Some x` or `None`.
enum Option[T] {
    /// A present value.
    Some(t: T)
    /// An absent value.
    None
}

impl[T] Option[T] {
    /// Transform the contained value with `f`, if present.
    def map[U](f: T -> U): Option[U] =
        match this {
            case Some(t) => Some(f(t))
            case None => None
        }
    /// Monadic bind: apply `f` to the contained value, if present.
    def flatmap[U](f: T -> Option[U]): Option[U] =
        match this {
            case Some(t) => f(t)
            case None => None
        }
    /// The contained value, or `default` when `None`.
    def unwrap_or(default: T): T =
        match this {
            case Some(t) => t
            case None => default
        }
    /// Whether this is `Some`.
    def is_some: Boolean =
        match this {
            case Some(_) => true
            case None => false
        }
    /// Whether this is `None`.
    def is_none: Boolean =
        match this {
            case Some(_) => false
            case None => true
        }
    /// `this` when `Some`, otherwise `other`.
    def or_else(other: Option[T]): Option[T] =
        match this {
            case Some(_) => this
            case None => other
        }
    /// Map the contained value, falling back to `default` when `None`.
    def map_or[U](default: U, f: T -> U): U =
        match this {
            case Some(t) => f t
            case None => default
        }
    /// Whether the contained value equals `x` under `eq`.
    def contains(x: T, eq: T -> T -> Boolean): Boolean =
        match this {
            case Some(t) => eq t x
            case None => false
        }
    /// Keep `this` when the contained value satisfies `p`, else `None`.
    def filter(p: T -> Boolean): Option[T] =
        match this {
            case Some(t) =>
                let b = p t;
                match b {
                    case true => this
                    case false => None
                }
            case None => None
        }
}

impl[T] Option[T] {
    /// `other` when this is `Some`, else `None`.
    def and(other: Option[T]): Option[T] =
        match this {
            case Some(_) => other
            case None => None
        }
    /// Pair up the contained values of `this` and `other`.
    def zip[B](other: Option[B]): Option[Product[T, B]] =
        match this {
            case Some(t) =>
                match other {
                    case Some(u) => Some (new Product(t, u))
                    case None => None
                }
            case None => None
        }
}

// 嵌套一层的 impl：flatten 只在元素类型本身是 Option 时才有意义。
impl[T] Option[Option[T]] {
    /// Collapse `Some (Some x)` to `Some x`; `Some None` / `None` become `None`.
    def flatten: Option[T] =
        match this {
            case Some(inner) => inner
            case None => None
        }
}

impl[T] Default for Option[T] {
    def default: Option[T] = None
}

/// `Some x` when `cond` holds, else `None`.
def guard[T](cond: Boolean, x: T): Option[T] =
    match cond {
        case true => Some x
        case false => None
    }

// 本轮补齐：惰性默认值形式（与 unwrap_or / map_or 的立即求值形式互补）。
impl[T] Option[T] {
    /// The contained value, or `f unit` when `None`.
    def unwrap_or_else(f: Unit -> T): T =
        match this {
            case Some(t) => t
            case None => f unit
        }
    /// Map the contained value, or fall back to `default unit` when `None`.
    def map_or_else[U](default: Unit -> U, f: T -> U): U =
        match this {
            case Some(t) => f t
            case None => default unit
        }
}
