//! A three-way comparison result and the `Nat` comparison function.

/// The result of a comparison: less-than, equal or greater-than.
enum Ordering {
    /// The left operand is smaller.
    lt
    /// The operands are equal.
    eq
    /// The left operand is greater.
    gt
}

/// Compare two naturals, returning an `Ordering`.
def nat_compare(x: Nat, y: Nat): Ordering =
    match x {
        case zero =>
            match y {
                case zero => eq
                case succ(_) => lt
            }
        case succ(xs) =>
            match y {
                case zero => gt
                case succ(ys) => nat_compare xs ys
            }
    }

impl Ordering {
    /// Whether this is `lt`.
    def is_lt: Boolean =
        match this {
            case lt => true
            case _ => false
        }
    /// Whether this is `eq`.
    def is_eq: Boolean =
        match this {
            case eq => true
            case _ => false
        }
    /// Whether this is `gt`.
    def is_gt: Boolean =
        match this {
            case gt => true
            case _ => false
        }
    /// The opposite ordering (`lt` becomes `gt` and vice versa).
    def reverse: Ordering =
        match this {
            case lt => gt
            case eq => eq
            case gt => lt
        }
    /// `this` when it already decides, else `f unit`; chains secondary
    /// comparisons (e.g. lexicographic ordering on pairs).
    def then_with(f: Unit -> Ordering): Ordering =
        match this {
            case lt => lt
            case eq => f unit
            case gt => gt
        }
}

// 本轮补齐：由任意比较函数 `p: T -> T -> Ordering` 驱动的三值选择。
// 刻意命名为 ordering_min / ordering_max：hdl-utils.typort 里已有自由函数
// `min` / `max`，prelude 是扁平命名空间，不能占用这两个名字。
/// `a` or `b`, whichever is smaller under `p` (equal keeps `a`).
def ordering_min[T](a: T, b: T, p: T -> T -> Ordering): T =
    match p a b {
        case lt => a
        case eq => a
        case gt => b
    }

/// `a` or `b`, whichever is greater under `p` (equal keeps `a`).
def ordering_max[T](a: T, b: T, p: T -> T -> Ordering): T =
    match p a b {
        case lt => b
        case eq => a
        case gt => a
    }

impl Ordering {
    /// The branch matching `this`: `lt_val` / `eq_val` / `gt_val`.
    def pick[T](lt_val: T, eq_val: T, gt_val: T): T =
        match this {
            case lt => lt_val
            case eq => eq_val
            case gt => gt_val
        }
}
