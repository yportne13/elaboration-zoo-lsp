//! A three-way comparison result and the `Nat` comparison function.

/// The result of a comparison: less-than, equal or greater-than.
enum Ordering {
    /// The left operand is smaller.
    lt
    /// The operands are equal.
    eq
    /// The left operand is greater.
    gt
}

/// Compare two naturals, returning an `Ordering`.
def nat_compare(x: Nat, y: Nat): Ordering =
    match x {
        case zero =>
            match y {
                case zero => eq
                case succ(_) => lt
            }
        case succ(xs) =>
            match y {
                case zero => gt
                case succ(ys) => nat_compare xs ys
            }
    }

impl Ordering {
    /// Whether this is `lt`.
    def is_lt: Boolean =
        match this {
            case lt => true
            case _ => false
        }
    /// Whether this is `eq`.
    def is_eq: Boolean =
        match this {
            case eq => true
            case _ => false
        }
    /// Whether this is `gt`.
    def is_gt: Boolean =
        match this {
            case gt => true
            case _ => false
        }
}
