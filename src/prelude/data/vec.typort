//! Length-indexed vectors (a GADT indexed by `Nat`).

/// A vector of exactly `len` elements of type `A`.
enum Vec[A](len: Nat) {
    /// The empty vector, of length 0.
    nil -> Vec[A] 0
    /// A cons cell: prepending one element raises the length by one.
    cons[l: Nat](x: A, xs: Vec[A] l) -> Vec[A] (l + 1)
}

/// Map `f` over a vector, preserving its length.
def vecmap[T, U, len: Nat](x: Vec[T] len, f: T -> U): Vec[U] len =
    match x {
        case nil => nil
        case cons(x, xs) => cons (f x) (vecmap xs f)
    }

impl[T, len: Nat] Vec[T] len {
    /// Map `f` over the vector, preserving its length.
    def map[U](f: T -> U): Vec[U] len =
        vecmap this f
    /// Left fold: `f (... (f (f z x1) x2) ...) xn` — accumulates from the head.
    /// For `[1, 2, 3]` and `f = a => x => a * 10 + x` the result is `123`.
    def foldl[U](z: U, f: U -> T -> U): U =
        match this {
            case nil => z
            case cons(x, xs) => xs.foldl (f z x) f
        }
    /// Right fold: `f (... (f (f z xn) x_{n-1}) ...) x1` — accumulates from the
    /// tail.  For `[1, 2, 3]` and `f = a => x => a * 10 + x` the result is `321`.
    def fold[U](z: U, f: U -> T -> U): U =
        match this {
            case nil => z
            case cons(x, xs) => f (xs.fold z f) x
        }
    /// The first element, if any.
    def head_option: Option[T] =
        match this {
            case nil => None
            case cons(x, _) => Some x
        }
    /// Whether every element satisfies `p`.
    def all(p: T -> Boolean): Boolean =
        match this {
            case nil => true
            case cons(a, xs) =>
                let b = p a;
                match b {
                    case true => xs.all p
                    case false => false
                }
        }
    /// Whether some element satisfies `p`.
    def any(p: T -> Boolean): Boolean =
        match this {
            case nil => false
            case cons(a, xs) =>
                let b = p a;
                match b {
                    case true => true
                    case false => xs.any p
                }
        }
    /// The first element satisfying `p`, if any.
    def find(p: T -> Boolean): Option[T] =
        match this {
            case nil => None
            case cons(a, xs) =>
                let b = p a;
                match b {
                    case true => Some a
                    case false => xs.find p
                }
        }
    /// Whether some element equals `x` under `eq`.
    def elem(x: T, eq: T -> T -> Boolean): Boolean =
        match this {
            case nil => false
            case cons(a, xs) =>
                let b = eq a x;
                match b {
                    case true => true
                    case false => xs.elem (x, eq)
                }
        }
    /// The element at index `n`, or `default` when out of range.
    def at(n: Nat, default: T): T =
        match n {
            case zero =>
                match this {
                    case nil => default
                    case cons(x, _) => x
                }
            case succ(m) =>
                match this {
                    case nil => default
                    case cons(_, xs) => xs.at (m, default)
                }
        }
    /// Concatenate `that` after `this`, summing the lengths.
    // 结果索引必须写成 `m + len` 且对 this 递归，语义才是 `this ++ that`
    //（与 List.append 一致）：nat_add 按第二参数递归，`m + 0` 可约回 m、
    // `m + succ l` 可约成 `succ (m + l)`，两个分支都定义性归约；若写成
    // `len + m`，对 this 递归时 nil 分支的 `0 + m` 卡死，只能对 that 递归，
    // 而那会把参数顺序翻到前面（`that ++ this`），连带 snoc/reverse 语义全错。
    def append[m: Nat](that: Vec[T] m): Vec[T] (m + len) =
        match this {
            case nil => that
            case cons(x, xs) => cons x (xs.append that)
        }
    /// Append a single element at the end, growing the length by one.
    def snoc(x: T): Vec[T] (len + 1) =
        match this {
            case nil => cons x nil
            case cons(y, ys) => cons y (ys.snoc x)
        }
    /// The vector in reverse order.
    def reverse: Vec[T] len =
        match this {
            case nil => nil
            case cons(x, xs) => (xs.reverse).snoc x
        }
    /// Combine two equal-length vectors elementwise with `f`.
    // 内层 match 只写 cons 分支即可：进入外层 cons 分支后 len 已细化为
    // succ l，other : Vec[U] (succ l) 不可能是 nil。
    def map2[U, V](other: Vec[U] len, f: T -> U -> V): Vec[V] len =
        match this {
            case nil => nil
            case cons(x, xs) =>
                match other {
                    case cons(y, ys) => cons (f x y) (xs.map2 ys f)
                }
        }
    /// Pair each element with the corresponding element of `other`.
    def zip[U](other: Vec[U] len): Vec[Product[T, U]] len =
        match this {
            case nil => nil
            case cons(x, xs) =>
                match other {
                    case cons(y, ys) => cons (new Product(x, y)) (xs.zip ys)
                }
        }
}

impl[T, len: Nat] Vec[T](succ len) {
    /// The first element of a non-empty vector.
    def head: T =
        match this {
            case cons(x, _) => x
        }
    /// The tail of a non-empty vector (`len` elements).
    def tail: Vec[T] len =
        match this {
            case cons(_, xs) => xs
        }
    /// Right fold using the first element as the initial accumulator
    /// (equivalent to `this.fold this.head f`).  It accumulates from the tail:
    /// for `[1, 2, 3]` and `f = a => x => a * 10 + x` the result is `132`.
    def reduce(f: T -> T -> T): T =
        match this {
            case cons(x, xs) => xs.fold x f
        }
}

/// Prepend an element to a vector: `x :: xs`.
trait Cons {
    /// Cons `x` onto `that`, growing the length by one.
    def ::[l: Nat](that: Vec[Self] l): Vec[Self] (l + 1)
}

impl[T] Cons for T {
    def ::[l: Nat](that: Vec[T] l): Vec[T] (l + 1) =
        cons this that
}

// 本轮补齐（本文件引用不到 List，故只用 Option）。
/// A vector of `n` copies of `x`; the index grows with the recursion, which
/// relies on `m + 1` reducing definitionally to `succ m`.
def vec_replicate[T](n: Nat, x: T): Vec[T] n =
    match n {
        case zero => nil
        case succ(m) => cons x (vec_replicate m x)
    }

/// The last element of a vector, if any (`len = 0` gives `None`).
def vec_last_option[T, len: Nat](x: Vec[T] len): Option[T] =
    match x {
        case nil => None
        case cons(y, nil) => Some y
        case cons(_, ys) => vec_last_option ys
    }
