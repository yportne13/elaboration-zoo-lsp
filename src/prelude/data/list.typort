//! Immutable singly-linked lists.
//!
//! The constructors use the `l`-prefix (`lnil` / `lcons`) because the
//! `Vec` GADT already occupies the `nil` / `cons` names.

// List：不可变链表。
// 构造器用 lnil/lcons 前缀 —— 因 Vec 的 GADT 构造器已占用 nil/cons 名。
/// An immutable singly-linked list of `T`.
enum List[T] {
    /// The empty list.
    lnil
    /// A cons cell: `head` followed by `tail`.
    lcons(head: T, tail: List[T])
}

impl[T] List[T] {
    /// Map `f` over every element.
    def map[U](f: T -> U): List[U] =
        match this {
            case lnil => lnil
            case lcons(x, xs) => lcons(f x, xs.map f)
        }
    /// The number of elements.
    def length: Nat =
        match this {
            case lnil => 0
            case lcons(_, xs) => 1 + xs.length
        }
    /// Concatenate `that` after `this`.
    def append(that: List[T]): List[T] =
        match this {
            case lnil => that
            case lcons(x, xs) => lcons(x, xs.append that)
        }
    /// `Some` of the first element, or `None` when empty.
    def head_option: Option[T] =
        match this {
            case lnil => None
            case lcons(x, _) => Some x
        }
    /// The list in reverse order.
    def reverse: List[T] =
        match this {
            case lnil => lnil
            case lcons(x, xs) => xs.reverse.append (lcons x lnil)
        }
}

impl[T] List[T] {
    /// Pair each element with the corresponding element of `other`, stopping
    /// at the shorter list.
    def zip[B](other: List[B]): List[Product[T, B]] =
        match this {
            case lnil => lnil
            case lcons(x, xs) =>
                match other {
                    case lnil => lnil
                    case lcons(y, ys) => lcons(new Product(x, y), xs.zip ys)
                }
        }
    /// The first element satisfying `p`, if any.
    def find(p: T -> Boolean): Option[T] =
        match this {
            case lnil => None
            case lcons(x, xs) =>
                let b = p x;
                match b {
                    case true => Some x
                    case false => xs.find p
                }
        }
    /// The first `n` elements (fewer when the list is shorter).
    def take(n: Nat): List[T] =
        match n {
            case zero => lnil
            case succ(m) =>
                match this {
                    case lnil => lnil
                    case lcons(x, xs) => lcons(x, xs.take m)
                }
        }
    /// `this` without its first `n` elements.
    def drop(n: Nat): List[T] =
        match n {
            case zero => this
            case succ(m) =>
                match this {
                    case lnil => lnil
                    case lcons(_, xs) => xs.drop m
                }
        }
    /// The elements satisfying `p`.
    def filter(p: T -> Boolean): List[T] =
        match this {
            case lnil => lnil
            case lcons(x, xs) =>
                let b = p x;
                match b {
                    case true => lcons(x, xs.filter p)
                    case false => xs.filter p
                }
        }
    /// Whether every element satisfies `p`.
    def all(p: T -> Boolean): Boolean =
        match this {
            case lnil => true
            case lcons(x, xs) =>
                let b = p x;
                match b {
                    case true => xs.all p
                    case false => false
                }
        }
    /// Whether some element satisfies `p`.
    def any(p: T -> Boolean): Boolean =
        match this {
            case lnil => false
            case lcons(x, xs) =>
                let b = p x;
                match b {
                    case true => true
                    case false => xs.any p
                }
        }
}

impl[T] Default for List[T] {
    def default: List[T] = lnil
}

/// The list without its head, if non-empty.
def list_tail_option[T](l: List[T]): Option[List[T]] =
    match l {
        case lnil => None
        case lcons(_, xs) => Some xs
    }

/// The list without its last element, if non-empty.
def list_init[T](l: List[T]): Option[List[T]] =
    match l {
        case lnil => None
        case lcons(_, lnil) => Some lnil
        case lcons(x, xs) =>
            let rest = list_init xs;
            match rest {
                case Some(xs_init) => Some (lcons x xs_init)
                case None => Some lnil
            }
    }

/// The last element, if any.
def list_last[T](l: List[T]): Option[T] =
    match l {
        case lnil => None
        case lcons(x, lnil) => Some x
        case lcons(_, xs) => list_last xs
    }

/// Concatenate a list of lists.
def list_flatten[T](l: List[List[T]]): List[T] =
    match l {
        case lnil => lnil
        case lcons(x, xs) => x.append (list_flatten xs)
    }

/// Map `f` over `l` and concatenate the results.
def list_concat_map[T, U](f: T -> List[U], l: List[T]): List[U] =
    list_flatten (l.map f)

/// `[0, 1, ..., n-1]`.
def range(n: Nat): List[Nat] =
    match n {
        case zero => lnil
        case succ(m) => (range m).append (lcons m lnil)
    }

/// A one-element list.
def list_singleton[T](x: T): List[T] = lcons x lnil

/// The first element, if any.
def list_head[T](l: List[T]): Option[T] = l.head_option

/// Whether the list is empty.
def list_is_empty[T](l: List[T]): Boolean =
    match l {
        case lnil => true
        case lcons(_, _) => false
    }

/// Free-function form of `List.map`.
def list_map[T, U](f: T -> U, l: List[T]): List[U] = l.map f

/// Free-function form of `List.append`.
def list_append[T](l: List[T], r: List[T]): List[T] = l.append r

/// Free-function form of `List.reverse`.
def list_reverse[T](l: List[T]): List[T] = l.reverse

/// Free-function form of `List.length`.
def list_length[T](l: List[T]): Nat = l.length

impl[T] List[T] {
    /// Right fold: `f x1 (f x2 (... (f xn z)))`.
    def foldr[U](f: T -> U -> U, z: U): U =
        match this {
            case lnil => z
            case lcons(x, xs) => f x (xs.foldr f z)
        }
    /// Left fold: `f (... (f z x1) x2 ...) xn`.
    def foldl[U](z: U, f: U -> T -> U): U =
        match this {
            case lnil => z
            case lcons(x, xs) => xs.foldl (f z x) f
        }
    /// Whether `x` occurs in the list, compared with `eq`.
    def elem(x: T, eq: T -> T -> Boolean): Boolean =
        match this {
            case lnil => false
            case lcons(y, ys) =>
                let b = eq y x;
                match b {
                    case true => true
                    case false => ys.elem x eq
                }
        }
    /// Combine corresponding elements of `this` and `other` with `f`,
    /// stopping at the shorter list.
    def zip_with[B, C](f: T -> B -> C, other: List[B]): List[C] =
        match this {
            case lnil => lnil
            case lcons(x, xs) =>
                match other {
                    case lnil => lnil
                    case lcons(y, ys) => lcons(f x y, xs.zip_with f ys)
                }
        }
    /// The number of elements satisfying `p`.
    def count(p: T -> Boolean): Nat =
        match this {
            case lnil => 0
            case lcons(x, xs) =>
                let b = p x;
                match b {
                    case true => succ (xs.count p)
                    case false => xs.count p
                }
        }
    /// The longest prefix of elements satisfying `p`.
    def take_while(p: T -> Boolean): List[T] =
        match this {
            case lnil => lnil
            case lcons(x, xs) =>
                let b = p x;
                match b {
                    case true => lcons(x, xs.take_while p)
                    case false => lnil
                }
        }
    /// `this` with the longest satisfying prefix removed.
    def drop_while(p: T -> Boolean): List[T] =
        match this {
            case lnil => lnil
            case lcons(x, xs) =>
                let b = p x;
                match b {
                    case true => xs.drop_while p
                    case false => this
                }
        }
    /// The last element, if any.
    def last_option: Option[T] = list_last this
    /// Split at index `n`: the first `n` elements paired with the rest.
    def split_at(n: Nat): Product[List[T], List[T]] =
        new Product(this.take n, this.drop n)
    /// Map `f` over every element and concatenate the resulting lists.
    def flat_map[U](f: T -> List[U]): List[U] = list_flatten (this.map f)
    /// Insert `x` into `this`, which must already be sorted by `p`.
    // 稳定插入：相等（eq）时 x 落在已有元素之后。
    def insert(x: T, p: T -> T -> Ordering): List[T] =
        match this {
            case lnil => lcons x lnil
            case lcons(y, ys) =>
                let c = p x y;
                match c {
                    case gt => lcons(y, ys.insert x p)
                    case lt => lcons(x, lcons(y, ys))
                    case eq => lcons(x, lcons(y, ys))
                }
        }
    /// Insertion sort ordered by `p` (stable).
    def sort(p: T -> T -> Ordering): List[T] =
        match this {
            case lnil => lnil
            case lcons(x, xs) => (xs.sort p).insert x p
        }
}

// 以下 impl 放在本文件末尾的原因：
// - Option/Vec 都定义在 list 之前，拿不到 List，其 to_list 只能在这里补
//   （参照 string.typort 为更早的 Boolean 补 Into impl 的先例）；
// - List[List[T]] / List[Product[T, B]] / List[Nat] 是嵌套/实例化类型，
//   只能在元素类型已知处递归定义。
impl[T] List[List[T]] {
    /// Concatenate a list of lists (method form of `list_flatten`).
    def concat: List[T] = list_flatten this
}

impl[T, B] List[Product[T, B]] {
    /// Split a list of pairs into a pair of lists.
    def unzip: Product[List[T], List[B]] =
        match this {
            case lnil => new Product(lnil, lnil)
            case lcons(p, rest) =>
                let tail_unzip = rest.unzip;
                new Product(lcons(p.fst, tail_unzip.fst), lcons(p.snd, tail_unzip.snd))
        }
}

impl List[Nat] {
    /// The sum of a list of naturals (`0` for the empty list).
    def sum: Nat =
        match this {
            case lnil => 0
            case lcons(x, xs) => x + xs.sum
        }
}

impl[T] Option[T] {
    /// Convert to a list: `Some x` becomes the singleton `[x]`.
    def to_list: List[T] =
        match this {
            case Some(x) => lcons x lnil
            case None => lnil
        }
}

impl[T, len: Nat] Vec[T] len {
    /// Convert a length-indexed vector to a plain list.
    def to_list: List[T] =
        match this {
            case nil => lnil
            case cons(x, xs) => lcons(x, xs.to_list)
        }
}

/// `x` repeated `n` times.
def list_replicate[T](n: Nat, x: T): List[T] =
    match n {
        case zero => lnil
        case succ(m) => lcons(x, list_replicate m x)
    }
