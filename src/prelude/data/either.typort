//! The sum type `Either[A, B]` and its conversions to `Option` / `Result`.

/// A value that is either `left a` or `right b`.
enum Either[A, B] {
    /// A left value.
    left(a: A)
    /// A right value.
    right(b: B)
}

impl[A, B] Either[A, B] {
    /// Whether this is a `left`.
    def is_left: Boolean =
        match this {
            case left(_) => true
            case right(_) => false
        }
    /// Whether this is a `right`.
    def is_right: Boolean =
        match this {
            case left(_) => false
            case right(_) => true
        }
    /// Exchange `left` and `right`.
    def swap: Either[B, A] =
        match this {
            case left(a) => right(a)
            case right(b) => left(b)
        }
    /// Map `f` over the left value, if any.
    def map_left[C](f: A -> C): Either[C, B] =
        match this {
            case left(a) => left(f a)
            case right(b) => right(b)
        }
    /// Map `f` over the right value, if any.
    def map_right[C](f: B -> C): Either[A, C] =
        match this {
            case left(a) => left(a)
            case right(b) => right(f b)
        }
    /// Case analysis: apply `f` to a left value or `g` to a right value.
    def elim[O](f: A -> O, g: B -> O): O =
        match this {
            case left(a) => f a
            case right(b) => g b
        }
}

/// Free-function form of `Either.swap`.
def either_swap[A, B](e: Either[A, B]): Either[B, A] = e.swap

/// Keep the right value as an `Option`, discarding a left value.
def either_to_option[A, B](e: Either[A, B]): Option[B] =
    match e {
        case left(_) => None
        case right(b) => Some b
    }

/// `Result` to `Either` (err becomes left, ok becomes right).
def result_to_either[Ok, Err](r: Result[Ok, Err]): Either[Err, Ok] =
    match r {
        case ok(v) => right(v)
        case err(e) => left(e)
    }

/// `Either` to `Result` (left becomes err, right becomes ok).
def either_to_result[A, B](e: Either[A, B]): Result[B, A] =
    match e {
        case left(a) => err(a)
        case right(b) => ok(b)
    }

impl[A, B] Either[A, B] {
    // Err-first 约定，与 either_to_result 一致：left = err，right = ok。
    /// Convert to `Result`, mapping the left value through `f` into the error.
    def to_result[Err](f: A -> Err): Result[B, Err] =
        match this {
            case left(a) => err(f a)
            case right(b) => ok(b)
        }
    /// Map `f` over the left value and `g` over the right value.
    def bimap[C, D](f: A -> C, g: B -> D): Either[C, D] =
        match this {
            case left(a) => left(f a)
            case right(b) => right(g b)
        }
    /// The left value as an `Option`, discarding a right value.
    def left_to_option: Option[A] =
        match this {
            case left(a) => Some a
            case right(_) => None
        }
}

// 补齐转换格：option_to_result / either_to_option / result_to_either /
// either_to_result 已有，唯缺 Option -> Either。
/// `Some b` becomes `right b`; `None` becomes `left if_none`.
def option_to_either[A, B](o: Option[B], if_none: A): Either[A, B] =
    match o {
        case Some(b) => right b
        case None => left if_none
    }

// 本轮补齐：转换格最后缺的一个方法形态方向（left_to_option 的镜像）。
impl[A, B] Either[A, B] {
    /// The right value as an `Option`, discarding a left value.
    def right_to_option: Option[B] =
        match this {
            case left(_) => None
            case right(b) => Some b
        }
}

/// Free-function form of `Either.right_to_option`.
def either_right_to_option[A, B](e: Either[A, B]): Option[B] = e.right_to_option
