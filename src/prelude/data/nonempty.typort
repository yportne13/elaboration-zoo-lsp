//! A list guaranteed to contain at least one element.

/// A non-empty list: a mandatory `head` plus a (possibly empty) `tail`.
struct NonEmpty[T] {
    /// The first element.
    head: T
    /// The remaining elements.
    tail: List[T]
}

impl[T] NonEmpty[T] {
    /// View as a plain `List`.
    def to_list: List[T] = lcons this.head this.tail
    /// Map `f` over every element.
    def map[U](f: T -> U): NonEmpty[U] =
        new NonEmpty(f this.head, this.tail.map f)
    /// The first element as an `Option` (always `Some`).
    def head_option: Option[T] = Some this.head
    /// The number of elements (at least one).
    def length: Nat = 1 + this.tail.length
    /// The last element.
    def last: T =
        match this.tail {
            case lnil => this.head
            case lcons(x, xs) =>
                let rest: NonEmpty[T] = new NonEmpty(x, xs);
                rest.last
        }
    /// The elements in reverse order.
    def reverse: NonEmpty[T] =
        match this.tail {
            case lnil => this
            case lcons(x, xs) =>
                let reversed_rest: NonEmpty[T] = (new NonEmpty(x, xs)).reverse;
                new NonEmpty(reversed_rest.head, (reversed_rest.tail).append (lcons this.head lnil))
        }
    /// Prepend `x`, keeping the list non-empty.
    def cons(x: T): NonEmpty[T] = new NonEmpty(x, this.to_list)
    /// Append another non-empty list at the end.
    def append(that: NonEmpty[T]): NonEmpty[T] =
        new NonEmpty(this.head, this.tail.append that.to_list)
    /// Left fold with initial accumulator `z`.
    def foldl[U](z: U, f: U -> T -> U): U =
        this.tail.foldl (f z this.head) f
}

/// A single-element non-empty list.
def nonempty_singleton[T](x: T): NonEmpty[T] = new NonEmpty(x, lnil)

// 本轮补齐：右折叠 / 查找 / 从普通 List 构造（本文件可引用 List，
// List 在 nonempty 之前加载）。
impl[T] NonEmpty[T] {
    /// Right fold over every element: `f x1 (f x2 (... (f xn z)))`.
    def foldr[U](f: T -> U -> U, z: U): U =
        this.to_list.foldr f z
    /// The first element satisfying `p`, if any.
    def find(p: T -> Boolean): Option[T] =
        this.to_list.find p
}

/// `Some` of the same elements when `l` is non-empty, else `None`.
def nonempty_from_list[T](l: List[T]): Option[NonEmpty[T]] =
    match l {
        case lnil => None
        case lcons(x, xs) => Some (new NonEmpty(x, xs))
    }
