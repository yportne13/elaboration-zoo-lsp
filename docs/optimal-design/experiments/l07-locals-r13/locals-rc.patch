-            close_ty(*mcl, Tm::Let(x, Box::new(a), Box::new(t), Box::new(b)))
+        Locals::Bind(mcl, x, a) => {
+            close_ty(mcl.as_ref().clone(), Tm::Pi(x, Icit::Expl, Box::new(a), Box::new(b)))
         }
+        Locals::Define(mcl, x, a, t) => close_ty(
+            mcl.as_ref().clone(),
+            Tm::Let(x, Box::new(a), Box::new(t), Box::new(b)),
+        ),
     }
 }
