+#[derive(Debug)]
+struct SubEntry {
+    lvl: Lvl,
+    /// 解的原始值。不预先包裹"更新的解"——读取时 `lookup_hit` 把整条 σ
+    /// 包在外面（条件包裹），由 force 在读点一次性推开。
+    val: Val,
+    next: Option<Rc<SubEntry>>,
