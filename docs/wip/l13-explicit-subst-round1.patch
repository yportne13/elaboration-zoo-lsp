+/// 把替换 `σ` 推进值 `v` 的结构（dpm-nbe `frcS`；参考版 `Infer::frcs` 的
+/// 快版对应）。槽位纪律：σ 对 spine / Sum/SumCase 槽只**包裹**，绝不推进
+/// 物化——槽位引用是作用域事实，物化会破坏后续 solve 的 invert。
+#[allow(clippy::too_many_arguments)]
+fn frcs<'a>(
+    bump: &'a Bump,
+    spine: &mut Spine,
+    defs: &mut Vec<V>,
+    metas: &[MetaEntry],
+    decl: &Decls<'a>,
+    mutable: &RefCell<Mutable>,
+    sub: &Rc<SubstV>,
+    v0: V,
+) -> V {
+    if sub.is_empty() {
+        return force(bump, spine, defs, metas, decl, mutable, v0);
+    }
+    let mut work: Vec<W<'a>> = Vec::new();
+    let mut vals: Vec<V> = Vec::new();
+    let mut icits: Vec<Icit> = Vec::new();
+    match v_tag(v0) {
+        // 内层先应用、外层后应用：组合后一次推进（frcS (subst sb sb') v）
+        7 => match v_xcell_of(v0) {
+            XCell::VSub { val, sub: sub2 } => {
+                let composed = SubstV::compose(sub, sub2);
+                frcs(bump, spine, defs, metas, decl, mutable, &composed, *val)
+            }
+            // Sum/SumCase 槽位只**包裹**不推进（保 invert 可逆）。
+            XCell::Sum { name, params, cases, is_trait } => {
+                let ps: Vec<SumParamV<'_>> = params
+                    .iter()
+                    .map(|p| SumParamV {
+                        name: p.name,
+                        val: wrap_sub(bump, sub, p.val),
+                        ty: wrap_sub(bump, sub, p.ty),
+                        icit: p.icit,
+                    })
+                    .collect();
+                v_xcell(bump.alloc(XCell::Sum {
+                    name,
+                    params: bump.alloc_slice_fill_iter(ps),
+                    cases,
+                    is_trait: *is_trait,
+                }))
+            }
+            XCell::SumCase { typ, index, datas, is_trait } => {
+                let ds: Vec<SumDataV<'_>> = datas
+                    .iter()
+                    .map(|d| SumDataV {
+                        name: d.name,
+                        val: wrap_sub(bump, sub, d.val),
+                        icit: d.icit,
+                    })
+                    .collect();
+                v_xcell(bump.alloc(XCell::SumCase {
+                    typ: wrap_sub(bump, sub, *typ),
+                    index: *index,
+                    datas: bump.alloc_slice_fill_iter(ds),
+                    is_trait: *is_trait,
+                }))
+            }
+            XCell::Lit(_) | XCell::Nat(_) => v0,
+            // 裸 Decl 无 spine 槽可包裹；交回 force 走 prim / 卡住臂
+            XCell::Decl { .. } => force(bump, spine, defs, metas, decl, mutable, v0),
+            XCell::Obj { val, name } => {
+                let inner = frcs(bump, spine, defs, metas, decl, mutable, sub, *val);
+                force(
+                    bump,
+                    spine,
+                    defs,
+                    metas,
+                    decl,
+                    mutable,
+                    v_xcell(bump.alloc(XCell::Obj { val: inner, name })),
+                )
+            }
+            // 内联调用值：实质参槽只包裹；体推进（体是值，读点可展开）
+            XCell::Call { name, args, body } => {
+                let new_args: Vec<(V, Icit)> = args
+                    .iter()
+                    .map(|(a, i)| (wrap_sub(bump, sub, *a), *i))
+                    .collect();
+                let nb = frcs(bump, spine, defs, metas, decl, mutable, sub, *body);
+                force(
+                    bump,
+                    spine,
+                    defs,
+                    metas,
+                    decl,
+                    mutable,
+                    v_xcell(bump.alloc(XCell::Call {
+                        name,
+                        args: bump.alloc_slice_fill_iter(new_args),
+                        body: nb,
+                    })),
+                )
+            }
+            // scrutinee **推进**（分支重选需要解出的构造子值）；捕获 env 只
+            // 包裹。交回 force：unify / eval 的 Match 臂按同一纪律重选分支。
+            XCell::Match { scrutinee, env, cases } => {
+                let s2 = frcs(bump, spine, defs, metas, decl, mutable, sub, *scrutinee);
+                let env2 = frcs_env(bump, defs, sub, &env);
+                force(
+                    bump,
+                    spine,
+                    defs,
+                    metas,
+                    decl,
+                    mutable,
+                    v_xcell(bump.alloc(XCell::Match {
+                        scrutinee: s2,
+                        env: env2,
+                        cases,
+                    })),
+                )
+            }
+        },
+        // 裸 Rigid 的读点：lookup 命中（真正的精化传播）烧 1 fuel；fuel
+        // 耗尽按未解处理（返回裸 rigid）。未命中零成本直通。
+        0 => match SubstV::lookup_hit(bump, spine, defs, sub, v_lvl_of(v0)) {
+            Some(hit) => {
+                if !burn() {
+                    return v0;
+                }
+                force(bump, spine, defs, metas, decl, mutable, hit)
+            }
+            None => v0,
+        },
+        // spine 链分派：Rigid 头 = 解析应用（对齐 dpm-nbe 的
+        // `napp (lookupSub sb v) (frcS sb sp)`）；Flex/Decl/Obj 头 = 槽位只
+        // 包裹，重建链后交回 force。
+        2 => {
+            let h = v_spine_of(v0);
+            let hd = spine.spine_head(h);
+            if v_tag(hd) == 0 {
+                let x = v_lvl_of(hd);
+                let mut head = match SubstV::lookup_hit(bump, spine, defs, sub, x) {
+                    Some(hit) => {
+                        if !burn() {
+                            return v0;
+                        }
+                        force(bump, spine, defs, metas, decl, mutable, hit)
+                    }
+                    None => v_lvl(x),
+                };
+                if !vapp_ok(head) {
+                    return v0;
+                }
+                let mut args: Vec<(V, Icit)> = Vec::new();
+                spine.collect_args(h, &mut args);
