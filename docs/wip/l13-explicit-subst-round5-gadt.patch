+    /// 链长即稳定，不会无界增长。
+    pub(crate) fn compose(outer: &Rc<Subst>, inner: &Rc<Subst>) -> Rc<Subst> {
+        // 恒等快路径：同一 σ 自我组合（读点反复 compose 自己——重建风暴里
+        // 最常见的形态）原指针返回，杜绝"每次 compose 新分配一个内容相同
+        // 的 Subst"导致的 σ 对象洪水（calc 路径实测慢路径见 9.8e5 个不同
+        // σ 指针，全是这样长出来的）。
+        if Rc::ptr_eq(outer, inner) {
