+            entry: &Option<Rc<SubEntry>>,
+            onto: Option<Rc<SubEntry>>,
+            outer: &Option<Rc<SubEntry>>,
+        ) -> Option<Rc<SubEntry>> {
+            match entry {
+                None => onto,
+                Some(e) => {
+                    if has_outer(outer, e.lvl) {
+                        cons_all(&e.next, onto, outer)
+                    } else {
+                        Some(Rc::new(SubEntry {
+                            lvl: e.lvl,
+                            val: e.val.clone(),
+                            next: cons_all(&e.next, onto, outer),
+                        }))
+                    }
+                }
+            }
+        }
+        Rc::new(Subst {
+            head: cons_all(&inner.head, outer.head.clone(), &outer.head),
+        })
+    }
