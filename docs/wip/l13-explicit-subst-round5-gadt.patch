+/// 能吃新实参。字面量 / U / Π / Sum / SumCase 与实参相遇时无从应用。
+pub(crate) fn v_applicable(v: &Val) -> bool {
+    matches!(
+        v,
+        Val::Lam(..)
+            | Val::Flex(..)
+            | Val::Rigid(..)
+            | Val::Decl(..)
+            | Val::Obj(..)
+            | Val::VSub(..)
+            | Val::Call(..)
+            | Val::Match(..)
+    )
