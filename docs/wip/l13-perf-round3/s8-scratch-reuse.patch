+/// CallAsm 臂实参求值草稿栈池（S8 内存轮）：原为每个 CallAsm 工作项现开
+/// `argv/w2/v2/i2` 四个小 Vec（首块 cap 4，S3 逐点栈定位的分配源之一）。
+/// LIFO 借还，池热后零分配；纪律与论证同 `quote::quote_sub_take/put`
+/// （取时 clear、还栈前 clear ⇒ 池内条目恒空；`W<'a>` 带生命周期 ⇒ 用
+/// `'static` 代存，`V`/`Icit`/`(V, Icit)` 无生命周期参数，直接存放）。
+thread_local! {
+    static EVAL_SUB_POOL: RefCell<Vec<(Vec<W<'static>>, Vec<V>, Vec<Icit>, Vec<(V, Icit)>)>> =
+        RefCell::new(Vec::new());
+}
+
+/// 池长上限（= 同时在飞的嵌套 eval 深度高水位）。
+const EVAL_SUB_POOL_MAX: usize = 64;
+/// 单条容量上限（元素数）：超过即丢弃，不常驻大缓冲。
+const EVAL_SUB_CAP_MAX: usize = 1024;
+
+/// 借一组 CallAsm 草稿栈（LIFO；池空 ⇒ 全空 Vec，语义同原 `Vec::new()`）。
+fn eval_sub_take<'a>() -> (Vec<W<'a>>, Vec<V>, Vec<Icit>, Vec<(V, Icit)>) {
+    let (mut w, mut v, mut i, mut argv) = EVAL_SUB_POOL
+        .with(|p| p.borrow_mut().pop())
+        .unwrap_or_default();
+    w.clear();
+    v.clear();
+    i.clear();
+    argv.clear();
+    // SAFETY：'static 仅是**存放**口径——池内条目在还栈前与取栈后都 clear，
+    // 池里只有容量、没有任何 `'a` 值；`W<'a>` 与 `W<'static>` 布局逐位相同。
+    unsafe { (std::mem::transmute::<Vec<W<'static>>, Vec<W<'a>>>(w), v, i, argv) }
+}
+
+/// 归还一组 CallAsm 草稿栈（先 clear 再入池）。
+fn eval_sub_put<'a>(
+    mut w: Vec<W<'a>>,
+    mut v: Vec<V>,
+    mut i: Vec<Icit>,
+    mut argv: Vec<(V, Icit)>,
+) {
+    w.clear();
+    v.clear();
+    i.clear();
+    argv.clear();
+    if w.capacity() > EVAL_SUB_CAP_MAX
+        || v.capacity() > EVAL_SUB_CAP_MAX
+        || i.capacity() > EVAL_SUB_CAP_MAX
+        || argv.capacity() > EVAL_SUB_CAP_MAX
+    {
+        return;
+    }
+    EVAL_SUB_POOL.with(|p| {
+        let mut p = p.borrow_mut();
+        if p.len() < EVAL_SUB_POOL_MAX {
+            // SAFETY：同上——条目此刻为空，池里不留 `'a` 引用。
+            p.push(unsafe {
+                (
+                    std::mem::transmute::<Vec<W<'a>>, Vec<W<'static>>>(w),
+                    v,
+                    i,
+                    argv,
+                )
+            });
+        }
+    });
+}
