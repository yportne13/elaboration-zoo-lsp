+/// 嵌套 quote 草稿栈池（S8 内存轮；S3 逐点栈定位的头号分配源）：quote.rs 的
+/// 三个嵌套调用点（Nat 类型项 / Match 分支体 / Match scrutinee）与 force.rs
+/// 的 Match splice 点原为 `&mut Vec::new()` 对——每次嵌套调用一对新小 Vec
+/// （首块 cap 4 × 8B = 32B，church 每轮 8269 个）。改为 **LIFO 池**：借一对、
+/// 还一对，池热后零分配（纪律同 `TRAIT_METAS_SNAP_POOL`；差异只在元素带
+/// `'a`，故池用 `'static` 代存，见 `quote_sub_take` 的 SAFETY 注）。
+///
+/// 为什么不是「本帧复用一对」（已实测证伪，2026-09-23）：每个嵌套调用都开
+/// 新帧、且多数帧只做一次嵌套调用，帧内复用不减少任何一次分配（`l06l13mem`
+/// 计数逐项不变）；而池是**跨帧**复用——嵌套链退栈后缓冲回池，下一棵子树
+/// 直接用，只有「同时在飞」的深度条数会被新建。
+///
+/// 取值/还值纪律（不可省）：
+/// - **取时 clear**、**还栈前 clear**：池内条目恒为空 ⇒ 池里从不真正持有
+///   短生命周期引用（`'static` 只是存放口径，与 `unify_stack`/`QUOTE_NAT_TM`
+///   同款论证）；
+/// - 池长与单条容量都有上限：异常形态退化为「借不到就新建」，不常驻膨胀。
+thread_local! {
+    static QUOTE_SUB_POOL: RefCell<Vec<(Vec<QJob<'static>>, Vec<&'static Tm<'static>>)>> =
+        RefCell::new(Vec::new());
+}
+
+/// 池长上限（= 同时在飞的嵌套 quote 深度高水位；超出即丢弃还栈条目）。
+const QUOTE_SUB_POOL_MAX: usize = 64;
+/// 单条容量上限（元素数）：超过即丢弃（quote 草稿栈实测只在 cap 4 量级，
+/// 大缓冲不值得常驻）。
+const QUOTE_SUB_CAP_MAX: usize = 1024;
+
+/// 借一对嵌套 quote 草稿栈（LIFO；池空 ⇒ 空 Vec，语义同原 `Vec::new()`）。
+pub(super) fn quote_sub_take<'a>() -> (Vec<QJob<'a>>, Vec<&'a Tm<'a>>) {
+    let (mut tasks, mut done) = QUOTE_SUB_POOL
+        .with(|p| p.borrow_mut().pop())
+        .unwrap_or_default();
+    tasks.clear();
+    done.clear();
+    // SAFETY：'static 仅是**存放**口径——池内条目在还栈前与取栈后都 clear，
+    // 池里只有容量、没有任何 `'a` 值；`QJob<'a>`/`&'a Tm<'a>` 与 `'static`
+    // 变体布局逐位相同（生命周期不参与布局）。同 `unify_stack`/
+    // `TWIN_DECLB_CACHE`/`QUOTE_NAT_TM` 的既有纪律。
+    unsafe {
+        (
+            std::mem::transmute::<Vec<QJob<'static>>, Vec<QJob<'a>>>(tasks),
+            std::mem::transmute::<Vec<&'static Tm<'static>>, Vec<&'a Tm<'a>>>(done),
+        )
+    }
+}
+
+/// 归还一对草稿栈（先 clear 再入池，见上纪律）。
+pub(super) fn quote_sub_put<'a>(mut tasks: Vec<QJob<'a>>, mut done: Vec<&'a Tm<'a>>) {
+    tasks.clear();
+    done.clear();
+    if tasks.capacity() > QUOTE_SUB_CAP_MAX || done.capacity() > QUOTE_SUB_CAP_MAX {
+        return;
+    }
+    QUOTE_SUB_POOL.with(|p| {
+        let mut p = p.borrow_mut();
+        if p.len() < QUOTE_SUB_POOL_MAX {
+            // SAFETY：同上——条目此刻为空，池里不留 `'a` 引用。
+            p.push(unsafe {
+                (
+                    std::mem::transmute::<Vec<QJob<'a>>, Vec<QJob<'static>>>(tasks),
+                    std::mem::transmute::<Vec<&'a Tm<'a>>, Vec<&'static Tm<'static>>>(done),
+                )
+            });
+        }
+    });
+}
