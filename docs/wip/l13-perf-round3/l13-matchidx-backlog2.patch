+struct MatchIdx {
+    /// constr_idx → 该 idx 的首个 Con 臂位（稠密，0..=max_idx）。
+    first: Vec<u32>,
+    /// 臂位 → 同 constr_idx 的下一臂位（NONE_ARM = 链尾）。
+    next: Vec<u32>,
+    /// 首个 Any/Bind 臂位（NONE_ARM = 无兜底臂）。
