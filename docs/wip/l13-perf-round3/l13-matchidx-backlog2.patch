+/// 查/懒建 cases 的分派索引。窄表（< [`CON_INDEX_MIN_ARMS`] 臂）返回
+/// `None` 且**不触碰 TLS**——窄表路径唯一新增成本是一次长度比较。
+/// 命中（含负结果哨兵）以 `Rc` 句柄返回，本代内同节点后续分派全部
+/// 复用，不再扫臂表建索引（上轮证伪的「逐调用重建」形态不复存在）。
+fn match_idx_of(cases: &[(PatternDetail, &Tm)]) -> Option<Rc<MatchIdx>> {
+    if cases.len() < CON_INDEX_MIN_ARMS {
+        return None;
+    }
+    let key = (cases.as_ptr() as usize, cases.len());
+    MATCH_IDX.with(|m| {
+        let mut m = m.borrow_mut();
+        if let Some(rc) = m.get(&key) {
+            return Some(rc.clone());
+        }
+        let rc = Rc::new(build_match_idx(cases));
+        m.insert(key, rc.clone());
+        Some(rc)
+    })
+}
