+/// 建表（已过 [`CON_INDEX_MIN_ARMS`] 闸）。逆序一遍填链：`first[ci]` 在
+/// 逆序扫描里始终是「已见的最小臂位」，先取出作 `next[pos]` 再覆盖——
+/// 终态 `first[ci]` = 首臂、链沿臂位升序，无需辅助 map。
+fn build_match_idx(cases: &[(PatternDetail, &Tm)]) -> MatchIdx {
+    let fallback = cases
+        .iter()
+        .position(|(p, _)| matches!(p, PatternDetail::Any(..) | PatternDetail::Bind(_)))
+        .map_or(NONE_ARM, |pos| pos as u32);
+    let mut max_ci = 0u32;
+    let mut any_con = false;
+    for (pat, _) in cases {
+        if let PatternDetail::Con(ci, ..) = pat {
+            any_con = true;
+            if *ci > max_ci {
+                max_ci = *ci;
+            }
+        }
+    }
+    if !any_con || max_ci as usize >= CON_INDEX_SPARSE_FACTOR * cases.len() {
+        return MatchIdx { first: Vec::new(), next: Vec::new(), fallback };
+    }
+    let mut first = vec![NONE_ARM; max_ci as usize + 1];
+    let mut next = vec![NONE_ARM; cases.len()];
+    for (pos, (pat, _)) in cases.iter().enumerate().rev() {
+        if let PatternDetail::Con(ci, ..) = pat {
+            let slot = &mut first[*ci as usize];
+            next[pos] = *slot;
+            *slot = pos as u32;
+        }
+    }
+    MatchIdx { first, next, fallback }
+}
