+/// prelude / kick / compact 各 bump 边界必经，继承其完整失效纪律）。
+/// 容量过 [`SPINE_SHRINK_MIN_ENTRIES`]（1<<16）还桶——14 表归还档同款
+/// 纪律：键 16B + Rc 句柄 8B，1<<16 槽 ≈ 2MB 空桶才值得还；稳态条目数
+/// = 宽 match 节点数（个位到百位级），远低于阈值，常态只 `clear` 复用。
+pub(super) fn match_idx_clear() {
+    MATCH_IDX.with(|m| {
+        let _ = m.borrow_mut().reclaim(SPINE_SHRINK_MIN_ENTRIES);
+    });
+}
